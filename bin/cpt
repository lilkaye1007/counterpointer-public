#!/bin/zsh
set -euo pipefail
setopt no_bg_nice
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
sqlite3() { /usr/bin/sqlite3 -cmd '.timeout 10000' "$@"; }
sed() { /usr/bin/sed "$@"; }
rg() { /usr/bin/grep -E "$@"; }
cmux() {
  if [[ -n "${COUNTERPOINTER_CMUX_BIN:-}" ]]; then
    command "$COUNTERPOINTER_CMUX_BIN" "$@"
  else
    command cmux "$@"
  fi
}

project_root="${PWD}"
launcher_path="${0:A}"
if [[ "${1:-}" == "-C" ]]; then
  project_root="$2"; shift 2
fi
state_root="$project_root/.counterpointer"
db="$state_root/state.sqlite3"
mkdir -p "$state_root"

init_db() {
  local schema_version=6 init_lock="$state_root/schema-init.lock" lock_owner lock_attempts=0

  # 親・supervisor・watchdogがほぼ同時に起動しても、DDL migrationは
  # 1 processだけが実行する。通常起動時はschema_versionを見て即時returnする。
  if [[ -f "$db" ]] && [[ "$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='schema_version'),'')" 2>/dev/null || true)" == "$schema_version" ]]; then
    return
  fi
  while ! mkdir "$init_lock" 2>/dev/null; do
    lock_owner=""
    [[ ! -r "$init_lock/pid" ]] || lock_owner="$(<"$init_lock/pid")"
    if [[ "$lock_owner" == <-> ]] && ! kill -0 "$lock_owner" 2>/dev/null; then
      /bin/rm -f "$init_lock/pid"
      rmdir "$init_lock" 2>/dev/null || true
      continue
    fi
    lock_attempts=$(( lock_attempts + 1 ))
    if (( lock_attempts >= 200 )); then
      print -u2 'SQLite schema初期化の待機時間を超えました'
      return 1
    fi
    sleep 0.05
  done
  print -r -- $$ > "$init_lock/pid"
  if [[ -f "$db" ]] && [[ "$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='schema_version'),'')" 2>/dev/null || true)" == "$schema_version" ]]; then
    /bin/rm -f "$init_lock/pid"
    rmdir "$init_lock" 2>/dev/null || true
    chmod 700 "$state_root"
    chmod 600 "$db"
    return
  fi
  sqlite3 "$db" >/dev/null <<'SQL'
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS tasks (
  task_id TEXT PRIMARY KEY,
  source_text TEXT NOT NULL,
  mode TEXT NOT NULL CHECK(mode IN ('detailed','quick')),
  state TEXT NOT NULL CHECK(state IN ('REGISTERED','READY','RUNNING','CLAIMED_DONE','VERIFYING','VERIFIED','FAILED','CANCELLED')),
  worktree TEXT,
  commit_sha TEXT,
  dispatch_base_sha TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS registrations (
  registration_id TEXT PRIMARY KEY,
  registration_mode TEXT NOT NULL CHECK(registration_mode IN ('detailed','quick')),
  source_text TEXT NOT NULL,
  source_hash TEXT NOT NULL,
  status TEXT NOT NULL CHECK(status IN ('REGISTERED','NEEDS_DECISION','REJECTED')),
  reason_code TEXT,
  task_id TEXT,
  plan_hash TEXT,
  confirmed_plan_hash TEXT,
  question_count INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS task_artifacts (
  task_id TEXT PRIMARY KEY,
  artifact_dir TEXT NOT NULL,
  goal_hash TEXT NOT NULL,
  execution_plan_hash TEXT NOT NULL,
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS change_sets (
  change_set_id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  state TEXT NOT NULL CHECK(state IN ('OPEN','INTEGRATING','VERIFIED','AWAITING_MERGE','MERGED','CLOSED','FAILED','CANCELLED')),
  membership_revision INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS change_set_tasks (
  change_set_id TEXT NOT NULL,
  task_id TEXT NOT NULL UNIQUE,
  member_kind TEXT NOT NULL CHECK(member_kind IN ('implementation','integration_fix','review_fix','gate_change')),
  added_revision INTEGER NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY(change_set_id,task_id)
);
CREATE TABLE IF NOT EXISTS task_contracts (
  task_id TEXT NOT NULL,
  contract_id TEXT NOT NULL,
  direction TEXT NOT NULL CHECK(direction IN ('PROVIDES','CONSUMES')),
  PRIMARY KEY(task_id,contract_id,direction)
);
CREATE TABLE IF NOT EXISTS task_edges (
  source_task_id TEXT NOT NULL,
  target_task_id TEXT NOT NULL,
  edge_type TEXT NOT NULL CHECK(edge_type IN ('DEPENDENCY','CONFLICT')),
  reason TEXT NOT NULL,
  origin TEXT NOT NULL CHECK(origin IN ('explicit','detected')),
  created_at TEXT NOT NULL,
  PRIMARY KEY(source_task_id,target_task_id,edge_type,reason)
);
CREATE TABLE IF NOT EXISTS execution_graph_snapshots (
  snapshot_id TEXT PRIMARY KEY,
  graph_hash TEXT NOT NULL,
  task_count INTEGER NOT NULL,
  edge_count INTEGER NOT NULL,
  valid INTEGER NOT NULL CHECK(valid IN (0,1)),
  created_at TEXT NOT NULL
