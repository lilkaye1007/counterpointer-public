  checkpoint_id TEXT PRIMARY KEY,
  session_kind TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  index_revision INTEGER NOT NULL,
  summary_path TEXT NOT NULL,
  summary_hash TEXT NOT NULL,
  created_at TEXT NOT NULL
);
SQL
  if ! sqlite3 "$db" "SELECT sql FROM sqlite_master WHERE type='table' AND name='change_sets';" | /usr/bin/grep -q AWAITING_MERGE; then
    sqlite3 "$db" <<'SQL'
BEGIN IMMEDIATE;
ALTER TABLE change_sets RENAME TO change_sets_legacy;
CREATE TABLE change_sets (
  change_set_id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  state TEXT NOT NULL CHECK(state IN ('OPEN','INTEGRATING','VERIFIED','AWAITING_MERGE','MERGED','CLOSED','FAILED','CANCELLED')),
  membership_revision INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
INSERT INTO change_sets SELECT * FROM change_sets_legacy;
DROP TABLE change_sets_legacy;
COMMIT;
SQL
  fi
  # 旧integration_jobsは5列だけだった。再作成時のSELECTより先に新列を
  # 足し、どの旧versionからでも同じmigrationを通せるようにする。
  sqlite3 "$db" 'ALTER TABLE integration_jobs ADD COLUMN change_set_id TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE integration_jobs ADD COLUMN membership_revision INTEGER;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE integration_jobs ADD COLUMN candidate_sha TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE integration_jobs ADD COLUMN failure_reason TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE integration_jobs ADD COLUMN evidence_path TEXT;' 2>/dev/null || true
  if ! sqlite3 "$db" "SELECT sql FROM sqlite_master WHERE type='table' AND name='integration_jobs';" | /usr/bin/grep -q PR_READY; then
    sqlite3 "$db" <<'SQL'
BEGIN IMMEDIATE;
ALTER TABLE integration_jobs RENAME TO integration_jobs_legacy;
CREATE TABLE integration_jobs (
  job_id TEXT PRIMARY KEY,
  state TEXT NOT NULL CHECK(state IN ('WAITING_TASKS','PREPARING','VERIFYING','VERIFIED','PR_READY','FAILED')),
  worktree TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  change_set_id TEXT,
  membership_revision INTEGER,
  candidate_sha TEXT,
  failure_reason TEXT,
  evidence_path TEXT
);
INSERT INTO integration_jobs(job_id,state,worktree,created_at,updated_at,change_set_id,membership_revision,candidate_sha,failure_reason,evidence_path)
SELECT job_id,state,worktree,created_at,updated_at,change_set_id,membership_revision,candidate_sha,failure_reason,evidence_path FROM integration_jobs_legacy;
DROP TABLE integration_jobs_legacy;
COMMIT;
SQL
  fi
  sqlite3 "$db" 'ALTER TABLE tasks ADD COLUMN worktree TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE tasks ADD COLUMN commit_sha TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE tasks ADD COLUMN dispatch_base_sha TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE publish_requests ADD COLUMN updated_at TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE publish_requests ADD COLUMN failure_reason TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE notifications ADD COLUMN provider_id TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE notifications ADD COLUMN external_id TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE notifications ADD COLUMN last_error TEXT;' 2>/dev/null || true
  sqlite3 "$db" 'ALTER TABLE notifications ADD COLUMN next_attempt_at TEXT;' 2>/dev/null || true
  sqlite3 "$db" "UPDATE publish_requests SET updated_at=created_at WHERE updated_at IS NULL;"
  sqlite3 "$db" "INSERT OR IGNORE INTO change_sets(change_set_id,title,state,membership_revision,created_at,updated_at)
    SELECT 'legacy-' || t.task_id,substr(t.source_text,1,80),CASE WHEN t.state='CANCELLED' THEN 'CANCELLED' ELSE 'OPEN' END,1,t.created_at,t.updated_at
    FROM tasks t LEFT JOIN change_set_tasks m ON m.task_id=t.task_id WHERE m.task_id IS NULL;"
  sqlite3 "$db" "INSERT OR IGNORE INTO change_set_tasks(change_set_id,task_id,member_kind,added_revision,created_at)
    SELECT 'legacy-' || t.task_id,t.task_id,'implementation',1,t.created_at
    FROM tasks t LEFT JOIN change_set_tasks m ON m.task_id=t.task_id WHERE m.task_id IS NULL;"
  sqlite3 "$db" "INSERT OR IGNORE INTO task_schedule(task_id) SELECT task_id FROM tasks; INSERT INTO metadata(key,value) VALUES('schema_version','$schema_version') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
  chmod 700 "$state_root"
  chmod 600 "$db"
  /bin/rm -f "$init_lock/pid"
  rmdir "$init_lock" 2>/dev/null || true
}

now() { /bin/date -u +%Y-%m-%dT%H:%M:%SZ; }
normalize_cmux_ref() {
  local kind="$1" value="$2" suffix
  [[ -n "$value" ]] || return 0
  if [[ "$value" == "$kind:"* ]]; then
    suffix="${value#*:}"
    # cmuxの短縮refは workspace:1 の形式。環境変数が返すUUIDへ
    # workspace: を付けた値は無効なので、旧状態も読み取り時に修復する。
    if print -r -- "$suffix" | /usr/bin/grep -Eq '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'; then
      print -r -- "$suffix"
    else
      print -r -- "$value"
    fi
  else
    print -r -- "$value"
  fi
}
# Never use resume --last: selection can occur before -C is applied and choose
# the parent's (or another application's) conversation. Verify both the index
# and the rollout metadata against this Task's unique worktree.
browser_child_pane() {
  local layout_json="$1" child_surface="$2"
  print -r -- "$layout_json" | jq -er --arg surface "$child_surface" '
    [.. | objects | select((.surfaces? | type)=="array")
      | select(any(.surfaces[]; .ref==$surface or .id==$surface))
      | (.ref // .id // .pane_ref // .pane_id) | select(type=="string")]
    | unique | if length==1 then .[0] else error("Task child pane not found uniquely") end'
}
size_initial_parent_pane() {
  local workspace="$1" pane="$2" pane_json grow_points attempt
  for attempt in {1..5}; do
    pane_json="$(cmux --json list-panes --workspace "$workspace")" || return 1
    grow_points="$(print -r -- "$pane_json" | jq -er --arg pane "$pane" '
      [.container_frame.width,
       (.panes[] | select(.ref==$pane or .id==$pane) | .pixel_frame.width)]
      | if length==2 and all(.[]; type=="number" and .>0)
        then ((.[0] * 2 / 3 - .[1]) | floor) else empty end' 2>/dev/null)" && break
    sleep 0.1
  done
  [[ "$grow_points" == <-> || "$grow_points" == -<-> ]] || return 1
  (( grow_points > 0 )) || return 0
  cmux resize-pane --pane "$pane" --workspace "$workspace" -R --amount "$grow_points" >/dev/null
}
place_browser_in_child_tab() {
  local layout_json child_pane browser_pane browser_tmp
  layout_json="$(cmux tree --workspace "$browser_workspace" --json)" || return 3
  child_pane="$(browser_child_pane "$layout_json" "$browser_child_surface")" || return 3
  browser_pane="$(browser_child_pane "$layout_json" "$browser_surface")" || return 3
  if [[ "$browser_pane" != "$child_pane" ]]; then
    cmux move-surface --surface "$browser_surface" --pane "$child_pane" --workspace "$browser_workspace" --focus false >/dev/null || return 3
  fi
  browser_tmp="$(mktemp "$browser_record.XXXXXX")"
  jq --arg child "$browser_child_surface" '. + {layout:"child-tab",child_surface:$child}' "$browser_record" > "$browser_tmp"
  /bin/mv "$browser_tmp" "$browser_record"
}
close_task_browser() {
  local task="$1" wt="$2" record surface workspace
  record="$wt/.counterpointer-task/browser-surface.json"
  [[ -f "$record" && ! -L "$record" ]] || return 0
  surface="$(jq -er --arg task "$task" 'select(.task_id==$task) | .surface | select(type=="string" and length>0)' "$record")" || return 3
  workspace="$(jq -er '.workspace | select(type=="string" and length>0)' "$record")" || return 3
  cmux close-surface --workspace "$workspace" --surface "$surface" >/dev/null || return 3
  /bin/rm -f "$record"
}
reconcile_completed_child_panes() {
  local task worktree generation record marker surface workspace tree marker_generation
  while IFS='|' read -r task worktree generation; do
    [[ -n "$task" && -n "$worktree" && -n "$generation" ]] || continue
    marker="$worktree/.counterpointer-task/selfcheck.txt"
    record="$worktree/.counterpointer-task/child-surface.json"
    [[ -s "$marker" && -f "$record" && ! -L "$record" ]] || continue
    marker_generation="$(sed -n 's/^generation=//p' "$marker" | sed -n '1p')"
    [[ "$marker_generation" == "$generation" ]] || continue
    /usr/bin/grep -Fxq 'result=PASSED' "$marker" || continue
    jq -e --arg task "$task" --arg generation "$generation" \
      '.task_id==$task and .generation==$generation and (.surface|type)=="string" and (.surface|length)>0' \
      "$record" >/dev/null 2>&1 || continue
    surface="$(jq -r '.surface' "$record")"
    workspace="$(jq -r '.workspace // empty' "$record")"
    [[ -n "$workspace" ]] || workspace="$(sqlite3 "$db" "SELECT COALESCE(workspace_ref,'') FROM task_runtimes WHERE task_id='$(sql_quote "$task")' AND generation=$generation;")"
    [[ -n "$workspace" ]] || continue
    close_task_browser "$task" "$worktree" || continue
    tree="$(cmux tree --workspace "$workspace" --json 2>/dev/null)" || continue
    if print -r -- "$tree" | jq -e --arg surface "$surface" \
      '[.. | objects | select((.surfaces? | type)=="array") | .surfaces[] | (.ref // .id)] | any(.==$surface)' >/dev/null 2>&1; then
      cmux close-surface --workspace "$workspace" --surface "$surface" >/dev/null 2>&1 || continue
    fi
    /bin/rm -f "$record"
    if [[ -s "$state_root/orchestrator.last-child-surface" ]] && \
      [[ "$(<"$state_root/orchestrator.last-child-surface")" == "$surface" ]]; then
      /bin/rm -f "$state_root/orchestrator.last-child-surface"
    fi
    event task "$task" CHILD_PANE_CLOSED "generation=$generation surface=$surface"
  done < <(sqlite3 "$db" "SELECT t.task_id,t.worktree,r.generation FROM tasks t JOIN task_runtimes r USING(task_id) WHERE t.state IN ('CLAIMED_DONE','VERIFYING','VERIFIED') AND r.state='COMPLETED' AND r.generation=(SELECT MAX(x.generation) FROM task_runtimes x WHERE x.task_id=t.task_id);")
}
codex_session_for_worktree() {
  local wt="$1" codex_root="${CODEX_HOME:-$HOME/.codex}" codex_db candidate rollout meta meta_cwd
  for codex_db in "$codex_root"/state_*.sqlite(N.om); do
    while IFS='|' read -r candidate rollout; do
      [[ -f "$rollout" ]] || continue
      print -r -- "$candidate" | /usr/bin/grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || continue
      meta="$(head -n 1 "$rollout")"
      print -r -- "$meta" | jq -e --arg id "$candidate" '.type=="session_meta" and .payload.id==$id and (.payload.cwd|type)=="string"' >/dev/null 2>&1 || continue
      meta_cwd="$(print -r -- "$meta" | jq -r .payload.cwd)"
      [[ "${meta_cwd:A}" == "${wt:A}" ]] || continue
      print -r -- "$candidate"
      return 0
    done < <(sqlite3 -readonly "$codex_db" "SELECT id,rollout_path FROM threads WHERE archived=0 AND cwd IN ('$(sql_quote "$wt")','$(sql_quote "${wt:A}")') ORDER BY created_at DESC LIMIT 10;" 2>/dev/null || true)
  done
  return 1
}
status_label() {
  case "$1" in
    REGISTERED) print '登録済み';;
    READY) print '実行待ち';;
    RUNNING|ACTIVE) print '実行中';;
    NEEDS_ATTENTION) print '要対応';;
    CLAIMED_DONE) print '親検証待ち';;
    VERIFYING) print '検証中';;
    VERIFIED) print '検証済み';;
    COMPLETED) print '実行終了';;
    COMPLETE) print '完了';;
    OPEN) print '統合待ち';;
    INTEGRATING) print '統合検証中';;
    AWAITING_MERGE) print 'マージ待ち';;
    MERGED) print 'マージ済み';;
    CLOSED) print '未マージ終了';;
    EXTERNAL_VERIFY_PENDING) print '外部検証待ち';;
    PUBLISH_PENDING) print 'PR準備待ち';;
    INCORPORATION_PENDING) print '取り込み待ち';;
    INDEX_PENDING) print '索引更新待ち';;
    HELD) print '保留';;
    BLOCKED) print '実行条件待ち';;
    FAILED|LOST) print '失敗';;
    CANCELLED) print '取消';;
    STARTING) print '起動中';;
    RESUMING) print '再開中';;
    RESTARTING) print '再起動中';;
    RESUME) print '同一session';;
    RESTART) print '新規session';;
    STOPPED) print '停止';;
    CREDENTIALS_PENDING) print '設定待ち';;
    CREDENTIALS_VERIFIED) print '開始可能';;
    PENDING_AI_ANALYSIS) print 'AI分析待ち';;
    AWAITING_OWNER) print '承認待ち';;
    READY_INDEX) print '準備完了';;
    '') print 'なし';;
    *) print -r -- "$1";;
  esac
}
# Canonical owner-facing projection shared by text, JSON and the parent agent.
# Reading status performs no fetch, merge, index update or scheduling action.
task_status_json() {
  local rows row task_id task_state display_code reason hold blockers set_state
  local merge_sha index_sha head_sha branch base_branch evidence_ok attention current_generation current_worktree current_events
  head_sha="$(git -C "$project_root" rev-parse HEAD 2>/dev/null || true)"
  branch="$(git -C "$project_root" branch --show-current 2>/dev/null || true)"
  index_sha="$(sqlite3 "$db" 'SELECT source_sha FROM index_revisions ORDER BY revision DESC LIMIT 1;')"
  rows="$(sqlite3 -json "$db" "SELECT t.task_id,m.change_set_id,t.mode,t.state,t.worktree,t.commit_sha,t.created_at,t.updated_at,t.source_text,
    c.state AS change_set_state,j.state AS integration_state,COALESCE(s.hold_reason,'') AS hold_reason,
    r.pr_state,r.pr_url,r.base_branch,
    COALESCE((SELECT value FROM metadata WHERE key='publish_target_branch:' || r.request_id),(SELECT value FROM metadata WHERE key='publish_base_branch'),'main') AS target_branch,
    COALESCE((SELECT value FROM metadata WHERE key='publish_sync_reason:' || r.request_id),'') AS sync_reason,
    COALESCE((SELECT value FROM metadata WHERE key='integration_merge:' || j.job_id),j.candidate_sha,'') AS merge_sha,
    CASE WHEN v.status='PASSED' AND v.commit_sha=t.commit_sha THEN 1 ELSE 0 END AS evidence_matches
    FROM tasks t LEFT JOIN change_set_tasks m ON m.task_id=t.task_id
    LEFT JOIN change_sets c ON c.change_set_id=m.change_set_id
    LEFT JOIN task_schedule s ON s.task_id=t.task_id LEFT JOIN verify_results v ON v.task_id=t.task_id
    LEFT JOIN integration_jobs j ON j.job_id=(SELECT job_id FROM integration_jobs WHERE change_set_id=c.change_set_id AND membership_revision=c.membership_revision ORDER BY rowid DESC LIMIT 1)
    LEFT JOIN pull_requests r ON r.request_id=(SELECT r2.request_id FROM pull_requests r2 JOIN publish_requests p ON p.request_id=r2.request_id WHERE p.job_id=j.job_id AND p.state='PUBLISHED' ORDER BY r2.rowid DESC LIMIT 1)
    ORDER BY t.created_at,t.task_id;")"
  while IFS= read -r row; do
    task_id="$(print -r -- "$row" | jq -r .task_id)"
    task_state="$(print -r -- "$row" | jq -r .state)"
    set_state="$(print -r -- "$row" | jq -r '.change_set_state // ""')"
    hold="$(print -r -- "$row" | jq -r .hold_reason)"
    display_code="$task_state"; reason=''
    attention="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='runtime_attention:$(sql_quote "$task_id"):$(latest_runtime_generation "$task_id")';")"
    if [[ "$task_state" == RUNNING && -n "$attention" ]]; then
      display_code=NEEDS_ATTENTION; reason="$attention"
    elif [[ "$task_state" == RUNNING ]]; then
      current_generation="$(latest_runtime_generation "$task_id")"
      current_worktree="$(print -r -- "$row" | jq -r '.worktree // ""')"
      current_events="$current_worktree/.counterpointer-task/events-$current_generation.log"
      if [[ -f "$current_events" ]] && /usr/bin/tail -c 65536 "$current_events" | /usr/bin/tr -d '\000' | /usr/bin/grep -Fq 'This conversation is open in another app'; then
        display_code=NEEDS_ATTENTION
        reason='会話ロックを検出しました。旧ペインの終了と再開先の確認が必要です。プロセス生存を作業進行とは扱いません。'
      else
        reason='子プロセスは起動済みです。実装・検証の進行を保証する表示ではありません。'
      fi
    elif [[ "$task_state" == VERIFIED ]]; then
      evidence_ok="$(print -r -- "$row" | jq -r .evidence_matches)"
      case "$set_state" in
        FAILED|CANCELLED|CLOSED) display_code="$set_state"; reason='所属する変更の統合・公開が停止しています';;
        MERGED)
          merge_sha="$(print -r -- "$row" | jq -r .merge_sha)"
          base_branch="$(print -r -- "$row" | jq -r '.target_branch // ""')"
          if [[ "$evidence_ok" != 1 ]]; then
            display_code=EXTERNAL_VERIFY_PENDING; reason='現在のタスクコミットに一致する検証記録が必要です'
          elif [[ "$(print -r -- "$row" | jq -r '.pr_state // ""')" != MERGED || "$(print -r -- "$row" | jq -r '.integration_state // ""')" != (VERIFIED|PR_READY) ]]; then
            display_code=INCORPORATION_PENDING; reason='現在の統合候補とマージ済みPRの対応確認待ちです'
          elif [[ -z "$base_branch" || "$branch" != "$base_branch" || -z "$merge_sha" ]] || ! git -C "$project_root" merge-base --is-ancestor "$merge_sha" "$head_sha" 2>/dev/null; then
            display_code=INCORPORATION_PENDING; reason="$(print -r -- "$row" | jq -r '.sync_reason | select(length>0)')"; reason="${reason:-最終取り込み先への成果反映・ローカル同期待ちです}"
          elif [[ "$index_sha" != "$head_sha" || "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='index_onboarding_state';")" != READY ]]; then
            display_code=INDEX_PENDING; reason='現在のHEADに対応する正式索引の更新・確認待ちです'
          else
            display_code=COMPLETE
          fi;;
        AWAITING_MERGE) display_code=AWAITING_MERGE; reason='PRのレビュー・マージ待ちです';;
        VERIFIED) display_code=PUBLISH_PENDING; reason='統合候補の公開準備・承認待ちです';;
        INTEGRATING) display_code=INTEGRATING;;
        *)
          if [[ "$evidence_ok" == 1 ]]; then display_code=OPEN; reason='所属する変更の統合待ちです'
          else display_code=EXTERNAL_VERIFY_PENDING; reason='現在のタスクコミットに一致する検証記録が必要です'; fi;;
      esac
    elif [[ "$task_state" == READY ]]; then
      blockers="$(task_blockers "$task_id")"
      if [[ "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='scheduler_paused';")" == 1 ]]; then
        blockers="${blockers:+$blockers / }新規開始を一時停止中です"
      fi
      if [[ "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='index_enforcement';")" == 1 && ( -z "$index_sha" || "$index_sha" != "$head_sha" ) ]]; then
        blockers="${blockers:+$blockers / }基準HEADに対応する正式索引の更新待ちです"
      fi
      if [[ -n "$blockers" ]]; then display_code=BLOCKED; reason="$blockers"; fi
    fi
    if [[ -n "$hold" && "$task_state" != CANCELLED && "$display_code" != COMPLETE ]]; then
      display_code=HELD; reason="$hold${reason:+ / $reason}"
    fi
    print -r -- "$row" | jq -c --arg code "$display_code" --arg label "$(status_label "$display_code")" --arg reason "$reason" --arg task_label "$(status_label "$task_state")" --arg set_label "$(status_label "$set_state")" \
      '. + {task_label:$task_label,change_set_label:$set_label,display_state:$code,display_label:$label,waiting_reason:$reason,completed:($code=="COMPLETE")} | del(.merge_sha,.evidence_matches)'
  done < <(print -r -- "${rows:-[]}" | jq -c '.[]') | jq -sc .
}
status_paint() {
  local code="$1" label="${2:-$(status_label "$1")}" color reset=$'\e[0m' color_enabled=0
  if [[ -n "${CPT_STATUS_COLOR_ENABLED:-}" ]]; then
    color_enabled="$CPT_STATUS_COLOR_ENABLED"
  elif [[ -z "${NO_COLOR:-}" && ( "${TERM:-}" != dumb || "${CPT_COLOR:-auto}" == always ) ]]; then
    case "${CPT_COLOR:-auto}" in
      always) color_enabled=1;;
      auto) [[ -t 1 ]] && color_enabled=1;;
      never) ;;
    esac
  fi
  if (( ! color_enabled )); then
    print -r -- "$label"
    return
  fi
  case "$code" in
    RUNNING|ACTIVE|VERIFIED|COMPLETED|READY_INDEX|CREDENTIALS_VERIFIED) color=$'\e[32m';;
    REGISTERED|READY|STARTING|RESUMING|RESTARTING|PENDING_AI_ANALYSIS|AWAITING_OWNER|CREDENTIALS_PENDING) color=$'\e[33m';;
    FAILED|LOST) color=$'\e[31m';;
    CANCELLED|STOPPED) color=$'\e[2m';;
    *) color=''; reset='';;
  esac
  print -r -- "${color}${label}${reset}"
}
event() {
  local entity_type="$1" entity_id="$2" event_type="$3" detail="${4:-}" event_id timestamp sequence previous_hash detail_hash event_hash
  event_id="$(/usr/bin/uuidgen | /usr/bin/tr '[:upper:]' '[:lower:]')"
  timestamp="$(now)"
  sequence="$(sqlite3 "$db" 'SELECT COALESCE(MAX(sequence),0)+1 FROM audit_events;')"
  previous_hash="$(sqlite3 "$db" 'SELECT COALESCE(event_hash,"") FROM audit_events ORDER BY sequence DESC LIMIT 1;')"
  [[ -n "$previous_hash" ]] || previous_hash=GENESIS
  detail_hash="$(text_sha256 "$detail")"
  event_hash="$(text_sha256 "$sequence|$event_id|$entity_type|$entity_id|$event_type|$detail_hash|$previous_hash|$timestamp")"
  sqlite3 "$db" "BEGIN IMMEDIATE; INSERT INTO events VALUES ('$event_id','$(sql_quote "$entity_type")','$(sql_quote "$entity_id")','$(sql_quote "$event_type")','$(sql_quote "$detail")','$timestamp'); INSERT INTO audit_events VALUES ($sequence,'$event_id','$(sql_quote "$entity_type")','$(sql_quote "$entity_id")','$(sql_quote "$event_type")','$detail_hash','$previous_hash','$event_hash','$timestamp'); COMMIT;"
}
init_db
context_file="$state_root/context/project-context.md"
restart_context() {
  local restart="$state_root/context/restart-state.json"
  [[ -f "$restart" ]] || return 0
  jq -e '.status | type=="string"' "$restart" >/dev/null || { print -u2 'restart-state.jsonが不正です'; return 3; }
  [[ "$(jq -r '.status' "$restart")" != completed ]] || return 0
  [[ -s "$state_root/context/restart-handoff.md" ]] || { print -u2 '有効な再開状態に引継ぎ文書がありません'; return 3; }
  print '\n## 継続中の再起動引継ぎ（最初に読む）'
  print -r -- "$state_root/context/restart-handoff.md"
  print -r -- "$restart"
  print -r -- "$state_root/context/parent-summary.md"
  print '実状態と照合して最初の未完了工程から続行。既存Task・許可・依存・保留を維持し、親の照合前に後続を開始しない。'
  print "restart_state_sha256=$(file_sha256 "$restart")"
}
project_monitor_pids() {
  local process_list
  process_list="$(/bin/ps -axo pid=,command=)" || return 3
  print -r -- "$process_list" | awk -v root="$project_root" '$2=="/bin/zsh" && $3 ~ /\/cpt$/ && $4=="-C" && $5==root && ($6=="supervise" || $6=="watchdog") && $7=="--watch" {print $1 "|" $6}'
}
assert_no_old_parent() {
  local processes pid command_line
  processes="$(/bin/ps -axo pid=)" || return 3
  while IFS= read -r pid; do
    [[ "$pid" == <-> && "$pid" != $$ && "$pid" != "${1:-}" ]] || continue
    if print -r -- "$processes" | awk -v p="$pid" '$1==p{found=1} END{exit !found}'; then
      command_line="$(/bin/ps -p "$pid" -o command=)" || return 3
      if [[ "$command_line" == *"$state_root/parent-launch.zsh"* || "$command_line" == *codex* ]]; then
        print -u2 "旧親が生存しています: pid=$pid。旧親を終了してから起動してください。"
        return 3
      fi
    fi
  done < <(sqlite3 "$db" 'SELECT DISTINCT process_pid FROM parent_runtimes WHERE process_pid IS NOT NULL;')
}
refresh_context() {
  mkdir -p "$state_root/context"
  owner_file="$project_root/docs/requirements/owner-requirements.json"
  owner_hash="unavailable"
  [[ -f "$owner_file" ]] && owner_hash="$(sha256sum "$owner_file" | awk '{print $1}')"
  {
    print '# プロジェクト文脈カプセル'
    print "generated_at=$(now)"
    print "owner_requirements_sha256=$owner_hash"
    print ''
    print '## 安定プロジェクト索引'
    if [[ -x /opt/homebrew/bin/rg ]]; then
      /opt/homebrew/bin/rg --files -g '!.git' -g '!node_modules' -g '!vendor' | sort | sed -n '1,200p'
    elif [[ -x /usr/local/bin/rg ]]; then
      /usr/local/bin/rg --files -g '!.git' -g '!node_modules' -g '!vendor' | sort | sed -n '1,200p'
    fi
    print ''
    print '## 読み込み方針'
    print -r -- '- このカプセルは簡易索引であり、ソース本体の代替ではありません。'
    print -r -- '- 担当タスクに必要なSSOT・ソースだけを必要時に読み込みます。'
    print -r -- '- プロジェクト構成またはオーナー要件が変わったら再生成します。'
  } > "$context_file"
  restart_context >> "$context_file" || return $?
  print "$context_file"
}
generate_index_proposal() {
  local proposal_mode="${1:-scan}" source_sha base_revision scanner_revision tmp_entries canonical proposal_id proposal_dir
  local output_mode="${2:-report}"
  local tracked_path area_root area_id entry_kind entry_id content_hash timestamp
  [[ -d "$project_root/.git" ]] || { print -u2 '索引生成にはGitリポジトリが必要です'; return 2; }
  source_sha="$(git -C "$project_root" rev-parse HEAD 2>/dev/null)" || { print -u2 '索引生成には初回commitが必要です'; return 2; }
  base_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
  scanner_revision=scan-v2
  tmp_entries="$(mktemp)"
  while IFS= read -r -d '' tracked_path; do
    [[ -n "$tracked_path" && "$tracked_path" != *'|'* && "$tracked_path" != *$'\n'* ]] || continue
    if [[ "$tracked_path" == */* ]]; then area_root="${tracked_path%%/*}"; else area_root=ROOT; fi
    area_id="AREA-$(text_sha256 "area\\0$area_root" | /usr/bin/cut -c1-12)"
    case "$tracked_path" in
      README*|AGENTS.md|docs/design/*|docs/requirements/*|docs/decisions/*) entry_kind=SSOT;;
      *) entry_kind=SOURCE;;
    esac
    entry_id="$(text_sha256 "${entry_kind:l}\\0$tracked_path" | /usr/bin/cut -c1-12)"
    [[ "$entry_kind" == SSOT ]] && entry_id="SSOT-$entry_id" || entry_id="SRC-$entry_id"
    content_hash="$(git -C "$project_root" show "$source_sha:$tracked_path" | /usr/bin/openssl dgst -sha256 | awk '{print $NF}')"
    print -r -- "$entry_kind|$entry_id|$tracked_path|$content_hash|$area_id" >> "$tmp_entries"
  done < <(git -C "$project_root" ls-tree -rz --name-only "$source_sha")
  canonical="scanner=$scanner_revision
source=$source_sha
base_revision=$base_revision
$(LC_ALL=C sort "$tmp_entries")"
  proposal_id="$(text_sha256 "$canonical")"
  proposal_dir="$state_root/index/proposals/$proposal_id"
  mkdir -p "$proposal_dir"
  LC_ALL=C sort "$tmp_entries" > "$proposal_dir/entries.tsv"
  timestamp="$(now)"
  sqlite3 "$db" "BEGIN; INSERT OR IGNORE INTO index_proposals(proposal_id,source_sha,base_revision,scanner_revision,mode,status,artifact_dir,created_at) VALUES ('$proposal_id','$source_sha',$base_revision,'$scanner_revision','$(sql_quote "$proposal_mode")','PENDING','$(sql_quote "$proposal_dir")','$timestamp'); DELETE FROM index_entries WHERE proposal_id='$proposal_id'; COMMIT;"
  while IFS='|' read -r entry_kind entry_id tracked_path content_hash area_id; do
    sqlite3 "$db" "INSERT INTO index_entries VALUES ('$proposal_id','$(sql_quote "$entry_id")','$entry_kind','$(sql_quote "$tracked_path")','$content_hash','$area_id');"
  done < "$proposal_dir/entries.tsv"
  {
    print '# 索引・SSOT整理案（確認待ち）'
    print ''
    print "提案ID: $proposal_id"
    print "基準commit: $source_sha"
    print "現在revision: $base_revision"
    print ''
    print '## 検出した主要領域'
    sqlite3 "$db" "SELECT '- ' || area_id || ': ' || CASE WHEN instr(path,'/')>0 THEN substr(path,1,instr(path,'/')-1) ELSE 'ROOT' END FROM index_entries WHERE proposal_id='$proposal_id' GROUP BY area_id ORDER BY area_id;"
    print ''
    print '## 索引へ登録する既存SSOT'
    sqlite3 "$db" "SELECT '- ' || entry_id || ': ' || path FROM index_entries WHERE proposal_id='$proposal_id' AND entry_kind='SSOT' ORDER BY entry_id;"
    print ''
    print '## SSOTが不足している領域'
    sqlite3 "$db" "SELECT '- ' || area_id FROM index_entries WHERE proposal_id='$proposal_id' GROUP BY area_id HAVING SUM(entry_kind='SSOT')=0 ORDER BY area_id;"
    print ''
    print '## 登録前に解決が必要な項目'
    print -r -- '- 上記の領域・SSOT対応が正しいかオーナー確認が必要です。'
    print ''
    print "適用する場合: cpt index apply $proposal_id"
  } > "$proposal_dir/summary.md"
  sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('index_enforcement','1') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
  rm -f "$tmp_entries"
  print "$proposal_id"
  [[ "$output_mode" == id-only ]] || /bin/cat "$proposal_dir/summary.md"
}
apply_index_proposal() {
  local proposal_id="$1" row source_sha base_revision proposal_status artifact_dir current_sha current_revision next_revision
  local index_dir staged_index staged_map staged_decisions staged_core index_hash timestamp
  row="$(sqlite3 "$db" "SELECT source_sha || '|' || base_revision || '|' || status || '|' || artifact_dir FROM index_proposals WHERE proposal_id='$(sql_quote "$proposal_id")';")"
  [[ -n "$row" ]] || { print -u2 "索引提案が見つかりません: $proposal_id"; return 2; }
  IFS='|' read -r source_sha base_revision proposal_status artifact_dir <<< "$row"
  [[ "$proposal_status" == PENDING ]] || { print -u2 "適用待ちの提案ではありません: $proposal_status"; return 2; }
  onboarding_proposal="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='index_onboarding_proposal';")"
  if [[ "$onboarding_proposal" == "$proposal_id" && "$(sqlite3 "$db" "SELECT COUNT(*) FROM index_analyses WHERE proposal_id='$(sql_quote "$proposal_id")' AND status='ANALYZED';")" != 1 ]]; then
    print -u2 '初回索引は親CodexによるSSOT分析とオーナー確認が完了するまで適用できません'
    return 3
  fi
  current_sha="$(git -C "$project_root" rev-parse HEAD)"
  current_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
  if [[ "$current_sha" != "$source_sha" || "$current_revision" != "$base_revision" ]]; then
    sqlite3 "$db" "UPDATE index_proposals SET status='STALE' WHERE proposal_id='$(sql_quote "$proposal_id")';"
    print -u2 '提案作成後にcheckoutまたは索引revisionが変わりました。再生成してください'
    return 3
  fi
  next_revision=$((current_revision+1))
  index_dir="$state_root/ssot"
  mkdir -p "$index_dir" "$state_root/decisions" "$state_root/context"
  staged_index="$index_dir/index.json.new"
  staged_map="$state_root/project-map.md.new"
  staged_decisions="$state_root/decisions/index.json.new"
  staged_core="$state_root/context/project-core.md.new"
  sqlite3 "$db" "SELECT json_object('schema_version',1,'project_id','$(sql_quote "${project_root:t}")','index_revision',$next_revision,'source_proposal_hash','$proposal_id','source_sha','$source_sha','areas',json((SELECT json_group_array(json_object('area_id',area_id,'root',root)) FROM (SELECT area_id,CASE WHEN instr(path,'/')>0 THEN substr(path,1,instr(path,'/')-1) ELSE '.' END AS root FROM index_entries WHERE proposal_id='$proposal_id' GROUP BY area_id ORDER BY area_id))),'sources',json((SELECT json_group_array(json_object('id',entry_id,'kind',entry_kind,'path',path,'sha256',content_hash,'area_id',area_id)) FROM (SELECT * FROM index_entries WHERE proposal_id='$proposal_id' ORDER BY entry_id))));" > "$staged_index"
  {
    print '# Project map'
    print ''
    print "index_revision=$next_revision"
    print "index_sha_pending=true"
    print ''
    sqlite3 "$db" "SELECT '- ' || area_id || ' → ' || CASE WHEN instr(path,'/')>0 THEN substr(path,1,instr(path,'/')-1) ELSE '.' END FROM index_entries WHERE proposal_id='$proposal_id' GROUP BY area_id ORDER BY area_id;"
  } > "$staged_map"
  print -r -- "{\"schema_version\":1,\"index_revision\":$next_revision,\"decisions\":[]}" > "$staged_decisions"
  analysis_path="$(sqlite3 "$db" "SELECT analysis_path FROM index_analyses WHERE proposal_id='$(sql_quote "$proposal_id")';")"
  if [[ -f "$analysis_path" ]]; then
    enriched_index="$staged_index.enriched"
    jq --slurpfile analysis "$analysis_path" '. + {project_analysis:$analysis[0]}' "$staged_index" > "$enriched_index"
    /bin/mv "$enriched_index" "$staged_index"
  fi
  index_hash="$(file_sha256 "$staged_index")"
  {
    print '# Project Core Capsule'
    print ''
    print "index_revision=$next_revision"
    print "index_hash=$index_hash"
    print '索引を入口にし、必要なSSOT・sourceだけをオンデマンドで読んでください。'
    print 'オーナー要件、外部作用の承認境界、Taskの対象pathを変更しないでください。'
  } > "$staged_core"
  restart_context >> "$staged_core" || return $?
  /bin/mv "$staged_index" "$index_dir/index.json"
  /bin/mv "$staged_map" "$state_root/project-map.md"
  /bin/mv "$staged_decisions" "$state_root/decisions/index.json"
  /bin/mv "$staged_core" "$state_root/context/project-core.md"
  timestamp="$(now)"
  sqlite3 "$db" "BEGIN; INSERT INTO index_revisions VALUES ($next_revision,'$proposal_id','$source_sha','$index_hash','$timestamp'); UPDATE index_proposals SET status='APPLIED',applied_at='$timestamp' WHERE proposal_id='$proposal_id'; INSERT INTO metadata(key,value) VALUES('active_index_revision','$next_revision') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('active_index_hash','$index_hash') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
  refresh_context >/dev/null
  event index "$proposal_id" APPLIED "revision=$next_revision hash=$index_hash"
  sqlite3 "$db" "UPDATE index_analyses SET status='APPLIED',applied_at='$timestamp' WHERE proposal_id='$(sql_quote "$proposal_id")'; INSERT INTO metadata(key,value) VALUES('index_onboarding_state','READY') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('index_refresh_required','0') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
  print "索引を適用しました: revision=$next_revision hash=$index_hash"
}
index_analysis_template() {
  local proposal_id="$1" artifact_dir
  artifact_dir="$(sqlite3 "$db" "SELECT artifact_dir FROM index_proposals WHERE proposal_id='$(sql_quote "$proposal_id")' AND status='PENDING';")"
  [[ -n "$artifact_dir" ]] || { print -u2 "確認待ち索引提案が見つかりません: $proposal_id"; return 2; }
  jq -n --arg proposal_id "$proposal_id" --arg manifest "$artifact_dir/entries.tsv" '{schema_version:1,proposal_id:$proposal_id,summary:"",existing_ssot:[],areas:[],gaps:[],inconsistencies:[],replacement_candidates:[],generated_drafts:[],manifest_path:$manifest}'
}
submit_index_analysis() {
  local proposal_id="$1" analysis_source="$2" artifact_dir analysis_path analysis_tmp analysis_hash
  [[ -f "$analysis_source" ]] || { print -u2 "AI分析JSONが見つかりません: $analysis_source"; return 2; }
  artifact_dir="$(sqlite3 "$db" "SELECT artifact_dir FROM index_proposals WHERE proposal_id='$(sql_quote "$proposal_id")' AND status='PENDING';")"
  [[ -n "$artifact_dir" ]] || { print -u2 "確認待ち索引提案が見つかりません: $proposal_id"; return 2; }
  jq -e --arg id "$proposal_id" '
    .schema_version == 1 and .proposal_id == $id and
    (.summary | type == "string" and length > 0) and
    (.existing_ssot | type == "array") and
    all(.existing_ssot[]; (.path|type=="string") and (.role|type=="string") and (.quality|type=="string")) and
    (.areas | type == "array" and length > 0) and
    all(.areas[]; (.name|type=="string") and (.root|type=="string") and (.coverage=="covered" or .coverage=="partial" or .coverage=="missing") and (.ssot_paths|type=="array")) and
    (.gaps|type=="array") and (.inconsistencies|type=="array") and
    (.replacement_candidates|type=="array") and
    all(.replacement_candidates[]; (.existing_path|type=="string") and (.generated_draft|type=="string") and (.recommendation|type=="string") and (.reason|type=="string")) and
    (.generated_drafts|type=="array") and
    all(.generated_drafts[]; (.target_path|type=="string") and (.draft_path|type=="string") and (.rationale|type=="string"))
  ' "$analysis_source" >/dev/null || { print -u2 'AI分析JSONの形式が不正です'; return 2; }
  while IFS= read -r ssot_path; do
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM index_entries WHERE proposal_id='$(sql_quote "$proposal_id")' AND path='$(sql_quote "$ssot_path")';")" == 1 ]] || { print -u2 "Git管理対象にないSSOT候補です: $ssot_path"; return 2; }
  done < <(jq -r '.existing_ssot[].path' "$analysis_source")
  while IFS= read -r draft_path; do
    [[ -n "$draft_path" && "$draft_path" == "$artifact_dir/generated-ssot/"* && -f "$draft_path" ]] || { print -u2 "生成SSOT draftが提案領域内にありません: $draft_path"; return 2; }
  done < <(jq -r '.generated_drafts[].draft_path' "$analysis_source")
  mkdir -p "$artifact_dir"
  analysis_path="$artifact_dir/analysis.json"; analysis_tmp="$analysis_path.new.$$"
  jq -S . "$analysis_source" > "$analysis_tmp"; chmod 600 "$analysis_tmp"; /bin/mv "$analysis_tmp" "$analysis_path"
  analysis_hash="$(file_sha256 "$analysis_path")"
  sqlite3 "$db" "BEGIN; DELETE FROM index_analyses WHERE proposal_id='$(sql_quote "$proposal_id")'; INSERT INTO index_analyses VALUES ('$(sql_quote "$proposal_id")','ANALYZED','$(sql_quote "$analysis_path")','$analysis_hash',$(jq '.existing_ssot|length' "$analysis_path"),$(jq '[.areas[]|select(.coverage=="covered")]|length' "$analysis_path"),$(jq '[.areas[]|select(.coverage=="missing")]|length' "$analysis_path"),'$(now)',NULL); UPDATE index_entries SET entry_kind='SSOT' WHERE proposal_id='$(sql_quote "$proposal_id")' AND path IN ($(jq -r '.existing_ssot[].path' "$analysis_path" | awk '{gsub("\047","\047\047"); printf "%s\047%s\047",sep,$0; sep=","} END {if(NR==0) printf "\047\047"}')); INSERT INTO metadata(key,value) VALUES('index_onboarding_state','AWAITING_OWNER') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
  event index "$proposal_id" AI_ANALYSIS_COMPLETED "$analysis_hash"
  render_index_report "$proposal_id"
}
render_index_report() {
  local proposal_id="$1" analysis_path source_count ssot_count covered partial missing
  analysis_path="$(sqlite3 "$db" "SELECT analysis_path FROM index_analyses WHERE proposal_id='$(sql_quote "$proposal_id")';")"
  [[ -f "$analysis_path" ]] || { print -u2 "AI分析が未完了です: $proposal_id"; return 3; }
  source_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM index_entries WHERE proposal_id='$(sql_quote "$proposal_id")';")"
  ssot_count="$(jq '.existing_ssot|length' "$analysis_path")"; covered="$(jq '[.areas[]|select(.coverage=="covered")]|length' "$analysis_path")"; partial="$(jq '[.areas[]|select(.coverage=="partial")]|length' "$analysis_path")"; missing="$(jq '[.areas[]|select(.coverage=="missing")]|length' "$analysis_path")"
  print 'プロジェクトの索引・SSOT分析が完了しました。'
  print "現状: ソース・文書 ${source_count}件 / 既存SSOT ${ssot_count}件 / 対象領域 $((covered+partial+missing))件"
  print "網羅状況: 説明済み ${covered}件 / 一部不足 ${partial}件 / 未整備 ${missing}件"
  print "分析概要: $(jq -r '.summary' "$analysis_path")"
  print ''; print '既存SSOT:'
  jq -r '.existing_ssot[] | "- \(.path): \(.role)（品質: \(.quality)）"' "$analysis_path"
  print ''; print '不足・不一致:'
  if [[ "$(jq '(.gaps|length)+(.inconsistencies|length)' "$analysis_path")" == 0 ]]; then print -r -- '- なし'; else jq -r '.gaps[]? | "- 不足: " + (if type=="string" then . else (.area + " — " + .reason) end), .inconsistencies[]? | "- 不一致候補: " + (if type=="string" then . else (.path + " — " + .reason) end)' "$analysis_path"; fi
  print ''; print "生成SSOT案: $(jq '.generated_drafts|length' "$analysis_path")件"
  jq -r '.generated_drafts[]? | "- \(.target_path): \(.rationale)（draft: \(.draft_path)）"' "$analysis_path"
  print ''; print "既存SSOTとの比較・移行候補: $(jq '.replacement_candidates|length' "$analysis_path")件"
  if [[ "$(jq '.replacement_candidates|length' "$analysis_path")" == 0 ]]; then print -r -- '- なし'; else jq -r '.replacement_candidates[] | "- \(.existing_path) ↔ \(.generated_draft): \(.recommendation) — \(.reason)"' "$analysis_path"; fi
  print ''; print '承認すると行うこと:'
  print -r -- "- 既存SSOT ${ssot_count}件と全ファイルのhash・領域対応を正式索引へ登録"
  print -r -- '- 親・子CodexがTaskに必要な領域だけを読む設定を有効化'
  print -r -- '- 生成案は比較用draftとして保持し、既存SSOTは変更・削除しない'
  print ''; print '承認しても行わないこと:'
  print -r -- '- ソース、既存SSOT、Git履歴、外部サービスの変更'
  print -r -- '- 既存SSOTの統合・置換・削除（別途オーナー承認が必要）'
  print "承認する場合: cpt index apply $proposal_id"
}
record_task_index_delta() {
  local task_id="$1" base_sha="$2" commit_sha="$3" changed_path content_hash change_state
  sqlite3 "$db" "DELETE FROM task_index_deltas WHERE task_id='$(sql_quote "$task_id")';"
  while IFS= read -r -d '' changed_path; do
    [[ -n "$changed_path" && "$changed_path" != *'|'* && "$changed_path" != *$'\n'* ]] || continue
    if git -C "$project_root" cat-file -e "$commit_sha:$changed_path" 2>/dev/null; then change_state=PRESENT; content_hash="$(git -C "$project_root" rev-parse "$commit_sha:$changed_path")"; else change_state=DELETED; content_hash=''; fi
    sqlite3 "$db" "INSERT OR REPLACE INTO task_index_deltas VALUES ('$(sql_quote "$task_id")','$(sql_quote "$changed_path")','$change_state','$(sql_quote "$content_hash")','$(now)');"
  done < <(git -C "$project_root" diff --name-only -z "$base_sha" "$commit_sha")
}
create_integration_index_snapshot() {
  local job_id="$1" source_sha="$2" snapshot_dir manifest snapshot_json snapshot_hash tracked_path blob_hash
  snapshot_dir="$state_root/integration/$job_id/index"; mkdir -p "$snapshot_dir"; manifest="$snapshot_dir/files.tsv"; : > "$manifest"
  while IFS= read -r -d '' tracked_path; do
    [[ -n "$tracked_path" && "$tracked_path" != *'|'* && "$tracked_path" != *$'\n'* ]] || continue
    blob_hash="$(git -C "$project_root" rev-parse "$source_sha:$tracked_path")"; print -r -- "$tracked_path|$blob_hash" >> "$manifest"
  done < <(git -C "$project_root" ls-tree -rz --name-only "$source_sha")
  LC_ALL=C sort "$manifest" -o "$manifest"; snapshot_json="$snapshot_dir/index-candidate.json"
  jq -Rn --arg source_sha "$source_sha" '[inputs | split("|") | {path:.[0],content_hash:.[1]}] | {schema_version:1,source_sha:$source_sha,files:.}' < "$manifest" > "$snapshot_json"
  snapshot_hash="$(file_sha256 "$snapshot_json")"
  sqlite3 "$db" "INSERT OR REPLACE INTO integration_index_snapshots VALUES ('$(sql_quote "$job_id")','$source_sha','$(sql_quote "$snapshot_json")','$snapshot_hash','CANDIDATE','$(now)',NULL);"
  event integration "$job_id" INDEX_CANDIDATE_CREATED "$snapshot_hash"
}
promote_integrated_snapshots() {
  local head_sha="$1" snapshot_job snapshot_source
  while IFS='|' read -r snapshot_job snapshot_source; do
    [[ -n "$snapshot_job" && -n "$snapshot_source" ]] || continue
    if git -C "$project_root" merge-base --is-ancestor "$snapshot_source" "$head_sha" 2>/dev/null; then
      sqlite3 "$db" "UPDATE integration_index_snapshots SET state='PROMOTED',promoted_at=COALESCE(promoted_at,'$(now)') WHERE job_id='$(sql_quote "$snapshot_job")' AND state='CANDIDATE';"
    fi
  done < <(sqlite3 "$db" "SELECT job_id,source_sha FROM integration_index_snapshots WHERE state='CANDIDATE';")
}
sync_index_with_head() {
  local current_sha active_row active_revision active_proposal active_source analysis_path new_proposal changed_path review_required carried_path carried_hash
  current_sha="$(git -C "$project_root" rev-parse HEAD 2>/dev/null)" || return 2
  active_row="$(sqlite3 "$db" 'SELECT revision || "|" || proposal_id || "|" || source_sha FROM index_revisions ORDER BY revision DESC LIMIT 1;')"
  if [[ -z "$active_row" ]]; then print '正式索引は未作成です。親Codexの初回分析を完了してください。'; return 3; fi
  IFS='|' read -r active_revision active_proposal active_source <<< "$active_row"
  if [[ "$current_sha" == "$active_source" ]]; then
    sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('index_refresh_required','0') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
    promote_integrated_snapshots "$current_sha"
    print "正式索引は最新です: revision=$active_revision"
    return 0
  fi
  git -C "$project_root" merge-base --is-ancestor "$active_source" "$current_sha" 2>/dev/null || { print -u2 '現在のHEADが正式索引の履歴を含まないため自動更新を停止しました'; return 4; }
  analysis_path="$(sqlite3 "$db" "SELECT analysis_path FROM index_analyses WHERE proposal_id='$(sql_quote "$active_proposal")';")"
  review_required=0
  while IFS= read -r -d '' changed_path; do
    if [[ "$changed_path" == README* || "$changed_path" == AGENTS.md || "$changed_path" == docs/design/* || "$changed_path" == docs/requirements/* || "$changed_path" == docs/decisions/* ]] || { [[ -f "$analysis_path" ]] && jq -e --arg path "$changed_path" '.existing_ssot[]? | select(.path==$path)' "$analysis_path" >/dev/null; }; then
      review_required=1; break
    fi
  done < <(git -C "$project_root" diff --name-only -z "$active_source" "$current_sha")
  new_proposal="$(sqlite3 "$db" "SELECT p.proposal_id FROM index_proposals p JOIN metadata m ON m.key='index_onboarding_proposal' AND m.value=p.proposal_id WHERE p.source_sha='$current_sha' AND p.status='PENDING' AND EXISTS(SELECT 1 FROM metadata WHERE key='index_onboarding_state' AND value='PENDING_AI_ANALYSIS');")"
  if [[ -n "$new_proposal" ]]; then
    queue_index_analysis_notice
    deliver_parent_notices
    print "正式索引の再分析・確認待ちです: $new_proposal"
    return 3
  fi
  new_proposal="$(generate_index_proposal scan id-only)" || return $?
  if (( review_required )) || [[ ! -f "$analysis_path" ]]; then
    sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('index_onboarding_state','PENDING_AI_ANALYSIS') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('index_onboarding_proposal','$(sql_quote "$new_proposal")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('index_refresh_required','1') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
    queue_index_analysis_notice
    deliver_parent_notices
    print "SSOTに関係する変更を検知しました。親Codexの再分析が必要です: $new_proposal"
    return 3
  fi
  carried_path="$(sqlite3 "$db" "SELECT artifact_dir FROM index_proposals WHERE proposal_id='$(sql_quote "$new_proposal")';")/analysis.json"
  jq --arg id "$new_proposal" '.proposal_id=$id' "$analysis_path" > "$carried_path"
  chmod 600 "$carried_path"; carried_hash="$(file_sha256 "$carried_path")"
  sqlite3 "$db" "INSERT OR REPLACE INTO index_analyses VALUES ('$(sql_quote "$new_proposal")','ANALYZED','$(sql_quote "$carried_path")','$carried_hash',$(jq '.existing_ssot|length' "$carried_path"),$(jq '[.areas[]|select(.coverage=="covered")]|length' "$carried_path"),$(jq '[.areas[]|select(.coverage=="missing")]|length' "$carried_path"),'$(now)',NULL); UPDATE index_entries SET entry_kind='SSOT' WHERE proposal_id='$(sql_quote "$new_proposal")' AND path IN ($(jq -r '.existing_ssot[].path' "$carried_path" | awk '{gsub("\047","\047\047"); printf "%s\047%s\047",sep,$0; sep=","} END {if(NR==0) printf "\047\047"}'));"
  apply_index_proposal "$new_proposal" >/dev/null || return $?
  promote_integrated_snapshots "$current_sha"
  print "merge済み変更を正式索引へ自動反映しました: revision=$((active_revision+1))"
}
# A PR comparison base may be a temporary stacked branch. The publication
# target remains the branch where downstream work is based.
process_pending_publications() {
  local pending_request publish_log
  while IFS= read -r pending_request; do
    [[ -n "$pending_request" ]] || continue
    publish_log="$state_root/publish/$pending_request/worker.log"
    mkdir -p "${publish_log:h}"
    # Keep the same request and SHA approval on transient failures. apply
    # rechecks authorization, candidate refs and remote divergence under its lock.
    if "$launcher_path" -C "$project_root" publish apply "$pending_request" > "$publish_log" 2>&1; then
      chmod 600 "$publish_log"
    else
      chmod 600 "$publish_log"
      event publish "$pending_request" WORKER_PUBLISH_DEFERRED "公開処理が失敗しました。要求と承認を保持して次周期で再確認します。詳細: $publish_log"
    fi
  done < <(sqlite3 "$db" "SELECT p.request_id FROM publish_requests p LEFT JOIN publish_approvals a ON a.request_id=p.request_id AND a.head_sha=p.head_sha WHERE p.state='PREPARED' AND (a.request_id IS NOT NULL OR COALESCE((SELECT value FROM metadata WHERE key='publish_mode'),'manual')='automatic') ORDER BY p.rowid;")
}
assert_integration_acceptance() {
  local acceptance_job="$1" acceptance_dir acceptance_sha expected
  acceptance_dir="$(sqlite3 "$db" "SELECT COALESCE(evidence_path,'') FROM integration_jobs WHERE job_id='$(sql_quote "$acceptance_job")';")"
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM metadata WHERE value='1' AND (key='integration_review_required' OR key='integration_review_required:' || (SELECT change_set_id FROM integration_jobs WHERE job_id='$(sql_quote "$acceptance_job")'));")" != 0 || -f "$acceptance_dir/acceptance-required.json" ]] || return 0
  acceptance_sha="$(sqlite3 "$db" "SELECT candidate_sha FROM integration_jobs WHERE job_id='$(sql_quote "$acceptance_job")';")"
  expected="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='integration_acceptance:$(sql_quote "$acceptance_job")';")"
  [[ -f "$acceptance_dir/acceptance.json" && "$expected" == "$acceptance_sha|$(file_sha256 "$acceptance_dir/acceptance.json")" ]] || { print -u2 '統合SHAの最終受入証拠がありません・変更されています。公開を拒否します'; return 3; }
  python3 - "$acceptance_dir/acceptance.json" "$acceptance_sha" <<'CHECK_ACCEPTANCE'
import sys,json,pathlib,hashlib
r=json.loads(pathlib.Path(sys.argv[1]).read_text())
assert r['status']=='passed' and r['candidate_sha']==sys.argv[2] and r['remaining_checks']==[] and r['checks']
for check in r['checks']:
 assert check['exit_code']==0 and check['artifacts']
 for a in check['artifacts']: assert hashlib.sha256(pathlib.Path(a['path']).read_bytes()).hexdigest()==a['sha256']
CHECK_ACCEPTANCE
}

publish_target_branch() {
  local target
  target="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='publish_target_branch:$(sql_quote "$1")';")"
  [[ -n "$target" ]] || target="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='publish_base_branch';")"
  print -r -- "${target:-main}"
}
publish_sync_result() {
  local request_id="$1" code="$2" reason="$3"
  sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('publish_sync_state:$(sql_quote "$request_id")','$(sql_quote "$code")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('publish_sync_reason:$(sql_quote "$request_id")','$(sql_quote "$reason")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
  [[ "$code" == SYNCED ]] || event publish "$request_id" INDEX_REFRESH_DEFERRED "$code $reason"
}
# Bound network waits and kill only the process group created for this call.
# Perl is shipped with macOS; no GNU timeout dependency is required.
run_network_command() {
  local timeout_seconds="${CPT_SYNC_TIMEOUT_SECONDS:-30}"
  [[ "$timeout_seconds" == <-> && "$timeout_seconds" -ge 1 && "$timeout_seconds" -le 300 ]] || { print -u2 'CPT_SYNC_TIMEOUT_SECONDSは1〜300秒で指定してください'; return 2; }
  LC_ALL=C LANG=C /usr/bin/perl -e '
    use strict; use warnings; use POSIX qw(setsid); use Errno qw(EINTR);
    my $seconds = shift @ARGV;
    my $pid = fork(); defined $pid or die "fork: $!";
    if (!$pid) {
      setsid() >= 0 or die "setsid: $!";
      exec @ARGV; die "exec: $!";
    }
    my $stop = sub {
      my ($code) = @_;
      alarm 0;
      kill "TERM", -$pid;
      select undef, undef, undef, 0.2;
      kill "KILL", -$pid;
      waitpid $pid, 0;
      exit $code;
    };
    $SIG{ALRM} = sub { print STDERR "CPT network timeout after ${seconds}s\n"; $stop->(124); };
    $SIG{TERM} = sub { $stop->(143); };
    $SIG{INT} = sub { $stop->(130); };
    alarm $seconds;
    my $result;
    do { $result = waitpid $pid, 0; } while ($result < 0 && $! == EINTR);
    my $status = $?;
    alarm 0;
    exit 125 if $result < 0;
    exit(($status & 127) ? 128 + ($status & 127) : $status >> 8);
  ' "$timeout_seconds" "$@"
}
refresh_main_and_index_after_merge() {
  local request_id="$1" row remote_name base_branch job_id current_branch fetched_sha current_sha merge_sha sync_dir fetch_exit
  row="$(sqlite3 "$db" "SELECT r.remote_name || '|' || p.job_id FROM pull_requests r JOIN publish_requests p ON p.request_id=r.request_id WHERE r.request_id='$(sql_quote "$request_id")' AND r.pr_state='MERGED' AND p.state='PUBLISHED';")"
  [[ -n "$row" ]] || return 2
  IFS='|' read -r remote_name job_id <<< "$row"
  base_branch="$(publish_target_branch "$request_id")"
  git check-ref-format "refs/heads/$base_branch" >/dev/null 2>&1 || return 2
  # Pin legacy requests before comparing/syncing; do not inherit a stacked PR base.
  sqlite3 "$db" "INSERT OR IGNORE INTO metadata(key,value) VALUES('publish_target_branch:$(sql_quote "$request_id")','$(sql_quote "$base_branch")');"
  sync_dir="$state_root/publish/$request_id/sync"; mkdir -p "$sync_dir"; chmod 700 "$sync_dir"
  current_branch="$(git -C "$project_root" branch --show-current)"
  if [[ "$current_branch" != "$base_branch" || -n "$(git -C "$project_root" status --porcelain --untracked-files=no)" ]]; then
    publish_sync_result "$request_id" LOCAL_UNSAFE "ローカルの$base_branchが未選択、または未コミット変更があります"
    return 3
  fi
  fetch_exit=0
  run_network_command git -C "$project_root" fetch --no-tags "$remote_name" "$base_branch" > "$sync_dir/fetch.log" 2>&1 || fetch_exit=$?
  if (( fetch_exit != 0 )); then
    chmod 600 "$sync_dir/fetch.log"
    if (( fetch_exit == 124 )); then
      publish_sync_result "$request_id" FETCH_TIMEOUT "取得が時間制限を超えました。監視を継続して再試行します。詳細: $sync_dir/fetch.log"
      return 3
    fi
    publish_sync_result "$request_id" FETCH_FAILED "監視による$remote_name/$base_branch取得が失敗しました。次の監視周期で再試行します。詳細: $sync_dir/fetch.log"
    return 3
  fi
  chmod 600 "$sync_dir/fetch.log"
  fetched_sha="$(git -C "$project_root" rev-parse FETCH_HEAD)"; current_sha="$(git -C "$project_root" rev-parse HEAD)"
  git -C "$project_root" merge-base --is-ancestor "$current_sha" "$fetched_sha" || { publish_sync_result "$request_id" LOCAL_DIVERGED 'ローカルとremoteの履歴が分岐しています'; return 3; }
  if [[ "$current_sha" != "$fetched_sha" ]]; then
    if ! git -C "$project_root" merge --ff-only "$fetched_sha" > "$sync_dir/merge.log" 2>&1; then
      chmod 600 "$sync_dir/merge.log"
      publish_sync_result "$request_id" UPDATE_FAILED "安全なfast-forward更新が失敗しました。詳細: $sync_dir/merge.log"
      return 3
    fi
    chmod 600 "$sync_dir/merge.log"
  fi
  merge_sha="$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='integration_merge:$(sql_quote "$job_id")'),candidate_sha) FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
  if [[ -z "$merge_sha" ]] || ! git -C "$project_root" merge-base --is-ancestor "$merge_sha" "$fetched_sha" 2>/dev/null; then
    publish_sync_result "$request_id" TARGET_PENDING "PRはマージ済みですが、成果は最終取り込み先$base_branchに未反映です"
    return 3
  fi
  if ! sync_index_with_head; then
    publish_sync_result "$request_id" INDEX_PENDING '成果を取り込み済みです。正式索引の更新・再分析を待っています'
    return 3
  fi
  if [[ "$(sqlite3 "$db" 'SELECT source_sha FROM index_revisions ORDER BY revision DESC LIMIT 1;')" != "$fetched_sha" || "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='index_onboarding_state';")" != READY ]]; then
    publish_sync_result "$request_id" INDEX_PENDING '正式索引の更新完了条件を満たしていません'
    return 3
  fi
  publish_sync_result "$request_id" SYNCED ''
  event publish "$request_id" MERGED_INDEX_REFRESHED "$fetched_sha"
}
ensure_git_exclude() {
  exclude="$project_root/.git/info/exclude"
  [[ -d "$project_root/.git" ]] || return 0
  mkdir -p "${exclude:h}"
  touch "$exclude"
  if ! /usr/bin/grep -Fxq '.counterpointer/' "$exclude" 2>/dev/null; then
    print -r -- '# Counterpointer local state' >> "$exclude"
    print -r -- '.counterpointer/' >> "$exclude"
  fi
}
owner_requirements_ok() {
  owner_file="$project_root/docs/requirements/owner-requirements.json"
  hash_file="$project_root/docs/requirements/owner-requirements.sha256"
  [[ -f "$owner_file" && -f "$hash_file" ]] || return 0
  expected="$(awk '{print $1}' "$hash_file")"
  actual="$(sha256sum "$owner_file" | awk '{print $1}')"
  [[ -n "$expected" && "$expected" == "$actual" ]]
}
notification_config_root() {
  print -r -- "${COUNTERPOINTER_CONFIG_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/counterpointer}"
}
capacity_values() {
  local free_kib critical_mib warning_mib
  free_kib="$(df -Pk "$project_root" | awk 'NR==2 {print $4}')"
  critical_mib="$(sqlite3 "$db" "SELECT COALESCE(value,'512') FROM metadata WHERE key='capacity_critical_mib';")"
  warning_mib="$(sqlite3 "$db" "SELECT COALESCE(value,'1024') FROM metadata WHERE key='capacity_warning_mib';")"
  [[ -n "$critical_mib" ]] || critical_mib=512
  [[ -n "$warning_mib" ]] || warning_mib=1024
  CAPACITY_FREE_BYTES=$((free_kib * 1024))
  CAPACITY_CRITICAL_BYTES=$((critical_mib * 1024 * 1024))
  CAPACITY_WARNING_BYTES=$((warning_mib * 1024 * 1024))
}
ensure_capacity() {
  local operation="$1" latest_state episode_id timestamp
  capacity_values
  latest_state="$(sqlite3 "$db" 'SELECT COALESCE(state,"") FROM capacity_episodes ORDER BY rowid DESC LIMIT 1;')"
  timestamp="$(now)"
  if (( CAPACITY_FREE_BYTES < CAPACITY_CRITICAL_BYTES )); then
    if [[ "$latest_state" != CRITICAL ]]; then
      episode_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
      sqlite3 "$db" "INSERT INTO capacity_episodes VALUES ('$episode_id','CRITICAL',$CAPACITY_FREE_BYTES,$CAPACITY_CRITICAL_BYTES,$CAPACITY_WARNING_BYTES,'$timestamp');"
      event project "$project_root" CAPACITY_CRITICAL "free=$CAPACITY_FREE_BYTES operation=$operation"
    fi
    print -u2 "空き容量が安全下限未満のため$operationを開始しません: free=$((CAPACITY_FREE_BYTES/1024/1024))MiB critical=$((CAPACITY_CRITICAL_BYTES/1024/1024))MiB"
    return 5
  fi
  if (( CAPACITY_FREE_BYTES < CAPACITY_WARNING_BYTES )) && [[ "$latest_state" != WARNING ]]; then
    episode_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    sqlite3 "$db" "INSERT INTO capacity_episodes VALUES ('$episode_id','WARNING',$CAPACITY_FREE_BYTES,$CAPACITY_CRITICAL_BYTES,$CAPACITY_WARNING_BYTES,'$timestamp');"
    event project "$project_root" CAPACITY_WARNING "free=$CAPACITY_FREE_BYTES operation=$operation"
  elif (( CAPACITY_FREE_BYTES >= CAPACITY_WARNING_BYTES )) && [[ "$latest_state" == WARNING || "$latest_state" == CRITICAL ]]; then
    episode_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    sqlite3 "$db" "INSERT INTO capacity_episodes VALUES ('$episode_id','RECOVERED',$CAPACITY_FREE_BYTES,$CAPACITY_CRITICAL_BYTES,$CAPACITY_WARNING_BYTES,'$timestamp');"
    event project "$project_root" CAPACITY_RECOVERED "free=$CAPACITY_FREE_BYTES"
  fi
}
sql_quote() { print -r -- "$1" | sed "s/'/''/g"; }
file_sha256() { /usr/bin/openssl dgst -sha256 "$1" | awk '{print $NF}'; }
text_sha256() { print -rn -- "$1" | /usr/bin/openssl dgst -sha256 | awk '{print $NF}'; }
resolve_task_id() {
  local supplied="$1" exact match_count
  exact="$(sqlite3 "$db" "SELECT task_id FROM tasks WHERE task_id='$(sql_quote "$supplied")' LIMIT 1;")"
  if [[ -n "$exact" ]]; then
    print -r -- "$exact"
    return 0
  fi
  if (( ${#supplied} < 8 )); then
    print -u2 '短縮タスクIDは8文字以上で指定してください'
    return 2
  fi
  match_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE substr(task_id,1,length('$(sql_quote "$supplied")'))='$(sql_quote "$supplied")';")"
  if [[ "$match_count" == 1 ]]; then
    sqlite3 "$db" "SELECT task_id FROM tasks WHERE substr(task_id,1,length('$(sql_quote "$supplied")'))='$(sql_quote "$supplied")' LIMIT 1;"
    return 0
  fi
  if [[ "$match_count" == 0 ]]; then
    print -u2 "タスクが見つかりません: $supplied"
  else
    print -u2 "短縮タスクIDが複数件に一致します: $supplied"
  fi
  return 2
}
paths_overlap() {
  local left="${1%/}" right="${2%/}"
  left="${left#./}"; right="${right#./}"
  [[ "$left" == . || "$right" == . || "$left" == "$right" || "$left" == "$right"/* || "$right" == "$left"/* ]]
}
schedule_context_hash() {
  sqlite3 "$db" "SELECT t.task_id,a.execution_plan_hash,COALESCE(group_concat(p.path),'') FROM tasks t JOIN task_artifacts a ON a.task_id=t.task_id LEFT JOIN task_paths p ON p.task_id=t.task_id WHERE t.state<>'CANCELLED' GROUP BY t.task_id ORDER BY t.rowid; SELECT source_task_id,target_task_id,relation,reason FROM task_relations ORDER BY 1,2,3; SELECT task_id,contract_id,direction FROM task_contracts ORDER BY 1,2,3; SELECT source_task_id,target_task_id,edge_type FROM task_edges WHERE origin='explicit' ORDER BY 1,2,3;" | /usr/bin/openssl dgst -sha256 | awk '{print $NF}'
}
sqlite_json() {
  local result="$(sqlite3 -json "$db" "$1")"
  print -r -- "${result:-[]}"
}
schedule_priority_order() {
  sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (
    SELECT source_task_id,target_task_id FROM task_edges WHERE edge_type='DEPENDENCY'
    UNION SELECT reach.src,e.target_task_id FROM reach JOIN task_edges e ON e.source_task_id=reach.dst WHERE e.edge_type='DEPENDENCY')
    SELECT t.task_id FROM tasks t JOIN task_schedule s ON s.task_id=t.task_id
    WHERE t.state NOT IN ('FAILED','CANCELLED')
    ORDER BY CASE WHEN t.state='VERIFIED' THEN 0 WHEN t.state IN ('RUNNING','CLAIMED_DONE','VERIFYING') THEN 1 WHEN t.state='READY' THEN 2 ELSE 3 END,
      s.urgency DESC,COALESCE(s.due_at,'9999'),
      (SELECT COUNT(*) FROM reach JOIN tasks successor ON successor.task_id=reach.dst WHERE reach.src=t.task_id AND successor.state IN ('REGISTERED','READY')) DESC,t.rowid;"
}
validate_schedule_priority() {
  case "$1" in low) SCHEDULE_URGENCY=0;; normal) SCHEDULE_URGENCY=1;; high) SCHEDULE_URGENCY=2;; critical) SCHEDULE_URGENCY=3;; *) print -u2 '緊急度はlow|normal|high|criticalです'; return 2;; esac
  [[ -z "$2" ]] || print -r -- "$2" | jq -eR '. as $original | fromdateiso8601 | todateiso8601 == $original' >/dev/null 2>&1 || { print -u2 '期限はUTC形式 YYYY-MM-DDTHH:MM:SSZ で指定してください'; return 2; }
}
task_predecessors_complete() {
  local target_task_id="$1"
  [[ -z "$(task_blockers "$target_task_id")" ]]
}
task_blockers() {
  local target_task_id="$1" predecessor edge_type reason predecessor_state source_set target_set set_state candidate_sha own_hold assessment
  if [[ -f "$state_root/context/restart-state.json" ]]; then
    restart_block="$(jq -r --arg task "$target_task_id" 'select(.status=="active" and .hero_task==$task and .steps.restart_checked!="completed") | .id' "$state_root/context/restart-state.json")" || { print '再起動状態の読取失敗'; return 0; }
    [[ -z "$restart_block" ]] || print "再起動引継ぎの親照合待ち: $restart_block"
  fi
  [[ ! -f "$state_root/service.stop-requested" ]] || print 'サービス停止中: service startで再開'
  own_hold="$(sqlite3 "$db" "SELECT hold_reason FROM task_schedule WHERE task_id='$(sql_quote "$target_task_id")';")"
  [[ -z "$own_hold" ]] || print -r -- "判断待ち: $own_hold"
  if [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM registrations WHERE task_id='$(sql_quote "$target_task_id")' AND (status<>'REGISTERED' OR COALESCE(confirmed_plan_hash,'')<>plan_hash);")" != 0 ]]; then print '確認済み計画が必要です'; fi
  if [[ "${COUNTERPOINTER_TEST:-0}" != 1 || "${COUNTERPOINTER_SCHEDULER_REVIEW_TEST:-0}" == 1 ]]; then
    assessment="$(sqlite3 "$db" "SELECT COUNT(*) FROM task_schedule s JOIN task_artifacts a ON a.task_id=s.task_id WHERE s.task_id='$(sql_quote "$target_task_id")' AND s.assessed_plan_hash=a.execution_plan_hash;")"
    [[ "$assessment" == 1 ]] || print '親エージェントによるタスク関係の分析待ち'
  fi
  sqlite3 "$db" "SELECT '関係の確認待ち: ' || r.reason FROM task_relations r JOIN tasks s ON s.task_id=r.source_task_id JOIN tasks t ON t.task_id=r.target_task_id JOIN task_artifacts sa ON sa.task_id=s.task_id JOIN task_artifacts ta ON ta.task_id=t.task_id WHERE (r.source_task_id='$(sql_quote "$target_task_id")' OR r.target_task_id='$(sql_quote "$target_task_id")') AND s.state<>'CANCELLED' AND t.state<>'CANCELLED' AND (r.relation='UNCERTAIN' OR r.source_plan_hash<>sa.execution_plan_hash OR r.target_plan_hash<>ta.execution_plan_hash);"
  sqlite3 "$db" "SELECT '提供元が未確定: ' || c.contract_id FROM task_contracts c WHERE c.task_id='$(sql_quote "$target_task_id")' AND c.direction='CONSUMES' AND NOT EXISTS (SELECT 1 FROM task_contracts p JOIN tasks t ON t.task_id=p.task_id WHERE p.direction='PROVIDES' AND p.contract_id=c.contract_id AND p.task_id<>c.task_id AND t.state<>'CANCELLED');"
  while IFS='|' read -r predecessor edge_type reason predecessor_state source_set target_set set_state candidate_sha; do
    if [[ "$edge_type" == CONFLICT && "$predecessor_state" == CANCELLED ]]; then continue; fi
    if [[ "$predecessor_state" != VERIFIED ]]; then
      print -r -- "${predecessor[1,12]} [$edge_type: $reason]"
    elif [[ "$edge_type" == DEPENDENCY && "$source_set" != "$target_set" ]]; then
      if [[ "$set_state" != MERGED ]]; then
        print -r -- "${predecessor[1,12]} [先行PRのマージ待ち: $set_state]"
      elif [[ -z "$candidate_sha" ]] || ! git -C "$project_root" merge-base --is-ancestor "$candidate_sha" HEAD 2>/dev/null; then
        print -r -- "${predecessor[1,12]} [先行Change Setの検証済み成果を基準HEADへ反映待ち]"
      fi
    elif [[ "$edge_type" == DEPENDENCY && "$(sqlite3 "$db" "SELECT COUNT(*) FROM verify_results WHERE task_id='$(sql_quote "$predecessor")' AND status='PASSED';")" != 1 ]]; then
      print -r -- "${predecessor[1,12]} [先行Taskの外部検証待ち]"
    fi
  done < <(sqlite3 "$db" "SELECT p.task_id,e.edge_type,e.reason,p.state,sm.change_set_id,tm.change_set_id,c.state,COALESCE((SELECT COALESCE((SELECT value FROM metadata WHERE key='integration_merge:' || j.job_id AND c.state='MERGED'),j.candidate_sha) FROM integration_jobs j WHERE j.change_set_id=c.change_set_id AND j.membership_revision=c.membership_revision AND j.state IN ('VERIFIED','PR_READY') ORDER BY j.rowid DESC LIMIT 1),'') FROM task_edges e JOIN tasks p ON p.task_id=e.source_task_id JOIN change_set_tasks sm ON sm.task_id=p.task_id JOIN change_set_tasks tm ON tm.task_id=e.target_task_id JOIN change_sets c ON c.change_set_id=sm.change_set_id WHERE e.target_task_id='$(sql_quote "$target_task_id")' ORDER BY p.rowid,e.edge_type;")
}
latest_runtime_generation() {
  sqlite3 "$db" "SELECT COALESCE(MAX(generation),0) FROM task_runtimes WHERE task_id='$(sql_quote "$1")';"
}
runtime_is_active() {
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM task_runtimes WHERE task_id='$(sql_quote "$1")' AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');")" != 0 ]]
}
# One durable request per proposal; an unavailable parent does not lose it.
queue_index_analysis_notice() {
  local proposal head_sha notice_id message inserted
  head_sha="$(git -C "$project_root" rev-parse HEAD 2>/dev/null)" || return 0
  proposal="$(sqlite3 "$db" "SELECT p.proposal_id FROM index_proposals p JOIN metadata m ON m.key='index_onboarding_proposal' AND m.value=p.proposal_id WHERE p.status='PENDING' AND p.source_sha='$head_sha' AND EXISTS(SELECT 1 FROM metadata WHERE key='index_onboarding_state' AND value='PENDING_AI_ANALYSIS') AND NOT EXISTS(SELECT 1 FROM index_analyses a WHERE a.proposal_id=p.proposal_id AND a.status IN ('ANALYZED','APPLIED'));")"
  [[ -n "$proposal" ]] || return 0
  notice_id="index-analysis:$proposal"
  message="Counterpointer通知: 正式索引の再分析が必要です（提案 $proposal）。index onboarding --jsonで現在の提案とHEADを確認し、変更されたSSOTと関連成果を再分析してindex submit-analysisへ記録してください。承認が必要なら具体的な変更内容を利用者へ提示してください。状態の報告だけで終了したり、利用者へ再分析の開始指示を求めたりしないでください。タスクの開始許可・保留・依存関係は変更しないでください。"
  inserted="$(sqlite3 "$db" "INSERT OR IGNORE INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES ('$(sql_quote "$notice_id")','$(sql_quote "$message")','PENDING',0,'$(now)'); SELECT changes();")"
  [[ "$inserted" == 0 ]] || event index "$proposal" INDEX_ANALYSIS_REQUESTED "$notice_id"
}
start_notice_worker() {
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM parent_notices WHERE state='PENDING' AND notice_id NOT LIKE 'permission:%' AND notice_id NOT LIKE 'sidebar-test:%';")" != 0 ]] || return 0
  [[ ! -f "$state_root/service.stop-requested" ]] || return 0
  if [[ "${COUNTERPOINTER_RUNTIME_TEST:-0}" == 1 ]]; then
    "$launcher_path" -C "$project_root" notice-worker
    return
  fi
  local worker_pid=""
  [[ ! -s "$state_root/notice-worker.pid" ]] || worker_pid="$(<"$state_root/notice-worker.pid")"
  if [[ "$worker_pid" == <-> ]] && [[ "$(/bin/ps -p "$worker_pid" -o command= 2>/dev/null || true)" == *"-C $project_root notice-worker"* ]]; then return 0; fi
  nohup "$launcher_path" -C "$project_root" notice-worker > "$state_root/notice-worker.log" 2>&1 &
  print $! > "$state_root/notice-worker.pid"
}
deliver_parent_notices() {
  local parent_state parent_workspace parent_surface parent_panes parent_pane parent_surfaces notice_id message notice_proposal sidebar_message
  [[ "${COUNTERPOINTER_TEST:-0}" != 1 ]] || return 0
  parent_state="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM parent_runtimes ORDER BY generation DESC LIMIT 1;")"
  [[ "$parent_state" == ACTIVE ]] || return 0
  parent_workspace=""
  parent_surface=""
  [[ ! -s "$state_root/orchestrator.workspace" ]] || parent_workspace="$(normalize_cmux_ref workspace "$(<"$state_root/orchestrator.workspace")")"
  [[ ! -s "$state_root/orchestrator.parent-surface" ]] || parent_surface="$(normalize_cmux_ref surface "$(<"$state_root/orchestrator.parent-surface")")"
  [[ -n "$parent_workspace" ]] || parent_workspace="$(normalize_cmux_ref workspace "$(sqlite3 "$db" "SELECT COALESCE(workspace_ref,'') FROM parent_runtimes WHERE state='ACTIVE' ORDER BY generation DESC LIMIT 1;")")"
  [[ -n "$parent_surface" ]] || parent_surface="$(normalize_cmux_ref surface "$(sqlite3 "$db" "SELECT COALESCE(pane_ref,'') FROM parent_runtimes WHERE state='ACTIVE' ORDER BY generation DESC LIMIT 1;")")"
  if [[ -n "$parent_workspace" && -z "$parent_surface" ]]; then
    parent_panes="$(cmux list-panes --workspace "$parent_workspace" 2>/dev/null || true)"
    parent_pane="$(print -r -- "$parent_panes" | sed -n 's/.*\(pane:[^ ]*\).*/\1/p' | sed -n '1p')"
    if [[ -n "$parent_pane" ]]; then
      parent_surfaces="$(cmux list-pane-surfaces --workspace "$parent_workspace" --pane "$parent_pane" 2>/dev/null || true)"
      parent_surface="$(print -r -- "$parent_surfaces" | sed -n 's/.*\(surface:[^ ]*\).*/\1/p' | sed -n '1p')"
      [[ -n "$parent_surface" ]] || parent_surface="$(print -r -- "$parent_surfaces" | sed -n '1s/^[[:space:]]*\([^[:space:]]*\).*$/\1/p')"
      if [[ -n "$parent_surface" ]]; then
        print -r -- "$parent_surface" > "$state_root/orchestrator.parent-surface"
        sqlite3 "$db" "UPDATE parent_runtimes SET pane_ref='$(sql_quote "$parent_surface")',updated_at='$(now)' WHERE generation=(SELECT MAX(generation) FROM parent_runtimes WHERE state='ACTIVE');"
      fi
    fi
  fi
  [[ -n "$parent_workspace" && -n "$parent_surface" ]] || return 0
  while IFS='|' read -r notice_id message; do
    [[ -n "$notice_id" ]] || continue
    if [[ "$notice_id" == child-attention:* ]]; then
      local attention_task="${${notice_id#child-attention:}%:*}" attention_generation="${notice_id##*:}"
      [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks t JOIN task_runtimes r USING(task_id) WHERE t.task_id='$(sql_quote "$attention_task")' AND t.state='RUNNING' AND r.generation='$(sql_quote "$attention_generation")' AND r.generation=(SELECT MAX(generation) FROM task_runtimes WHERE task_id=t.task_id);")" == 1 ]] || continue
    fi
    if [[ "$notice_id" == question:* ]]; then
      question_notice_json="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='$(sql_quote "$notice_id")';")"
      question_notice_task="$(print -r -- "$question_notice_json" | jq -r .task_id)"
      question_notice_plan="$(sqlite3 "$db" "SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$(sql_quote "$question_notice_task")';")"
      [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$question_notice_task")';")" == RUNNING ]] || continue
      print -r -- "$question_notice_json" | jq -e --argjson gen "$(latest_runtime_generation "$question_notice_task")" --arg plan "$question_notice_plan" '.state=="pending" and .generation==$gen and .plan_hash==$plan' >/dev/null || continue
    fi
    if [[ "$notice_id" == index-analysis:* ]]; then
      notice_proposal="${notice_id#index-analysis:}"
      # Retain stale records as history, but never deliver obsolete analysis work.
      [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM index_proposals p JOIN metadata m ON m.key='index_onboarding_proposal' AND m.value=p.proposal_id WHERE p.proposal_id='$(sql_quote "$notice_proposal")' AND p.status='PENDING' AND p.source_sha='$(git -C "$project_root" rev-parse HEAD)' AND EXISTS(SELECT 1 FROM metadata WHERE key='index_onboarding_state' AND value='PENDING_AI_ANALYSIS') AND NOT EXISTS(SELECT 1 FROM index_analyses a WHERE a.proposal_id=p.proposal_id AND a.status IN ('ANALYZED','APPLIED'));")" == 1 ]] || continue
    fi
    # Owner approval stays visible; all other notices go to the autonomous
    # notice worker. Neither path types into the owner's live Codex prompt.
    [[ "$notice_id" == permission:* || "$notice_id" == sidebar-test:* ]] || continue
    sqlite3 "$db" "UPDATE parent_notices SET attempts=attempts+1 WHERE notice_id='$(sql_quote "$notice_id")';"
    case "$notice_id" in
      permission:*) notification_title="CPT検証承認待ち"; sidebar_message="検証承認待ち ${notice_id#permission:}。cpt permission status ${notice_id#permission:} で内容を確認";;
      sidebar-test:*) notification_title="CPT通知テスト"; sidebar_message="CPTサイドバー通知テスト: ${message[1,120]}";;
      question:*) sidebar_message="子の確認待ち ${notice_id#question:}。cpt question status ${notice_id#question:} で内容を確認";;
      child-attention:*) sidebar_message="子の作業が要対応: Task ${attention_task[1,12]}。cpt status --json で理由を確認";;
      *) sidebar_message="CPT通知: ${message[1,120]}。cpt notices $notice_id で全文を確認";;
    esac
    notification_file="$state_root/owner-notification-${notice_id//:/-}.json"
    if cmux notify --title "$notification_title" --body "$sidebar_message" --workspace "$parent_workspace" --surface "$parent_surface" --json > "$notification_file" 2> "$state_root/owner-notification-error.log"; then
      cmux log --level warning --source CPT --workspace "$parent_workspace" "$sidebar_message" >/dev/null 2>&1 || true
      sqlite3 "$db" "UPDATE parent_notices SET state='DELIVERED',delivered_at='$(now)' WHERE notice_id='$(sql_quote "$notice_id")' AND state='PENDING';"
    else
      return 0
    fi
  done < <(sqlite3 "$db" "SELECT notice_id,replace(message,'|','／') FROM parent_notices WHERE state='PENDING' ORDER BY created_at;")
  start_notice_worker
}
notify_parent_agent() {
  local message="$1" notice_id timestamp
  notice_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  timestamp="$(now)"
  sqlite3 "$db" "INSERT INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES ('$notice_id','$(sql_quote "$message")','PENDING',0,'$timestamp');"
  event parent "$project_root" CHILD_STATUS_NOTICE "$message" || true
  deliver_parent_notices
}
# Freeze only a verified process tree, then terminate and verify every member.
service_collect_processes() {
  local target="$1" child identity children enumerate_exit
  identity="$(/bin/ps -p "$target" -o lstart=,command=)" || return 1
  [[ -n "$identity" ]] || return 0
  kill -STOP "$target" || return 1
  service_stop_pids+=("$target")
  service_stop_identity[$target]="$identity"
  enumerate_exit=0
  children="$(/usr/bin/pgrep -P "$target")" || enumerate_exit=$?
  # pgrep exit 1 means no matches; other failures cannot hide descendants.
  (( enumerate_exit <= 1 )) || return 1
  while IFS= read -r child; do
    [[ "$child" == <-> ]] || continue
    service_collect_processes "$child" || return 1
  done <<< "$children"
}
service_stop_process() {
  local target="$1" expected="$2" identity ancestor="$PPID" item round failed=0 observed_pids
  local -a service_stop_pids=()
  local -A service_stop_identity=()
  [[ "$target" == <-> && "$target" -gt 1 && "$target" != "$$" ]] || return 1
  # Fail closed if process inspection is disallowed (including by a sandbox).
  observed_pids="$(/bin/ps -axo pid=)" || return 1
  if ! print -r -- "$observed_pids" | /usr/bin/awk -v target="$target" '$1 == target {found=1} END {exit !found}'; then
    return 0
  fi
  identity="$(/bin/ps -p "$target" -o lstart=,command= 2>/dev/null)" || return 1
  [[ "$identity" == *"$expected"* ]] || { print -u2 "PIDの実体が記録と異なります: $target"; return 1; }
  while [[ "$ancestor" == <-> && "$ancestor" -gt 1 ]]; do
    [[ "$ancestor" != "$target" ]] || { print -u2 '停止対象ワーカー内からのservice stopは拒否しました'; return 1; }
    ancestor="$(/bin/ps -p "$ancestor" -o ppid= | tr -d ' ')"
  done
  service_collect_processes "$target" || failed=1
  for item in "${service_stop_pids[@]}"; do
    if [[ "$(/bin/ps -p "$item" -o lstart=,command= 2>/dev/null || true)" == "${service_stop_identity[$item]}" ]]; then
      kill -TERM "$item" 2>/dev/null || true
      kill -CONT "$item" 2>/dev/null || true
    fi
  done
  for round in {1..20}; do
    local alive=0
    for item in "${service_stop_pids[@]}"; do
      identity="$(/bin/ps -p "$item" -o stat= 2>/dev/null || true)"
      [[ -z "$identity" || "$identity" == *Z* ]] || alive=1
    done
    (( alive )) || break
    sleep 0.1
  done
  for item in "${service_stop_pids[@]}"; do
    if [[ "$(/bin/ps -p "$item" -o lstart=,command= 2>/dev/null || true)" == "${service_stop_identity[$item]}" ]]; then
      kill -KILL "$item" 2>/dev/null || true
    fi
  done
  sleep 0.1
  for item in "${service_stop_pids[@]}"; do
    # First establish that process enumeration still works; permission failure
    # cannot serve as successful termination evidence.
    if ! /bin/ps -axo pid= >/dev/null 2>&1; then
      failed=1
      continue
    fi
    identity="$(/bin/ps -p "$item" -o stat= 2>/dev/null || true)"
    [[ -z "$identity" || "$identity" == *Z* ]] || failed=1
  done
  (( failed == 0 ))
}
# Inspect every recorded generation before creating another pane. A denied
# process listing is UNKNOWN, not proof that the old session has exited.
assert_previous_runtimes_stopped() {
  local check_task="$1" row old_generation old_state old_pid processes
  local rows="$(sqlite3 "$db" "SELECT generation,state,COALESCE(process_pid,'') FROM task_runtimes WHERE task_id='$(sql_quote "$check_task")' ORDER BY generation;")"
  [[ -n "$rows" ]] || return 0
  processes=""
  while IFS='|' read -r old_generation old_state old_pid; do
    [[ -n "$old_generation" ]] || continue
    if [[ "$old_state" == (STARTING|ACTIVE|RESUMING|RESTARTING) ]]; then
      print -u2 "旧子sessionの停止確認が必要です: generation=$old_generation state=$old_state。新しいペインは作りません。"
      return 1
    fi
    [[ "$old_pid" == <-> ]] || continue
    if [[ -z "$processes" ]]; then
      processes="$(/bin/ps -axo pid=)" || {
        print -u2 '旧プロセスの検査が許可されていません。停止済みとは扱わず、新しいペインは作りません。'
        return 1
      }
    fi
    if print -r -- "$processes" | /usr/bin/awk -v target="$old_pid" '$1 == target {found=1} END {exit !found}'; then
      print -u2 "旧プロセスが残っています: generation=$old_generation pid=$old_pid。新しいペインは作りません。"
      return 1
    fi
  done <<< "$rows"
}

terminate_process_tree() {
  local target_pid="$1" child_pid
  [[ "$target_pid" == <-> && "$target_pid" -gt 1 ]] || return 0
  while IFS= read -r child_pid; do
    [[ "$child_pid" == <-> ]] || continue
    terminate_process_tree "$child_pid"
  done < <(/usr/bin/pgrep -P "$target_pid" 2>/dev/null || true)
  kill -TERM "$target_pid" 2>/dev/null || true
}
reconcile_completion_markers() {
  local completed_task worktree marker marker_task marker_generation current_generation
  while IFS='|' read -r completed_task worktree; do
    [[ -n "$completed_task" && -d "$worktree" ]] || continue
    marker="$worktree/.counterpointer-task/selfcheck.txt"
    [[ -s "$marker" ]] || continue
    marker_task="$(sed -n 's/^task_id=//p' "$marker" | sed -n '1p')"
    marker_generation="$(sed -n 's/^generation=//p' "$marker" | sed -n '1p')"
    current_generation="$(latest_runtime_generation "$completed_task")"
    if [[ -n "$marker_task" && "$marker_task" != "$completed_task" ]]; then
      event task "$completed_task" COMPLETION_MARKER_REJECTED 'task_id mismatch' || true
      continue
    fi
    if [[ -n "$marker_generation" && "$marker_generation" != "$current_generation" ]]; then
      event task "$completed_task" COMPLETION_MARKER_REJECTED "generation=$marker_generation current=$current_generation" || true
      continue
    fi
    if "$launcher_path" -C "$project_root" selfcheck "$completed_task" >/dev/null; then
      event task "$completed_task" COMPLETION_MARKER_ACCEPTED "generation=$current_generation" || true
      notify_parent_agent "Counterpointer通知: 子タスク ${completed_task[1,12]} の完了申告を受領しました。親側で検証と後続処理を進めてください。"
      if [[ "${COUNTERPOINTER_TEST:-0}" != 1 ]]; then
        while IFS= read -r completed_pid; do terminate_process_tree "$completed_pid"; done < <(sqlite3 "$db" "SELECT process_pid FROM task_runtimes WHERE task_id='$(sql_quote "$completed_task")' AND generation=$current_generation AND process_pid IS NOT NULL;")
      fi
    fi
  done < <(sqlite3 "$db" "SELECT task_id,worktree FROM tasks WHERE state='RUNNING' AND COALESCE(worktree,'')<>'' ORDER BY updated_at;")
}
# A live interactive CLI may have finished its turn without completing its Task.
# Keep RUNNING's scheduling reservation: a final-turn event does not prove the
# process exited, and a user may already have started another turn in that pane.
reconcile_child_reports() {
  local report_task report_worktree report_generation report_file report_reason notice_id message timestamp
  while IFS='|' read -r report_task report_worktree report_generation; do
    report_file="$report_worktree/.counterpointer-task/turn-complete-$report_generation.json"
    [[ -f "$report_file" && ! -L "$report_file" ]] || continue
    [[ "$(wc -c < "$report_file" | tr -d ' ')" -le 16384 ]] || continue
    if ! jq -e --arg task "$report_task" --arg generation "$report_generation" \
      '.task_id==$task and .generation==$generation and (.reason|type)=="string" and (.reason|length)>0' "$report_file" >/dev/null 2>&1; then continue; fi
    report_reason="$(jq -r '.reason | gsub("[\u0000-\u001f\u007f]";" ") | .[0:2000]' "$report_file")"
    notice_id="child-attention:$report_task:$report_generation"
    timestamp="$(now)"
    message="Counterpointer通知: 子タスク ${report_task[1,12]} は未完了で応答を終了しました（要対応）。理由: $report_reason。成果と実行枠を保持しています。親は記録を確認し、必要な実行許可・検証環境を整えてから子を再開してください。同じ制限下での再試行や未検証でのselfcheckは行わないでください。"
    sqlite3 "$db" "BEGIN IMMEDIATE;
      INSERT OR IGNORE INTO metadata(key,value) VALUES ('runtime_attention:$(sql_quote "$report_task"):$report_generation','$(sql_quote "$report_reason")');
      INSERT OR IGNORE INTO parent_notices(notice_id,message,state,attempts,created_at)
        VALUES ('$(sql_quote "$notice_id")','$(sql_quote "$message")','PENDING',0,'$timestamp');
      COMMIT;"
  done < <(sqlite3 "$db" "SELECT t.task_id,t.worktree,r.generation FROM tasks t JOIN task_runtimes r USING(task_id)
    WHERE t.state='RUNNING' AND r.state IN ('STARTING','ACTIVE','RESUMING','RESTARTING')
      AND r.generation=(SELECT MAX(generation) FROM task_runtimes WHERE task_id=t.task_id);")
  deliver_parent_notices
}
process_browser_bridge_requests() {
  local bridge_task bridge_worktree bridge_dir request processing response output request_id task action result
  local -a browser_args
  while IFS='|' read -r bridge_task bridge_worktree; do
    [[ -n "$bridge_task" && -d "$bridge_worktree/.counterpointer-task" ]] || continue
    bridge_dir="$bridge_worktree/.counterpointer-task/browser-bridge"
    [[ -d "$bridge_dir" && ! -L "$bridge_dir" ]] || continue
    for request in "$bridge_dir"/*.request.json(N); do
    [[ -f "$request" && ! -L "$request" ]] || continue
    [[ "$(wc -c < "$request" | tr -d ' ')" -le 65536 ]] || continue
    request_id="${request:t:r:r}"
    [[ "$request_id" =~ '^[a-f0-9-]+$' ]] || continue
    processing="$bridge_dir/$request_id.processing.json"
    response="$bridge_dir/$request_id.response.json"
    /bin/mv "$request" "$processing" || continue
    if ! jq -e '.task_id|type=="string"' "$processing" >/dev/null 2>&1 || \
       ! jq -e '.action|type=="string"' "$processing" >/dev/null 2>&1 || \
       ! jq -e '.args|type=="array" and length<=20 and all(.[];type=="string")' "$processing" >/dev/null 2>&1; then
      jq -n '{exit_code:2,output:"ブラウザ操作の形式が不正です"}' > "$response"
      /bin/rm -f "$processing"
      continue
    fi
    task="$(jq -r '.task_id' "$processing")"
    if [[ "$task" != "$bridge_task" ]]; then
      jq -n '{exit_code:2,output:"Taskの対象が一致しません"}' > "$response"
      /bin/rm -f "$processing"
      continue
    fi
    action="$(jq -r '.action' "$processing")"
    browser_args=()
    while IFS= read -r -d $'\0' result; do browser_args+=("$result"); done < <(jq -j '.args[] | ., "\u0000"' "$processing")
    output="$bridge_dir/$request_id.output"
    if CPT_BROWSER_BROKER=1 "$launcher_path" -C "$project_root" browser "$task" "$action" "${browser_args[@]}" > "$output" 2>&1; then
      result=0
    else
      result=$?
    fi
    jq -n --argjson code "$result" --rawfile body "$output" '{exit_code:$code,output:$body}' > "$response.tmp"
    /bin/mv "$response.tmp" "$response"
    /bin/rm -f "$processing" "$output"
    done
  done < <(sqlite3 "$db" "SELECT task_id,worktree FROM tasks WHERE state IN ('RUNNING','CLAIMED_DONE','VERIFYING','VERIFIED') AND COALESCE(worktree,'')<>'';")
}
permission_target_file() {
  local worktree="$1" body="$2" command_name target
  command_name="$(print -r -- "$body" | jq -r '.recipe.argv[0]')"
  case "$command_name" in
    node)
      target="$(print -r -- "$body" | jq -r '.recipe.argv[1] // empty')"
      [[ -n "$target" && "$target" != -* && "$target" != /* ]] || return 3
      target="${worktree:A}/$target"
      ;;
    npm)
      print -r -- "$body" | jq -e '.recipe.argv|length==3 and .[1]=="run" and (.[2]|test("^[a-zA-Z0-9:_-]+$"))' >/dev/null || return 3
      target="${worktree:A}/package.json"
      ;;
    *) return 3;;
  esac
  [[ "$(print -r -- "$body" | jq -r .recipe.mode)" != server || "$command_name" == node ]] || return 3
  target="${target:A}"
  [[ "$target" == "${worktree:A}/"* && -f "$target" && ! -L "$target" ]] || return 3
  print -r -- "$target"
}
collect_permission_requests() {
  local task worktree dir request request_id generation body inserted message target target_sha target_rel recipe_json grant
  while IFS='|' read -r task worktree; do
    [[ -n "$task" && -d "$worktree/.counterpointer-task" ]] || continue
    dir="$worktree/.counterpointer-task/permission-requests"
    [[ -d "$dir" && ! -L "$dir" ]] || continue
    for request in "$dir"/*.request.json(N); do
      [[ -f "$request" && ! -L "$request" && "$(wc -c < "$request" | tr -d ' ')" -le 16384 ]] || continue
      request_id="${request:t:r:r}"
      [[ "$request_id" =~ '^[a-f0-9]{64}$' ]] || continue
      generation="$(latest_runtime_generation "$task")"
      jq -e --arg task "$task" --argjson generation "$generation" --arg id "$request_id" \
        '.task_id==$task and .generation==$generation and .request_id==$id and
         (.operation|type=="string" and length>0 and length<=200) and
         (.reason|type=="string" and length>0 and length<=2000) and
         (.remaining_checks|type=="array" and length<=20 and all(.[];type=="string" and length<=500)) and
         (.recipe|type=="object") and (.recipe.mode=="once" or .recipe.mode=="server") and
         (.recipe.argv|type=="array" and length>=1 and length<=16 and all(.[];type=="string" and length>0 and length<=500))' "$request" >/dev/null 2>&1 || continue
      body="$(jq -cS . "$request")"
      [[ "$(print -rn -- "$(print -r -- "$body" | jq -cS 'del(.request_id)')" | /usr/bin/openssl dgst -sha256 | awk '{print $NF}')" == "$request_id" ]] || continue
      target="$(permission_target_file "$worktree" "$body" 2>/dev/null || true)"
      grant=""
      if [[ -n "$target" ]]; then
        target_sha="$(/usr/bin/openssl dgst -sha256 "$target" | awk '{print $NF}')"
        target_rel="${target#${worktree:A}/}"
        recipe_json="$(print -r -- "$body" | jq -cS .recipe)"
        grant="$(sqlite3 "$db" "SELECT grant_id FROM permission_grants WHERE recipe_json='$(sql_quote "$recipe_json")' AND target_relative_path='$(sql_quote "$target_rel")' AND target_sha256='$target_sha' LIMIT 1;")"
      fi
      if [[ -n "$grant" ]]; then
        inserted="$(sqlite3 "$db" "INSERT OR IGNORE INTO permission_requests(request_id,task_id,generation,request_json,state,approved_file,approved_sha256,created_at,decided_at) VALUES('$request_id','$(sql_quote "$task")',$generation,'$(sql_quote "$body")','APPROVED','$(sql_quote "$target")','$target_sha','$(now)','$(now)'); SELECT changes();")"
        [[ "$inserted" != 1 ]] || event task "$task" PERMISSION_REUSED "$request_id grant=$grant"
      else
        inserted="$(sqlite3 "$db" "INSERT OR IGNORE INTO permission_requests(request_id,task_id,generation,request_json,state,created_at) VALUES('$request_id','$(sql_quote "$task")',$generation,'$(sql_quote "$body")','PENDING','$(now)'); SELECT changes();")"
      fi
      if [[ "$inserted" == 1 && -z "$grant" ]]; then
        message="権限外の定型検証候補: Task $task、要求 $request_id。cpt permission status $request_id で操作・対象・残検証を確認してください。未承認のまま実行しません。"
        sqlite3 "$db" "INSERT OR IGNORE INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES('permission:$request_id','$(sql_quote "$message")','PENDING',0,'$(now)');"
        event task "$task" PERMISSION_REQUESTED "$request_id"
      fi
      /bin/mv "$request" "$dir/$request_id.recorded.json"
    done
  done < <(sqlite3 "$db" "SELECT task_id,worktree FROM tasks WHERE state='RUNNING' AND COALESCE(worktree,'')<>'';")
}
process_permission_run_requests() {
  local task worktree dir request run_id request_id body generation approved_file approved_sha current_sha
  local command_name mode response log_path pid exit_code output active
  local -a argv
  while IFS='|' read -r task worktree; do
    [[ -n "$task" && -d "$worktree/.counterpointer-task" ]] || continue
    dir="$worktree/.counterpointer-task/permission-bridge"
    [[ -d "$dir" && ! -L "$dir" ]] || continue
    for request in "$dir"/*.request.json(N); do
      [[ -f "$request" && ! -L "$request" && "$(wc -c < "$request" | tr -d ' ')" -le 4096 ]] || continue
      run_id="${request:t:r:r}"
      [[ "$run_id" =~ '^[a-f0-9-]{36}$' ]] || continue
      response="$dir/$run_id.response.json"
      /bin/mv "$request" "$dir/$run_id.processing.json" || continue
      request_id="$(jq -r --arg run "$run_id" 'select(.run_id==$run) | .request_id | select(type=="string" and test("^[a-f0-9]{64}$"))' "$dir/$run_id.processing.json")"
      body="$(sqlite3 "$db" "SELECT request_json FROM permission_requests WHERE request_id='$(sql_quote "$request_id")' AND task_id='$(sql_quote "$task")' AND state='APPROVED';")"
      generation="$(latest_runtime_generation "$task")"
      approved_file="$(sqlite3 "$db" "SELECT COALESCE(approved_file,'') FROM permission_requests WHERE request_id='$(sql_quote "$request_id")';")"
      approved_sha="$(sqlite3 "$db" "SELECT COALESCE(approved_sha256,'') FROM permission_requests WHERE request_id='$(sql_quote "$request_id")';")"
      if [[ -z "$body" || "$(print -r -- "$body" | jq -r .generation)" != "$generation" || ! -f "$approved_file" || -L "$approved_file" ]]; then
        jq -n '{exit_code:3,output:"承認またはTask世代が失効しています"}' > "$response"
        /bin/rm -f "$dir/$run_id.processing.json"
        continue
      fi
      current_sha="$(/usr/bin/openssl dgst -sha256 "$approved_file" | awk '{print $NF}')"
      if [[ "$current_sha" != "$approved_sha" ]]; then
        jq -n '{exit_code:3,output:"承認後に実行対象ファイルが変わりました"}' > "$response"
        /bin/rm -f "$dir/$run_id.processing.json"
        continue
      fi
      active="$(sqlite3 "$db" "SELECT COALESCE(process_pid,'') FROM permission_runs WHERE request_id='$request_id' AND state='RUNNING' ORDER BY created_at DESC LIMIT 1;")"
      if [[ "$active" == <-> ]] && kill -0 "$active" 2>/dev/null; then
        jq -n --arg pid "$active" '{exit_code:0,output:("実行中 PID="+$pid)}' > "$response"
        /bin/rm -f "$dir/$run_id.processing.json"
        continue
      fi
      argv=()
      while IFS= read -r -d $'\0' output; do argv+=("$output"); done < <(print -r -- "$body" | jq -j '.recipe.argv[] | ., "\u0000"')
      mode="$(print -r -- "$body" | jq -r .recipe.mode)"
      command_name="${argv[1]}"
      [[ "$command_name" == node || "$command_name" == npm ]] || continue
      log_path="$dir/$run_id.log"
      sqlite3 "$db" "INSERT INTO permission_runs(run_id,request_id,task_id,generation,state,log_path,created_at,updated_at) VALUES('$run_id','$request_id','$(sql_quote "$task")',$generation,'STARTING','$(sql_quote "$log_path")','$(now)','$(now)');"
      (
        cd "$worktree" || exit 3
        /usr/bin/nohup /usr/bin/env -i HOME="$worktree/.counterpointer-task/codex-home" PATH="$PATH" TMPDIR=/private/tmp "${argv[@]}" > "$log_path" 2>&1 &
        pid=$!
        sqlite3 "$db" "UPDATE permission_runs SET state='RUNNING',process_pid=$pid,updated_at='$(now)' WHERE run_id='$run_id';"
        if [[ "$mode" == server ]]; then
          sleep 1
          if kill -0 "$pid" 2>/dev/null; then
            jq -n --arg pid "$pid" --arg log "$log_path" '{exit_code:0,output:("起動しました PID="+$pid+" log="+$log)}' > "$response.tmp"
            /bin/mv "$response.tmp" "$response"
          else
            wait "$pid" || true
            sqlite3 "$db" "UPDATE permission_runs SET state='FAILED',exit_code=1,updated_at='$(now)' WHERE run_id='$run_id';"
            jq -n --arg log "$log_path" '{exit_code:1,output:("起動失敗 log="+$log)}' > "$response.tmp"
            /bin/mv "$response.tmp" "$response"
          fi
        else
          exit_code=0
          wait "$pid" || exit_code=$?
          sqlite3 "$db" "UPDATE permission_runs SET state='$(if (( exit_code == 0 )); then print COMPLETED; else print FAILED; fi)',exit_code=$exit_code,updated_at='$(now)' WHERE run_id='$run_id';"
          output="$(tail -c 8000 "$log_path")"
          jq -n --argjson code "$exit_code" --arg output "$output" '{exit_code:$code,output:$output}' > "$response.tmp"
          /bin/mv "$response.tmp" "$response"
        fi
      ) </dev/null >/dev/null 2>&1 &!
      /bin/rm -f "$dir/$run_id.processing.json"
    done
  done < <(sqlite3 "$db" "SELECT task_id,worktree FROM tasks WHERE state='RUNNING' AND COALESCE(worktree,'')<>'';")
}
stop_permission_runs() {
  local filter_task="${1:-}" run_id task pid script expected generation current_generation task_state
  while IFS='|' read -r run_id task pid script generation; do
    [[ "$pid" == <-> ]] || continue
    task_state="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM tasks WHERE task_id='$(sql_quote "$task")';")"
    current_generation="$(latest_runtime_generation "$task")"
    if [[ -z "$filter_task" && "$task_state" == RUNNING && "$generation" == "$current_generation" ]]; then continue; fi
    expected="node $script"
    service_stop_process "$pid" "$expected" || return 3
    sqlite3 "$db" "UPDATE permission_runs SET state='COMPLETED',updated_at='$(now)' WHERE run_id='$run_id' AND state='RUNNING';"
  done < <(sqlite3 "$db" "SELECT r.run_id,r.task_id,COALESCE(r.process_pid,''),json_extract(p.request_json,'$.recipe.argv[1]'),r.generation FROM permission_runs r JOIN permission_requests p USING(request_id) WHERE r.state='RUNNING' AND json_extract(p.request_json,'$.recipe.mode')='server' AND ('$(sql_quote "$filter_task")' IN ('','--all') OR r.task_id='$(sql_quote "$filter_task")');")
}
registration_decision() {
  local registration_id="$1" mode="$2" source_text="$3" source_hash="$4" reason="$5"
  sqlite3 "$db" "INSERT INTO registrations
    (registration_id,registration_mode,source_text,source_hash,status,reason_code,question_count,created_at)
    VALUES ('$(sql_quote "$registration_id")','$(sql_quote "$mode")','$(sql_quote "$source_text")','$(sql_quote "$source_hash")','NEEDS_DECISION','$(sql_quote "$reason")',1,'$(now)');"
  event registration "$registration_id" NEEDS_DECISION "$reason"
  print -u2 "壁打ちが必要です（$reason）。Taskは作成していません。親ペインで要件を整理してください。"
  print "$registration_id"
}
create_task_artifacts() {
  local task_id="$1" mode="$2" source_text="$3" confirmed_plan_file="${4:-}"
  local artifact_dir="$state_root/tasks/$task_id" goal_file plan_file goal_hash plan_hash
  artifact_dir="$state_root/tasks/$task_id"
  goal_file="$artifact_dir/goal.md"
  plan_file="$artifact_dir/execution-plan.md"
  mkdir -p "$artifact_dir"
  if [[ "$mode" == detailed ]]; then
    /bin/cp "$confirmed_plan_file" "$plan_file"
    {
      print '# ゴール'
      print ''
      print '確認済み実行計画を変更せずに完了し、計画内の受入条件をすべて満たす。'
    } > "$goal_file"
  else
    {
      print '# ゴール'
      print ''
      print -r -- "$source_text"
      print ''
      print '上記変更を対象範囲内で実装し、該当するテストに合格すること。'
    } > "$goal_file"
    {
      print '# 実行計画'
      print ''
      print '## 目的'
      print ''
      print -r -- "$source_text"
      print ''
      print '## 受入条件'
      print ''
      print -r -- '- 依頼された変更が対象ファイル内に実装されている。'
      print -r -- '- 変更に対応する検証が成功している。'
      print ''
      print '## 制約・非ゴール'
      print ''
      print -r -- '- 指定されていない外部公開、push、PR作成は行わない。'
      print -r -- '- 対象外の仕様やオーナー要件を変更しない。'
      print ''
      print '## 作業手順'
      print ''
      print '1. 対象範囲と既存実装を確認する。'
      print '2. 依頼内容を実装する。'
      print '3. 関連テストを実行する。'
      print '4. selfcheckで完了を申告する。'
      print ''
      print '## 停止条件'
      print ''
      print -r -- '- 要件の矛盾、対象範囲外の変更、外部操作が必要な場合は実行せず親へ報告する。'
    } > "$plan_file"
  fi
  CREATED_ARTIFACT_DIR="$artifact_dir"
  CREATED_GOAL_HASH="$(file_sha256 "$goal_file")"
  CREATED_PLAN_HASH="$(file_sha256 "$plan_file")"
}
repair_stop_reason() {
  case "$1" in
    REPAIR_LIMIT) print 'Change Setあたりの修復上限2回に到達';;
    SCOPE_EXPANSION) print '承認済み対象範囲を超えるためオーナー判断が必要';;
    SCOPE_UNRESOLVED) print '修復対象範囲が未確定';;
    *) print '登録エラーを確認してください';;
  esac
}
create_integration_fix() {
  local job_id="$1" change_set_id="$2" failure_kind="$3" failure_hash="$4" fix_base_sha="$5" affected_paths="$6" superseded_task_id="${7:-}" prepare_sha="${8:-}"
  local previous_occurrences timestamp repair_text repair_args affected_path allowed_path path_allowed
  CREATED_INTEGRATION_FIX_ERROR=REGISTRATION_FAILED
  previous_occurrences="$(sqlite3 "$db" "SELECT COALESCE(occurrence_count,0) FROM integration_failures WHERE change_set_id='$(sql_quote "$change_set_id")' AND failure_hash='$(sql_quote "$failure_hash")';")"
  [[ "$previous_occurrences" == <-> ]] || previous_occurrences=0
  timestamp="$(now)"
  sqlite3 "$db" "INSERT INTO integration_failures(change_set_id,failure_hash,failure_kind,occurrence_count,latest_job_id,updated_at) VALUES ('$(sql_quote "$change_set_id")','$(sql_quote "$failure_hash")','$(sql_quote "$failure_kind")',1,'$(sql_quote "$job_id")','$timestamp') ON CONFLICT(change_set_id,failure_hash) DO UPDATE SET occurrence_count=occurrence_count+1,latest_job_id=excluded.latest_job_id,updated_at=excluded.updated_at;"
  if (( previous_occurrences > 0 )); then
    CREATED_INTEGRATION_FIX=""
    CREATED_INTEGRATION_FIX_ERROR=REPEATED_FAILURE
    return 5
  fi
  if [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks WHERE change_set_id='$(sql_quote "$change_set_id")' AND member_kind='integration_fix';")" -ge 2 ]]; then
    CREATED_INTEGRATION_FIX_ERROR=REPAIR_LIMIT
    return 5
  fi
  repair_text="Change Set $change_set_id の統合失敗 $failure_hash を修復する"
  repair_args=(--mode quick --text "$repair_text" --change-set "$change_set_id" --kind integration_fix --base-sha "$fix_base_sha")
  while IFS= read -r affected_path; do
    [[ -n "$affected_path" ]] || continue
    path_allowed=0
    while IFS= read -r allowed_path; do
      if [[ "$allowed_path" == . || "$affected_path" == "$allowed_path" || "$affected_path" == "${allowed_path%/}"/* ]]; then path_allowed=1; break; fi
    done < <(sqlite3 "$db" "SELECT p.path FROM task_paths p JOIN change_set_tasks m ON m.task_id=p.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND m.member_kind='implementation';")
    if (( ! path_allowed )); then CREATED_INTEGRATION_FIX_ERROR=SCOPE_EXPANSION; return 5; fi
    repair_args+=(--path "$affected_path")
  done <<< "$affected_paths"
  (( ${#repair_args[@]} > 10 )) || { CREATED_INTEGRATION_FIX_ERROR=SCOPE_UNRESOLVED; return 5; }
  [[ -z "$prepare_sha" ]] || repair_args+=(--prepare-cherry-pick "$prepare_sha")
  [[ -z "$superseded_task_id" ]] || repair_args+=(--supersedes "$superseded_task_id")
  if ! CREATED_INTEGRATION_FIX="$("$launcher_path" -C "$project_root" register "${repair_args[@]}")"; then
    CREATED_INTEGRATION_FIX=""
    return 6
  fi
  [[ -n "$CREATED_INTEGRATION_FIX" ]] || return 6
  sqlite3 "$db" "UPDATE integration_failures SET latest_repair_task_id='$(sql_quote "$CREATED_INTEGRATION_FIX")',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")' AND failure_hash='$(sql_quote "$failure_hash")';"
  sqlite3 "$db" "UPDATE task_schedule SET urgency=COALESCE((SELECT MAX(s.urgency) FROM task_schedule s JOIN change_set_tasks m ON m.task_id=s.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND m.member_kind='implementation'),1),due_at=(SELECT MIN(s.due_at) FROM task_schedule s JOIN change_set_tasks m ON m.task_id=s.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND m.member_kind='implementation'),assessed_plan_hash=(SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$(sql_quote "$CREATED_INTEGRATION_FIX")'),assessment_reason='実行許可済み成果の範囲内修復' WHERE task_id='$(sql_quote "$CREATED_INTEGRATION_FIX")';"
  "$launcher_path" -C "$project_root" queue "$CREATED_INTEGRATION_FIX" >/dev/null
}
publish_branch_name() {
  local change_set_id="$1" title="$2" slug branch
  slug="$(print -rn -- "$title" | LC_ALL=C /usr/bin/tr '[:upper:]' '[:lower:]' | LC_ALL=C /usr/bin/tr -cs 'a-z0-9' '-' | /usr/bin/cut -c1-32 | /usr/bin/sed -E 's/^-+//;s/-+$//')"
  [[ -n "$slug" ]] || slug=change
  branch="counterpointer/change/${change_set_id}-${slug}"
  git check-ref-format --branch "$branch" >/dev/null || return 2
  print -r -- "$branch"
}
prepare_publish_request() {
  local job_id="$1" state worktree head_sha candidate_sha change_set_id change_set_title
  local existing_request request_id publish_dir body_path manifest_path branch base_branch remote_name draft timestamp
  state="$(sqlite3 "$db" "SELECT state FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
  [[ "$state" == VERIFIED || "$state" == PR_READY ]] || { print -u2 "公開準備にはVERIFIEDの統合ジョブが必要です: ${state:-未登録}"; return 2; }
  worktree="$(sqlite3 "$db" "SELECT COALESCE(worktree,'') FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
  [[ -n "$worktree" && -d "$worktree" ]] || { print -u2 "統合worktreeがありません: $job_id"; return 2; }
  head_sha="$(git -C "$worktree" rev-parse HEAD)"
  candidate_sha="$(sqlite3 "$db" "SELECT COALESCE(candidate_sha,'') FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
  [[ -n "$candidate_sha" && "$candidate_sha" == "$head_sha" ]] || { print -u2 "検証済みSHAと統合worktreeが一致しません"; return 3; }
  existing_request="$(sqlite3 "$db" "SELECT request_id FROM publish_requests WHERE job_id='$(sql_quote "$job_id")' AND head_sha='$head_sha' AND state IN ('PREPARED','PUBLISHED') ORDER BY rowid DESC LIMIT 1;")"
  if [[ -n "$existing_request" ]]; then
    print "公開要求ID: $existing_request"
    print "固定SHA: $head_sha"
    print "状態: $(sqlite3 "$db" "SELECT state FROM publish_requests WHERE request_id='$existing_request';")"
    return 0
  fi
  change_set_id="$(sqlite3 "$db" "SELECT change_set_id FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
  [[ -n "$change_set_id" ]] || { print -u2 "Change Setへ紐づかない旧形式ジョブは公開できません"; return 2; }
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM integration_jobs j JOIN change_sets c ON c.change_set_id=j.change_set_id WHERE j.job_id='$(sql_quote "$job_id")' AND j.state IN ('VERIFIED','PR_READY') AND c.state IN ('VERIFIED','AWAITING_MERGE') AND j.membership_revision=c.membership_revision AND NOT EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state<>'VERIFIED');")" == 1 ]] || { print -u2 '現在のTask構成と統合候補が一致しません。取消または再統合の状態を確認してください'; return 3; }
  change_set_title="$(sqlite3 "$db" "SELECT title FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")';")"
  branch="$(publish_branch_name "$change_set_id" "$change_set_title")" || return 2
  base_branch="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='publish_base_branch';")"
  if [[ -z "$base_branch" ]]; then
    base_branch="$(git -C "$project_root" symbolic-ref --short HEAD 2>/dev/null || true)"
    [[ -n "$base_branch" ]] || base_branch=main
  fi
  remote_name="$(sqlite3 "$db" "SELECT COALESCE(value,'origin') FROM metadata WHERE key='publish_remote';")"
  [[ -n "$remote_name" ]] || remote_name=origin
  draft=0
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks WHERE change_set_id='$(sql_quote "$change_set_id")' AND member_kind='gate_change';")" == 0 ]] || draft=1
  request_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  timestamp="$(now)"
  publish_dir="$state_root/publish/$request_id"
  body_path="$publish_dir/pr-body.md"
  manifest_path="$publish_dir/manifest.txt"
  mkdir -p "$publish_dir"
  {
    print "# $change_set_title"
    print ''
    print '## 概要'
    print ''
    print -r -- "- Change Set: \`$change_set_id\`"
    print -r -- "- 統合ジョブ: \`$job_id\`"
    print -r -- "- 検証済みcommit: \`$head_sha\`"
    print -r -- "- 検証済みtree: \`$(git -C "$worktree" rev-parse "$head_sha^{tree}")\`"
    print ''
    print '## 含まれるタスク'
    print ''
    sqlite3 "$db" "SELECT '- ' || t.source_text || '（' || t.task_id || '）' FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' ORDER BY m.rowid;"
    print ''
    print '## 検証結果'
    print ''
    print -r -- '- 各Taskの内部検証・外部検証: 成功'
    print -r -- '- 統合後の全量検証: 成功'
    print -r -- "- 統合証跡: \`$(sqlite3 "$db" "SELECT COALESCE(evidence_path,'') FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")\`"
    print ''
    print '## 変更ファイル'
    print ''
    integration_base="$(sqlite3 "$db" "SELECT base_sha FROM integration_attempts WHERE job_id='$(sql_quote "$job_id")' ORDER BY rowid DESC LIMIT 1;")"
    git -C "$worktree" diff --name-status "$integration_base" "$head_sha" | /usr/bin/sed 's/^/- /'
    print ''
    print '## リスクと運用'
    print ''
    if (( draft )); then print -r -- '- 保護対象を変更するためDraft PRとして作成します。'; else print -r -- '- 既知の追加リスクはありません。'; fi
    print -r -- '- 自動merge、force push、mainへの直接pushは行いません。'
  } > "$body_path"
  {
    print "request_id=$request_id"
    print "job_id=$job_id"
    print "change_set_id=$change_set_id"
    print "head_sha=$head_sha"
    print "branch=$branch"
    print "base_branch=$base_branch"
    print "remote=$remote_name"
    print "draft=$draft"
    print "body_sha256=$(file_sha256 "$body_path")"
  } > "$manifest_path"
  sqlite3 "$db" "BEGIN; INSERT INTO publish_requests(request_id,job_id,state,head_sha,created_at,updated_at) VALUES ('$request_id','$(sql_quote "$job_id")','PREPARED','$head_sha','$timestamp','$timestamp'); INSERT INTO pull_requests(request_id,change_set_id,branch_name,base_branch,remote_name,pr_state,body_path,draft,created_at,updated_at) VALUES ('$request_id','$(sql_quote "$change_set_id")','$(sql_quote "$branch")','$(sql_quote "$base_branch")','$(sql_quote "$remote_name")','NOT_CREATED','$(sql_quote "$body_path")',$draft,'$timestamp','$timestamp'); COMMIT;"
  sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('publish_target_branch:$request_id','$(sql_quote "$base_branch")');"
  git -C "$project_root" update-ref "refs/counterpointer/publish/$request_id" "$head_sha"
  event integration "$job_id" PUBLISH_PREPARED "$request_id $head_sha"
  print "公開要求ID: $request_id"
  print "固定SHA: $head_sha"
  print "公開ブランチ: $branch"
  print "PR本文: $body_path"
  print '確認モード: pushやPR変更は行っていません'
}
# Recovery guards remain attached to the Task across retries and generations.
recovery_base() {
  sqlite3 "$db" "SELECT value FROM metadata WHERE key='recovery_base:$(sql_quote "$1")';"
}
check_recovery_context() {
  local task="$1" wt="$2" base row artifact goal plan
  base="${3:-$(recovery_base "$task")}"
  [[ -n "$base" ]] || return 0
  [[ "$(git -C "$wt" rev-parse --show-toplevel)" == "${wt:A}" ]] || return 2
  [[ "$(sqlite3 "$db" "SELECT dispatch_base_sha FROM tasks WHERE task_id='$(sql_quote "$task")';")" == "$base" ]] || return 2
  git -C "$wt" merge-base --is-ancestor "$base" HEAD || return 2
  row="$(sqlite3 "$db" "SELECT artifact_dir,goal_hash,execution_plan_hash FROM task_artifacts WHERE task_id='$(sql_quote "$task")';")"
  IFS='|' read -r artifact goal plan <<< "$row"
  [[ -n "$plan" && "$(sqlite3 "$db" "SELECT COUNT(*) FROM registrations WHERE task_id='$(sql_quote "$task")' AND plan_hash='$plan' AND confirmed_plan_hash='$plan';")" == 1 ]] || return 2
  [[ "$(file_sha256 "$artifact/goal.md")" == "$goal" && "$(file_sha256 "$artifact/execution-plan.md")" == "$plan" && "$(file_sha256 "$wt/.counterpointer-task/goal.md")" == "$goal" && "$(file_sha256 "$wt/.counterpointer-task/execution-plan.md")" == "$plan" ]] || return 2
}
check_recovery_changes() {
  local task="$1" wt="$2" revision="${3:-}" base changed untracked
  base="$(recovery_base "$task")"
  [[ -n "$base" ]] || return 0
  check_recovery_context "$task" "$wt" || { print -u2 '復旧Taskのworktree・基点・確認済み計画が一致しません'; return 2; }
  if [[ -n "$revision" ]]; then
    changed="$(git -C "$wt" diff --name-only "$base" "$revision" -- . ':(exclude).counterpointer-task/**')" || return 2
  else
    changed="$(git -C "$wt" diff --name-only "$base" -- . ':(exclude).counterpointer-task/**')" || return 2
    untracked="$(git -C "$wt" ls-files --others --exclude-standard -- . ':(exclude).counterpointer-task/**')" || return 2
    changed+="$untracked"
  fi
  [[ -n "$changed" ]] || { print -u2 '復旧Taskの実装差分が空です。完了・検証はできません'; return 2; }
}
cmd="${1:-status}"
shift || true
if [[ "${1:-}" == "--help" && "$cmd" != "help" && "$cmd" != "--help" ]]; then
  case "$cmd" in
    init) print '使い方: cpt init [--scan|--assist]'; print '  --scan    Git管理中ファイルから決定的に候補生成（既定）'; print '  --assist  AI整理用の候補として生成'; print '副作用: 確認待ち提案だけを保存します。index applyまでは正本索引を変更しません。';;
    start) print '使い方: cpt start'; print '引数・オプション: なし'; print '副作用: serviceを開始し、cmux内なら現在のペインを親Codexにします。';;
    question) print '使い方: cpt question TASK JSON_FILE | status ID | wait ID';;
    attention) print '使い方: cpt attention'; print '未解決の子からの確認・定型検証承認を一覧表示します。';;
    notices) print '使い方: cpt notices [通知ID]'; print '最近の通知または指定IDの全文を表示します。';;
    sidebar-test) print '使い方: cpt sidebar-test'; print '監視から親のcmuxサイドバーへ承認不要のテスト通知を1件送ります。';;
    permission) print '使い方: cpt permission request TASK JSON_FILE | list | status ID | approve ID --hash SHA256 [--scope project] | decline ID | run ID | stop TASK'; print 'requestはTask worktreeへ記録し、監視がSQLiteへ取り込みます。approveは固定した要求だけを許可します。';;
    answer) print '使い方: cpt answer ID JSON_FILE（対象Task/世代/計画/操作に束縛）';;
    integration-verify) print '使い方: cpt integration-verify JOB EVIDENCE_JSON（候補SHAの受入証拠を照合）';;
    context) print '使い方: cpt context <refresh|show|compact>'; print '  show     現在の文脈カプセルを表示（既定）'; print '  refresh  簡易プロジェクト索引を再生成'; print '  compact  親要約をhash付きcheckpointとして保存して圧縮';;
    index) print '使い方: cpt index <操作> [引数]'; print '  status                         有効revisionと確認待ち件数を表示（既定）'; print '  onboarding [--json]            初回AI整理の状態と入力manifestを表示'; print '  analysis-template <提案ID>     親Codexが記入するJSON雛形を表示'; print '  submit-analysis <ID> <JSON>    AI分析を検証・保存して承認レポートを表示'; print '  report [提案ID]                承認レポートを再表示'; print '  refresh [--assist]             新しいscan／AI再分析依頼を生成'; print '  sync                            merge済み通常変更を正式索引へ自動反映'; print '  apply <提案ID>                 AI分析済み提案を正本化';;
    register) print '使い方: cpt register --mode <quick|detailed> [オプション]'; print 'quick必須: --text <1文> --path <相対path>（--pathは複数可）'; print 'detailed必須: --plan <計画書> --confirm-hash <SHA-256> --path <相対path>'; print '関連指定: --change-set <ID> --depends-on <Task ID> --provides <契約ID> --consumes <契約ID>'; print '優先度: --urgency low|normal|high|critical --due-at YYYY-MM-DDTHH:MM:SSZ'; print '内部修復用: --kind --base-sha --prepare-cherry-pick --supersedes'; print '副作用: 明確な依頼だけTask化し、曖昧な依頼はNEEDS_DECISIONで止めます。登録だけでは実行しません。';;
    changeset) print '使い方: cpt changeset <create|status> [引数]'; print '  create --title <名前>  空のChange Setを作成'; print '  status [ID]            全件または指定IDの構成を表示（既定）';;
    graph) print '使い方: cpt graph <refresh|status>'; print '  refresh  依存・path包含・契約競合を再計算'; print '  status   最新graphとedgeを表示'; print '循環は拒否し、実行中Taskへの後発依存は関連する未着手Taskを保留します。';;
    queue) print '使い方: cpt queue <タスクID>|--all'; print '  <タスクID>  登録済みTaskの実行を許可する'; print '  --all        この時点の確認済み・登録済みTaskだけを実行待ちへ移す'; print '監視が条件を満たすTaskから自動開始します。後から登録したTaskには許可を引き継ぎません。';;
    schedule) print '使い方: cpt schedule context|status|pause|resume'; print '  priority <ID> low|normal|high|critical [期限UTC]'; print '  relation <先行ID> <後続ID> DEPENDENCY|CONFLICT|UNCERTAIN <根拠>'; print '  forget <先行ID> <後続ID> <解除根拠>'; print '  assess <ID> <最新context hash> <分析根拠>'; print '  hold|release <ID> <根拠> / withdraw <ID>'; print '  replan <ID> <計画file> / confirm <ID> <確認済みhash>'; print '登録は実行許可ではありません。queueは実行許可、pauseは全体の新規開始停止です。';;
    dispatch) print '使い方: cpt dispatch <タスクID>|--all [--include-retries]'; print '  <タスクID>       指定Taskを直ちに割当（登録済み・実行待ち・再試行待ち）'; print '  --all             queue済みの通常Taskを依存順・並列上限に従って割当'; print '  --include-retries  --allに再試行待ちTaskも含める'; print '副作用: Task専用Git worktreeを作成してRUNNINGへ進め、稼働中serviceが子を起動します。';;
    run) print '使い方: cpt run <タスクID>'; print '公開オプション: なし'; print '副作用: 対象worktreeを右側子ペインでCodex起動します。通常はsupervisorが自動実行します。';;
    invalidate-verification) print '使い方: cpt invalidate-verification <Task ID> --reason <理由> [--apply]'; print '既定は確認のみ。未公開・後続未着手の空コミットを失効し、証拠を保存してFAILEDへ戻します。実行許可・holdは変更しません。';;
    retry) print '使い方: cpt retry <タスクID>|--all [--fresh]'; print '  <タスクID>  指定したFAILED Taskの再試行を許可する'; print '  --all        現在の再試行可能なFAILED Taskをまとめて許可する'; print '  --fresh      次回実行時に保存sessionを使わず新規sessionにする'; print '監視が依存・並列上限などの条件成立時に開始します。';;
    pause) print '使い方: cpt pause <タスクID>'; print '実行中の子processを停止し、worktreeとsessionを保持して登録済みへ戻します。'; print '再開を許可するにはqueue <ID>、直ちに割り当てるにはdispatch <ID>を指定します。';;
    status) print '使い方: cpt status [--details|--json]'; print '  指定なし  重要状態と対応対象を簡潔な表で表示'; print '  --details Task・Change Set・runtime・公開・通知の全明細'; print '  --json    統一表示・完了判定・待機理由と内部状態のJSON'; print '色は端末表示時だけ使用します。NO_COLOR=1またはCPT_COLOR=neverで無効化できます。状態は変更しません。';;
    usage) print '使い方: cpt usage <summary|import|タスクID|--all>'; print '  summary                 実測値と推定値を分離集計'; print '  import <ID> <JSONL>     Codex usage実測値を取込'; print '  <タスクID> | --all      明細表示';;
    reset) print '使い方: cpt reset'; print 'オプション: なし'; print '副作用: 停止中serviceの.counterpointer状態を時刻付きdirectoryへ退避し、新規DBと文脈を作成します。Git管理ファイルは変更しません。';;
    service) print '使い方: cpt service <操作> [オプション]'; print '  install                                      project内へ常駐定義を生成'; print '  configure-credentials --profile <profile>   前提診断後に運用profileを固定'; print '    profile: phase1-attended | phase2-publish | phase2-notify | phase3-unattended'; print '  start [--attach-current-parent] | status      サービス再開・現在のCodex親を保持・状態表示'; print '  stop                                         監視と全ワーカーを停止し、成果・実行承認を保持'; print '  reload                                       親を維持して監視processだけ更新'; print '  plist-validate                               plist構文検査'; print '  load | unload                                LaunchAgentの明示登録・解除';;
    integrate) print '使い方: cpt integrate [Change Set ID]'; print 'ID指定なしでは次の統合可能対象を選びます。全Taskの外部検証完了が必須です。'; print '副作用: integration worktreeを作成し、commit適用と全体verifyを行います。';;
    publish) print '使い方: cpt publish <操作または統合ジョブID> [オプション]'; print '  enable --remote <名前> --confirm-url <実URL>  URL照合後に自動PR公開を有効化'; print '  disable                                      手動公開modeへ戻す'; print '  <統合ジョブID>                               固定SHA・branch・PR本文を準備'; print '  set-base <公開要求ID> <branch> <SHA> [--apply]  未公開要求の比較先を固定'; print '  repair-branch <公開要求ID> [--apply]          未公開要求の不正branchを修復'; print '  approve <公開要求ID>                         手動modeで固定SHAを承認'; print '  apply <公開要求ID>                           pushとPR作成を実行'; print '  reconcile <公開要求ID>                       GitHub上のPR状態を再取得（親からの実行ではGit同期なし）'; print '  sync <公開要求ID>                            監視用: 最終取り込み先を安全に更新し索引を同期'; print 'main直接push、force push、自動mergeは行いません。';;
    notify) print '使い方: cpt notify <操作> [オプション]'; print '  configure --provider ntfy --server <URL> --topic <topic> [--token-stdin] [--enable]'; print '  status                                       tokenを隠して設定表示'; print '  test [--apply]                               既定dry-run。--applyで実送信'; print '  deliver [通知ID] [--dry-run|--apply]          1件を確認または配送'; print 'tokenは--token-stdinで非表示入力し、argvへ指定しません。';;
    backup) print '使い方: cpt backup [保存先]'; print '保存先既定: .counterpointer/backups/state-<UTC日時>.sqlite3'; print 'SQLite整合性とSHA-256を検証・記録します。';;
    recovery) print '使い方: cpt recovery <status|drill>'; print '  status  DB整合性、最新backup、service状態を表示（既定）'; print '  drill   一時領域へbackupして復元可能性とTask件数を検証';;
    cancel) print '使い方: cpt cancel <タスクID>'; print 'オプション: なし'; print '実行processを停止し、未公開のTaskを検証済みも含めてCANCELLEDへ更新します。統合候補と公開準備は失効させ、pushまたはPR開始後は拒否します。';;
    browser) print '使い方: cpt browser <タスクID> <open URL|close|操作 [引数…]>'; print 'cmux内蔵ブラウザだけを使用します。操作: close, get, snapshot, screenshot, viewport, eval, wait, click, fill, press, reloadなど。';;
    blocked) print '使い方: cpt blocked <タスクID> <理由>'; print '成果と実行枠を保持し、親へ未完了の理由を通知します。';;
    selfcheck) print '使い方: cpt selfcheck <タスクID> [--implementation-only]'; print '統合後の残検証は--implementation-onlyで親へ引継ぎ、最終受入ゲートを必須化します。'; print '成果物、計画・ゴール未改変、未解消競合を確認して完了申告します。';;
    verify) print '使い方: cpt verify <タスクID>'; print 'オプション: なし'; print '許可path外変更と競合を検査し、Task成果だけをcommitします。';;
    external-verify) print '使い方: cpt external-verify <タスクID>'; print 'オプション: なし'; print 'commit・tree・計画・ゴールを照合してhash付き証跡を保存します。';;
    retry-integration) print '使い方: cpt retry-integration <統合ジョブID>'; print 'オプション: なし'; print 'FAILEDの統合ジョブに対応するChange Setを再試行可能に戻します。';;
    notify-resolve) print '使い方: cpt notify-resolve <通知ID> <判断>'; print '判断: confirm_delivered（配送済み）| retry（再試行）| dismiss（破棄）';;
    supervise) print '使い方: cpt supervise <--once|--watch> [--interval <秒>]'; print '  --once          自動処理を1周期だけ実行'; print '  --watch         常時監視'; print '  --interval <秒> 監視間隔（既定5秒）'; print 'Task起動、verify、統合、公開、通知、日次backupを進めます。';;
    logs) print '使い方: cpt logs <タスクID>'; print 'オプション: なし'; print 'SQLiteへ保存したTask eventを時系列表示します。状態は変更しません。';;
    restore) print '使い方: cpt restore <backupファイル>'; print 'オプション: なし'; print 'backup整合性確認後、現DBを時刻付き退避して復元します。';;
    version) print '使い方: cpt version [--json]'; print '  --json  name、version、schema_versionをJSON表示';;
    doctor) print '使い方: cpt doctor [--profile <profile>]'; print 'profile既定: phase1-attended'; print '選択肢: phase1-attended | phase2-publish | phase2-notify | phase3-unattended'; print 'publishではgh認証と固定remote、notifyでは0600通知設定も検査します。';;
    audit) print '使い方: cpt audit <verify|show>'; print '  verify  監査eventの連番・直前hash・event hashを検証（既定）'; print '  show    監査event一覧を表示';;
    capacity) print '使い方: cpt capacity <status|check>'; print '  status  空き容量、警告・停止下限、状態使用量を表示（既定）'; print '  check   停止下限未満なら失敗終了'; print '既定下限: critical 512 MiB、warning 1024 MiB';;
    cleanup) print '使い方: cpt cleanup [--dry-run|--apply]'; print '  --dry-run  対象表示のみ（既定）'; print '  --apply    終了済みTask／Change Setの再生成可能worktreeを削除'; print 'DB、backup、利用者repositoryは削除しません。';;
    config) print '使い方: cpt config <設定オプション>'; print '  --max-parallel <件数>                    Task並列上限'; print '  --integration-verify <相対hook>          統合後全量verify'; print '  --integration-review required           統合候補の親受入証拠を必須化'; print '  --publish-base <branch>                  PRのbase branch'; print '  --publish-remote <remote>                手動公開用remote'; print '  --capacity <criticalMiB> <warningMiB>    容量下限';;
    test) print '使い方: cpt test <smoke|e2e|install|all>'; print '  smoke    基本経路'; print '  e2e      登録から模擬PRまで'; print '  install  導入・rollback・uninstall'; print '  all      migrationを含む全回帰'; print '一時repositoryと模擬外部commandを使い、実push・通知は行いません。';;
    *) print "個別ヘルプ未定義: $cmd"; exit 2;;
  esac
  exit 0
fi
if [[ "$cmd" == service && "${1:-}" == (start|stop|reload) ]]; then
  service_lifecycle_lock="$state_root/service-lifecycle.lock"
  service_lock_attempt=0
  while ! mkdir "$service_lifecycle_lock" 2>/dev/null; do
    service_lock_owner=""; [[ ! -s "$service_lifecycle_lock/pid" ]] || service_lock_owner="$(<"$service_lifecycle_lock/pid")"
    if [[ "$service_lock_owner" == <-> ]] && ! kill -0 "$service_lock_owner" 2>/dev/null; then
      /bin/rm -f "$service_lifecycle_lock/pid"; rmdir "$service_lifecycle_lock" 2>/dev/null || true
    fi
    service_lock_attempt=$((service_lock_attempt+1))
    (( service_lock_attempt < 400 )) || { print -u2 'サービス開始・停止が処理中です'; exit 3; }
    sleep 0.05
  done
  print $$ > "$service_lifecycle_lock/pid"
  trap '/bin/rm -f "$service_lifecycle_lock/pid"; rmdir "$service_lifecycle_lock" 2>/dev/null || true' EXIT
fi
if [[ "$cmd" == service && "${1:-}" == stop ]]; then
  [[ -f "$state_root/service.state" ]] || { print -u2 'サービスが登録されていません'; exit 2; }
  : > "$state_root/service.stop-requested"
  service_previous_installed="$(sed -n 's/^installed_at=//p' "$state_root/service.state")"
  print -r -- "installed_at=$service_previous_installed"$'\n''state=STOPPING' > "$state_root/service.state"
  # Remove launchd restart sources before stopping the processes they own.
  if [[ "${COUNTERPOINTER_TEST:-0}" != 1 ]] && command -v launchctl >/dev/null 2>&1; then
    for service_worker in supervisor watchdog; do
      service_label="gui/$(id -u)/com.counterpointer.$service_worker"
      service_launch_info="$(launchctl print "$service_label" 2>/dev/null || true)"
      # Legacy labels are global; never unload another repository's service.
      if [[ "$service_launch_info" == *"$state_root/launchagents/"* ]]; then
        service_launch_pid="$(print -r -- "$service_launch_info" | sed -n 's/^[[:space:]]*pid = \([0-9]*\)$/\1/p')"
        if [[ "$service_launch_pid" == <-> ]]; then
          service_stop_process "$service_launch_pid" "-C $project_root ${service_worker/supervisor/supervise} --watch" || exit 3
        fi
        launchctl bootout "$service_label" || { print -u2 'LaunchAgent停止が未完了です'; exit 3; }
      fi
    done
  fi
  orphan_monitors="$(project_monitor_pids)" || exit 3
  while IFS='|' read -r orphan_pid orphan_mode; do
    [[ -n "$orphan_pid" ]] || continue
    service_stop_process "$orphan_pid" "-C $project_root $orphan_mode --watch" || exit 3
  done <<< "$orphan_monitors"
  for service_worker in supervisor watchdog; do
    service_pid_file="$state_root/$service_worker.pid"
    [[ -s "$service_pid_file" ]] || continue
    service_pid="$(<"$service_pid_file")"
    service_expected="-C $project_root ${service_worker/supervisor/supervise} --watch"
    service_stop_process "$service_pid" "$service_expected" || { print -u2 '監視停止が未完了です。service stopを再実行してください'; exit 3; }
    /bin/rm -f "$service_pid_file"
  done
fi
service_execution_gate() {
  [[ ! -f "$state_root/service.stop-requested" ]] || { print -u2 'サービスは停止中です。service startで再開してください'; return 3; }
}
case "$cmd:${1:-}" in
  dispatch:*|run:*|supervise:*|watchdog:*|complete:*|verify:*|external-verify:*|integrate:*|publish:apply|publish:sync|runtime:started|runtime:reconcile|parent-runtime:reconcile|service:reload)
    service_execution_gate || exit $?;;
esac
if [[ ( "$cmd" == question && "${1:-}" != status && "${1:-}" != wait ) || "$cmd" == answer || "$cmd" == integration-verify || "$cmd" == selfcheck || "$cmd" == register || "$cmd" == queue || "$cmd" == dispatch || "$cmd" == schedule || "$cmd" == graph || "$cmd" == retry || "$cmd" == repair-child || "$cmd" == model || "$cmd" == pause || "$cmd" == cancel || "$cmd" == invalidate-verification || "$cmd" == verify || "$cmd" == external-verify || "$cmd" == complete || "$cmd" == integrate || "$cmd" == publish || "$cmd" == run || ( "$cmd" == runtime && "${1:-}" == started ) || ( "$cmd" == service && ( "${1:-}" == stop || "${1:-}" == start ) ) ]]; then
  scheduler_lock="$state_root/scheduler.lock"
  scheduler_owner=""
  [[ ! -s "$scheduler_lock/pid" ]] || scheduler_owner="$(<"$scheduler_lock/pid")"
  if [[ -z "${CPT_SCHEDULER_LOCK_OWNER:-}" || "$scheduler_owner" != "$CPT_SCHEDULER_LOCK_OWNER" ]] || ! kill -0 "$scheduler_owner" 2>/dev/null; then
    scheduler_attempt=0
    while ! mkdir "$scheduler_lock" 2>/dev/null; do
      scheduler_owner=""; [[ ! -s "$scheduler_lock/pid" ]] || scheduler_owner="$(<"$scheduler_lock/pid")"
      if [[ "$scheduler_owner" == <-> ]] && ! kill -0 "$scheduler_owner" 2>/dev/null; then
        /bin/rm -f "$scheduler_lock/pid"; rmdir "$scheduler_lock" 2>/dev/null || true
      fi
      scheduler_attempt=$((scheduler_attempt+1))
      (( scheduler_attempt < 400 )) || { print -u2 '実行順の更新が処理中です。再試行してください'; exit 3; }
      sleep 0.05
    done
    print -r -- $$ > "$scheduler_lock/pid"
    export CPT_SCHEDULER_LOCK_OWNER=$$
    trap '/bin/rm -f "$scheduler_lock/pid"; rmdir "$scheduler_lock" 2>/dev/null || true; if [[ -n "${service_lifecycle_lock:-}" ]]; then /bin/rm -f "$service_lifecycle_lock/pid"; rmdir "$service_lifecycle_lock" 2>/dev/null || true; fi' EXIT
  fi
fi
case "$cmd:${1:-}" in
  dispatch:*|run:*|complete:*|verify:*|external-verify:*|integrate:*|publish:apply|publish:sync|runtime:started)
    service_execution_gate || exit $?;;
esac
case "$cmd" in
  help|-h|--help)
    cat <<'USAGE'
Counterpointer CLI（日本語）
使い方: cpt [-C <プロジェクトpath>] <コマンド> [オプション]
  -C <path>                    現在directory以外のprojectを対象にする（コマンドより前に指定）

  version [--json]             CLIのversionを表示
  init                         プロジェクトを初期化し、ファイル一覧から索引を生成
  start                        現在のペインで親オーケストレーターを起動
  context refresh|show|compact 索引の再生成・表示・圧縮
  index                        初回AI分析・状態確認・同期・適用
  register                     タスクを登録（quick／detailed）
  changeset create|status      Change Setの作成・状態確認
  graph refresh|status         依存・競合グラフの再計算・表示
  schedule                    優先順位・関係分析・保留・新規開始の制御
  queue <task-id>|--all        指定Taskの実行を許可して実行待ちへ移す
  dispatch <task-id>|--all     Taskを明示的に実行へ割り当てる
  run <task-id>                子Codexを起動
  attention                    子からの未解決の確認・検証承認を表示
  notices [通知ID]              最近の親向け通知・全文を表示
  sidebar-test                 親のcmuxサイドバーへテスト通知を送る
  invalidate-verification <task-id> --reason <理由> [--apply]
                              未公開の空コミット誤検証を撤回
  retry <task-id>|--all        失敗Taskを安全な再試行キューへ戻す
  repair-child <task-id> <理由> 停滞した子を親が停止確認して同じ成果から再開
  model <task-id> <sol|luna|astra> <理由> 次世代の子モデルを選択
  pause <task-id>              実行中Taskを成果を残したまま一時停止
  browser <task-id> <操作>     タスク専用のcmux内蔵ブラウザを操作・終了
  blocked <task-id> <理由>     未完了の理由を親へ通知
  selfcheck <task-id>          子タスクの完了を申告
  verify <task-id>             コミットを作成し内部検証
  external-verify <task-id>   外部検証証跡を作成
  cancel <task-id>             Taskを取消
  integrate                    検証済みタスクを統合
  retry-integration <job-id>  失敗した統合を再試行
  publish enable|disable       対象remoteへの自動PR公開を設定
  publish <job-id>             固定SHA・branch・日本語PR本文を準備
  publish approve|apply        個別承認／push・PR作成（手動運用時）
  notify configure|status     ntfy設定・状態確認
  notify deliver|test         通知配送・接続試験
  notify-resolve              不確実な配送結果の確定
  backup                       SQLite backupを作成
  restore <backup-file>        SQLite backupから復元
  recovery status|drill       復旧状態の確認・復元試験
  logs <task-id>               Taskの実行ログを表示
  supervise --once|--watch     自動監視と後続処理
  doctor [--profile <profile>] 実行環境を診断
  audit verify|show            改ざん検知可能な監査鎖を確認
  capacity status|check        空き容量と安全下限を確認
  cleanup --dry-run|--apply    再生成可能な終了済みworktreeを清掃
  config                       並列上限・verify・PR公開先を設定
  status [--details|--json]    状態を要約／詳細／JSONで表示
  usage summary|<task-id>      使用量（実測／推定）とcache効果を表示
  usage import <id> <jsonl>    JSONログの実測usageを取り込む
  reset                        状態をバックアップして初期化
  service <action>              常駐サービスを管理・監視processを更新
  test smoke|e2e|install|all    回帰テストを実行

個別ヘルプ: cpt <コマンド> --help
USAGE
    ;;
  version)
    if [[ "${1:-}" == --json ]]; then print -r -- '{"name":"counterpointer","version":"0.3.0","schema_version":6}'; else print 'Counterpointer 0.3.0'; fi
    ;;
  init)
    init_mode="${1:---scan}"
    ensure_git_exclude
    existing_onboarding_state="$(sqlite3 "$db" "SELECT COALESCE(value,'NOT_INITIALIZED') FROM metadata WHERE key='index_onboarding_state';")"
    existing_onboarding_proposal="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='index_onboarding_proposal';")"
    if [[ "$existing_onboarding_state" == READY ]]; then
      print "初期整理は完了しています（索引revision $(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')）。"
      print '再分析する場合: cpt index refresh --assist'
      exit 0
    elif [[ "$existing_onboarding_state" == AWAITING_OWNER && -n "$existing_onboarding_proposal" ]]; then
      render_index_report "$existing_onboarding_proposal"
      exit 0
    elif [[ "$existing_onboarding_state" == PENDING_AI_ANALYSIS && -n "$existing_onboarding_proposal" && "$(sqlite3 "$db" "SELECT source_sha FROM index_proposals WHERE proposal_id='$(sql_quote "$existing_onboarding_proposal")';")" == "$(git -C "$project_root" rev-parse HEAD 2>/dev/null)" ]]; then
      print '初期準備は完了しており、親CodexのAI分析待ちです。'
      print '次の操作: cpt start'
      exit 0
    fi
    if [[ "$init_mode" == "--assist" || "$init_mode" == "--scan" ]]; then
      proposal_mode=scan; [[ "$init_mode" == --assist ]] && proposal_mode=assist
      onboarding_proposal="$(generate_index_proposal "$proposal_mode" id-only)"
      sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('index_onboarding_state','PENDING_AI_ANALYSIS') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('index_onboarding_proposal','$(sql_quote "$onboarding_proposal")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
      refresh_context >/dev/null
      tracked_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM index_entries WHERE proposal_id='$(sql_quote "$onboarding_proposal")';")"
      preliminary_ssot="$(sqlite3 "$db" "SELECT COUNT(*) FROM index_entries WHERE proposal_id='$(sql_quote "$onboarding_proposal")' AND entry_kind='SSOT';")"
      print 'Counterpointerの初期準備が完了しました。'
      print "Git管理中ファイル: ${tracked_count}件"
      print "機械判定によるSSOT候補: ${preliminary_ssot}件（まだ確定していません）"
      print '次のcpt startで親Codexが既存SSOTとソースの対応を分析し、承認内容を日本語で報告します。'
      print '現時点では索引を適用せず、ソースや既存SSOTも変更していません。'
    else
      print -u2 "不明な初期化オプション: $init_mode"; exit 2
    fi
    ;;
  start)
    exec "$0" -C "$project_root" service start
    ;;
  reset)
    if [[ -f "$state_root/service.state" && "$(sed -n 's/^state=//p' "$state_root/service.state")" == RUNNING ]]; then
      print -u2 "先にサービスを停止してください: cpt service stop"
      exit 2
    fi
    backup_dir="$project_root/.counterpointer.backup-$(/bin/date -u +%Y%m%dT%H%M%SZ)"
    [[ -d "$state_root" ]] && mv "$state_root" "$backup_dir"
    mkdir -p "$state_root"
    init_db
    refresh_context >/dev/null
    ensure_git_exclude
    print "初期化完了（旧状態を退避）: $backup_dir"
    ;;
  context)
    action="${1:-show}"
    case "$action" in
      refresh|scan) refresh_context ;;
      compact)
        summary="$state_root/context/parent-summary.md"
        [[ -s "$summary" ]] || { print -u2 "圧縮前に親セッション要約が必要です: $summary"; exit 2; }
        checkpoint_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        checkpoint_dir="$state_root/context/checkpoints/$checkpoint_id"
        mkdir -p "$checkpoint_dir"
        /bin/cp "$summary" "$checkpoint_dir/summary.md"
        for restart_file in restart-handoff.md restart-state.json; do
          [[ ! -f "$state_root/context/$restart_file" ]] || /bin/cp "$state_root/context/$restart_file" "$checkpoint_dir/$restart_file"
        done
        summary_hash="$(file_sha256 "$checkpoint_dir/summary.md")"
        checkpoint_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
        sqlite3 "$db" "INSERT INTO context_checkpoints VALUES ('$checkpoint_id','parent','$(sql_quote "$project_root")',$checkpoint_revision,'$(sql_quote "$checkpoint_dir/summary.md")','$summary_hash','$(now)');"
        refresh_context >/dev/null
        print "compacted_at=$(now)" >> "$context_file"
        print "checkpoint_id=$checkpoint_id" >> "$context_file"
        print "checkpoint_sha256=$summary_hash" >> "$context_file"
        rm -f "$state_root/context/compaction-required"
        event project "$project_root" CONTEXT_COMPACTED "$checkpoint_id $summary_hash"
        print "$context_file"
        ;;
      show) [[ -f "$context_file" ]] && /bin/cat "$context_file" || refresh_context ;;
      *) print -u2 "使い方: cpt context refresh|show|compact"; exit 2;;
    esac
    ;;
  index)
    index_action="${1:-status}"
    case "$index_action" in
      status|show)
        active_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
        if (( active_revision == 0 )); then print '有効な索引はありません。cpt initを実行してください'; else sqlite3 -header -column "$db" 'SELECT revision,proposal_id,source_sha,index_hash,applied_at FROM index_revisions ORDER BY revision DESC LIMIT 1;'; fi
        pending_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM index_proposals WHERE status='PENDING';")"
        print "確認待ち提案: ${pending_count}件"
        ;;
      refresh)
        if [[ "${2:-}" == --assist ]]; then
          proposal_id="$(generate_index_proposal assist id-only)"
          sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('index_onboarding_state','PENDING_AI_ANALYSIS') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('index_onboarding_proposal','$(sql_quote "$proposal_id")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
          print "AI再分析を親Codexへ依頼しました: $proposal_id"
          print '親ペインで分析結果と適用内容を確認してください。'
        else
          generate_index_proposal scan
        fi
        ;;
      onboarding)
        onboarding_state="$(sqlite3 "$db" "SELECT COALESCE(value,'NOT_INITIALIZED') FROM metadata WHERE key='index_onboarding_state';")"
        onboarding_proposal="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='index_onboarding_proposal';")"
        if [[ "${2:-}" == --json ]]; then
          jq -n --arg state "$onboarding_state" --arg proposal_id "$onboarding_proposal" --arg manifest "$(sqlite3 "$db" "SELECT COALESCE(artifact_dir || '/entries.tsv','') FROM index_proposals WHERE proposal_id='$(sql_quote "$onboarding_proposal")';")" '{state:$state,proposal_id:$proposal_id,manifest_path:$manifest}'
        else
          print "初期整理状態: $onboarding_state"; print "対象提案ID: ${onboarding_proposal:-なし}"
        fi
        ;;
      analysis-template)
        [[ -n "${2:-}" ]] || { print -u2 '提案IDが必要です'; exit 2; }; index_analysis_template "$2";;
      submit-analysis)
        [[ -n "${2:-}" && -n "${3:-}" ]] || { print -u2 '使い方: cpt index submit-analysis <提案ID> <分析JSON>'; exit 2; }; submit_index_analysis "$2" "$3";;
      report)
        report_id="${2:-$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='index_onboarding_proposal';")}"; [[ -n "$report_id" ]] || { print -u2 '提案IDが必要です'; exit 2; }; render_index_report "$report_id";;
      sync) sync_index_with_head;;
      apply)
        [[ -n "${2:-}" ]] || { print -u2 '提案IDが必要です'; exit 2; }
        apply_index_proposal "$2"
        ;;
      *) print -u2 "使い方: cpt index status | refresh [--assist] | apply <提案ID>"; exit 2;;
    esac
    ;;
  changeset)
    changeset_action="${1:-status}"
    shift || true
    case "$changeset_action" in
      create)
        [[ "${1:-}" == --title && -n "${2:-}" ]] || { print -u2 "使い方: cpt changeset create --title <名前>"; exit 2; }
        change_set_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        timestamp="$(now)"
        sqlite3 "$db" "INSERT INTO change_sets VALUES ('$(sql_quote "$change_set_id")','$(sql_quote "$2")','OPEN',0,'$timestamp','$timestamp');"
        event changeset "$change_set_id" CREATED "$2"
        print "$change_set_id"
        ;;
      status)
        requested_change_set="${1:-}"
        if [[ -n "$requested_change_set" ]]; then
          sqlite3 -header -column "$db" "SELECT c.change_set_id,c.title,c.state,c.membership_revision,COUNT(m.task_id) AS tasks,c.created_at,c.updated_at FROM change_sets c LEFT JOIN change_set_tasks m ON m.change_set_id=c.change_set_id WHERE c.change_set_id='$(sql_quote "$requested_change_set")' GROUP BY c.change_set_id;"
          sqlite3 -header -column "$db" "SELECT m.task_id,m.member_kind,t.state,t.mode FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$requested_change_set")' ORDER BY m.created_at;"
        else
          sqlite3 -header -column "$db" 'SELECT c.change_set_id,c.title,c.state,c.membership_revision,COUNT(m.task_id) AS tasks,c.created_at,c.updated_at FROM change_sets c LEFT JOIN change_set_tasks m ON m.change_set_id=c.change_set_id GROUP BY c.change_set_id ORDER BY c.created_at;'
        fi
        ;;
      *) print -u2 "使い方: cpt changeset create --title <名前> | status [<ID>]"; exit 2;;
    esac
    ;;
  graph)
    graph_action="${1:-status}"
    case "$graph_action" in
      refresh)
        timestamp="$(now)"
        sqlite3 "$db" "DELETE FROM task_edges WHERE origin='detected';"
        sqlite3 "$db" "INSERT OR IGNORE INTO task_edges SELECT r.source_task_id,r.target_task_id,'DEPENDENCY','analysis:' || r.reason,'detected','$timestamp' FROM task_relations r JOIN task_artifacts s ON s.task_id=r.source_task_id JOIN task_artifacts t ON t.task_id=r.target_task_id JOIN tasks st ON st.task_id=s.task_id JOIN tasks tt ON tt.task_id=t.task_id WHERE r.relation='DEPENDENCY' AND r.source_plan_hash=s.execution_plan_hash AND r.target_plan_hash=t.execution_plan_hash AND st.state<>'CANCELLED' AND tt.state<>'CANCELLED';"
        sqlite3 "$db" "INSERT OR IGNORE INTO task_edges(source_task_id,target_task_id,edge_type,reason,origin,created_at)
          SELECT p.task_id,c.task_id,'DEPENDENCY','contract:' || p.contract_id,'detected','$timestamp'
          FROM task_contracts p JOIN task_contracts c ON c.contract_id=p.contract_id
          JOIN tasks pt ON pt.task_id=p.task_id JOIN tasks ct ON ct.task_id=c.task_id
          WHERE p.direction='PROVIDES' AND c.direction='CONSUMES' AND p.task_id<>c.task_id
            AND pt.state<>'CANCELLED' AND ct.state<>'CANCELLED';"
        active_task_ids=()
        # 外部利用側は、提供元Change Setの追加修正も待つ。
        sqlite3 "$db" "INSERT OR IGNORE INTO task_edges
          SELECT member.task_id,e.target_task_id,'DEPENDENCY','change-set:' || source.change_set_id,'detected','$timestamp'
          FROM task_edges e JOIN change_set_tasks source ON source.task_id=e.source_task_id
          JOIN change_set_tasks target ON target.task_id=e.target_task_id
          JOIN change_set_tasks member ON member.change_set_id=source.change_set_id
          JOIN tasks mt ON mt.task_id=member.task_id
          WHERE e.edge_type='DEPENDENCY' AND source.change_set_id<>target.change_set_id
            AND mt.state<>'CANCELLED';"
        # 固定のTask群ではなく、現在の許可状態・緊急度・期限・後続解放効果で再評価。
        while IFS= read -r graph_task_id; do [[ -n "$graph_task_id" ]] && active_task_ids+=("$graph_task_id"); done < <(schedule_priority_order)
        for (( i=1; i<=${#active_task_ids[@]}; i++ )); do
          left_task_id="${active_task_ids[$i]}"
          for (( j=i+1; j<=${#active_task_ids[@]}; j++ )); do
            right_task_id="${active_task_ids[$j]}"
            conflict_reason=""
            while IFS='|' read -r left_path right_path; do
              [[ -n "$left_path" && -n "$right_path" ]] || continue
              if paths_overlap "$left_path" "$right_path"; then conflict_reason="path:$left_path<>$right_path"; break; fi
            done < <(sqlite3 "$db" "SELECT l.path,r.path FROM task_paths l CROSS JOIN task_paths r WHERE l.task_id='$(sql_quote "$left_task_id")' AND r.task_id='$(sql_quote "$right_task_id")';")
            if [[ -z "$conflict_reason" ]]; then
              shared_contract="$(sqlite3 "$db" "SELECT l.contract_id FROM task_contracts l JOIN task_contracts r ON r.contract_id=l.contract_id WHERE l.task_id='$(sql_quote "$left_task_id")' AND r.task_id='$(sql_quote "$right_task_id")' AND l.direction='PROVIDES' AND r.direction='PROVIDES' LIMIT 1;")"
              [[ -n "$shared_contract" ]] && conflict_reason="contract-write:$shared_contract"
            fi
            if [[ -z "$conflict_reason" ]]; then
              conflict_reason="$(sqlite3 "$db" "SELECT 'analysis:' || r.reason FROM task_relations r JOIN task_artifacts s ON s.task_id=r.source_task_id JOIN task_artifacts t ON t.task_id=r.target_task_id WHERE r.relation='CONFLICT' AND r.source_plan_hash=s.execution_plan_hash AND r.target_plan_hash=t.execution_plan_hash AND ((r.source_task_id='$left_task_id' AND r.target_task_id='$right_task_id') OR (r.source_task_id='$right_task_id' AND r.target_task_id='$left_task_id')) LIMIT 1;")"
            fi
            [[ -n "$conflict_reason" ]] || continue
            left_reaches_right="$(sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (SELECT source_task_id,target_task_id FROM task_edges UNION SELECT reach.src,e.target_task_id FROM reach JOIN task_edges e ON e.source_task_id=reach.dst) SELECT 1 FROM reach WHERE src='$(sql_quote "$left_task_id")' AND dst='$(sql_quote "$right_task_id")' LIMIT 1;")"
            right_reaches_left="$(sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (SELECT source_task_id,target_task_id FROM task_edges UNION SELECT reach.src,e.target_task_id FROM reach JOIN task_edges e ON e.source_task_id=reach.dst) SELECT 1 FROM reach WHERE src='$(sql_quote "$right_task_id")' AND dst='$(sql_quote "$left_task_id")' LIMIT 1;")"
            if [[ -n "$right_reaches_left" && -z "$left_reaches_right" ]]; then
              edge_source="$right_task_id"; edge_target="$left_task_id"
            else
              edge_source="$left_task_id"; edge_target="$right_task_id"
            fi
            sqlite3 "$db" "INSERT OR IGNORE INTO task_edges VALUES ('$(sql_quote "$edge_source")','$(sql_quote "$edge_target")','CONFLICT','$(sql_quote "$conflict_reason")','detected','$timestamp');"
          done
        done
        cycle="$(sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (SELECT source_task_id,target_task_id FROM task_edges UNION SELECT reach.src,e.target_task_id FROM reach JOIN task_edges e ON e.source_task_id=reach.dst) SELECT src FROM reach WHERE src=dst LIMIT 1;")"
        unsafe_running="$(sqlite3 "$db" "SELECT e.target_task_id FROM task_edges e JOIN tasks predecessor ON predecessor.task_id=e.source_task_id JOIN tasks successor ON successor.task_id=e.target_task_id WHERE successor.state IN ('RUNNING','CLAIMED_DONE','VERIFYING') AND predecessor.state<>'VERIFIED' LIMIT 1;")"
        graph_valid=1
        [[ -z "$cycle" ]] || graph_valid=0
        if [[ -n "$unsafe_running" ]]; then
          newly_held="$(sqlite3 "$db" "UPDATE task_schedule SET hold_reason='実行中Taskへの後発依存を検出。関係の再確認が必要' WHERE hold_reason='' AND task_id IN (SELECT e.source_task_id FROM task_edges e JOIN tasks p ON p.task_id=e.source_task_id JOIN tasks s ON s.task_id=e.target_task_id WHERE s.state IN ('RUNNING','CLAIMED_DONE','VERIFYING') AND p.state IN ('REGISTERED','READY')); SELECT changes();")"
          if (( newly_held > 0 )); then notify_parent_agent "Counterpointer通知: 実行中Taskへの後発依存を検出し、関連する未着手Taskを保留しました。実行中Taskは継続します。schedule status/contextで関係を再確認してください。"; fi
        fi
        schedule_position=0
        for graph_task_id in "${active_task_ids[@]}"; do
          schedule_position=$((schedule_position+1))
          sqlite3 "$db" "UPDATE task_schedule SET position=$schedule_position WHERE task_id='$graph_task_id';"
        done
        graph_text="$(sqlite3 "$db" "SELECT source_task_id || '|' || target_task_id || '|' || edge_type || '|' || reason FROM task_edges ORDER BY source_task_id,target_task_id,edge_type,reason;")"
        graph_hash="$(text_sha256 "$graph_text|$(sqlite3 "$db" 'SELECT task_id,urgency,due_at,position,hold_reason FROM task_schedule ORDER BY position,task_id;')")"
        previous_graph_hash="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='execution_graph_hash';")"
        previous_graph_valid="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='execution_graph_valid';")"
        if [[ "$graph_hash" == "$previous_graph_hash" && "$graph_valid" == "$previous_graph_valid" ]]; then
          print "依存・競合グラフは変更ありません: Hash=$graph_hash"
          (( graph_valid == 1 )) || exit 3
          exit 0
        fi
        snapshot_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        task_count="${#active_task_ids[@]}"
        edge_count="$(sqlite3 "$db" 'SELECT COUNT(*) FROM task_edges;')"
        sqlite3 "$db" "BEGIN; INSERT INTO execution_graph_snapshots VALUES ('$snapshot_id','$graph_hash',$task_count,$edge_count,$graph_valid,'$timestamp'); INSERT INTO metadata(key,value) VALUES('execution_graph_valid','$graph_valid') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('execution_graph_hash','$graph_hash') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
        event graph "$snapshot_id" REFRESHED "$graph_hash tasks=$task_count edges=$edge_count valid=$graph_valid"
        if (( graph_valid == 0 )); then
          if [[ -n "$cycle" ]]; then print -u2 "依存グラフに循環があります: $cycle"; else print -u2 "実行中Taskより前へ新しい先行Taskを挿入できません: $unsafe_running"; fi
          exit 3
        fi
        print "依存・競合グラフ更新完了: Task=$task_count Edge=$edge_count Hash=$graph_hash"
        ;;
      status)
        latest_snapshot="$(sqlite3 "$db" 'SELECT snapshot_id FROM execution_graph_snapshots ORDER BY created_at DESC LIMIT 1;')"
        if [[ -z "$latest_snapshot" ]]; then print '依存・競合グラフは未生成です'; exit 0; fi
        sqlite3 -header -column "$db" "SELECT snapshot_id,graph_hash,task_count,edge_count,valid,created_at FROM execution_graph_snapshots WHERE snapshot_id='$latest_snapshot';"
        sqlite3 -header -column "$db" 'SELECT source_task_id AS predecessor,target_task_id AS successor,edge_type,reason FROM task_edges ORDER BY source_task_id,target_task_id;'
        ;;
      *) print -u2 "使い方: cpt graph refresh|status"; exit 2;;
    esac
    ;;
  register)
    mode=""; text=""; paths=(); plan_file=""; confirm_hash=""; change_set_id=""
    dependencies=(); provides_contracts=(); consumes_contracts=(); member_kind="implementation"
    dispatch_base_sha=""; prepare_cherry_pick_sha=""; supersedes_task_id=""
    urgency=normal; due_at=""
    while (( $# )); do
      case "$1" in
        --mode) mode="$2"; shift 2;;
        --text) text="$2"; shift 2;;
        --plan) plan_file="$2"; shift 2;;
        --confirm-hash) confirm_hash="$2"; shift 2;;
        --path) paths+=("$2"); shift 2;;
        --change-set) change_set_id="$2"; shift 2;;
        --depends-on) dependencies+=("$2"); shift 2;;
        --provides) provides_contracts+=("$2"); shift 2;;
        --consumes) consumes_contracts+=("$2"); shift 2;;
        --kind) member_kind="$2"; shift 2;;
        --base-sha) dispatch_base_sha="$2"; shift 2;;
        --prepare-cherry-pick) prepare_cherry_pick_sha="$2"; shift 2;;
        --supersedes) supersedes_task_id="$2"; shift 2;;
        --urgency) urgency="$2"; shift 2;;
        --due-at) due_at="$2"; shift 2;;
      *) print -u2 "不明なオプション: $1"; exit 2;;
      esac
    done
    [[ "$mode" == quick || "$mode" == detailed ]] || { print -u2 "--mode quick または --mode detailed を明示してください"; exit 2; }
    validate_schedule_priority "$urgency" "$due_at" || exit $?
    registration_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    if [[ "$mode" == detailed ]]; then
      [[ -z "$text" ]] || { print -u2 "detailedでは--textではなく--planを使用してください"; exit 2; }
      [[ -n "$plan_file" && -f "$plan_file" ]] || { print -u2 "detailedには--planで計画書を指定してください"; exit 2; }
      text="$(<"$plan_file")"
      source_hash="$(text_sha256 "$text")"
      actual_plan_hash="$(file_sha256 "$plan_file")"
      if [[ -z "$confirm_hash" ]]; then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" PLAN_CONFIRMATION_REQUIRED
        exit 3
      fi
      if [[ "$confirm_hash" != "$actual_plan_hash" ]]; then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" PLAN_HASH_MISMATCH
        exit 3
      fi
    else
      [[ -z "$plan_file" && -z "$confirm_hash" ]] || { print -u2 "quickでは--plan／--confirm-hashを使用できません"; exit 2; }
      [[ -n "$text" ]] || { print -u2 "quickには--textが必要です"; exit 2; }
      source_hash="$(text_sha256 "$text")"
      if [[ "$text" == *$'\n'* ]]; then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" QUICK_REQUIRES_ONE_STRING
        exit 3
      fi
      if (( ${#paths[@]} == 0 )); then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" TARGET_PATH_UNRESOLVED
        exit 3
      fi
      if [[ "$text" == *'?'* || "$text" == *'？'* ]] || print -r -- "$text" | /usr/bin/grep -Eiq '(作りたい|どうにか|いい感じ|適切に|検討(する|して)?|など|その他|未定|TBD|maybe|perhaps|somehow)'; then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" AMBIGUOUS_REQUIREMENT
        exit 3
      fi
      if print -r -- "$text" | /usr/bin/grep -Eiq '(本番|production|削除|消去|drop[[:space:]]|destroy|秘密鍵|credential|課金|billing)'; then
        registration_decision "$registration_id" "$mode" "$text" "$source_hash" RISK_REVIEW_REQUIRED
        exit 3
      fi
    fi
    for target_path in "${paths[@]}"; do
      [[ -n "$target_path" && "$target_path" != /* && "/$target_path/" != */../* ]] || { print -u2 "対象パスはプロジェクト相対で指定してください: $target_path"; exit 2; }
    done
    [[ "$member_kind" == implementation || "$member_kind" == integration_fix || "$member_kind" == review_fix || "$member_kind" == gate_change ]] || { print -u2 "不正なTask種別です: $member_kind"; exit 2; }
    if [[ -n "$dispatch_base_sha$prepare_cherry_pick_sha$supersedes_task_id" && "$member_kind" != integration_fix ]]; then
      print -u2 'base／競合準備／置換指定はintegration_fix専用です'; exit 2
    fi
    for required_sha in "$dispatch_base_sha" "$prepare_cherry_pick_sha"; do
      [[ -z "$required_sha" ]] || git -C "$project_root" cat-file -e "$required_sha^{commit}" 2>/dev/null || { print -u2 "参照commitが見つかりません: $required_sha"; exit 2; }
    done
    if [[ -n "$supersedes_task_id" ]]; then
      [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks WHERE change_set_id='$(sql_quote "$change_set_id")' AND task_id='$(sql_quote "$supersedes_task_id")';")" == 1 ]] || { print -u2 "同じChange Setの置換対象Taskではありません: $supersedes_task_id"; exit 2; }
    fi
    for dependency_id in "${dependencies[@]}"; do
      [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE task_id='$(sql_quote "$dependency_id")' AND state NOT IN ('FAILED','CANCELLED');")" == 1 ]] || { print -u2 "依存先Taskが存在しないか終了済みです: $dependency_id"; exit 2; }
    done
    for contract_id in "${provides_contracts[@]}" "${consumes_contracts[@]}"; do
      [[ -z "$contract_id" ]] || print -r -- "$contract_id" | /usr/bin/grep -Eq '^[A-Za-z0-9._:/-]+$' || { print -u2 "契約IDの形式が不正です: $contract_id"; exit 2; }
    done
    if [[ -n "$change_set_id" ]]; then
      change_set_state_predicate="state='OPEN'"
      [[ "$member_kind" == integration_fix ]] && change_set_state_predicate="state IN ('OPEN','INTEGRATING','FAILED')"
      current_membership_revision="$(sqlite3 "$db" "SELECT membership_revision FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")' AND $change_set_state_predicate;")"
      [[ -n "$current_membership_revision" ]] || { print -u2 "追加可能なChange Setではありません: $change_set_id"; exit 2; }
      membership_revision=$((current_membership_revision+1))
      create_change_set=0
    else
      change_set_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
      membership_revision=1
      create_change_set=1
    fi
    task_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    timestamp="$(now)"
    create_task_artifacts "$task_id" "$mode" "$text" "$plan_file"
    sql="BEGIN IMMEDIATE;"
    if (( create_change_set )); then
      change_set_title="${text[1,80]}"
      sql+="INSERT INTO change_sets VALUES ('$(sql_quote "$change_set_id")','$(sql_quote "$change_set_title")','OPEN',1,'$timestamp','$timestamp');"
    else
      sql+="UPDATE change_sets SET membership_revision=$membership_revision,state='OPEN',updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$change_set_id")' AND $change_set_state_predicate AND membership_revision=$current_membership_revision;"
    fi
    sql+="
      INSERT INTO tasks (task_id,source_text,mode,state,created_at,updated_at)
      VALUES ('$(sql_quote "$task_id")','$(sql_quote "$text")','$mode','REGISTERED','$timestamp','$timestamp');
      INSERT INTO task_schedule(task_id,urgency,due_at) VALUES ('$(sql_quote "$task_id")',$SCHEDULE_URGENCY,NULLIF('$(sql_quote "$due_at")',''));
      INSERT INTO registrations
      (registration_id,registration_mode,source_text,source_hash,status,task_id,plan_hash,confirmed_plan_hash,question_count,created_at)
      VALUES ('$(sql_quote "$registration_id")','$mode','$(sql_quote "$text")','$source_hash','REGISTERED','$(sql_quote "$task_id")','$CREATED_PLAN_HASH','${confirm_hash:-$CREATED_PLAN_HASH}',0,'$timestamp');
      INSERT INTO task_artifacts VALUES ('$(sql_quote "$task_id")','$(sql_quote "$CREATED_ARTIFACT_DIR")','$CREATED_GOAL_HASH','$CREATED_PLAN_HASH','$timestamp');
      INSERT INTO change_set_tasks VALUES ('$(sql_quote "$change_set_id")','$(sql_quote "$task_id")','$member_kind',$membership_revision,'$timestamp');"
    if [[ -n "$dispatch_base_sha" ]]; then sql+="UPDATE tasks SET dispatch_base_sha='$(sql_quote "$dispatch_base_sha")' WHERE task_id='$(sql_quote "$task_id")';"; fi
    if [[ -n "$prepare_cherry_pick_sha" ]]; then sql+="INSERT INTO task_preparations VALUES ('$(sql_quote "$task_id")','$(sql_quote "$prepare_cherry_pick_sha")','PENDING','integration conflict reproduction','$timestamp','$timestamp');"; fi
    if [[ -n "$supersedes_task_id" ]]; then sql+="INSERT INTO task_supersessions VALUES ('$(sql_quote "$change_set_id")','$(sql_quote "$supersedes_task_id")','$(sql_quote "$task_id")','integration conflict replacement','$timestamp');"; fi
    for target_path in "${paths[@]}"; do sql+="INSERT INTO task_paths VALUES ('$(sql_quote "$task_id")','$(sql_quote "$target_path")');"; done
    for dependency_id in "${dependencies[@]}"; do sql+="INSERT INTO task_edges VALUES ('$(sql_quote "$dependency_id")','$(sql_quote "$task_id")','DEPENDENCY','explicit dependency','explicit','$timestamp');"; done
    for contract_id in "${provides_contracts[@]}"; do sql+="INSERT INTO task_contracts VALUES ('$(sql_quote "$task_id")','$(sql_quote "$contract_id")','PROVIDES');"; done
    for contract_id in "${consumes_contracts[@]}"; do sql+="INSERT INTO task_contracts VALUES ('$(sql_quote "$task_id")','$(sql_quote "$contract_id")','CONSUMES');"; done
    sql+="COMMIT;"
    if ! sqlite3 "$db" "$sql"; then
      /bin/rm -rf "$CREATED_ARTIFACT_DIR"
      print -u2 '登録transactionに失敗しました。Taskは作成していません。'
      exit 1
    fi
    if ! "$0" -C "$project_root" graph refresh >/dev/null 2>&1; then
      rollback_sql="BEGIN;
        DELETE FROM task_edges WHERE source_task_id='$(sql_quote "$task_id")' OR target_task_id='$(sql_quote "$task_id")';
        DELETE FROM task_preparations WHERE task_id='$(sql_quote "$task_id")';
        DELETE FROM task_supersessions WHERE replacement_task_id='$(sql_quote "$task_id")';
        DELETE FROM task_contracts WHERE task_id='$(sql_quote "$task_id")';
        DELETE FROM task_paths WHERE task_id='$(sql_quote "$task_id")';
        DELETE FROM task_artifacts WHERE task_id='$(sql_quote "$task_id")';
        DELETE FROM change_set_tasks WHERE task_id='$(sql_quote "$task_id")';
        DELETE FROM registrations WHERE registration_id='$(sql_quote "$registration_id")';
        DELETE FROM tasks WHERE task_id='$(sql_quote "$task_id")';"
      rollback_sql+="DELETE FROM task_schedule WHERE task_id='$(sql_quote "$task_id")';"
      if (( create_change_set )); then
        rollback_sql+="DELETE FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")';"
      else
        rollback_sql+="UPDATE change_sets SET membership_revision=$current_membership_revision,updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")';"
      fi
      rollback_sql+="COMMIT;"
      sqlite3 "$db" "$rollback_sql"
      /bin/rm -rf "$CREATED_ARTIFACT_DIR"
      "$0" -C "$project_root" graph refresh >/dev/null 2>&1 || true
      registration_decision "$registration_id" "$mode" "$text" "$source_hash" DEPENDENCY_CYCLE_OR_GRAPH_INVALID
      exit 3
    fi
    event task "$task_id" REGISTERED "$mode"
    if [[ "$member_kind" == implementation ]]; then
      # path非重複でも意味的依存があり得るため、親の要約比較前には既存Taskを開始しない。
      sqlite3 "$db" "UPDATE task_schedule SET assessed_plan_hash='' WHERE task_id IN (SELECT task_id FROM tasks WHERE state IN ('REGISTERED','READY'));"
    fi
    event changeset "$change_set_id" MEMBER_ADDED "$task_id@$membership_revision"
    if [[ "$member_kind" == implementation && "${COUNTERPOINTER_TEST:-0}" != 1 ]]; then
      notify_parent_agent "Counterpointer通知: 新規Task ${task_id[1,12]}を登録しました。schedule contextで既存Taskを確認し、依存・競合の分析をschedule assessへ記録してください。登録だけでは実行しません。"
    fi
    print "$task_id"
    ;;
  schedule)
    schedule_action="${1:-status}"; shift || true
    case "$schedule_action" in
      context)
        jq -n --arg context_hash "$(schedule_context_hash)" \
          --argjson tasks "$(sqlite_json "SELECT t.task_id,t.state,substr(t.source_text,1,500) summary,a.execution_plan_hash,a.artifact_dir,s.urgency,s.due_at,s.hold_reason,(s.assessed_plan_hash=a.execution_plan_hash) assessed FROM tasks t JOIN task_artifacts a ON a.task_id=t.task_id JOIN task_schedule s ON s.task_id=t.task_id WHERE t.state<>'CANCELLED' ORDER BY s.position,t.rowid;")" \
          --argjson paths "$(sqlite_json 'SELECT * FROM task_paths;')" \
          --argjson contracts "$(sqlite_json 'SELECT * FROM task_contracts;')" \
          '{context_hash:$context_hash,tasks:$tasks,paths:$paths,contracts:$contracts}'
        ;;
      pause|resume)
        paused=0; [[ "$schedule_action" != pause ]] || paused=1
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('scheduler_paused','$paused') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        event schedule project "$schedule_action" '実行中Taskは継続'
        if (( paused )); then print '新規開始を停止しました。実行中Taskは継続します。'; else print '実行待ちTaskの自動開始を再開しました。'; fi
        ;;
      status)
        sqlite3 -header -column "$db" "SELECT substr(t.task_id,1,12) task,t.state,s.urgency,s.due_at,s.position,s.hold_reason,s.assessment_reason FROM tasks t JOIN task_schedule s ON s.task_id=t.task_id WHERE t.state IN ('REGISTERED','READY','RUNNING','VERIFYING','CLAIMED_DONE') ORDER BY s.position;"
        ;;
      relation)
        source_id="$(resolve_task_id "${1:-}")"; target_id="$(resolve_task_id "${2:-}")"; relation="${3:-}"; reason="${4:-}"
        [[ "$source_id" != "$target_id" && -n "$reason" && ( "$relation" == DEPENDENCY || "$relation" == CONFLICT || "$relation" == UNCERTAIN ) ]] || { print -u2 '使い方: cpt schedule relation <先行ID> <後続ID> DEPENDENCY|CONFLICT|UNCERTAIN <根拠>'; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM task_relations WHERE source_task_id='$source_id' AND target_task_id='$target_id';")" == 0 ]] || { print -u2 '既存関係はschedule forgetで根拠を確認してから更新してください'; exit 2; }
        sqlite3 "$db" "INSERT INTO task_relations SELECT '$source_id','$target_id','$relation','$(sql_quote "$reason")',s.execution_plan_hash,t.execution_plan_hash FROM task_artifacts s,task_artifacts t WHERE s.task_id='$source_id' AND t.task_id='$target_id';"
        if ! "$0" -C "$project_root" graph refresh >/dev/null; then
          sqlite3 "$db" "DELETE FROM task_relations WHERE source_task_id='$source_id' AND target_task_id='$target_id';"
          "$0" -C "$project_root" graph refresh >/dev/null
          print -u2 '循環を生む関係は適用しませんでした'; exit 3
        fi
        event schedule "$target_id" RELATION "$source_id $relation $reason"
        sqlite3 "$db" "UPDATE task_schedule SET assessed_plan_hash='' WHERE task_id IN ('$source_id','$target_id');"
        ;;
      forget)
        source_id="$(resolve_task_id "${1:-}")"; target_id="$(resolve_task_id "${2:-}")"; reason="${3:-}"
        [[ -n "$reason" ]] || { print -u2 '関係を解除する根拠が必要です'; exit 2; }
        sqlite3 "$db" "DELETE FROM task_relations WHERE source_task_id='$source_id' AND target_task_id='$target_id'; UPDATE task_schedule SET assessed_plan_hash='' WHERE task_id IN ('$source_id','$target_id');"
        "$0" -C "$project_root" graph refresh >/dev/null
        event schedule "$target_id" RELATION_REMOVED "$source_id $reason"
        ;;
      assess)
        task_id="$(resolve_task_id "${1:-}")"; supplied_context="${2:-}"; reason="${3:-}"
        [[ -n "$reason" && "$supplied_context" == "$(schedule_context_hash)" ]] || { print -u2 '最新のschedule contextのhashと分析根拠が必要です'; exit 3; }
        sqlite3 "$db" "UPDATE task_schedule SET assessed_plan_hash=(SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$task_id'),assessment_reason='$(sql_quote "$reason")',assessment_context_hash='$(sql_quote "$supplied_context")' WHERE task_id='$task_id';"
        event schedule "$task_id" ASSESSED "$reason"
        ;;
      priority)
        task_id="$(resolve_task_id "${1:-}")"; urgency="${2:-}"
        due_at="${3-$(sqlite3 "$db" "SELECT COALESCE(due_at,'') FROM task_schedule WHERE task_id='$task_id';")}"
        [[ "$due_at" != none ]] || due_at=""
        validate_schedule_priority "$urgency" "$due_at" || exit $?
        sqlite3 "$db" "UPDATE task_schedule SET urgency=$SCHEDULE_URGENCY,due_at=NULLIF('$(sql_quote "$due_at")','') WHERE task_id='$task_id';"
        "$0" -C "$project_root" graph refresh >/dev/null
        event schedule "$task_id" PRIORITY "$urgency $due_at"
        ;;
      hold|release|withdraw)
        task_id="$(resolve_task_id "${1:-}")"; reason="${2:-}"
        if [[ "$schedule_action" == withdraw ]]; then
          [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == READY ]] || { print -u2 '実行待ちTaskだけを登録済みに戻せます'; exit 2; }
          sqlite3 "$db" "UPDATE tasks SET state='REGISTERED',updated_at='$(now)' WHERE task_id='$task_id' AND state='READY';"
        else
          [[ -n "$reason" ]] || { print -u2 '保留・解除の根拠が必要です'; exit 2; }
          hold_reason="$reason"; [[ "$schedule_action" != release ]] || hold_reason=""
          sqlite3 "$db" "UPDATE task_schedule SET hold_reason='$(sql_quote "$hold_reason")' WHERE task_id='$task_id';"
        fi
        "$0" -C "$project_root" graph refresh >/dev/null
        event schedule "$task_id" "$schedule_action" "$reason"
        ;;
      replan)
        task_id="$(resolve_task_id "${1:-}")"; plan_file="${2:-}"
        [[ -s "$plan_file" ]] || { print -u2 '新しい計画ファイルが必要です'; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE task_id='$task_id' AND state IN ('REGISTERED','READY') AND worktree IS NULL;")" == 1 ]] || { print -u2 '未着手Taskだけを再計画できます。実行済み成果は別途再計画が必要です'; exit 2; }
        revision_dir="$state_root/task-revisions/$task_id/$(uuidgen)"
        mkdir -p "$revision_dir"
        cp -R "$state_root/tasks/$task_id" "$revision_dir/artifacts"
        cp "$plan_file" "$revision_dir/proposed-plan.md"
        text="$(<"$revision_dir/proposed-plan.md")"
        create_task_artifacts "$task_id" detailed "$text" "$revision_dir/proposed-plan.md"
        sqlite3 "$db" "BEGIN; UPDATE tasks SET state='REGISTERED',mode='detailed',source_text='$(sql_quote "$text")',updated_at='$(now)' WHERE task_id='$task_id'; UPDATE task_artifacts SET goal_hash='$CREATED_GOAL_HASH',execution_plan_hash='$CREATED_PLAN_HASH' WHERE task_id='$task_id'; UPDATE task_schedule SET assessed_plan_hash='' WHERE task_id IN (SELECT task_id FROM tasks WHERE state IN ('REGISTERED','READY')); UPDATE task_schedule SET hold_reason='計画変更のオーナー確認待ち' WHERE task_id='$task_id'; UPDATE registrations SET registration_mode='detailed',source_text='$(sql_quote "$text")',source_hash='$(text_sha256 "$text")',plan_hash='$CREATED_PLAN_HASH',confirmed_plan_hash=NULL,status='NEEDS_DECISION',reason_code='PLAN_CONFIRMATION_REQUIRED' WHERE task_id='$task_id'; COMMIT;"
        "$0" -C "$project_root" graph refresh >/dev/null
        notify_parent_agent "Counterpointer通知: Task ${task_id[1,12]}の計画変更で実行許可を撤回しました。オーナー確認とschedule contextによる関係の再分析が必要です。"
        event schedule "$task_id" REPLANNED "$revision_dir $CREATED_PLAN_HASH"
        print "登録済みに戻しました。確認対象hash: $CREATED_PLAN_HASH"
        ;;
      confirm)
        task_id="$(resolve_task_id "${1:-}")"; confirmed_hash="${2:-}"
        [[ -n "$confirmed_hash" && "$confirmed_hash" == "$(file_sha256 "$state_root/tasks/$task_id/execution-plan.md")" ]] || { print -u2 '確認済み計画のhashが一致しません'; exit 3; }
        sqlite3 "$db" "UPDATE registrations SET confirmed_plan_hash='$confirmed_hash',status='REGISTERED',reason_code=NULL WHERE task_id='$task_id' AND plan_hash='$confirmed_hash'; UPDATE task_schedule SET hold_reason='' WHERE task_id='$task_id' AND hold_reason='計画変更のオーナー確認待ち';"
        event schedule "$task_id" PLAN_CONFIRMED "$confirmed_hash"
        print '計画確認を記録しました。実行許可は別途queueで指定してください。'
        ;;
      *) print -u2 '使い方: cpt schedule context|status|pause|resume|priority|relation|forget|assess|hold|release|withdraw|replan|confirm'; exit 2;;
    esac
    ;;
  queue)
    queue_target="${1:-}"
    [[ -n "$queue_target" ]] || { print -u2 'タスクIDまたは--allが必要です'; exit 2; }
    timestamp="$(now)"
    if [[ "$queue_target" == --all ]]; then
      queue_filter="state='REGISTERED' AND task_id IN (SELECT task_id FROM registrations WHERE status='REGISTERED' AND confirmed_plan_hash=plan_hash)"
      queued_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE $queue_filter;")"
      sqlite3 "$db" "UPDATE tasks SET state='READY',updated_at='$timestamp' WHERE $queue_filter;"
      "$0" -C "$project_root" graph refresh >/dev/null
      event project "$project_root" TASKS_QUEUED "count=$queued_count"
      print "実行待ちへ移しました: ${queued_count}件（監視が条件を満たすTaskから開始します）"
      exit 0
    fi
    queue_target="$(resolve_task_id "$queue_target")" || exit $?
    queue_state="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM tasks WHERE task_id='$(sql_quote "$queue_target")';")"
    [[ "$queue_state" == REGISTERED ]] || { print -u2 "登録済みTaskだけを実行待ちへ移せます: ${queue_state:-未登録}"; exit 2; }
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM registrations WHERE task_id='$queue_target' AND status='REGISTERED' AND confirmed_plan_hash=plan_hash;")" == 1 ]] || { print -u2 '計画の確認が完了していません'; exit 3; }
    sqlite3 "$db" "UPDATE tasks SET state='READY',updated_at='$timestamp' WHERE task_id='$(sql_quote "$queue_target")' AND state='REGISTERED';"
    "$0" -C "$project_root" graph refresh >/dev/null
    event task "$queue_target" QUEUED 'owner requested ready state'
    print "実行待ちへ移しました: $queue_target（監視が条件を満たせば開始します）"
    ;;
  dispatch)
    task_id="${1:-}"
    dispatch_include_retries=0
    if [[ "$task_id" == --all && "${2:-}" == --include-retries ]]; then
      dispatch_include_retries=1
    elif [[ -n "${2:-}" ]]; then
      print -u2 "不明なdispatchオプションです: $2"
      exit 2
    fi
    automatic_dispatch=0
    if [[ "$task_id" == --automatic ]]; then
      [[ "$(sed -n 's/^state=//p' "$state_root/service.state" 2>/dev/null || true)" != STOPPED ]] || exit 0
      [[ "$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='scheduler_paused'),'0');")" != 1 ]] || exit 0
      automatic_dispatch=1; task_id=--all; dispatch_include_retries=1
    fi
    [[ "$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='scheduler_paused'),'0');")" != 1 ]] || { print -u2 '新規開始は全体停止中です。schedule resumeで解除してください'; exit 4; }
    ensure_capacity dispatch
    if [[ "$(sqlite3 "$db" "SELECT COALESCE(value,'0') FROM metadata WHERE key='index_enforcement';")" == 1 ]]; then
      active_index_source="$(sqlite3 "$db" 'SELECT COALESCE(source_sha,"") FROM index_revisions ORDER BY revision DESC LIMIT 1;')"
      [[ -n "$active_index_source" ]] || { print -u2 '索引・SSOT整理が確認待ちです。cpt index apply <提案ID>を実行してください'; exit 3; }
      [[ "$active_index_source" == "$(git -C "$project_root" rev-parse HEAD 2>/dev/null)" ]] || { print -u2 '索引作成後に基準commitが変わりました。cpt index refreshで更新提案を確認してください'; exit 3; }
    fi
    if ! "$0" -C "$project_root" doctor --profile phase1-attended --quick >/dev/null; then
      print -u2 "dispatchを中止しました: doctorに失敗しました"
      exit 2
    fi
    if [[ "$task_id" == "--all" ]]; then
      dispatch_scope="$task_id"
      "$0" -C "$project_root" graph refresh >/dev/null || { print -u2 "依存グラフが不正なためdispatchを停止しました"; exit 3; }
      limit="$(sqlite3 "$db" "SELECT COALESCE(value,'2') FROM metadata WHERE key='max_parallel_tasks';")"
      [[ -n "$limit" ]] || limit=2
      running="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state IN ('RUNNING','CLAIMED_DONE','VERIFYING');")"
      slots=$((limit-running))
      (( slots > 0 )) || exit 0
      if [[ "$dispatch_include_retries" == 0 ]]; then
        candidate_sql="SELECT t.task_id FROM tasks t JOIN task_schedule s ON s.task_id=t.task_id WHERE t.state='READY' AND NOT EXISTS (SELECT 1 FROM task_retry_requests r WHERE r.task_id=t.task_id AND r.state='QUEUED') ORDER BY s.position;"
      else
        candidate_sql="SELECT t.task_id FROM tasks t JOIN task_schedule s ON s.task_id=t.task_id WHERE t.state='READY' ORDER BY s.position;"
      fi
      assigned_count=0
      blocked_count=0
      while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        (( slots > 0 )) || break
        if ! task_predecessors_complete "$candidate"; then
          blocker_summary="$(task_blockers "$candidate")"
          print "保留 ${candidate[1,12]}: 先行・競合Task待ち ${blocker_summary}"
          blocked_count=$((blocked_count+1))
          continue
        fi
        if "$0" -C "$project_root" dispatch "$candidate" >/dev/null; then
          assigned_count=$((assigned_count+1)); (( slots-- ))
        else
          blocked_count=$((blocked_count+1))
        fi
      done < <(sqlite3 "$db" "$candidate_sql")
      print "割当結果: 開始=${assigned_count}件 保留=${blocked_count}件（並列上限=${limit}）"
      exit 0
    fi
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    sqlite3 "$db" "UPDATE tasks SET state='READY',updated_at='$(now)' WHERE task_id='$task_id' AND state='REGISTERED' AND task_id IN (SELECT task_id FROM registrations WHERE status='REGISTERED' AND confirmed_plan_hash=plan_hash);"
    "$0" -C "$project_root" graph refresh >/dev/null || { print -u2 "依存グラフが不正なためdispatchを停止しました"; exit 3; }
    if ! task_predecessors_complete "$task_id"; then
      print -u2 "先行Taskの完了待ちです: $task_id"
      task_blockers "$task_id" >&2
      exit 4
    fi
    limit="$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='max_parallel_tasks'),'2');")"
    running="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state IN ('RUNNING','CLAIMED_DONE','VERIFYING');")"
    (( running < limit )) || { print -u2 '並列実行枠の空き待ちです'; exit 4; }
    task_dir="$state_root/worktrees/$task_id"
    mkdir -p "$state_root/worktrees"
    if [[ ! -d "$project_root/.git" ]]; then
      print -u2 "dispatchにはGitリポジトリが必要です: $project_root"
      exit 2
    fi
    if ! git -C "$project_root" rev-parse --verify HEAD >/dev/null 2>&1; then
      print -u2 "dispatchには初回Gitコミットが必要です。先に基準状態を確認・コミットしてください"
      exit 2
    fi
    current="$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")"
    [[ "$current" == REGISTERED || "$current" == READY ]] || { print -u2 "このタスクはdispatchできません: $current"; exit 2; }
    retry_request_state="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM task_retry_requests WHERE task_id='$(sql_quote "$task_id")';")"
    if [[ "$current" == READY && "$retry_request_state" == QUEUED ]]; then
      [[ -d "$task_dir" ]] || { print -u2 "再試行用worktreeが見つかりません: $task_dir"; exit 2; }
      timestamp="$(now)"
      sqlite3 "$db" "BEGIN; UPDATE tasks SET state='RUNNING',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state='READY'; UPDATE task_retry_requests SET state='DISPATCHED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state='QUEUED'; COMMIT;"
      [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == RUNNING ]] || exit 1
      event task "$task_id" RETRY_DISPATCHED "$task_dir"
      print "$task_dir"
      # 旧versionから継続中のsupervisorでも、新CLIのdispatchを呼べば
      # retry runtimeまで起動できる。判定済みなので並列制御は迂回しない。
      if [[ "$(sed -n 's/^state=//p' "$state_root/service.state" 2>/dev/null || true)" == RUNNING ]]; then
        "$0" -C "$project_root" run "$task_id"
      fi
      exit 0
    fi
    if [[ -e "$task_dir" ]]; then
      print -u2 "worktreeは既に存在します: $task_dir"
      exit 2
    fi
    dispatch_base_sha="$(sqlite3 "$db" "SELECT COALESCE(dispatch_base_sha,'') FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
    [[ -n "$dispatch_base_sha" ]] || dispatch_base_sha="$(git -C "$project_root" rev-parse HEAD)"
    git -C "$project_root" worktree add --detach "$task_dir" "$dispatch_base_sha" >/dev/null
    if [[ "$(sqlite3 "$db" "SELECT member_kind FROM change_set_tasks WHERE task_id='$task_id';")" == implementation ]]; then
      while IFS='|' read -r dependency_task dependency_commit; do
        [[ -n "$dependency_commit" ]] || continue
        git -C "$task_dir" merge-base --is-ancestor "$dependency_commit" HEAD 2>/dev/null && continue
        if ! git -C "$task_dir" cherry-pick --allow-empty "$dependency_commit" >/dev/null 2>&1; then
          git -C "$task_dir" cherry-pick --abort >/dev/null 2>&1 || true
          git -C "$project_root" worktree remove --force "$task_dir"
          sqlite3 "$db" "UPDATE task_schedule SET hold_reason='先行成果の引き継ぎ競合。親による再計画が必要' WHERE task_id='$task_id';"
          event task "$task_id" DEPENDENCY_PREPARATION_FAILED "$dependency_task"
          print -u2 '先行成果の引き継ぎに失敗したため保留しました'; exit 3
        fi
      done < <(sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (SELECT source_task_id,target_task_id FROM task_edges WHERE edge_type='DEPENDENCY' UNION SELECT r.src,e.target_task_id FROM reach r JOIN task_edges e ON e.source_task_id=r.dst WHERE e.edge_type='DEPENDENCY') SELECT DISTINCT t.task_id,t.commit_sha FROM reach r JOIN tasks t ON t.task_id=r.src JOIN change_set_tasks sm ON sm.task_id=t.task_id JOIN change_set_tasks tm ON tm.task_id=r.dst WHERE r.dst='$task_id' AND sm.change_set_id=tm.change_set_id AND t.state='VERIFIED' ORDER BY (SELECT COUNT(*) FROM reach ancestors WHERE ancestors.dst=t.task_id),t.rowid;")
      dispatch_base_sha="$(git -C "$task_dir" rev-parse HEAD)"
    fi
    sqlite3 "$db" "UPDATE tasks SET dispatch_base_sha='$(sql_quote "$dispatch_base_sha")' WHERE task_id='$(sql_quote "$task_id")';"
    preparation_sha="$(sqlite3 "$db" "SELECT COALESCE(cherry_pick_sha,'') FROM task_preparations WHERE task_id='$(sql_quote "$task_id")';")"
    if [[ -n "$preparation_sha" ]]; then
      if git -C "$task_dir" cherry-pick --allow-empty "$preparation_sha" >/dev/null 2>&1; then
        sqlite3 "$db" "UPDATE task_preparations SET preparation_state='APPLIED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")';"
      elif [[ -n "$(git -C "$task_dir" diff --name-only --diff-filter=U)" ]]; then
        sqlite3 "$db" "UPDATE task_preparations SET preparation_state='CONFLICT_READY',detail='conflict reproduced in worktree',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")';"
      else
        git -C "$task_dir" cherry-pick --abort >/dev/null 2>&1 || true
        sqlite3 "$db" "BEGIN; UPDATE task_preparations SET preparation_state='FAILED',detail='cherry-pick preparation failed without conflict',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")'; UPDATE tasks SET state='FAILED',worktree='$(sql_quote "$task_dir")',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")'; COMMIT;"
        print -u2 "統合競合の再現準備に失敗しました: $task_id"
        exit 2
      fi
    fi
    task_text="$(sqlite3 "$db" "SELECT source_text FROM tasks WHERE task_id='$task_id';")"
    artifact_dir="$(sqlite3 "$db" "SELECT artifact_dir FROM task_artifacts WHERE task_id='$task_id';")"
    [[ -n "$artifact_dir" && -s "$artifact_dir/goal.md" && -s "$artifact_dir/execution-plan.md" ]] || {
      git -C "$project_root" worktree remove --force "$task_dir"
      print -u2 "登録時のゴール／実行計画が見つかりません: $task_id"
      exit 2
    }
    expected_goal_hash="$(sqlite3 "$db" "SELECT goal_hash FROM task_artifacts WHERE task_id='$task_id';")"
    expected_plan_hash="$(sqlite3 "$db" "SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$task_id';")"
    [[ "$(file_sha256 "$artifact_dir/goal.md")" == "$expected_goal_hash" && "$(file_sha256 "$artifact_dir/execution-plan.md")" == "$expected_plan_hash" ]] || {
      git -C "$project_root" worktree remove --force "$task_dir"
      sqlite3 "$db" "UPDATE tasks SET state='REGISTERED',dispatch_base_sha=NULL WHERE task_id='$task_id'; UPDATE task_schedule SET assessed_plan_hash='',hold_reason='計画の改変を検知。再計画と確認が必要' WHERE task_id='$task_id';"
      print -u2 "登録後にゴール／実行計画が変更されたためdispatchを停止しました: $task_id"
      exit 2
    }
    mkdir -p "$task_dir/.counterpointer-task"
    /bin/cp "$artifact_dir/execution-plan.md" "$task_dir/.counterpointer-task/execution-plan.md"
    /bin/cp "$artifact_dir/goal.md" "$task_dir/.counterpointer-task/goal.md"
    if [[ -s "$state_root/context/project-core.md" ]]; then
      /bin/cp "$state_root/context/project-core.md" "$task_dir/.counterpointer-task/project-core.md"
      active_index_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
      {
        print '# Task Context Capsule'
        print ''
        print "index_revision=$active_index_revision"
        print '## 対象pathに関係する索引'
        while IFS= read -r target_path; do
          sqlite3 "$db" "SELECT '- ' || entry_id || ' ' || path || ' sha256=' || content_hash FROM index_entries WHERE proposal_id=(SELECT proposal_id FROM index_revisions WHERE revision=$active_index_revision) AND (path='$(sql_quote "$target_path")' OR path LIKE '$(sql_quote "${target_path%/}")/%' OR '$(sql_quote "${target_path%/}")' LIKE path || '/%') ORDER BY entry_id;"
        done < <(sqlite3 "$db" "SELECT path FROM task_paths WHERE task_id='$(sql_quote "$task_id")' ORDER BY path;")
        print ''
        print '上記ID・path・hashを参照し、本文は必要になったものだけfilesystemから読んでください。'
      } > "$task_dir/.counterpointer-task/task-context.md"
    fi
    {
      print ''
      print '## Counterpointer実行契約'
      print ''
      print -r -- "- このworktreeの外を変更しない。"
      print -r -- '- commit、push、PR作成を行わない。'
      print -r -- "- 実装と検証完了後に実行する: cpt -C \"$project_root\" selfcheck \"$task_id\""
      print -r -- '- 文章報告だけで停止せず、selfcheckを親への完了信号とする。'
      print -r -- '- selfcheck合格は最終成功ではなく親検証待ちである。利用者には「子作業完了・親検証待ち」と報告し、「Task完了」「検証完了」と断定しない。'
    } > "$task_dir/.counterpointer-task/execution-contract.md"
    if [[ -n "$preparation_sha" ]]; then
      {
        print '# 統合競合の修復情報'
        print ''
        print "置換対象commit: $preparation_sha"
        print 'worktreeには競合状態が再現されています。競合を解消してgit addし、通常のselfcheckを実行してください。'
      } > "$task_dir/.counterpointer-task/integration-context.md"
    fi
    timestamp="$(now)"
    sqlite3 "$db" "UPDATE tasks SET state='RUNNING', worktree='$(print -r -- "$task_dir" | sed "s/'/''/g")', updated_at='$timestamp' WHERE task_id='$task_id' AND state IN ('REGISTERED','READY');"
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == RUNNING ]] || { git -C "$project_root" worktree remove --force "$task_dir"; exit 1; }
    print "$task_dir"
    event task "$task_id" RUNNING "$task_dir"
    ;;
  run)
    task_id="${1:-}"
    shift || true
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    launch_mode=INITIAL
    requested_resume_attempts=""
    requested_restart_attempts=""
    while (( $# )); do
      case "$1" in
        --resume) launch_mode=RESUME; shift;;
        --restart) launch_mode=RESTART; shift;;
        --resume-attempts) requested_resume_attempts="$2"; shift 2;;
        --restart-attempts) requested_restart_attempts="$2"; shift 2;;
        *) print -u2 "不明なrunオプションです: $1"; exit 2;;
      esac
    done
    queued_retry_mode="$(sqlite3 "$db" "SELECT COALESCE(launch_mode,'') FROM task_retry_requests WHERE task_id='$(sql_quote "$task_id")' AND state='DISPATCHED';")"
    if [[ "$launch_mode" == INITIAL && "$queued_retry_mode" == RESUME ]]; then
      launch_mode=RESUME
      requested_resume_attempts=0
      requested_restart_attempts=0
    elif [[ "$launch_mode" == INITIAL && "$queued_retry_mode" == RESTART ]]; then
      launch_mode=RESTART
      requested_resume_attempts=0
      requested_restart_attempts=0
    fi
    row="$(sqlite3 "$db" "SELECT state,worktree,source_text FROM tasks WHERE task_id='$task_id';")"
    state="${row%%|*}"; rest="${row#*|}"; worktree="${rest%%|*}"; prompt="${rest#*|}"
    [[ "$state" == RUNNING && -d "$worktree" ]] || { print -u2 "タスクはRUNNING状態かつworktreeが必要です"; exit 2; }
    if [[ "$launch_mode" == INITIAL ]] && runtime_is_active "$task_id"; then
      print -u2 "子sessionは既に起動中です: $task_id"
      exit 2
    fi
    assert_previous_runtimes_stopped "$task_id" || {
      event task "$task_id" SESSION_RESTART_BLOCKED '旧sessionの終了を証明できないためペイン作成を拒否'
      exit 3
    }
    if [[ -n "$(recovery_base "$task_id")" ]]; then
      check_recovery_context "$task_id" "$worktree" || { print -u2 '復旧Taskのworktree・基点・計画が一致しません'; exit 2; }
      [[ "$launch_mode" != RESUME ]] || { print -u2 '失効済みTaskは旧sessionを再開できません。--freshを使用してください'; exit 2; }
    fi
    previous_generation="$(latest_runtime_generation "$task_id")"
    previous_runtime="$(sqlite3 "$db" "SELECT logical_session_id,resume_attempts,restart_attempts FROM task_runtimes WHERE task_id='$(sql_quote "$task_id")' ORDER BY generation DESC LIMIT 1;")"
    previous_session="${previous_runtime%%|*}"
    previous_rest="${previous_runtime#*|}"
    previous_resume_attempts="${previous_rest%%|*}"
    previous_restart_attempts="${previous_rest#*|}"
    [[ "$previous_resume_attempts" == <-> ]] || previous_resume_attempts=0
    [[ "$previous_restart_attempts" == <-> ]] || previous_restart_attempts=0
    resume_attempts="${requested_resume_attempts:-$previous_resume_attempts}"
    restart_attempts="${requested_restart_attempts:-$previous_restart_attempts}"
    resume_codex_session=""
    if [[ "$launch_mode" == RESUME ]]; then
      resume_codex_session="$(codex_session_for_worktree "$worktree" || true)"
      if [[ -z "$resume_codex_session" ]]; then
        max_restart="$(sqlite3 "$db" "SELECT COALESCE(value,'1') FROM metadata WHERE key='max_session_restart_attempts';")"
        [[ "$max_restart" == <-> ]] || max_restart=1
        if (( restart_attempts >= max_restart )); then
          sqlite3 "$db" "UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING';"
          notify_parent_agent "Counterpointer通知: Task ${task_id[1,12]} のworktreeに一致するCodex sessionを確認できず、再起動上限に達しました。成果を保持して停止しました。"
          exit 3
        fi
        launch_mode=RESTART
        restart_attempts=$((restart_attempts+1))
        event task "$task_id" SESSION_RESUME_UNAVAILABLE 'No matching Codex session; starting bounded fresh session in the same worktree'
      fi
    fi
    generation=$((previous_generation+1))
    if [[ "$launch_mode" == RESUME && -n "$previous_session" ]]; then logical_session_id="$previous_session"; runtime_state=RESUMING
    elif [[ "$launch_mode" == RESTART ]]; then logical_session_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"; runtime_state=RESTARTING
    else logical_session_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"; runtime_state=STARTING
    fi
    runtime_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    timestamp="$(now)"
    # Preserve the prior handoff for the next generation, but never accept it
    # as the current generation's completion report.
    previous_report="$worktree/.counterpointer-task/completion-report.md"
    archived_report="$worktree/.counterpointer-task/completion-report-generation-$previous_generation.md"
    if [[ -s "$previous_report" ]]; then /bin/cp "$previous_report" "$archived_report"; fi
    # 前generationの完了印を新しい実行が誤って引き継がないようにする。
    /bin/rm -f "$worktree/.counterpointer-task/selfcheck.txt" "$worktree/.counterpointer-task/completion-report.md"
    sqlite3 "$db" "INSERT INTO task_runtimes(runtime_id,task_id,generation,logical_session_id,state,launch_mode,resume_attempts,restart_attempts,last_heartbeat_at,last_progress_at,created_at,updated_at) VALUES ('$runtime_id','$(sql_quote "$task_id")',$generation,'$logical_session_id','$runtime_state','$launch_mode',$resume_attempts,$restart_attempts,'$timestamp','$timestamp','$timestamp','$timestamp');"
    sqlite3 "$db" "DELETE FROM task_retry_requests WHERE task_id='$(sql_quote "$task_id")' AND state='DISPATCHED';"
    events_file="$worktree/.counterpointer-task/events-$generation.log"
    prompt_file="$worktree/.counterpointer-task/initial-prompt.md"
    prompt_parts=()
    [[ -s "$worktree/.counterpointer-task/project-core.md" ]] && prompt_parts+=("$worktree/.counterpointer-task/project-core.md")
    [[ -s "$worktree/.counterpointer-task/task-context.md" ]] && prompt_parts+=("$worktree/.counterpointer-task/task-context.md")
    prompt_parts+=("$worktree/.counterpointer-task/goal.md" "$worktree/.counterpointer-task/execution-plan.md" "$worktree/.counterpointer-task/execution-contract.md")
    /bin/cat "${prompt_parts[@]}" > "$prompt_file"
    if [[ -s "$archived_report" ]]; then
      {
        print ''; print "## 前世代の引継ぎ（generation $previous_generation）"
        print '以下は作業継続用の記録であり、今回の完了申告や検証合格ではありません。'
        /bin/cat "$archived_report"
      } >> "$prompt_file"
    fi
    print -r -- "{\"task_id\":\"$task_id\",\"runtime_id\":\"$runtime_id\",\"generation\":$generation,\"logical_session_id\":\"$logical_session_id\",\"started_at\":\"$timestamp\",\"mode\":\"$launch_mode\"}" > "$worktree/.counterpointer-task/run.json"
    if [[ -n "$(recovery_base "$task_id")" ]]; then
      {
        print ''; print '## 誤検証からの新規実行'
        print "今回の基点: $(recovery_base "$task_id")"
        print '過去の会話やarchivesの完了記録を現在の成果として扱わない。現在のworktreeで実装し、基点からの実装差分を確認する。差分が空なら完了申告せず停止して理由を報告する。'
        print '今回実行した検証の終了コード、差分一覧、受入条件との対応をcompletion-report.mdへ記録し、最後に指定されたselfcheckを今回の実行で行う。'
      } >> "$prompt_file"
    fi
    # Authorization belongs to the current runtime, not an old registration note.
    authorization_file="$worktree/.counterpointer-task/execution-authorization.md"
    {
      print '# 現在の実行許可'
      print "task=$task_id generation=$generation state=RUNNING"
      print "confirmed_plan_hash=$(sqlite3 "$db" "SELECT confirmed_plan_hash FROM registrations WHERE task_id='$(sql_quote "$task_id")';")"
      print 'このTaskは登録確認とは別の実行許可を経てRUNNINGへ割り当てられています。'
      print '登録時点の「実行許可なし」「REGISTERED維持」は、その後の実行許可を否定しません。'
      print '実行計画の範囲・受入条件・依存・保留・sandbox制限を変更する許可ではありません。'
      print '未解決の承認や検証環境の問題がある場合は具体的な理由を記録してください。'
    } > "$authorization_file"
    /bin/cat "$authorization_file" >> "$prompt_file"
    # Child work stays sandboxed and never opens an OS approval dialog.
    # Host-only checks are reported to the parent for separately authorized review.
    child_notify="$(jq -cn --arg cli "$launcher_path" --arg root "$project_root" --arg task "$task_id" --arg generation "$generation" \
      '[$cli,"-C",$root,"runtime","turn-complete",$task,$generation]')"
    child_notify_override="notify=$child_notify"
    child_policy="$worktree/.counterpointer-task/runtime-policy.md"
    {
      print '## CPTの検証・未完了時の引継ぎ'
      print 'workspace-writeを維持し、OS承認を求めない。権限外の検証は親へ対象・理由・残項目を報告する。'
      print 'ブラウザ検証は必ず.counterpointer-task/browser-verification.mdを読み、cpt browser経由でcmux内蔵ブラウザを使う。'
      print 'cmux socketがsandboxで拒否された場合だけ、CPT_BROWSER_BRIDGE=1を付けて同じcpt browser操作を再実行する。CPT監視プロセスがTask専用surfaceへの操作だけを中継し、任意のホストコマンドは受け付けない。'
      print 'Chrome/Chromium/OS既定ブラウザの直接起動、open URL、Playwright/Puppeteerのbrowser.launch()を標準経路にしない。外部ブラウザへの自動fallbackは禁止。'
      print 'HTTP listenのEPERMやネットワーク制限を同じ条件で反復しない。node <相対script>またはnpm run <固定名>による定型検証なら、operation,reason,remaining_checks,recipe:{mode:"once"|"server",argv:[...]}のJSONを作り、cpt permission request TASK JSON_FILEで記録する。監視がSQLiteへ取り込んだ後、所有者が承認した同じIDだけcpt permission run IDで実行する。未承認なら独立作業を進め、完了扱いにしない。その他はcpt blockedで残検証を引き継ぐ。'
      print 'この子の既定モデルはSol。部分作業のサブエージェントは明確で低リスクならLunaを選べる。理由をcompletion-report.mdへ記録し、同じ作業で上位モデルへの引継ぎは1回まで。要件・受入条件・料金/契約・破壊的操作・本番反映の未許可判断は親へ返す。'
      print '子の実装検証が未完了ならselfcheckしない。統合SHAでしか実施できない残検証だけの場合、実施済み証跡と残検証をcompletion-report.mdへ記録し、selfcheck TASK --implementation-onlyで親へ引き継ぐ。最終受入は親のintegration-verifyまで未完了。'
      print '仕様判断・実行許可の再確認は利用者へ直接質問せず、cpt question TASK JSON_FILEで親へ集約する。JSONはkind(specification/permission/environment),operation,reason,remaining_checks配列。質問登録後はcpt question wait IDで同じ子のまま回答を待つ。staleなら古い回答を使用しない。親回答をOS権限として流用しない。'
      print -r -- "実行を続けられない場合は cpt -C ${(q)project_root} blocked ${(q)task_id} '具体的な理由と残検証' を実行して親へ引き継ぐ。文章報告だけで停止しない。"
    } > "$child_policy"
    cat > "$worktree/.counterpointer-task/browser-verification.md" <<'BROWSER'
# CPTブラウザ検証契約

CPTの画面確認はcmux内蔵ブラウザが標準。CPTの実行中Taskにだけ適用する。ブラウザは右側の該当子ペイン内の別タブに置き、左の親ペインを分割しない。
Chrome実行ファイル、OSの既定ブラウザ、open/osascript、Playwright/Puppeteerのbrowser.launch()を直接起動しない。
既存E2Eスクリプトが外部ブラウザを起動する場合、そのまま実行しない。fixture／サーバーを再利用し、同じ操作・検証条件を下記の経路で確認する。

1. 対象アプリのローカルサーバーを起動し、HTTP応答を確認する。listen EPERMの場合は固定したNodeスクリプトと残検証をcpt permission requestへ記録する。承認前に別ポートや起動反復で権限制限を回避しない。
2. `cpt -C <project> browser <task-id> open http://127.0.0.1:<port>`。タスク専用surfaceを作成／再利用し、通常使っているブラウザを操作しない。
3. 以後はすべて同じ `cpt -C <project> browser <task-id>` に続けて操作する:
   - `wait --load-state complete --timeout-ms 15000`
   - `viewport 390 844` と `eval '({width:innerWidth,height:innerHeight})'` で実際の表示幅を確認
   - `snapshot --interactive`、`get text body`、`click <selector>`、`fill <selector> <text>`、`press Tab`
   - `eval '<DOMのassertion>'`、`console list`、`errors list`
   - `screenshot --out <worktree内の証跡path>`
4. 保存／再読込、表示・操作、横はみ出し、キーボード、指定幅、画像目視を実際に確認し、URL・viewport・操作・期待値・結果・証跡pathを記録する。スクリーンショット取得だけでE2E全条件を合格にしない。
5. cmux socketがsandboxで拒否された場合だけ、`CPT_BROWSER_BRIDGE=1 cpt -C <project> browser <task-id> ...`を使う。CPT監視プロセスがTask専用ブラウザ操作だけを中継する。中継も失敗したら親へ報告し、子からOS承認を求めず、外部Chromeへ切り替えない。
6. 画面検証が終わったら `cpt -C <project> browser <task-id> close` でTask専用ブラウザを閉じる。閉じられなかった場合は記録が残り、Task終了後に監視が再試行する。
6. 内蔵ブラウザで未対応の操作、特定Chromiumエンジンが必須の受入条件は未検証と明記し、`cpt blocked <task-id> '理由・必要な検証'`で親へ渡す。外部ブラウザが必要なら、理由と実行方法を具体化して別途判断する。

この手順は実ブラウザ検証用。HTTP/DB結合検証や静的buildの合格を代替しない。
参考: https://cmux.com/docs/browser-automation （実機の `cmux browser --help` を優先）
BROWSER
    /bin/cat "$child_policy" >> "$prompt_file"
    prompt_bytes="$(wc -c < "$prompt_file" | tr -d ' ')"
    estimated_tokens=$(( (prompt_bytes + 3) / 4 ))
    sqlite3 "$db" "INSERT INTO usage_metrics VALUES ('$(uuidgen | tr '[:upper:]' '[:lower:]')','task','$task_id','child',NULL,NULL,NULL,$estimated_tokens,$prompt_bytes,'estimate','$(now)');"
    child_model="$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='child_model:$(sql_quote "$task_id")'),'gpt-6-sol');")"
    case "$child_model" in gpt-6-sol|gpt-6-luna|gpt-6-astra) ;; *) print -u2 '子モデル設定が不正です'; exit 3;; esac
    launcher_file="$worktree/.counterpointer-task/launch-$generation.zsh"
    if [[ "$launch_mode" == RESUME ]]; then
      codex_invocation="codex resume ${(q)resume_codex_session} --model ${(q)child_model} --ask-for-approval never --sandbox workspace-write -c ${(q)child_notify_override} -C ${(q)worktree} 'Counterpointerによる自動再開です。最初に.counterpointer-task/execution-authorization.mdと.counterpointer-task/runtime-policy.mdを読み、現在の実行許可を確認して既存のゴールと実行計画を継続してください。未完了ならblockedで親へ通知し、実装と検証が完了した場合だけselfcheckしてください。'"
    else
      codex_invocation="codex --model ${(q)child_model} --ask-for-approval never --sandbox workspace-write -c ${(q)child_notify_override} -C ${(q)worktree} \"\$(/bin/cat ${(q)prompt_file})\""
    fi
cat > "$launcher_file" <<EOF
#!/bin/zsh
set +e
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE GH_TOKEN GITHUB_TOKEN CLOUDFLARE_API_TOKEN NPM_TOKEN
${(q)launcher_path} -C ${(q)project_root} runtime started ${(q)task_id} $generation \$\$ || exit \$?
cd -- ${(q)worktree} || exit 3
script -q ${(q)events_file} $codex_invocation
runtime_exit_code=\$?
${(q)launcher_path} -C ${(q)project_root} runtime exited ${(q)task_id} $generation \$runtime_exit_code
exit \$runtime_exit_code
EOF
    chmod 700 "$launcher_file"
    # cmuxのcommand parserが先頭slashをcommand markerとして扱う版でも
    # `/bin/zsh` が `bin/zsh` へ崩れないよう、execを先頭に置く。
    command_text="exec /bin/zsh ${(q)launcher_file}"
    event runtime "$runtime_id" LAUNCH_REQUESTED "$launch_mode generation=$generation"
    if [[ "${COUNTERPOINTER_DRY_RUN:-0}" == 1 || "${COUNTERPOINTER_RUNTIME_TEST:-0}" == 1 ]]; then
      print "$command_text"
      exit 0
    fi
    if [[ -s "$state_root/orchestrator.workspace" ]]; then
      parent_workspace="$(<"$state_root/orchestrator.workspace")"
      parent_ref="$(normalize_cmux_ref workspace "$parent_workspace")"
      if [[ -n "$parent_ref" ]]; then
        parent_surface=""
        [[ ! -s "$state_root/orchestrator.parent-surface" ]] || parent_surface="$(normalize_cmux_ref surface "$(<"$state_root/orchestrator.parent-surface")")"
        [[ -n "$parent_surface" ]] || parent_surface="$(normalize_cmux_ref surface "$(sqlite3 "$db" "SELECT COALESCE(pane_ref,'') FROM parent_runtimes WHERE state='ACTIVE' ORDER BY generation DESC LIMIT 1;")")"
        split_target="$parent_surface"
        split_direction=right
        if [[ -s "$state_root/orchestrator.last-child-surface" ]]; then
          last_child_surface="$(normalize_cmux_ref surface "$(<"$state_root/orchestrator.last-child-surface")")"
          if cmux tree --workspace "$parent_ref" --json 2>/dev/null | /usr/bin/grep -Fq "$last_child_surface"; then
            split_target="$last_child_surface"
            split_direction=down
          else
            /bin/rm -f "$state_root/orchestrator.last-child-surface"
          fi
        fi
        child_pane=""; child_ref=""; child_surface=""
        if [[ -n "$split_target" ]]; then
          child_layout_error="$state_root/tasks/$task_id/cmux-layout-generation-$generation.stderr"
          child_layout_exit=0
          : > "$child_layout_error"
          layout_json="$(cmux tree --workspace "$parent_ref" --json 2>/dev/null || true)"
          visible_panes="$(print -r -- "$layout_json" | jq -r '[.. | objects | select((.surfaces? | type)=="array")] | length' 2>/dev/null || print 0)"
          initial_parent_pane=""
          if [[ "$split_direction" == right && "$visible_panes" == 1 ]]; then
            initial_parent_pane="$(browser_child_pane "$layout_json" "$parent_surface" 2>/dev/null || true)"
          fi
          if [[ "$split_direction" == down && "$visible_panes" == <-> && "$visible_panes" -ge 3 ]]; then
            child_ref="$(browser_child_pane "$layout_json" "$split_target")" || child_layout_exit=$?
            if (( child_layout_exit == 0 )); then
              child_pane="$(cmux --json new-surface --type terminal --pane "$child_ref" --workspace "$parent_ref" --focus false 2>"$child_layout_error")" || child_layout_exit=$?
              if (( child_layout_exit == 0 )); then
                child_surface="$(print -r -- "$child_pane" | jq -r '.surface_ref // .surface_id // empty')"
              fi
            fi
          else
            child_pane="$(cmux new-split "$split_direction" --workspace "$parent_ref" --surface "$split_target" --focus false 2>"$child_layout_error")" || child_layout_exit=$?
          fi
          chmod 600 "$child_layout_error"
          if (( child_layout_exit != 0 )); then
            event task "$task_id" CHILD_LAYOUT_COMMAND_FAILED "exit=$child_layout_exit stderr=$child_layout_error"
            child_pane=""
          fi
        fi
        [[ -n "$child_ref" ]] || child_ref="$(print -r -- "$child_pane" | sed -n 's/.*\(pane:[^ ]*\).*/\1/p')"
        # cmuxのversionによりnew-splitの返値はpane refまたはsurface ref。
        # surfaceが直接返った場合は追加探索せず、そのまま送信先に使う。
        [[ -n "$child_surface" ]] || child_surface="$(print -r -- "$child_pane" | sed -n 's/.*\(surface:[^ ]*\).*/\1/p')"
        if [[ -z "$child_surface" && -n "$child_ref" ]]; then
          child_surfaces="$(cmux list-pane-surfaces --workspace "$parent_ref" --pane "$child_ref" 2>/dev/null || true)"
          child_surface="$(print -r -- "$child_surfaces" | sed -n 's/.*\(surface:[^ ]*\).*/\1/p' | sed -n '1p')"
          [[ -n "$child_surface" ]] || child_surface="$(print -r -- "$child_surfaces" | sed -n '1s/^[[:space:]]*\([^[:space:]]*\).*$/\1/p')"
        fi
        if [[ -n "${child_surface:-}" ]]; then
          if [[ "$split_direction" == right && -n "$initial_parent_pane" ]]; then
            if ! size_initial_parent_pane "$parent_ref" "$initial_parent_pane"; then
              event task "$task_id" PARENT_PANE_RESIZE_FAILED "workspace=$parent_ref pane=$initial_parent_pane"
            fi
          fi
          sqlite3 "$db" "UPDATE task_runtimes SET workspace_ref='$(sql_quote "$parent_ref")',pane_ref='$(sql_quote "$child_ref")',updated_at='$(now)' WHERE runtime_id='$runtime_id';"
          print -r -- "$child_surface" > "$state_root/orchestrator.last-child-surface"
          jq -n --arg task "$task_id" --arg surface "$child_surface" --arg generation "$generation" --arg workspace "$parent_ref" \
            '{task_id:$task,surface:$surface,generation:$generation,workspace:$workspace}' > "$worktree/.counterpointer-task/child-surface.json"
          # respawn-paneは起動したcommandの終了まで待つcmux版があるため、
          # shellへ送信して即時returnする。長時間Taskをcpt CLIへ同期させない。
          cmux send --workspace "$parent_ref" --surface "$child_surface" "$command_text"
          cmux send-key --workspace "$parent_ref" --surface "$child_surface" enter
          if [[ "$split_direction" == right ]]; then
            print "完了 $child_ref（親の右側に子領域を作成）"
          else
            print "完了 $child_ref（右側の子領域へ上下追加）"
          fi
          exit 0
        fi
        # 親が存在するのに分割できなかった場合、別workspaceへ黙って逃がさない。
        # 配置不良を明示して停止し、ownerによる再試行を待つ。
        sqlite3 "$db" "BEGIN; UPDATE task_runtimes SET state='FAILED',exit_code=2,updated_at='$(now)' WHERE runtime_id='$runtime_id'; UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING'; COMMIT;"
        event task "$task_id" CHILD_LAYOUT_FAILED "parent=$parent_ref surface=$split_target output=$(print -r -- "$child_pane" | tr '\n' ' ')"
        print -u2 '子ペインを親の右側へ配置できなかったため停止しました。別workspaceでは起動していません。'
        exit 3
      fi
    fi
    child_workspace="$(cmux new-workspace --name "cpt-$task_id" --cwd "$worktree" --command "$command_text" --focus false)"
    child_workspace_ref="$(print -r -- "$child_workspace" | sed -n 's/.*\(workspace:[^ ]*\).*/\1/p')"
    sqlite3 "$db" "UPDATE task_runtimes SET workspace_ref='$(sql_quote "${child_workspace_ref:-$child_workspace}")',updated_at='$(now)' WHERE runtime_id='$runtime_id';"
    print "$child_workspace"
    ;;
  runtime)
    runtime_action="${1:-}"
    task_id="${2:-}"
    generation="${3:-}"
    [[ -n "$runtime_action" && -n "$task_id" && "$generation" == <-> ]] || { print -u2 "runtime引数が不正です"; exit 2; }
    case "$runtime_action" in
      turn-complete)
        report_payload="${4:-}"
        report_worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING';")"
        [[ -n "$report_worktree" && -d "$report_worktree/.counterpointer-task" ]] || exit 0
        [[ "$generation" == "$(latest_runtime_generation "$task_id")" ]] || exit 0
        # JSON is data, never a command. Ignore unrelated/invalid notifications.
        print -r -- "$report_payload" | jq -e --arg cwd "$report_worktree" \
          '.type=="agent-turn-complete" and .cwd==$cwd and (."last-assistant-message"|type)=="string"' >/dev/null 2>&1 || exit 0
        # Codex can emit a short JSON progress title during a live turn.
        # It is not the child's final report and must not create attention.
        if print -r -- "$report_payload" | jq -e \
          '."last-assistant-message" | fromjson? | type=="object" and (keys==["title"])' >/dev/null 2>&1; then
          exit 0
        fi
        report_file="$report_worktree/.counterpointer-task/turn-complete-$generation.json"
        report_tmp="$(mktemp "$report_file.XXXXXX")"
        print -r -- "$report_payload" | jq --arg task "$task_id" --arg generation "$generation" \
          '{task_id:$task,generation:$generation,reason:((."last-assistant-message" | .[0:2000]) | if length>0 then . else "完了申告なしで子の応答が終了しました" end)}' > "$report_tmp"
        /bin/mv "$report_tmp" "$report_file"
        ;;
      started)
        process_pid="${4:-}"
        [[ "$process_pid" == <-> ]] || { print -u2 "process PIDが不正です"; exit 2; }
        timestamp="$(now)"
        sqlite3 "$db" "UPDATE task_runtimes SET state='ACTIVE',process_pid=$process_pid,last_heartbeat_at='$timestamp',last_progress_at='$timestamp',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND generation=$generation AND state IN ('STARTING','RESUMING','RESTARTING');"
        [[ "$(sqlite3 "$db" "SELECT state FROM task_runtimes WHERE task_id='$(sql_quote "$task_id")' AND generation=$generation;")" == ACTIVE ]] || { print -u2 "古いruntime開始通知を拒否しました"; exit 3; }
        event task "$task_id" SESSION_ACTIVE "generation=$generation pid=$process_pid"
        ;;
      heartbeat)
        timestamp="$(now)"
        sqlite3 "$db" "UPDATE task_runtimes SET last_heartbeat_at='$timestamp',last_progress_at='$timestamp',health_probe_failures=0,updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND generation=$generation AND state='ACTIVE';"
        ;;
      exited)
        runtime_exit_code="${4:-1}"
        [[ "$runtime_exit_code" == <-> ]] || runtime_exit_code=1
        task_state="$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
        next_runtime_state=EXITED
        [[ "$task_state" != RUNNING ]] && next_runtime_state=COMPLETED
        timestamp="$(now)"
        sqlite3 "$db" "UPDATE task_runtimes SET state='$next_runtime_state',exit_code=$runtime_exit_code,updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND generation=$generation AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');"
        event task "$task_id" SESSION_EXITED "generation=$generation code=$runtime_exit_code state=$next_runtime_state"
        ;;
      reconcile)
        # 子sandboxは親DBを書けない。子がworktreeへ残した完了印を、
        # DB権限を持つ親processが検証して正式な状態へ反映する。
        reconcile_completion_markers
        reconcile_completed_child_panes
        reconcile_child_reports
        process_browser_bridge_requests
        collect_permission_requests
        process_permission_run_requests
        stop_permission_runs || true
        startup_grace="$(sqlite3 "$db" "SELECT COALESCE(value,'30') FROM metadata WHERE key='runtime_startup_grace_seconds';")"
        [[ "$startup_grace" == <-> ]] || startup_grace=30
        while IFS='|' read -r reconcile_task reconcile_generation runtime_state process_pid created_at; do
          [[ -n "$reconcile_task" ]] || continue
          runtime_workspace="$(sqlite3 "$db" "SELECT COALESCE(workspace_ref,'') FROM task_runtimes WHERE task_id='$(sql_quote "$reconcile_task")' AND generation=$reconcile_generation;")"
          runtime_pane="$(sqlite3 "$db" "SELECT COALESCE(pane_ref,'') FROM task_runtimes WHERE task_id='$(sql_quote "$reconcile_task")' AND generation=$reconcile_generation;")"
          pane_alive=1
          if [[ -n "$runtime_workspace" && -n "$runtime_pane" ]]; then
            pane_listing="$(cmux list-panes --workspace "$runtime_workspace" 2>/dev/null || true)"
            print -r -- "$pane_listing" | /usr/bin/grep -Fq "$runtime_pane" || pane_alive=0
          fi
          # processの生存を一次情報とする。cmuxのpane参照形式差異だけで
          # 生きている子をLOST扱いし、重複generationを起動してはならない。
          if [[ "$process_pid" == <-> ]] && kill -0 "$process_pid" 2>/dev/null; then
            sqlite3 "$db" "UPDATE task_runtimes SET state='ACTIVE',last_heartbeat_at='$(now)',health_probe_failures=0,updated_at='$(now)' WHERE task_id='$(sql_quote "$reconcile_task")' AND generation=$reconcile_generation;"
            continue
          fi
          age_seconds="$(sqlite3 "$db" "SELECT CAST((julianday('now')-julianday('$(sql_quote "$created_at")'))*86400 AS INTEGER);")"
          [[ "$age_seconds" == <-> ]] || age_seconds=$startup_grace
          if [[ "$runtime_state" != ACTIVE && "$age_seconds" -lt "$startup_grace" ]]; then continue; fi
          if [[ "$process_pid" == <-> ]] && (( ! pane_alive )); then
            /usr/bin/pkill -TERM -P "$process_pid" 2>/dev/null || true
            kill -TERM "$process_pid" 2>/dev/null || true
          fi
          sqlite3 "$db" "UPDATE task_runtimes SET state='LOST',health_probe_failures=health_probe_failures+1,updated_at='$(now)' WHERE task_id='$(sql_quote "$reconcile_task")' AND generation=$reconcile_generation AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');"
          event task "$reconcile_task" SESSION_LOST "generation=$reconcile_generation"
        done < <(sqlite3 "$db" "SELECT r.task_id,r.generation,r.state,COALESCE(r.process_pid,''),r.created_at FROM task_runtimes r JOIN tasks t ON t.task_id=r.task_id WHERE t.state='RUNNING' AND r.state IN ('STARTING','ACTIVE','RESUMING','RESTARTING') AND r.generation=(SELECT MAX(x.generation) FROM task_runtimes x WHERE x.task_id=r.task_id);")

        max_resume="$(sqlite3 "$db" "SELECT COALESCE(value,'1') FROM metadata WHERE key='max_session_resume_attempts';")"
        max_restart="$(sqlite3 "$db" "SELECT COALESCE(value,'1') FROM metadata WHERE key='max_session_restart_attempts';")"
        [[ "$max_resume" == <-> ]] || max_resume=1
        [[ "$max_restart" == <-> ]] || max_restart=1
        while IFS='|' read -r recover_task recover_generation resume_count restart_count; do
          [[ -n "$recover_task" ]] || continue
          if (( resume_count < max_resume )); then
            next_resume=$((resume_count+1))
            event task "$recover_task" SESSION_RESUME_REQUESTED "from=$recover_generation attempt=$next_resume"
            "$0" -C "$project_root" run "$recover_task" --resume --resume-attempts "$next_resume" --restart-attempts "$restart_count" >/dev/null || true
          elif (( restart_count < max_restart )); then
            next_restart=$((restart_count+1))
            event task "$recover_task" SESSION_RESTART_REQUESTED "from=$recover_generation attempt=$next_restart"
            "$0" -C "$project_root" run "$recover_task" --restart --resume-attempts "$resume_count" --restart-attempts "$next_restart" >/dev/null || true
          else
            timestamp="$(now)"
            sqlite3 "$db" "BEGIN; UPDATE task_runtimes SET state='FAILED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$recover_task")' AND generation=$recover_generation AND state IN ('LOST','EXITED'); UPDATE tasks SET state='FAILED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$recover_task")' AND state='RUNNING'; COMMIT;"
            event task "$recover_task" SESSION_RECOVERY_EXHAUSTED "resume=$resume_count restart=$restart_count"
          fi
        done < <(sqlite3 "$db" "SELECT r.task_id,r.generation,r.resume_attempts,r.restart_attempts FROM task_runtimes r JOIN tasks t ON t.task_id=r.task_id WHERE t.state='RUNNING' AND r.state IN ('LOST','EXITED') AND r.generation=(SELECT MAX(x.generation) FROM task_runtimes x WHERE x.task_id=r.task_id);")
        ;;
      *) print -u2 "不明なruntime操作です: $runtime_action"; exit 2;;
    esac
    ;;
  notice-worker)
    [[ ! -f "$state_root/service.stop-requested" ]] || exit 0
    notice_lock="$state_root/notice-worker.lock"
    if ! mkdir "$notice_lock" 2>/dev/null; then
      notice_lock_pid="$(<"$notice_lock/pid" 2>/dev/null || true)"
      if [[ "$notice_lock_pid" == <-> ]] && kill -0 "$notice_lock_pid" 2>/dev/null; then exit 0; fi
      /bin/rm -f "$notice_lock/pid"
      rmdir "$notice_lock" 2>/dev/null || exit 0
      mkdir "$notice_lock" 2>/dev/null || exit 0
    fi
    print $$ > "$notice_lock/pid"
    trap '[[ ! -s "$state_root/notice-worker.pid" || "$(<"$state_root/notice-worker.pid")" != "$$" ]] || /bin/rm -f "$state_root/notice-worker.pid"; /bin/rm -f "$notice_lock/pid"; rmdir "$notice_lock" 2>/dev/null || true' EXIT
    notice_schema="$state_root/notice-worker-schema.json"
    cat > "$notice_schema" <<'NOTICE_SCHEMA'
{"type":"object","properties":{"status":{"type":"string","enum":["handled","owner_required","retry"]},"summary":{"type":"string"}},"required":["status","summary"],"additionalProperties":false}
NOTICE_SCHEMA
    chmod 600 "$notice_schema"
    while [[ ! -f "$state_root/service.stop-requested" ]]; do
      notice_id="$(sqlite3 "$db" "SELECT notice_id FROM parent_notices WHERE state='PENDING' AND notice_id NOT LIKE 'permission:%' AND notice_id NOT LIKE 'sidebar-test:%' AND COALESCE((SELECT CAST(value AS INTEGER) FROM metadata WHERE key='notice_retry_until:' || notice_id),0)<=CAST(strftime('%s','now') AS INTEGER) ORDER BY created_at LIMIT 1;")"
      [[ -n "$notice_id" ]] || break
      notice_message="$(sqlite3 "$db" "SELECT message FROM parent_notices WHERE notice_id='$(sql_quote "$notice_id")';")"
      notice_response="$state_root/notice-worker-response.json"
      /bin/rm -f "$notice_response"
      sqlite3 "$db" "UPDATE parent_notices SET attempts=attempts+1 WHERE notice_id='$(sql_quote "$notice_id")' AND state='PENDING';"
      notice_exit=0
      {
        print -r -- "You are CPT's autonomous coordination agent for $project_root. Process one durable notice, ID $notice_id. Inspect the current CPT state before acting. Continue routine parent-child coordination automatically using cpt commands. Never ask the owner to relay a routine message. Do not approve permission requests, grant new task execution, expand scope, publish, or make an owner-only decision. If a decision requires the owner, return owner_required with a concise concrete question. If action cannot be completed, return retry with the reason. Return handled only after completing the applicable action or confirming the notice is obsolete. Work idempotently: this notice may be retried."
        print -r -- "Notice: $notice_message"
      } | env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN -u GH_TOKEN -u GITHUB_TOKEN -u CLOUDFLARE_API_TOKEN -u NPM_TOKEN "${COUNTERPOINTER_NOTICE_AGENT_BIN:-codex}" exec --ephemeral -c 'approval_policy="never"' --sandbox workspace-write -C "$project_root" --output-schema "$notice_schema" --output-last-message "$notice_response" - >> "$state_root/notice-worker-agent.log" 2>&1 || notice_exit=$?
      notice_status=""
      notice_summary=""
      if (( notice_exit == 0 )) && [[ -s "$notice_response" ]]; then
        notice_status="$(jq -r '.status // empty' "$notice_response" 2>/dev/null || true)"
        notice_summary="$(jq -r '.summary // empty' "$notice_response" 2>/dev/null || true)"
      fi
      if [[ "$notice_status" == handled ]]; then
        sqlite3 "$db" "UPDATE parent_notices SET state='DELIVERED',delivered_at='$(now)' WHERE notice_id='$(sql_quote "$notice_id")' AND state='PENDING';"
      elif [[ "$notice_status" == owner_required && -n "$notice_summary" ]]; then
        notice_workspace="$(normalize_cmux_ref workspace "$(<"$state_root/orchestrator.workspace" 2>/dev/null || true)")"
        notice_surface="$(normalize_cmux_ref surface "$(<"$state_root/orchestrator.parent-surface" 2>/dev/null || true)")"
        notice_body="判断待ち $notice_id: ${notice_summary[1,180]}"
        if [[ -n "$notice_workspace" && -n "$notice_surface" ]] && cmux notify --title 'CPT判断待ち' --body "$notice_body" --workspace "$notice_workspace" --surface "$notice_surface" --json > "$state_root/owner-notification-${notice_id//:/-}.json" 2> "$state_root/owner-notification-error.log"; then
          cmux log --level warning --source CPT --workspace "$notice_workspace" "$notice_body" >/dev/null 2>&1 || true
          sqlite3 "$db" "UPDATE parent_notices SET state='DELIVERED',delivered_at='$(now)' WHERE notice_id='$(sql_quote "$notice_id")' AND state='PENDING';"
        fi
      fi
      if [[ "$(sqlite3 "$db" "SELECT state FROM parent_notices WHERE notice_id='$(sql_quote "$notice_id")';")" == PENDING ]]; then
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('notice_retry_until:$(sql_quote "$notice_id")',CAST(strftime('%s','now') AS INTEGER)+60) ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        event parent "$notice_id" NOTICE_AGENT_RETRY "exit=$notice_exit status=${notice_status:-invalid} ${notice_summary[1,180]}" || true
      fi
    done
    ;;
  parent-close-watch)
    watch_generation="${1:-}"
    [[ "$watch_generation" == <-> ]] || exit 2
    watch_row="$(sqlite3 "$db" "SELECT COALESCE(workspace_ref,''),COALESCE(pane_ref,'') FROM parent_runtimes WHERE generation=$watch_generation AND state IN ('STARTING','ACTIVE');")"
    [[ -n "$watch_row" ]] || exit 0
    IFS='|' read -r watch_workspace watch_surface <<< "$watch_row"
    [[ -n "$watch_workspace" && -n "$watch_surface" ]] || exit 0
    while true; do
      if [[ -f "$state_root/parent-close-requested" ]]; then
        if cmux close-surface --workspace "$watch_workspace" --surface "$watch_surface" >/dev/null 2>&1; then
          print "$watch_generation|$watch_workspace|$watch_surface" > "$state_root/parent-close-ack"
          exit 0
        fi
      fi
      watch_state="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM parent_runtimes WHERE generation=$watch_generation;")"
      [[ "$watch_state" == (STARTING|ACTIVE|LOST) ]] || exit 0
      sleep 0.2
    done
    ;;
  parent-runtime)
    parent_action="${1:-}"
    parent_generation="${2:-}"
    [[ -n "$parent_action" && "$parent_generation" == <-> ]] || { print -u2 "親session引数が不正です"; exit 2; }
    queue_index_analysis_notice
    # Existing supervisors keep their cmux authorization and pick up this fix
    # through their per-cycle CLI call, without requiring a restart.
    if [[ "$parent_action" == reconcile && "${3:-}" != --defer-publish && -s "$state_root/supervisor.pid" && "$PPID" == "$(<"$state_root/supervisor.pid")" ]]; then
      process_pending_publications
    fi
    case "$parent_action" in
      started)
        parent_pid="${3:-}"
        [[ "$parent_pid" == <-> ]] || { print -u2 "親process PIDが不正です"; exit 2; }
        started_workspace="$(normalize_cmux_ref workspace "${4:-}")"
        started_surface="$(normalize_cmux_ref surface "${5:-}")"
        parent_location_sql=""
        if [[ -n "$started_workspace" ]]; then
          parent_location_sql=",workspace_ref='$(sql_quote "$started_workspace")'"
          print -r -- "$started_workspace" > "$state_root/orchestrator.workspace"
        fi
        if [[ -n "$started_surface" ]]; then
          parent_location_sql+=",pane_ref='$(sql_quote "$started_surface")'"
          print -r -- "$started_surface" > "$state_root/orchestrator.parent-surface"
        fi
        sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',process_pid=$parent_pid$parent_location_sql,last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$parent_generation AND state IN ('STARTING','ACTIVE');"
        event parent "$parent_generation" PARENT_SESSION_ACTIVE "pid=$parent_pid"
        deliver_parent_notices
        ;;
      exited)
        parent_exit_code="${3:-1}"
        sqlite3 "$db" "UPDATE parent_runtimes SET state='LOST',updated_at='$(now)' WHERE generation=$parent_generation AND state IN ('STARTING','ACTIVE');"
        event parent "$parent_generation" PARENT_SESSION_EXITED "code=$parent_exit_code"
        ;;
      reconcile)
        latest_parent="$(sqlite3 "$db" "SELECT generation,state,COALESCE(workspace_ref,''),COALESCE(process_pid,'') FROM parent_runtimes ORDER BY generation DESC LIMIT 1;")"
        [[ -n "$latest_parent" ]] || exit 0
        current_parent_generation="${latest_parent%%|*}"; parent_rest="${latest_parent#*|}"
        current_parent_state="${parent_rest%%|*}"; parent_rest="${parent_rest#*|}"
        current_parent_workspace="${parent_rest%%|*}"; current_parent_pid="${parent_rest#*|}"
        parent_alive=0
        if [[ "$current_parent_pid" == <-> ]] && kill -0 "$current_parent_pid" 2>/dev/null; then parent_alive=1
        elif [[ -n "$current_parent_workspace" && "$current_parent_workspace" != test ]]; then
          parent_panes="$(cmux list-panes --workspace "$current_parent_workspace" 2>/dev/null || true)"
          [[ -n "$parent_panes" ]] && parent_alive=1
        elif [[ "$current_parent_workspace" == test ]]; then parent_alive=1
        fi
        if (( parent_alive )); then
          sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$current_parent_generation AND state IN ('STARTING','ACTIVE');"
          deliver_parent_notices
          exit 0
        fi
        if [[ "$current_parent_state" == STARTING || "$current_parent_state" == ACTIVE ]]; then
          sqlite3 "$db" "UPDATE parent_runtimes SET state='LOST',updated_at='$(now)' WHERE generation=$current_parent_generation;"
          event parent "$current_parent_generation" PARENT_SESSION_LOST "workspace=$current_parent_workspace pid=$current_parent_pid"
          current_parent_state=LOST
        fi
        service_running="$(sed -n 's/^state=//p' "$state_root/service.state" 2>/dev/null || true)"
        parent_launcher="$state_root/parent-launch.zsh"
        if [[ "$current_parent_state" == LOST && "$service_running" == RUNNING && -x "$parent_launcher" ]]; then
          new_parent_generation=$((current_parent_generation+1))
          timestamp="$(now)"
          if ! assert_no_old_parent; then
            event parent "$current_parent_generation" PARENT_RECOVERY_BLOCKED '旧親終了を確認できません。新しい親を作りません。'
            exit 3
          fi
          # supervisor と watchdog が同時に到達しても、復旧枠を取得できるのは
          # 片方だけとする。自動復旧は明示的な service start ごとに1回まで。
          sqlite3 "$db" "BEGIN IMMEDIATE;
            INSERT INTO metadata(key,value) VALUES('parent_recovery_remaining','0') ON CONFLICT(key) DO NOTHING;
            UPDATE metadata SET value=CAST(value AS INTEGER)-1
             WHERE key='parent_recovery_remaining' AND CAST(value AS INTEGER)>0
               AND EXISTS (
                 SELECT 1 FROM parent_runtimes
                  WHERE generation=$current_parent_generation AND state='LOST'
                    AND generation=(SELECT MAX(generation) FROM parent_runtimes)
               );
            INSERT INTO parent_runtimes(generation,state,process_pid,started_at,last_heartbeat_at,updated_at)
              SELECT $new_parent_generation,'STARTING',$$,'$timestamp','$timestamp','$timestamp'
               WHERE changes()=1;
            COMMIT;"
          recovery_claimed="$(sqlite3 "$db" "SELECT COUNT(*) FROM parent_runtimes WHERE generation=$new_parent_generation AND state='STARTING' AND process_pid=$$;")"
          if [[ "$recovery_claimed" != 1 ]]; then
            # 別の監視processが先に復旧generationを作った場合は正常な競合解決。
            # 復旧上限到達としては扱わない。
            latest_parent_generation_now="$(sqlite3 "$db" 'SELECT COALESCE(MAX(generation),0) FROM parent_runtimes;')"
            if (( latest_parent_generation_now > current_parent_generation )); then
              exit 0
            fi
            exhaustion_key="parent_recovery_exhausted:$current_parent_generation"
            exhaustion_token="$(uuidgen | tr '[:upper:]' '[:lower:]')"
            sqlite3 "$db" "INSERT OR IGNORE INTO metadata(key,value) VALUES('$(sql_quote "$exhaustion_key")','$(sql_quote "$exhaustion_token")');"
            if [[ "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='$(sql_quote "$exhaustion_key")';")" == "$exhaustion_token" ]]; then
              event parent "$current_parent_generation" PARENT_RECOVERY_EXHAUSTED "自動復旧上限に達しました。cpt start で明示的に再開してください。"
            fi
            exit 0
          fi
          parent_command="/bin/zsh ${(q)parent_launcher} $new_parent_generation"
          if recovered_workspace="$(cmux new-workspace --name "cpt-parent" --cwd "$project_root" --command "$parent_command" --focus false 2>/dev/null)"; then
            recovered_workspace_ref="$(print -r -- "$recovered_workspace" | sed -n 's/.*\(workspace:[^ ]*\).*/\1/p')"
            [[ -n "$recovered_workspace_ref" ]] || recovered_workspace_ref="$recovered_workspace"
            print -r -- "$recovered_workspace_ref" > "$state_root/orchestrator.workspace"
            print -r -- 'mode=workspace' > "$state_root/orchestrator.mode"
            sqlite3 "$db" "UPDATE parent_runtimes SET workspace_ref='$(sql_quote "$recovered_workspace_ref")',updated_at='$(now)' WHERE generation=$new_parent_generation;"
            event parent "$new_parent_generation" PARENT_SESSION_RECOVERED "$recovered_workspace_ref"
            deliver_parent_notices
          else
            sqlite3 "$db" "UPDATE parent_runtimes SET state='LOST',updated_at='$(now)' WHERE generation=$new_parent_generation;"
          fi
        fi
        ;;
      *) print -u2 "不明な親session操作です: $parent_action"; exit 2;;
    esac
    ;;
  invalidate-verification)
    task_id="${1:-}"; shift || true
    task_id="$(resolve_task_id "$task_id")" || exit $?
    recovery_reason=""; recovery_apply=0
    while (( $# )); do
      case "$1" in
        --reason) recovery_reason="${2:-}"; shift 2;;
        --apply) recovery_apply=1; shift;;
        *) print -u2 "不明な失効オプション: $1"; exit 2;;
      esac
    done
    [[ -n "$recovery_reason" ]] || { print -u2 '--reasonが必要です'; exit 2; }
    old_recovery="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='verification_revoked:$task_id';")"
    if [[ -n "$old_recovery" ]]; then
      print "失効済みです。既存の復旧記録: $old_recovery"
      exit 0
    fi
    row="$(sqlite3 "$db" "SELECT state,COALESCE(worktree,''),COALESCE(dispatch_base_sha,''),COALESCE(commit_sha,'') FROM tasks WHERE task_id='$task_id';")"
    IFS='|' read -r state worktree recovery_base_sha old_commit <<< "$row"
    [[ "$state" == VERIFIED && -d "$worktree" && -n "$recovery_base_sha" && -n "$old_commit" ]] || { print -u2 '失効対象はworktreeと基点を持つVERIFIED Taskに限ります'; exit 2; }
    [[ "$(git -C "$worktree" rev-parse --show-toplevel)" == "${worktree:A}" && "$(git -C "$worktree" rev-parse HEAD)" == "$old_commit" ]] || { print -u2 'worktreeまたはHEADが検証済み記録と一致しません'; exit 2; }
    [[ "$(git -C "$worktree" rev-parse "$recovery_base_sha^{tree}")" == "$(git -C "$worktree" rev-parse "$old_commit^{tree}")" ]] || { print -u2 '実装差分があるcommitはこの操作で失効できません'; exit 2; }
    git -C "$worktree" merge-base --is-ancestor "$recovery_base_sha" "$old_commit" || exit 2
    [[ -z "$(git -C "$worktree" status --porcelain --untracked-files=all -- . ':(exclude).counterpointer-task/**')" ]] || { print -u2 'worktreeに未保存の実装差分があります'; exit 2; }
    change_set_id="$(sqlite3 "$db" "SELECT change_set_id FROM change_set_tasks WHERE task_id='$task_id';")"
    [[ -n "$change_set_id" && "$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks WHERE change_set_id='$change_set_id';")" == 1 ]] || { print -u2 'この復旧は単独TaskのChange Setのみ対応しています'; exit 2; }
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM change_sets WHERE change_set_id='$change_set_id' AND state IN ('OPEN','VERIFIED','FAILED');")" == 1 ]] || { print -u2 '統合中・公開済み・終了済みのChange Setは失効できません'; exit 2; }
    [[ "$(sqlite3 "$db" "WITH RECURSIVE downstream(id) AS (SELECT target_task_id FROM task_edges WHERE source_task_id='$task_id' AND edge_type='DEPENDENCY' UNION SELECT e.target_task_id FROM task_edges e JOIN downstream d ON e.source_task_id=d.id WHERE e.edge_type='DEPENDENCY') SELECT COUNT(*) FROM tasks t JOIN downstream d ON d.id=t.task_id WHERE t.state NOT IN ('REGISTERED','READY') OR t.worktree IS NOT NULL OR EXISTS (SELECT 1 FROM task_runtimes r WHERE r.task_id=t.task_id);")" == 0 ]] || { print -u2 '後続Taskが着手済みのため失効できません'; exit 2; }
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM task_runtimes WHERE task_id='$task_id' AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');")" == 0 ]] || { print -u2 '実行中sessionが残っています'; exit 2; }
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM integration_jobs WHERE change_set_id='$change_set_id' AND (state NOT IN ('VERIFIED','FAILED') OR job_id IN (SELECT substr(key,19) FROM metadata WHERE key LIKE 'integration_merge:%'));")" == 0 ]] || { print -u2 '統合中またはマージ記録のある候補は失効できません'; exit 2; }
    [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM publish_requests p LEFT JOIN pull_requests r ON r.request_id=p.request_id WHERE p.job_id IN (SELECT job_id FROM integration_jobs WHERE change_set_id='$change_set_id') AND (p.state='PUBLISHED' OR r.request_id IS NULL OR r.pr_state<>'NOT_CREATED' OR r.pr_number IS NOT NULL OR COALESCE(r.pr_url,'')<>'' OR COALESCE(r.last_pushed_sha,'')<>'' OR EXISTS (SELECT 1 FROM events e WHERE e.entity_type='publish' AND e.entity_id=p.request_id AND e.event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY')));")" == 0 ]] || { print -u2 '公開済みまたは公開試行済みの候補は失効できません'; exit 2; }
    while IFS='|' read -r recovery_job recovery_candidate integration_base; do
      [[ -n "$recovery_job" ]] || continue
      [[ -n "$recovery_candidate" && -n "$integration_base" && "$(git -C "$project_root" rev-parse "$recovery_candidate^{tree}")" == "$(git -C "$project_root" rev-parse "$integration_base^{tree}")" ]] || { print -u2 "空と証明できない統合候補です: $recovery_job"; exit 2; }
    done < <(sqlite3 "$db" "SELECT j.job_id,COALESCE(j.candidate_sha,''),COALESCE((SELECT base_sha FROM integration_attempts a WHERE a.job_id=j.job_id ORDER BY rowid DESC LIMIT 1),'') FROM integration_jobs j WHERE j.change_set_id='$change_set_id';")
    check_recovery_context "$task_id" "$worktree" "$recovery_base_sha" || { print -u2 "worktree・基点・確認済み計画の照合に失敗しました"; exit 2; }
    print "失効対象: Task=$task_id commit=$old_commit ChangeSet=$change_set_id"
    print '旧証拠を保存し、検証・統合・公開候補を失効します。TaskはFAILED、新規sessionと実装差分を必須にします。hold・計画・依存・実行許可は維持します。'
    (( recovery_apply )) || exit 0
    recovery_dir="$state_root/diagnostics/verification-revocations/$task_id/$(uuidgen | tr '[:upper:]' '[:lower:]')"
    mkdir -p "$recovery_dir"; chmod 700 "$recovery_dir"
    sqlite3 "$db" ".backup '$recovery_dir/before.sqlite3'"
    chmod 600 "$recovery_dir/before.sqlite3"
    [[ ! -d "$state_root/evidence/$task_id" ]] || cp -R "$state_root/evidence/$task_id" "$recovery_dir/verification-evidence"
    print -r -- "$recovery_reason" > "$recovery_dir/reason.txt"
    timestamp="$(now)"
    event task "$task_id" VERIFICATION_REVOCATION_INTENT "commit=$old_commit archive=$recovery_dir reason=$recovery_reason"
    sqlite3 "$db" "BEGIN IMMEDIATE;
      UPDATE verify_results SET status='FAILED' WHERE task_id='$task_id';
      UPDATE publish_requests SET state='FAILED',failure_reason='EMPTY_VERIFICATION_REVOKED',updated_at='$timestamp' WHERE job_id IN (SELECT job_id FROM integration_jobs WHERE change_set_id='$change_set_id');
      UPDATE pull_requests SET failure_reason='EMPTY_VERIFICATION_REVOKED',updated_at='$timestamp' WHERE change_set_id='$change_set_id';
      UPDATE integration_attempts SET status='FAILED',failure_kind='EMPTY_VERIFICATION_REVOKED',updated_at='$timestamp' WHERE change_set_id='$change_set_id';
      UPDATE integration_jobs SET state='FAILED',failure_reason='EMPTY_VERIFICATION_REVOKED',updated_at='$timestamp' WHERE change_set_id='$change_set_id';
      UPDATE change_sets SET state='OPEN',updated_at='$timestamp' WHERE change_set_id='$change_set_id';
      DELETE FROM task_retry_requests WHERE task_id='$task_id';
      INSERT INTO metadata(key,value) VALUES('verification_revoked:$task_id','$(sql_quote "$recovery_dir")');
      INSERT INTO metadata(key,value) VALUES('recovery_base:$task_id','$recovery_base_sha');
      UPDATE tasks SET state='FAILED',commit_sha=NULL,updated_at='$timestamp' WHERE task_id='$task_id' AND state='VERIFIED';
      COMMIT;"
    event task "$task_id" VERIFICATION_REVOKED "commit=$old_commit archive=$recovery_dir reason=$recovery_reason"
    print "失効完了。証拠: $recovery_dir"
    print "次の操作: cpt retry $task_id --fresh（hold解除と開始は親で判断）"
    ;;
  model)
    task_id="$(resolve_task_id "${1:-}")" || exit $?
    selected_model="${2:-}"; model_reason="${3:-}"
    [[ -n "$model_reason" ]] || { print -u2 'モデル選択理由が必要です'; exit 2; }
    case "$selected_model" in sol) selected_model=gpt-6-sol;; luna) selected_model=gpt-6-luna;; astra) selected_model=gpt-6-astra;; *) print -u2 'モデルはsol|luna|astraから選んでください'; exit 2;; esac
    old_model="$(sqlite3 "$db" "SELECT COALESCE((SELECT value FROM metadata WHERE key='child_model:$(sql_quote "$task_id")'),'gpt-6-sol');")"
    model_rank=0; old_rank=0
    case "$selected_model" in gpt-6-luna) model_rank=1;; gpt-6-sol) model_rank=2;; gpt-6-astra) model_rank=3;; esac
    case "$old_model" in gpt-6-luna) old_rank=1;; gpt-6-sol) old_rank=2;; gpt-6-astra) old_rank=3;; esac
    if (( model_rank > old_rank )); then
      escalation_count="$(sqlite3 "$db" "SELECT COUNT(*) FROM events WHERE entity_type='task' AND entity_id='$(sql_quote "$task_id")' AND event_type='CHILD_MODEL_ESCALATED';")"
      (( escalation_count == 0 )) || { print -u2 '同じTaskの上位モデルへの引継ぎは1回までです'; exit 3; }
    fi
    sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES ('child_model:$(sql_quote "$task_id")','$selected_model') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
    if (( model_rank > old_rank )); then event task "$task_id" CHILD_MODEL_ESCALATED "from=$old_model to=$selected_model reason=$model_reason"; fi
    event task "$task_id" CHILD_MODEL_SELECTED "model=$selected_model reason=$model_reason"
    print "次の子世代のモデル: $selected_model"
    ;;
  repair-child)
    task_id="$(resolve_task_id "${1:-}")" || exit $?
    repair_reason="${2:-}"
    [[ -n "$repair_reason" ]] || { print -u2 '修復理由が必要です'; exit 2; }
    repair_row="$(sqlite3 "$db" "SELECT r.generation,COALESCE(r.process_pid,''),COALESCE(t.worktree,''),r.state FROM task_runtimes r JOIN tasks t USING(task_id) WHERE r.task_id='$(sql_quote "$task_id")' AND t.state='RUNNING' ORDER BY r.generation DESC LIMIT 1;")"
    [[ -n "$repair_row" ]] || { print -u2 '実行中の子がありません'; exit 2; }
    IFS='|' read -r repair_generation repair_pid repair_worktree repair_state <<< "$repair_row"
    [[ "$repair_pid" == <-> && "$repair_state" == (ACTIVE|RESUMING|RESTARTING) ]] || { print -u2 'PIDが確定した実行中の子だけを修復できます'; exit 3; }
    service_stop_process "$repair_pid" "$repair_worktree/.counterpointer-task/launch-$repair_generation.zsh" || { event task "$task_id" CHILD_REPAIR_STOP_FAILED "$repair_reason"; print -u2 '子の停止を確認できません。成果と実行枠を保持します'; exit 3; }
    timestamp="$(now)"
    sqlite3 "$db" "BEGIN IMMEDIATE;
      UPDATE task_runtimes SET state='CANCELLED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND generation=$repair_generation AND state IN ('ACTIVE','RESUMING','RESTARTING');
      UPDATE tasks SET state='READY',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING';
      INSERT INTO task_retry_requests(task_id,launch_mode,state,created_at,updated_at)
        VALUES ('$(sql_quote "$task_id")','RESTART','QUEUED','$timestamp','$timestamp')
        ON CONFLICT(task_id) DO UPDATE SET launch_mode='RESTART',state='QUEUED',updated_at=excluded.updated_at;
      COMMIT;"
    event task "$task_id" CHILD_REPAIR_QUEUED "generation=$repair_generation reason=$repair_reason"
    print "子の停止を確認し、同じworktreeからの再開を登録しました: ${task_id[1,12]}"
    ;;
  retry)
    retry_target=""
    retry_all=0
    retry_fresh=0
    while (( $# )); do
      case "$1" in
        --all) retry_all=1; shift;;
        --fresh) retry_fresh=1; shift;;
        --refresh) print -u2 '不明なオプションです: --refresh（新規sessionは --fresh）'; exit 2;;
        -*) print -u2 "不明なretryオプションです: $1"; exit 2;;
        *) [[ -z "$retry_target" ]] || { print -u2 'タスクIDは1件だけ指定してください'; exit 2; }; retry_target="$1"; shift;;
      esac
    done
    (( ! retry_all || ${#retry_target} == 0 )) || { print -u2 '--allとタスクIDは同時指定できません'; exit 2; }
    (( retry_all || ${#retry_target} > 0 )) || { print -u2 'タスクIDまたは--allが必要です'; exit 2; }
    if (( retry_all )); then
      retry_targets=("${(@f)$(sqlite3 "$db" "SELECT task_id FROM tasks WHERE state='FAILED' ORDER BY created_at;")}")
    else
      retry_target="$(resolve_task_id "$retry_target")" || exit $?
      retry_targets=("$retry_target")
    fi
    eligible_retry_targets=()
    for task_id in "${retry_targets[@]}"; do
      [[ -n "$task_id" ]] || continue
      worktree="$(sqlite3 "$db" "SELECT COALESCE(worktree,'') FROM tasks WHERE task_id='$(sql_quote "$task_id")' AND state='FAILED';")"
      if [[ -n "$worktree" && -d "$worktree" ]]; then
        if [[ -n "$(recovery_base "$task_id")" && "$retry_fresh" != 1 ]]; then
          print -u2 "失効済みTaskの再試行には--freshが必要です: $task_id"
          exit 2
        fi
        eligible_retry_targets+=("$task_id")
      elif (( retry_all )); then
        print -u2 "再試行対象外（worktreeなし）: $task_id"
      else
        print -u2 "再実行可能なFAILED Taskではありません: $task_id"
        exit 2
      fi
    done
    if (( ${#eligible_retry_targets[@]} == 0 )); then
      print '再試行可能なFAILED Taskはありません'
      exit 0
    fi
    retry_launch_mode=RESUME
    (( ! retry_fresh )) || retry_launch_mode=RESTART
    timestamp="$(now)"
    retry_sql='BEGIN;'
    for task_id in "${eligible_retry_targets[@]}"; do
      retry_sql+="UPDATE tasks SET state='READY',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state='FAILED'; INSERT INTO task_retry_requests(task_id,launch_mode,state,created_at,updated_at) VALUES ('$(sql_quote "$task_id")','$retry_launch_mode','QUEUED','$timestamp','$timestamp') ON CONFLICT(task_id) DO UPDATE SET launch_mode=excluded.launch_mode,state='QUEUED',updated_at=excluded.updated_at;"
    done
    retry_sql+='COMMIT;'
    sqlite3 "$db" "$retry_sql"
    if ! "$0" -C "$project_root" graph refresh >/dev/null; then
      retry_rollback_sql='BEGIN;'
      for task_id in "${eligible_retry_targets[@]}"; do retry_rollback_sql+="UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state='READY'; DELETE FROM task_retry_requests WHERE task_id='$(sql_quote "$task_id")';"; done
      retry_rollback_sql+='COMMIT;'
      sqlite3 "$db" "$retry_rollback_sql"
      print -u2 '依存・競合グラフを更新できなかったため再試行登録を取り消しました'
      exit 3
    fi
    for task_id in "${eligible_retry_targets[@]}"; do event task "$task_id" RETRY_QUEUED "$retry_launch_mode"; done
    print "再試行キューへ戻しました: ${#eligible_retry_targets[@]}件（$(status_label "$retry_launch_mode")）"
    print '再試行の実行を許可しました。監視が条件を満たせば開始します。'
    ;;
  complete)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    worktree="$(sqlite3 "$db" "SELECT COALESCE(worktree,'') FROM tasks WHERE task_id='$task_id';")"
    check_recovery_changes "$task_id" "$worktree" || exit 2
    timestamp="$(now)"
    sqlite3 "$db" "UPDATE tasks SET state='CLAIMED_DONE', updated_at='$timestamp' WHERE task_id='$task_id' AND state='RUNNING';"
    sqlite3 "$db" "UPDATE task_runtimes SET state='COMPLETED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state IN ('STARTING','ACTIVE','EXITED','LOST','RESUMING','RESTARTING');"
    event task "$task_id" CLAIMED_DONE
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == CLAIMED_DONE ]] || { print -u2 "タスクは実行中ではありません"; exit 2; }
    ;;
  attention)
    [[ $# == 0 ]] || { print -u2 '使い方: cpt attention'; exit 2; }
    sqlite3 -header -column "$db" "SELECT '検証承認' AS kind,p.request_id AS id,substr(p.task_id,1,12) AS task,json_extract(p.request_json,'$.operation') AS detail FROM permission_requests p JOIN tasks t ON t.task_id=p.task_id WHERE p.state='PENDING' AND t.state='RUNNING' AND p.generation=(SELECT MAX(generation) FROM task_runtimes WHERE task_id=p.task_id)
      UNION ALL SELECT '子の確認',substr(m.key,10),substr(t.task_id,1,12),json_extract(m.value,'$.operation') FROM metadata m JOIN tasks t ON t.task_id=json_extract(m.value,'$.task_id') JOIN task_artifacts a ON a.task_id=t.task_id WHERE m.key LIKE 'question:%' AND json_extract(m.value,'$.state')='pending' AND t.state='RUNNING' AND json_extract(m.value,'$.generation')=(SELECT MAX(generation) FROM task_runtimes WHERE task_id=t.task_id) AND json_extract(m.value,'$.plan_hash')=a.execution_plan_hash;"
    ;;
  sidebar-test)
    [[ $# == 0 ]] || { print -u2 '使い方: cpt sidebar-test'; exit 2; }
    test_notice_id="sidebar-test:$(uuidgen | tr '[:upper:]' '[:lower:]')"
    test_message='表示確認です。承認や操作は不要です。'
    sqlite3 "$db" "INSERT INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES ('$(sql_quote "$test_notice_id")','$(sql_quote "$test_message")','PENDING',0,'$(now)');"
    event parent "$project_root" SIDEBAR_TEST_QUEUED "$test_notice_id"
    print -r -- "$test_notice_id"
    ;;
  notices)
    (( $# <= 1 )) || { print -u2 '使い方: cpt notices [通知ID]'; exit 2; }
    if [[ -n "${1:-}" ]]; then
      sqlite3 -header -column "$db" "SELECT notice_id,state,attempts,created_at,delivered_at,message FROM parent_notices WHERE notice_id='$(sql_quote "$1")';"
    else
      sqlite3 -header -column "$db" "SELECT notice_id,state,created_at,substr(message,1,100) AS message FROM parent_notices ORDER BY created_at DESC LIMIT 30;"
    fi
    ;;
  browser)
    task_id="${1:-}"; browser_action="${2:-}"
    [[ -n "$task_id" && -n "$browser_action" ]] || { print -u2 '使い方: cpt browser <タスクID> <open URL|操作 [引数…]>'; exit 2; }
    shift 2
    task_id="$(resolve_task_id "$task_id")" || exit $?
    worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")' AND state IN ('RUNNING','CLAIMED_DONE','VERIFYING','VERIFIED');")"
    [[ -n "$worktree" && -d "$worktree/.counterpointer-task" ]] || { print -u2 '実行worktreeがありません'; exit 2; }
    if [[ "${CPT_BROWSER_BRIDGE:-0}" == 1 && "${CPT_BROWSER_BROKER:-0}" != 1 ]] && ! cmux ping >/dev/null 2>&1; then
      bridge_dir="$worktree/.counterpointer-task/browser-bridge"
      mkdir -p "$bridge_dir"
      bridge_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
      bridge_request="$bridge_dir/$bridge_id.request.json"
      bridge_response="$bridge_dir/$bridge_id.response.json"
      jq -n --arg task "$task_id" --arg action "$browser_action" \
        '{task_id:$task,action:$action,args:$ARGS.positional}' --args -- "$@" > "$bridge_request.tmp"
      /bin/mv "$bridge_request.tmp" "$bridge_request"
      for bridge_wait in {1..300}; do
        if [[ -f "$bridge_response" ]]; then
          bridge_result="$(jq -r '.exit_code' "$bridge_response")"
          jq -r '.output' "$bridge_response"
          /bin/rm -f "$bridge_response"
          exit "$bridge_result"
        fi
        sleep 0.1
      done
      print -u2 "cmux内の監視プロセスから応答がありません: $bridge_id"
      exit 4
    fi
    browser_record="$worktree/.counterpointer-task/browser-surface.json"
    browser_surface=""; browser_workspace=""
    if [[ -f "$browser_record" && ! -L "$browser_record" ]]; then
      browser_surface="$(jq -r --arg task "$task_id" 'select(.task_id==$task) | .surface // empty' "$browser_record")"
      browser_workspace="$(jq -r '.workspace // empty' "$browser_record")"
    fi
    if [[ -z "$browser_workspace" && -s "$state_root/orchestrator.workspace" ]]; then
      browser_workspace="$(normalize_cmux_ref workspace "$(<"$state_root/orchestrator.workspace")")"
    fi
    [[ -n "$browser_workspace" ]] || { print -u2 'CPTのcmux workspaceがありません。親で起動状態を確認してください。外部ブラウザには切り替えません。'; exit 3; }
    browser_child_record="$worktree/.counterpointer-task/child-surface.json"
    browser_child_surface="$(jq -er --arg task "$task_id" 'select(.task_id==$task) | .surface | select(type=="string" and length>0)' "$browser_child_record")" || { print -u2 'Taskの子surfaceを確認できません。親ペインを分割せず停止します。'; exit 3; }
    # Use the recorded workspace, never the focused workspace of another task.
    export CMUX_WORKSPACE_ID="$browser_workspace"
    if [[ "$browser_action" == close ]]; then
      [[ $# == 0 ]] || { print -u2 'closeに引数は指定できません'; exit 2; }
      close_task_browser "$task_id" "$worktree" || { print -u2 'Taskブラウザを閉じられません。記録を保持して再試行します'; exit 3; }
      exit 0
    fi
    if [[ -n "$browser_surface" ]]; then place_browser_in_child_tab || exit $?; fi
    case "$browser_action" in
      open)
        [[ $# == 1 && "$1" != -* ]] || { print -u2 'openには検証URLを1つ指定してください'; exit 2; }
        if [[ -n "$browser_surface" ]]; then
          cmux browser --surface "$browser_surface" navigate "$1"
        else
          browser_tree="$(cmux tree --workspace "$browser_workspace" --json)" || exit 3
          browser_target_pane="$(browser_child_pane "$browser_tree" "$browser_child_surface")" || exit 3
          browser_created="$(cmux --json new-surface --type browser --pane "$browser_target_pane" --workspace "$browser_workspace" --url "$1" --focus false)" || { print -u2 'cmux内蔵ブラウザの起動に失敗しました。接続・承認を確認してください。外部ブラウザには切り替えません。'; exit 3; }
          browser_surface="$(print -r -- "$browser_created" | jq -er '.surface_ref // .surface_id | select(type=="string" and length>0)')" || { print -u2 'cmuxからブラウザsurfaceを取得できません'; exit 3; }
          browser_tmp="$(mktemp "$browser_record.XXXXXX")"
          jq -n --arg task "$task_id" --arg surface "$browser_surface" --arg workspace "$browser_workspace" \
            '{task_id:$task,surface:$surface,workspace:$workspace,engine:"cmux"}' > "$browser_tmp"
          /bin/mv "$browser_tmp" "$browser_record"
          place_browser_in_child_tab || exit $?
          print -r -- "$browser_created"
        fi
        ;;
      navigate|goto|back|forward|reload|url|get-url|snapshot|screenshot|viewport|get|is|find|eval|wait|click|dblclick|hover|focus|check|uncheck|scroll-into-view|type|fill|press|keydown|keyup|select|scroll|console|errors)
        [[ -n "$browser_surface" ]] || { print -u2 '先に cpt browser <task-id> open <URL> を実行してください'; exit 2; }
        # Do not permit caller options to replace this Task's explicit target.
        for browser_arg in "$@"; do
          case "$browser_arg" in --surface|--surface=*|--workspace|--workspace=*|--window|--window=*) print -u2 '対象surface/workspaceはCPTが固定します'; exit 2;; esac
        done
        cmux browser --surface "$browser_surface" "$browser_action" "$@"
        ;;
      *) print -u2 "未対応のブラウザ操作です: $browser_action（cmux browser --helpを確認）"; exit 2;;
    esac
    ;;
  permission)
    permission_action="${1:-}"; shift || true
    case "$permission_action" in
      request)
        task_id="$(resolve_task_id "${1:-}")" || exit $?
        input="${2:-}"
        [[ -f "$input" && "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == RUNNING ]] || exit 2
        worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
        generation="$(latest_runtime_generation "$task_id")"; (( generation > 0 )) || exit 2
        jq -e '(.operation|type=="string" and length>0 and length<=200) and
          (.reason|type=="string" and length>0 and length<=2000) and
          (.remaining_checks|type=="array" and length<=20 and all(.[];type=="string" and length<=500)) and
          (.recipe|type=="object") and (.recipe.mode=="once" or .recipe.mode=="server") and
          (.recipe.argv|type=="array" and length>=1 and length<=16 and all(.[];type=="string" and length>0 and length<=500))' "$input" >/dev/null || exit 2
        permission_body="$(jq -cS --arg task "$task_id" --argjson generation "$generation" '{task_id:$task,generation:$generation,operation,reason,remaining_checks,recipe:{mode:.recipe.mode,argv:.recipe.argv}}' "$input")"
        request_id="$(print -rn -- "$permission_body" | /usr/bin/openssl dgst -sha256 | awk '{print $NF}')"
        permission_dir="$worktree/.counterpointer-task/permission-requests"
        mkdir -p "$permission_dir"
        [[ ! -L "$permission_dir" ]] || exit 3
        permission_path="$permission_dir/$request_id.request.json"
        if [[ ! -f "$permission_path" && ! -f "$permission_dir/$request_id.recorded.json" ]]; then
          permission_tmp="$(mktemp "$permission_path.XXXXXX")"
          print -r -- "$permission_body" | jq -cS --arg id "$request_id" '. + {request_id:$id}' > "$permission_tmp"
          /bin/mv "$permission_tmp" "$permission_path"
        fi
        print "$request_id"
        ;;
      list)
        sqlite3 -header -column "$db" "SELECT request_id AS id,substr(task_id,1,8) AS task,generation,state,json_extract(request_json,'$.operation') AS operation,created_at FROM permission_requests ORDER BY created_at DESC LIMIT 100;"
        ;;
      status)
        request_id="${1:-}"
        [[ "$request_id" =~ '^[a-f0-9]{64}$' ]] || exit 2
        sqlite3 "$db" "SELECT json_object('request',json(request_json),'state',state,'created_at',created_at,'decided_at',decided_at) FROM permission_requests WHERE request_id='$request_id';"
        ;;
      approve)
        request_id="${1:-}"
        [[ "$request_id" =~ '^[a-f0-9]{64}$' && "${2:-}" == --hash && "${3:-}" == "$request_id" ]] || { print -u2 '要求全体のSHA-256を--hashで指定してください'; exit 2; }
        permission_scope=task
        if [[ -n "${4:-}" ]]; then
          [[ "${4:-}" == --scope && "${5:-}" == project && -z "${6:-}" ]] || { print -u2 '再利用する場合は --scope project を指定してください'; exit 2; }
          permission_scope=project
        fi
        permission_json="$(sqlite3 "$db" "SELECT request_json FROM permission_requests WHERE request_id='$request_id' AND state='PENDING';")"
        [[ -n "$permission_json" ]] || { print -u2 '確認待ちの要求がありません'; exit 3; }
        task_id="$(print -r -- "$permission_json" | jq -r .task_id)"
        generation="$(print -r -- "$permission_json" | jq -r .generation)"
        [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == RUNNING && "$(latest_runtime_generation "$task_id")" == "$generation" ]] || { print -u2 'Taskまたは世代が失効しました'; exit 3; }
        worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
        permission_file="$(permission_target_file "$worktree" "$permission_json")" || { print -u2 '自動実行に登録できるのはworktree内のnode <相対script>またはnpm run <固定名>です'; exit 3; }
        permission_sha="$(/usr/bin/openssl dgst -sha256 "$permission_file" | awk '{print $NF}')"
        permission_sql="UPDATE permission_requests SET state='APPROVED',approved_file='$(sql_quote "$permission_file")',approved_sha256='$permission_sha',decided_at='$(now)' WHERE request_id='$request_id' AND state='PENDING';"
        if [[ "$permission_scope" == project ]]; then
          permission_rel="${permission_file#${worktree:A}/}"
          permission_recipe="$(print -r -- "$permission_json" | jq -cS .recipe)"
          permission_sql+=" INSERT INTO permission_grants(grant_id,recipe_json,target_relative_path,target_sha256,created_at) VALUES('$request_id','$(sql_quote "$permission_recipe")','$(sql_quote "$permission_rel")','$permission_sha','$(now)');"
        fi
        sqlite3 "$db" "BEGIN IMMEDIATE; $permission_sql COMMIT;"
        event task "$task_id" PERMISSION_APPROVED "$request_id"
        if [[ "$permission_scope" == project ]]; then
          print "要求 $request_id を承認しました。同じプロジェクト内で固定コマンド・対象path・ファイルhashが一致する将来のTaskにも再利用します。"
        else
          print "Task $task_id の要求 $request_id を承認しました。許可はこの世代・固定コマンドだけです。"
        fi
        ;;
      decline)
        request_id="${1:-}"
        [[ "$request_id" =~ '^[a-f0-9]{64}$' ]] || exit 2
        sqlite3 "$db" "UPDATE permission_requests SET state='DECLINED',decided_at='$(now)' WHERE request_id='$request_id' AND state='PENDING';"
        ;;
      run)
        request_id="${1:-}"
        [[ "$request_id" =~ '^[a-f0-9]{64}$' ]] || exit 2
        permission_json="$(sqlite3 "$db" "SELECT request_json FROM permission_requests WHERE request_id='$request_id' AND state='APPROVED';")"
        [[ -n "$permission_json" ]] || { print -u2 '承認済みの要求ではありません'; exit 3; }
        task_id="$(print -r -- "$permission_json" | jq -r .task_id)"
        generation="$(print -r -- "$permission_json" | jq -r .generation)"
        [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == RUNNING && "$(latest_runtime_generation "$task_id")" == "$generation" ]] || { print -u2 'Taskまたは世代が失効しました'; exit 3; }
        worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
        permission_dir="$worktree/.counterpointer-task/permission-bridge"
        mkdir -p "$permission_dir"
        [[ ! -L "$permission_dir" ]] || exit 3
        permission_run_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        jq -n --arg request "$request_id" --arg run "$permission_run_id" '{request_id:$request,run_id:$run}' > "$permission_dir/$permission_run_id.request.json.tmp"
        /bin/mv "$permission_dir/$permission_run_id.request.json.tmp" "$permission_dir/$permission_run_id.request.json"
        for permission_wait in {1..3000}; do
          if [[ -f "$permission_dir/$permission_run_id.response.json" ]]; then
            permission_result="$(jq -r '.exit_code' "$permission_dir/$permission_run_id.response.json")"
            jq -r '.output' "$permission_dir/$permission_run_id.response.json"
            /bin/rm -f "$permission_dir/$permission_run_id.response.json"
            exit "$permission_result"
          fi
          sleep 0.1
        done
        print -u2 'CPT監視プロセスの応答待ちが時間切れになりました'
        exit 4
        ;;
      stop)
        task_id="$(resolve_task_id "${1:-}")" || exit $?
        stop_permission_runs "$task_id" || exit $?
        print 'Taskの定型検証サーバーを停止しました'
        ;;
      *) print -u2 '使い方: cpt permission request TASK JSON_FILE | list | status ID | approve ID --hash SHA256 | decline ID | run ID | stop TASK'; exit 2;;
    esac
    ;;
  question)
    if [[ "${1:-}" == wait ]]; then
      request_id="${2:-}"
      [[ "$request_id" =~ '^[a-f0-9]+$' ]] || exit 2
      for wait_round in {1..30}; do
        response="$("$0" -C "$project_root" question status "$request_id")" || exit $?
        if print -r -- "$response" | jq -e '.stale or .state=="answered"' >/dev/null; then print -r -- "$response"; exit 0; fi
        sleep 1
      done
      print '親の回答待ちです。許可済みの独立作業を進め、同じIDのwaitを継続してください。'
      exit 4
    fi
    if [[ "${1:-}" == status ]]; then
      request_id="${2:-}"
      [[ "$request_id" =~ '^[a-f0-9]+$' ]] || exit 2
      question_json="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='question:$request_id';")"
      [[ -n "$question_json" ]] || exit 2
      question_task="$(print -r -- "$question_json" | jq -r .task_id)"
      current_plan="$(sqlite3 "$db" "SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$(sql_quote "$question_task")';")"
      print -r -- "$question_json" | jq --argjson generation "$(latest_runtime_generation "$question_task")" --arg plan "$current_plan" --arg task_state "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$question_task")';")" '. + {stale:(.generation!=$generation or .plan_hash!=$plan or $task_state!="RUNNING")}'
      exit 0
    fi
    task_id="$(resolve_task_id "${1:-}")" || exit $?
    input="${2:-}"
    [[ -f "$input" && "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == RUNNING ]] || exit 2
    generation="$(latest_runtime_generation "$task_id")"; (( generation > 0 )) || exit 2
    plan_hash="$(sqlite3 "$db" "SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$task_id';")"
    jq -e '(.kind=="specification" or .kind=="permission" or .kind=="environment") and (.operation|type=="string" and length>0) and (.reason|type=="string" and length>0) and (.remaining_checks|type=="array")' "$input" >/dev/null || exit 2
    question_json="$(jq -cS --arg task "$task_id" --argjson gen "$generation" --arg plan "$plan_hash" '{task_id:$task,generation:$gen,plan_hash:$plan,kind,operation,reason,remaining_checks,state:"pending"}' "$input")"
    request_id="$(text_sha256 "$question_json")"
    question_json="$(print -r -- "$question_json" | jq -c --arg id "$request_id" '. + {request_id:$id}')"
    question_inserted="$(sqlite3 "$db" "INSERT OR IGNORE INTO metadata(key,value) VALUES('question:$request_id','$(sql_quote "$question_json")'); SELECT changes();")"
    if [[ "$question_inserted" == 1 ]]; then
      message="子の確認を親へ集約: Task $task_id 世代 $generation 確認ID $request_id。cpt question status $request_id を確認し、同じTask/世代/計画/操作へanswerを記録してください。OS権限は別の通常承認が必要です。"
      sqlite3 "$db" "INSERT OR IGNORE INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES('question:$request_id','$(sql_quote "$message")','PENDING',0,'$(now)'); INSERT INTO metadata(key,value) VALUES('runtime_attention:$task_id:$generation','親の判断待ち: $request_id') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
      event task "$task_id" QUESTION_PENDING "$request_id"
    fi
    deliver_parent_notices
    print "$request_id"
    ;;
  answer)
    request_id="${1:-}"; input="${2:-}"
    [[ "$request_id" =~ '^[a-f0-9]+$' && -f "$input" ]] || exit 2
    question_json="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='question:$request_id';")"
    [[ -n "$question_json" ]] || exit 2
    task_id="$(print -r -- "$question_json" | jq -r .task_id)"
    generation="$(latest_runtime_generation "$task_id")"
    plan_hash="$(sqlite3 "$db" "SELECT execution_plan_hash FROM task_artifacts WHERE task_id='$task_id';")"
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == RUNNING ]] || exit 3
    print -r -- "$question_json" | jq -e --argjson gen "$generation" --arg plan "$plan_hash" '.state=="pending" and .generation==$gen and .plan_hash==$plan' >/dev/null || { print -u2 '失効済み・回答済みの確認です'; exit 3; }
    jq -e --argjson q "$question_json" '.request_id==$q.request_id and .task_id==$q.task_id and .generation==$q.generation and .plan_hash==$q.plan_hash and .operation==$q.operation and (.decision=="clarify" or .decision=="unavailable" or (.decision=="proceed" and $q.kind!="permission")) and (.answer|type=="string" and length>0)' "$input" >/dev/null || { print -u2 '回答の対象不一致、またはOS権限の自動許可は拒否します'; exit 3; }
    question_json="$(print -r -- "$question_json" | jq -c --slurpfile a "$input" '. + {state:"answered",response:$a[0]}')"
    sqlite3 "$db" "UPDATE metadata SET value='$(sql_quote "$question_json")' WHERE key='question:$request_id'; UPDATE metadata SET value='親の回答あり: cpt question status $request_id（同じ世代で確認）' WHERE key='runtime_attention:$task_id:$generation';"
    event task "$task_id" QUESTION_ANSWERED "$request_id"
    print "回答を記録しました。新しい子ペインは作りません。同じ子で question status $request_id を読んでください。"
    ;;
  blocked)
    task_id="${1:-}"; blocked_reason="${2:-}"
    [[ -n "$task_id" && -n "$blocked_reason" ]] || { print -u2 '使い方: cpt blocked <タスクID> <理由>'; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING';")"
    [[ -n "$worktree" && -d "$worktree/.counterpointer-task" ]] || { print -u2 '実行中Taskだけが対象です'; exit 2; }
    generation="$(latest_runtime_generation "$task_id")"
    [[ "$generation" -gt 0 ]] || { print -u2 '子runtimeがありません'; exit 2; }
    report_file="$worktree/.counterpointer-task/turn-complete-$generation.json"
    report_tmp="$(mktemp "$report_file.XXXXXX")"
    jq -n --arg task "$task_id" --arg generation "$generation" --arg reason "$blocked_reason" \
      '{task_id:$task,generation:$generation,reason:($reason|.[0:2000])}' > "$report_tmp"
    /bin/mv "$report_tmp" "$report_file"
    print '未完了の理由を記録しました。監視が親へ通知します（成果・実行枠を保持）。'
    ;;
  selfcheck)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    row="$(sqlite3 "$db" "SELECT state,worktree FROM tasks WHERE task_id='$task_id';")"
    state="${row%%|*}"; worktree="${row#*|}"
    [[ "$state" == RUNNING && -d "$worktree" ]] || { print -u2 "Taskは実行中でworktreeが必要です"; exit 2; }
    [[ "${2:-}" == '' || "${2:-}" == --implementation-only ]] || { print -u2 '使い方: selfcheck TASK [--implementation-only]'; exit 2; }
    if [[ "${2:-}" == --implementation-only ]]; then
      [[ -s "$worktree/.counterpointer-task/completion-report.md" ]] || { print -u2 '実施済み・残検証のcompletion-report.mdが必要です'; exit 2; }
      sqlite3 "$db" "INSERT INTO metadata(key,value) SELECT 'integration_review_required:' || change_set_id,'1' FROM change_set_tasks WHERE task_id='$task_id' ON CONFLICT(key) DO UPDATE SET value='1';"
      event task "$task_id" IMPLEMENTATION_HANDOFF '子検証終了、統合SHAの最終受入は未完了'
    fi
    [[ -s "$worktree/.counterpointer-task/execution-plan.md" && -s "$worktree/.counterpointer-task/goal.md" ]] || { print -u2 "タスク成果物がありません"; exit 2; }
    unresolved_paths="$(git -C "$worktree" diff --name-only --diff-filter=U)"
    [[ -z "$unresolved_paths" ]] || { print -u2 "セルフチェック失敗: 未解消の統合競合があります"; exit 2; }
    if git -C "$worktree" diff --name-only | rg -q '^\.counterpointer-task/(execution-plan|goal)\.md$'; then
      print -u2 "セルフチェック失敗: タスク計画またはゴールが変更されています"
      exit 2
    fi
    check_recovery_changes "$task_id" "$worktree" || exit 2
    mkdir -p "$worktree/.counterpointer-task"
    report="$worktree/.counterpointer-task/completion-report.md"
    if [[ ! -s "$report" ]]; then
      {
        print '# 完了報告'
        print ''
        print "タスクID: $task_id"
        print "完了日時: $(now)"
        print ''
        print '## 変更ファイル'
        git -C "$worktree" status --short || true
      } > "$report"
    fi
    current_generation="$(latest_runtime_generation "$task_id")"
    pending_questions="$(sqlite3 "$db" "SELECT COUNT(*) FROM metadata WHERE key LIKE 'question:%' AND json_extract(value,'$.task_id')='$task_id' AND json_extract(value,'$.generation')=$current_generation AND json_extract(value,'$.state')='pending';")"
    [[ "$pending_questions" == 0 ]] || { print -u2 '未回答の親確認があります。selfcheckは未実施です'; exit 3; }
    {
      print "task_id=$task_id"
      print "generation=$current_generation"
      print "checked_at=$(now)"
      print 'result=PASSED'
    } > "$worktree/.counterpointer-task/selfcheck.txt"
    if ! event task "$task_id" CHILD_COMPLETED "$report" 2>/dev/null; then
      print '子作業のセルフチェックに合格しました。Taskはまだ親検証待ちです。'
      exit 0
    fi
    if ! "$0" -C "$project_root" complete "$task_id" 2>/dev/null; then
      print '子作業のセルフチェックに合格しました。Taskはまだ親検証待ちです。'
      exit 0
    fi
    ;;
  verify)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    timestamp="$(now)"
    worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$task_id';")"
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$task_id';")" == CLAIMED_DONE ]] || { print -u2 'verifyにはCLAIMED_DONE Taskが必要です'; exit 2; }
    if ! check_recovery_changes "$task_id" "$worktree"; then
      sqlite3 "$db" "UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$task_id' AND state='CLAIMED_DONE';"
      event task "$task_id" VERIFY_FAILED 'recovery context mismatch or empty implementation diff'
      exit 2
    fi
    sqlite3 "$db" "UPDATE tasks SET state='VERIFYING', updated_at='$timestamp' WHERE task_id='$task_id' AND state='CLAIMED_DONE';"
    if [[ -n "$worktree" && -d "$worktree" ]]; then
      if [[ -n "$(git -C "$worktree" diff --name-only --diff-filter=U)" ]]; then
        sqlite3 "$db" "UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state='VERIFYING';"
        event task "$task_id" VERIFY_FAILED 'unresolved integration conflict'
        print -u2 '検証失敗: 未解消の統合競合があります'
        exit 2
      fi
      dispatch_base_sha="$(sqlite3 "$db" "SELECT COALESCE(dispatch_base_sha,'') FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
      [[ -n "$dispatch_base_sha" ]] || dispatch_base_sha="$(git -C "$worktree" rev-parse HEAD)"
      cherry_pick_head="$(git -C "$worktree" rev-parse --git-path CHERRY_PICK_HEAD)"
      [[ -f "$cherry_pick_head" ]] && git -C "$worktree" cherry-pick --quit >/dev/null 2>&1 || true
      git -C "$worktree" reset --soft "$dispatch_base_sha"
      git -C "$worktree" add -A -- . ':(exclude).counterpointer-task/**'
      path_violation=""
      while IFS= read -r actual_path; do
        [[ -n "$actual_path" ]] || continue
        actual_allowed=0
        while IFS= read -r allowed_path; do
          [[ -n "$allowed_path" ]] || continue
          if [[ "$allowed_path" == . || "$actual_path" == "${allowed_path%/}" || "$actual_path" == "${allowed_path%/}"/* ]]; then actual_allowed=1; break; fi
        done < <(sqlite3 "$db" "SELECT path FROM task_paths WHERE task_id='$(sql_quote "$task_id")';")
        if (( ! actual_allowed )); then path_violation="$actual_path"; break; fi
      done < <(git -C "$worktree" diff --cached --name-only "$dispatch_base_sha")
      if [[ -n "$path_violation" ]]; then
        git -C "$worktree" reset --mixed "$dispatch_base_sha" >/dev/null
        sqlite3 "$db" "UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state='VERIFYING';"
        event task "$task_id" PATH_VIOLATION "$path_violation"
        notify_parent_agent "Counterpointer通知: タスク ${task_id[1,12]} は許可範囲外の変更（$path_violation）を検出したため失敗しました。内容を確認して再計画してください。"
        print -u2 "検証失敗: 許可範囲外の変更です: $path_violation"
        exit 2
      fi
      if [[ -n "$(recovery_base "$task_id")" ]] && git -C "$worktree" diff --cached --quiet; then
        sqlite3 "$db" "UPDATE tasks SET state='FAILED',updated_at='$(now)' WHERE task_id='$task_id' AND state='VERIFYING';"
        event task "$task_id" VERIFY_FAILED 'empty implementation diff'
        print -u2 '実装差分が空のため検証を停止しました'
        exit 2
      fi
      if git -C "$worktree" diff --cached --quiet; then
        git -C "$worktree" -c user.name=counterpointer -c user.email=counterpointer@localhost commit --allow-empty -m "counterpointer task $task_id" >/dev/null
      else
        git -C "$worktree" -c user.name=counterpointer -c user.email=counterpointer@localhost commit -m "counterpointer task $task_id" >/dev/null
      fi
      commit_sha="$(git -C "$worktree" rev-parse HEAD)"
      sqlite3 "$db" "UPDATE tasks SET state='VERIFIED', commit_sha='$commit_sha', updated_at='$(now)' WHERE task_id='$task_id' AND state='VERIFYING';"
      record_task_index_delta "$task_id" "$dispatch_base_sha" "$commit_sha"
      event task "$task_id" VERIFIED "$commit_sha"
      notify_parent_agent "Counterpointer通知: タスク ${task_id[1,12]} の検証が完了しました。commit ${commit_sha[1,12]} を後続処理へ進めてください。"
    else
      sqlite3 "$db" "UPDATE tasks SET state='FAILED', updated_at='$(now)' WHERE task_id='$task_id' AND state='VERIFYING';"
      exit 1
    fi
    ;;
  external-verify)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    row="$(sqlite3 "$db" "SELECT state,worktree,commit_sha FROM tasks WHERE task_id='$task_id';")"
    state="${row%%|*}"; rest="${row#*|}"; worktree="${rest%%|*}"; commit_sha="${rest#*|}"
    [[ "$state" == VERIFIED && -n "$commit_sha" && -d "$worktree" ]] || { print -u2 "Taskは検証済みでcommitとworktreeが必要です"; exit 2; }
    check_recovery_changes "$task_id" "$worktree" "$commit_sha" || exit 2
    evidence="$state_root/evidence/$task_id"
    [[ -z "$(recovery_base "$task_id")" ]] || evidence="$evidence/$commit_sha"
    mkdir -p "$evidence"
    git -C "$project_root" show --quiet --format='%H' "$commit_sha" >/dev/null || { print -u2 "commitへ到達できません"; exit 2; }
    [[ -s "$worktree/.counterpointer-task/execution-plan.md" && -s "$worktree/.counterpointer-task/goal.md" ]] || { print -u2 "Taskの計画書またはゴールがありません"; exit 2; }
    tree_sha="$(git -C "$worktree" rev-parse "$commit_sha^{tree}")"
    print "task_id=$task_id" > "$evidence/result.txt"
    print "commit_sha=$commit_sha" >> "$evidence/result.txt"
    print "tree_sha=$tree_sha" >> "$evidence/result.txt"
    print "checked_at=$(now)" >> "$evidence/result.txt"
    sha256sum "$evidence/result.txt" > "$evidence/result.sha256"
    sqlite3 "$db" "INSERT INTO verify_results VALUES ('$task_id','PASSED','$commit_sha','$(print -r -- "$evidence" | sed "s/'/''/g")','$(now)') ON CONFLICT(task_id) DO UPDATE SET status='PASSED',commit_sha=excluded.commit_sha,evidence_path=excluded.evidence_path,checked_at=excluded.checked_at;"
    event task "$task_id" EXTERNAL_VERIFY "$commit_sha"
    print "$evidence"
    ;;
  integrate)
    ensure_capacity integration
    requested_change_set="${1:-}"
    if [[ -n "$requested_change_set" ]]; then
      change_set_id="$requested_change_set"
    else
      change_set_id="$(sqlite3 "$db" "SELECT c.change_set_id FROM change_sets c
        WHERE c.state='OPEN'
          AND EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state='VERIFIED')
          AND NOT EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state NOT IN ('VERIFIED','CANCELLED'))
          AND NOT EXISTS (SELECT 1 FROM integration_jobs j WHERE j.change_set_id=c.change_set_id AND j.membership_revision=c.membership_revision AND j.state IN ('PREPARING','VERIFYING','VERIFIED'))
        ORDER BY c.created_at LIMIT 1;")"
    fi
    [[ -n "$change_set_id" ]] || { print -u2 "統合可能なChange Setはありません"; exit 4; }
    membership_revision="$(sqlite3 "$db" "SELECT membership_revision FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")' AND state IN ('OPEN','FAILED');")"
    [[ -n "$membership_revision" ]] || { print -u2 "統合可能なChange Setではありません: $change_set_id"; exit 2; }
    missing_verify="$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id LEFT JOIN verify_results v ON v.task_id=t.task_id AND v.status='PASSED' WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND t.state='VERIFIED' AND v.task_id IS NULL;")"
    if (( missing_verify > 0 )); then
      print -u2 "統合待機中: $missing_verify件の外部検証が必要です"
      exit 2
    fi
    active="$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND t.state IN ('RUNNING','CLAIMED_DONE','VERIFYING');")"
    pending="$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND t.state NOT IN ('VERIFIED','CANCELLED');")"
    if (( active > 0 || pending > 0 )); then
      print -u2 "統合待機中: 実行中=$active 未完了=$pending"
      exit 2
    fi
    job_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    job_dir="$state_root/integration/$job_id"
    mkdir -p "$state_root/integration"
    integration_base_sha="$(git -C "$project_root" rev-parse HEAD)"
    git -C "$project_root" worktree add --detach "$job_dir" "$integration_base_sha" >/dev/null
    timestamp="$(now)"
    membership_text="$(sqlite3 "$db" "SELECT m.task_id || '|' || m.member_kind || '|' || t.state || '|' || COALESCE(t.commit_sha,'') FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' ORDER BY m.rowid;")"
    membership_hash="$(text_sha256 "$membership_text")"
    attempt_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    integration_evidence="$state_root/integration-evidence/$job_id"
    mkdir -p "$integration_evidence"
    sqlite3 "$db" "BEGIN; INSERT INTO integration_jobs(job_id,state,worktree,created_at,updated_at,change_set_id,membership_revision) VALUES ('$job_id','PREPARING','$(sql_quote "$job_dir")','$timestamp','$timestamp','$(sql_quote "$change_set_id")',$membership_revision); UPDATE change_sets SET state='INTEGRATING',updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$change_set_id")' AND membership_revision=$membership_revision; COMMIT;"
    sqlite3 "$db" "INSERT INTO integration_attempts(attempt_id,job_id,change_set_id,membership_revision,base_sha,membership_hash,status,evidence_path,created_at,updated_at) VALUES ('$attempt_id','$job_id','$(sql_quote "$change_set_id")',$membership_revision,'$integration_base_sha','$membership_hash','BUILDING','$(sql_quote "$integration_evidence")','$timestamp','$timestamp');"
    sqlite3 "$db" "UPDATE integration_jobs SET state='VERIFYING', updated_at='$(now)' WHERE job_id='$job_id' AND state='PREPARING';"
    failed=0
    while IFS='|' read -r task_id commit_sha; do
      [[ -n "$commit_sha" ]] || continue
      if ! git -C "$job_dir" cherry-pick --allow-empty "$commit_sha" >/dev/null 2>&1; then
        conflict_paths="$(git -C "$job_dir" diff --name-only --diff-filter=U || true)"
        conflict_base_sha="$(git -C "$job_dir" rev-parse HEAD)"
        git -C "$project_root" update-ref "refs/counterpointer/integration/$job_id/candidate" "$conflict_base_sha"
        {
          print "failure_kind=TEXT_CONFLICT"
          print "source_task=$task_id"
          print "source_commit=$commit_sha"
          print "base_sha=$conflict_base_sha"
          print 'conflict_paths='
          print -r -- "$conflict_paths"
        } > "$integration_evidence/conflict.txt"
        git -C "$job_dir" cherry-pick --abort >/dev/null 2>&1 || true
        failed=1
        failure_hash="$(text_sha256 "TEXT_CONFLICT|$commit_sha|$conflict_paths")"
        if create_integration_fix "$job_id" "$change_set_id" TEXT_CONFLICT "$failure_hash" "$conflict_base_sha" "$conflict_paths" "$task_id" "$commit_sha"; then
          conflict_task_id="$CREATED_INTEGRATION_FIX"
          event integration "$job_id" CONFLICT_TASK_CREATED "$conflict_task_id"
          failure_message="統合競合が発生しました: $job_id（修復Task: $conflict_task_id）"
          next_change_set_state=OPEN
        else
          conflict_task_id=""
          if [[ "$CREATED_INTEGRATION_FIX_ERROR" == REPEATED_FAILURE ]]; then
            failure_message="同じ統合競合が再発したため自動修復を停止しました: $job_id"
          else
            failure_message="統合競合の自動修復を停止しました: $job_id（$CREATED_INTEGRATION_FIX_ERROR: $(repair_stop_reason "$CREATED_INTEGRATION_FIX_ERROR")）"
          fi
          notify_parent_agent "$failure_message"
          event integration "$job_id" "$CREATED_INTEGRATION_FIX_ERROR" "$failure_hash"
          next_change_set_state=FAILED
        fi
        sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET status='FAILED',failure_kind='TEXT_CONFLICT',failure_hash='$failure_hash',updated_at='$(now)' WHERE attempt_id='$attempt_id'; UPDATE integration_jobs SET state='FAILED',candidate_sha='$conflict_base_sha',failure_reason='TEXT_CONFLICT',evidence_path='$(sql_quote "$integration_evidence")',updated_at='$(now)' WHERE job_id='$job_id'; UPDATE change_sets SET state='$next_change_set_state',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")' AND membership_revision=$membership_revision; COMMIT;"
        break
      fi
    done < <(sqlite3 "$db" "WITH RECURSIVE reach(src,dst) AS (SELECT source_task_id,target_task_id FROM task_edges WHERE edge_type='DEPENDENCY' UNION SELECT r.src,e.target_task_id FROM reach r JOIN task_edges e ON e.source_task_id=r.dst WHERE e.edge_type='DEPENDENCY') SELECT t.task_id,t.commit_sha FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id='$(sql_quote "$change_set_id")' AND t.state='VERIFIED' AND t.commit_sha IS NOT NULL AND NOT EXISTS (SELECT 1 FROM task_supersessions s JOIN tasks replacement ON replacement.task_id=s.replacement_task_id WHERE s.change_set_id=m.change_set_id AND s.superseded_task_id=t.task_id AND replacement.state='VERIFIED') ORDER BY (SELECT COUNT(*) FROM reach WHERE dst=t.task_id),m.rowid;")
    if (( failed )); then
      print -u2 "$failure_message"
      exit 1
    fi
    integration_candidate_sha="$(git -C "$job_dir" rev-parse HEAD)"
    git -C "$project_root" update-ref "refs/counterpointer/integration/$job_id/candidate" "$integration_candidate_sha"
    sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET candidate_sha='$integration_candidate_sha',status='VERIFYING',updated_at='$(now)' WHERE attempt_id='$attempt_id'; UPDATE integration_jobs SET candidate_sha='$integration_candidate_sha',evidence_path='$(sql_quote "$integration_evidence")',updated_at='$(now)' WHERE job_id='$job_id'; COMMIT;"
    if [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM metadata WHERE value='1' AND key IN ('integration_review_required','integration_review_required:$change_set_id');")" != 0 ]]; then
      jq -n --arg job "$job_id" --arg sha "$integration_candidate_sha" '{job_id:$job,candidate_sha:$sha,status:"pending",checks:[]}' > "$integration_evidence/acceptance-required.json"
      event integration "$job_id" ACCEPTANCE_PENDING "$integration_candidate_sha"
      notify_parent_agent "統合候補 $job_id / $integration_candidate_sha は最終検証待ちです。実際の保存・ブラウザ等の受入試験後、integration-verifyへ証拠を渡してください。未検証公開は拒否します。"
      print "$job_id"
      exit 0
    fi
    configured_verify_hook="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='integration_verify_hook';")"
    verify_hook="$integration_evidence/verify-hook.zsh"
    if [[ -n "$configured_verify_hook" ]]; then
      if ! git -C "$project_root" show "$integration_base_sha:$configured_verify_hook" > "$verify_hook" 2>/dev/null; then
        failure_hash="$(text_sha256 "VERIFY_CONFIGURATION|$configured_verify_hook")"
        sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET status='FAILED',failure_kind='VERIFY_CONFIGURATION',failure_hash='$failure_hash',updated_at='$(now)' WHERE attempt_id='$attempt_id'; UPDATE integration_jobs SET state='FAILED',failure_reason='VERIFY_CONFIGURATION',updated_at='$(now)' WHERE job_id='$job_id'; UPDATE change_sets SET state='FAILED',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")'; COMMIT;"
        print -u2 "統合verify hookを固定baseから取得できません: $configured_verify_hook"
        exit 2
      fi
    else
      cat > "$verify_hook" <<'EOF'
#!/bin/zsh
set -euo pipefail
git diff --check "$CPT_INTEGRATION_BASE_SHA" "$CPT_INTEGRATION_HEAD_SHA"
EOF
    fi
    chmod 500 "$verify_hook"
    verify_hook_hash="$(file_sha256 "$verify_hook")"
    if (cd "$job_dir" && CPT_INTEGRATION_BASE_SHA="$integration_base_sha" CPT_INTEGRATION_HEAD_SHA="$integration_candidate_sha" CPT_INTEGRATION_WORKTREE="$job_dir" /bin/zsh "$verify_hook") > "$integration_evidence/verify.log" 2>&1; then
      print 'status=passed' > "$integration_evidence/result.txt"
      print "base_sha=$integration_base_sha" >> "$integration_evidence/result.txt"
      print "candidate_sha=$integration_candidate_sha" >> "$integration_evidence/result.txt"
      print "membership_hash=$membership_hash" >> "$integration_evidence/result.txt"
      print "verify_hook_hash=$verify_hook_hash" >> "$integration_evidence/result.txt"
      /usr/bin/openssl dgst -sha256 "$integration_evidence/result.txt" > "$integration_evidence/result.sha256"
      sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET status='PASSED',verify_hook_hash='$verify_hook_hash',updated_at='$(now)' WHERE attempt_id='$attempt_id'; UPDATE integration_jobs SET state='VERIFIED',candidate_sha='$integration_candidate_sha',failure_reason=NULL,evidence_path='$(sql_quote "$integration_evidence")',updated_at='$(now)' WHERE job_id='$job_id' AND state='VERIFYING'; UPDATE change_sets SET state='VERIFIED',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")' AND membership_revision=$membership_revision; COMMIT;"
      create_integration_index_snapshot "$job_id" "$integration_candidate_sha"
    else
      affected_paths="$(git -C "$job_dir" diff --name-only "$integration_base_sha" "$integration_candidate_sha")"
      verify_log_hash="$(file_sha256 "$integration_evidence/verify.log")"
      failure_hash="$(text_sha256 "SEMANTIC_VERIFY|$verify_hook_hash|$verify_log_hash")"
      if create_integration_fix "$job_id" "$change_set_id" SEMANTIC_VERIFY "$failure_hash" "$integration_candidate_sha" "$affected_paths"; then
        semantic_fix_task="$CREATED_INTEGRATION_FIX"
        next_change_set_state=OPEN
        failure_message="統合後verifyに失敗しました: $job_id（修復Task: $semantic_fix_task）"
        event integration "$job_id" SEMANTIC_FIX_TASK_CREATED "$semantic_fix_task"
      else
        next_change_set_state=FAILED
        if [[ "$CREATED_INTEGRATION_FIX_ERROR" == REPEATED_FAILURE ]]; then
          failure_message="同じ統合後verify失敗が再発したため自動修復を停止しました: $job_id"
        else
          failure_message="統合後verifyの自動修復を停止しました: $job_id（$CREATED_INTEGRATION_FIX_ERROR: $(repair_stop_reason "$CREATED_INTEGRATION_FIX_ERROR")）"
        fi
        notify_parent_agent "$failure_message"
        event integration "$job_id" "$CREATED_INTEGRATION_FIX_ERROR" "$failure_hash"
      fi
      sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET status='FAILED',verify_hook_hash='$verify_hook_hash',failure_kind='SEMANTIC_VERIFY',failure_hash='$failure_hash',updated_at='$(now)' WHERE attempt_id='$attempt_id'; UPDATE integration_jobs SET state='FAILED',candidate_sha='$integration_candidate_sha',failure_reason='SEMANTIC_VERIFY',evidence_path='$(sql_quote "$integration_evidence")',updated_at='$(now)' WHERE job_id='$job_id'; UPDATE change_sets SET state='$next_change_set_state',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")' AND membership_revision=$membership_revision; COMMIT;"
      print -u2 "$failure_message"
      exit 1
    fi
    print "$job_id"
    event integration "$job_id" VERIFIED
    ;;
  integration-verify)
    job_id="${1:-}"; acceptance_input="${2:-}"
    [[ "$job_id" =~ '^[a-f0-9-]+$' && -f "$acceptance_input" ]] || { print -u2 '使い方: integration-verify JOB EVIDENCE_JSON'; exit 2; }
    row="$(sqlite3 "$db" "SELECT j.worktree,j.candidate_sha,j.change_set_id,j.membership_revision,j.evidence_path FROM integration_jobs j JOIN change_sets c USING(change_set_id) WHERE j.job_id='$(sql_quote "$job_id")' AND j.state='VERIFYING' AND c.state='INTEGRATING' AND j.membership_revision=c.membership_revision AND NOT EXISTS(SELECT 1 FROM change_set_tasks m JOIN tasks t USING(task_id) WHERE m.change_set_id=c.change_set_id AND t.state<>'VERIFIED');")"
    [[ -n "$row" ]] || { print -u2 '現構成の最終検証待ち統合jobが必要です'; exit 3; }
    IFS='|' read -r job_dir candidate_sha change_set_id membership_revision integration_evidence <<< "$row"
    [[ -s "$integration_evidence/acceptance-required.json" ]] || exit 3
    [[ "$(git -C "$job_dir" rev-parse HEAD)" == "$candidate_sha" ]] && git -C "$job_dir" diff --quiet HEAD || { print -u2 '候補SHAまたは追跡ファイルが変化しています'; exit 3; }
    python3 - "$acceptance_input" "$candidate_sha" "$job_id" "$integration_evidence" "$job_dir" <<'ACCEPT'
import sys,json,hashlib,pathlib
src,sha,job,out,work=sys.argv[1:];r=json.loads(pathlib.Path(src).read_text())
assert r['candidate_sha']==sha and r['job_id']==job and r['status']=='passed'
assert r['remaining_checks']==[]
assert isinstance(r['checks'],list) and r['checks']
for check in r['checks']:
 assert check['exit_code']==0 and check['command'].strip() and check['artifacts']
 for artifact in check['artifacts']:
  p=pathlib.Path(artifact['path']).resolve(); assert p.is_file()
  assert p.is_relative_to(pathlib.Path(work).resolve()) or p.is_relative_to(pathlib.Path(out).resolve())
  assert hashlib.sha256(p.read_bytes()).hexdigest()==artifact['sha256']
dst=pathlib.Path(out)/'acceptance.json';dst.write_text(json.dumps(r,ensure_ascii=False,indent=2)+'\n')
ACCEPT
    [[ $? == 0 ]] || exit 3
    acceptance_hash="$(file_sha256 "$integration_evidence/acceptance.json")"
    print "status=passed\ncandidate_sha=$candidate_sha\nacceptance_sha256=$acceptance_hash" > "$integration_evidence/result.txt"
    /usr/bin/openssl dgst -sha256 "$integration_evidence/result.txt" > "$integration_evidence/result.sha256"
    sqlite3 "$db" "BEGIN; UPDATE integration_attempts SET status='PASSED',updated_at='$(now)' WHERE job_id='$job_id' AND candidate_sha='$candidate_sha'; UPDATE integration_jobs SET state='VERIFIED',failure_reason=NULL,updated_at='$(now)' WHERE job_id='$job_id' AND state='VERIFYING'; UPDATE change_sets SET state='VERIFIED',updated_at='$(now)' WHERE change_set_id='$change_set_id' AND membership_revision=$membership_revision; INSERT INTO metadata(key,value) VALUES('integration_acceptance:$job_id','$candidate_sha|$acceptance_hash') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
    create_integration_index_snapshot "$job_id" "$candidate_sha"
    event integration "$job_id" ACCEPTANCE_PASSED "$candidate_sha $acceptance_hash"
    print "統合候補の最終検証を記録しました: $candidate_sha"
    ;;
  retry-integration)
    job_id="${1:-}"
    [[ -n "$job_id" ]] || { print -u2 "統合ジョブIDが必要です"; exit 2; }
    state="$(sqlite3 "$db" "SELECT state FROM integration_jobs WHERE job_id='$job_id';")"
    [[ "$state" == FAILED ]] || { print -u2 "この統合ジョブは再試行できません: $state"; exit 2; }
    retry_change_set="$(sqlite3 "$db" "SELECT change_set_id FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
    [[ -n "$retry_change_set" ]] || { print -u2 "旧形式の統合ジョブは自動再試行できません: $job_id"; exit 2; }
    event integration "$job_id" RETRY
    "$0" -C "$project_root" integrate "$retry_change_set"
    ;;
  publish)
    publish_action="${1:-}"
    case "$publish_action" in
      set-base)
        request_id="${2:-}"; new_base="${3:-}"; new_base_sha="${4:-}"; apply_mode="${5:---dry-run}"
        [[ -n "$request_id" && -n "$new_base" && -n "$new_base_sha" && ( "$apply_mode" == --dry-run || "$apply_mode" == --apply ) && $# -le 5 ]] || { print -u2 '使い方: cpt publish set-base REQUEST BRANCH SHA [--apply]'; exit 2; }
        git check-ref-format --branch "$new_base" >/dev/null || exit 2
        new_base_sha="$(git -C "$project_root" rev-parse --verify "$new_base_sha^{commit}")" || exit 2
        request_id="$(sqlite3 "$db" "SELECT request_id FROM publish_requests WHERE request_id='$(sql_quote "$request_id")';")"
        [[ -n "$request_id" ]] || { print -u2 '公開要求がありません'; exit 2; }
        row="$(sqlite3 "$db" "SELECT p.state,p.job_id,p.head_sha,r.base_branch,r.remote_name,r.branch_name,r.pr_state,COALESCE(r.last_pushed_sha,''),COALESCE(r.pr_url,''),COALESCE(r.pr_number,'') FROM publish_requests p JOIN pull_requests r USING(request_id) WHERE p.request_id='$request_id';")"
        IFS='|' read -r request_state job_id head_sha old_base remote_name branch pr_state pushed_sha pr_url pr_number <<< "$row"
        [[ "$request_state" == PREPARED && "$pr_state" == NOT_CREATED && -z "$pushed_sha$pr_url$pr_number" ]] || { print -u2 'base変更は未公開・未pushのPREPARED要求のみ対応しています'; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM events WHERE entity_type='publish' AND entity_id='$request_id' AND event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY');")" == 0 ]] || { print -u2 '公開試行済みのbaseは変更できません'; exit 2; }
        [[ "$new_base" != "$branch" ]] || { print -u2 'baseとheadは別branchが必要です'; exit 2; }
        integration_base="$(sqlite3 "$db" "SELECT base_sha FROM integration_attempts WHERE job_id='$job_id' ORDER BY rowid DESC LIMIT 1;")"
        [[ "$integration_base" == "$new_base_sha" && "$(sqlite3 "$db" "SELECT candidate_sha FROM integration_jobs WHERE job_id='$job_id' AND state='VERIFIED';")" == "$head_sha" && "$(git -C "$project_root" rev-parse "refs/counterpointer/publish/$request_id")" == "$head_sha" ]] || { print -u2 '新baseは検証した統合基点と一致する必要があります'; exit 2; }
        git -C "$project_root" merge-base --is-ancestor "$new_base_sha" "$head_sha" || exit 2
        remote_base_sha="$(run_network_command git -C "$project_root" ls-remote --heads "$remote_name" "refs/heads/$new_base" | awk 'NR==1 {print $1}')"
        [[ "$remote_base_sha" == "$new_base_sha" ]] || { print -u2 'remoteのbase branchが指定SHAと一致しません'; exit 2; }
        print "PR比較先: $old_base → $new_base ($new_base_sha)"
        [[ "$apply_mode" == --apply ]] || exit 0
        if [[ "$old_base" == "$new_base" && "$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='publish_base_sha:$request_id';")" == "$new_base_sha" ]]; then print '比較先は設定済みです'; exit 0; fi
        base_archive="$state_root/diagnostics/publish-base/$request_id/$(uuidgen | tr '[:upper:]' '[:lower:]')"
        mkdir -p "$base_archive"; chmod 700 "$base_archive"
        sqlite3 "$db" ".backup '$base_archive/before.sqlite3'"
        chmod 600 "$base_archive/before.sqlite3"
        manifest_path="$state_root/publish/$request_id/manifest.txt"
        cp "$manifest_path" "$base_archive/manifest.before.txt"
        body_path="$(sqlite3 "$db" "SELECT body_path FROM pull_requests WHERE request_id='$request_id';")"
        [[ -s "$body_path" ]] || { print -u2 'PR本文がありません'; exit 2; }
        awk -v base="$new_base" -v body_hash="$(file_sha256 "$body_path")" '/^base_branch=/ {print "base_branch=" base; next} /^body_sha256=/ {print "body_sha256=" body_hash; next} {print}' "$manifest_path" > "$base_archive/manifest.after.txt"
        event publish "$request_id" BASE_CHANGE_INTENT "base=$new_base sha=$new_base_sha archive=$base_archive"
        cp "$base_archive/manifest.after.txt" "$manifest_path"
        sqlite3 "$db" "BEGIN IMMEDIATE; UPDATE pull_requests SET base_branch='$(sql_quote "$new_base")',updated_at='$(now)' WHERE request_id='$request_id'; INSERT INTO metadata(key,value) VALUES('publish_base_sha:$request_id','$new_base_sha') ON CONFLICT(key) DO UPDATE SET value=excluded.value; DELETE FROM publish_approvals WHERE request_id='$request_id'; COMMIT;"
        event publish "$request_id" BASE_CHANGED "base=$new_base sha=$new_base_sha archive=$base_archive approvals=revoked"
        print '比較先を変更しました。候補SHAは維持し、旧承認を解除しました。'
        ;;
      repair-branch)
        request_id="${2:-}"; repair_mode="${3:---dry-run}"
        [[ -n "$request_id" && ( "$repair_mode" == --dry-run || "$repair_mode" == --apply ) && $# -le 3 ]] || { print -u2 '使い方: cpt publish repair-branch <request-id> [--apply]'; exit 2; }
        request_id="$(sqlite3 "$db" "SELECT request_id FROM publish_requests WHERE request_id='$(sql_quote "$request_id")';")"
        [[ -n "$request_id" ]] || { print -u2 '公開要求がありません'; exit 2; }
        row="$(sqlite3 "$db" "SELECT p.state,r.change_set_id,r.pr_state,COALESCE(r.last_pushed_sha,''),COALESCE(r.pr_url,''),COALESCE(r.pr_number,'') FROM publish_requests p JOIN pull_requests r USING(request_id) WHERE p.request_id='$request_id';")"
        IFS='|' read -r request_state change_set_id pr_state pushed_sha pr_url pr_number <<< "$row"
        [[ "$request_state" == PREPARED && "$pr_state" == NOT_CREATED && -z "$pushed_sha$pr_url$pr_number" ]] || { print -u2 '未公開・未pushのPREPARED要求だけ修復できます'; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM events WHERE entity_type='publish' AND entity_id='$request_id' AND event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY');")" == 0 ]] || { print -u2 '公開試行済みの要求は自動修復できません'; exit 2; }
        old_branch="$(sqlite3 "$db" "SELECT branch_name FROM pull_requests WHERE request_id='$request_id';")"
        if git check-ref-format --branch "$old_branch" >/dev/null 2>&1; then
          print '公開ブランチ名は正常です。変更していません。'
          exit 0
        fi
        change_set_title="$(sqlite3 "$db" "SELECT title FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")';")"
        branch="$(publish_branch_name "$change_set_id" "$change_set_title")" || exit 2
        row="$(sqlite3 "$db" "SELECT p.job_id,p.head_sha,r.base_branch,r.remote_name,r.draft,r.body_path FROM publish_requests p JOIN pull_requests r USING(request_id) WHERE p.request_id='$request_id';")"
        IFS='|' read -r job_id head_sha base_branch remote_name draft body_path <<< "$row"
        [[ "$(sqlite3 "$db" "SELECT state FROM integration_jobs WHERE job_id='$job_id';")" == VERIFIED && "$(sqlite3 "$db" "SELECT candidate_sha FROM integration_jobs WHERE job_id='$job_id';")" == "$head_sha" && "$(git -C "$project_root" rev-parse "refs/counterpointer/publish/$request_id")" == "$head_sha" && -s "$body_path" ]] || { print -u2 '統合候補・固定SHA・公開準備の整合性を確認できません'; exit 2; }
        print "修復後ブランチ: $branch"
        [[ "$repair_mode" == --apply ]] || exit 0
        repair_dir="$state_root/diagnostics/publish-branch/$request_id"
        mkdir -p "$repair_dir"; chmod 700 "$repair_dir"
        [[ ! -e "$repair_dir/before.sqlite3" ]] || { print -u2 '修復記録が既にあります。前回の処理結果を確認してください'; exit 2; }
        sqlite3 "$db" ".backup '$repair_dir/before.sqlite3'"
        chmod 600 "$repair_dir/before.sqlite3"
        manifest_path="$state_root/publish/$request_id/manifest.txt"
        [[ ! -f "$manifest_path" ]] || cp "$manifest_path" "$repair_dir/manifest.before.txt"
        {
          print "request_id=$request_id"
          print "job_id=$job_id"
          print "change_set_id=$change_set_id"
          print "head_sha=$head_sha"
          print "branch=$branch"
          print "base_branch=$base_branch"
          print "remote=$remote_name"
          print "draft=$draft"
          print "body_sha256=$(file_sha256 "$body_path")"
        } > "$repair_dir/manifest.after.txt"
        event publish "$request_id" BRANCH_REPAIR_INTENT "branch=$branch archive=$repair_dir"
        cp "$repair_dir/manifest.after.txt" "$manifest_path"
        sqlite3 "$db" "BEGIN IMMEDIATE; UPDATE pull_requests SET branch_name='$(sql_quote "$branch")',updated_at='$(now)' WHERE request_id='$request_id'; DELETE FROM publish_approvals WHERE request_id='$request_id'; COMMIT;"
        event publish "$request_id" BRANCH_REPAIRED "branch=$branch archive=$repair_dir approvals=revoked"
        print '公開ブランチ名を修復しました。固定SHA・要求IDは維持し、旧承認を解除しました。push・PR作成は行っていません。'
        ;;
      enable)
        [[ "${2:-}" == --remote && -n "${3:-}" && "${4:-}" == --confirm-url && -n "${5:-}" ]] || { print -u2 '使い方: cpt publish enable --remote <name> --confirm-url <URL>'; exit 2; }
        remote_name="$3"; confirmed_url="$5"
        actual_url="$(git -C "$project_root" remote get-url "$remote_name" 2>/dev/null || true)"
        [[ -n "$actual_url" && "$actual_url" == "$confirmed_url" ]] || { print -u2 "remote URLが一致しません。実際: ${actual_url:-未登録}"; exit 3; }
        remote_hash="$(text_sha256 "$actual_url")"
        sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('publish_remote','$(sql_quote "$remote_name")') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('publish_remote_url_hash','$remote_hash') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('publish_mode','automatic') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
        event project "$project_root" AUTOMATIC_PUBLISH_ENABLED "$remote_name $remote_hash"
        print "自動PR公開を有効にしました: remote=$remote_name"
        print 'mainへの直接push、force push、自動mergeは行いません。'
        ;;
      disable)
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('publish_mode','manual') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        event project "$project_root" AUTOMATIC_PUBLISH_DISABLED ''
        print '自動PR公開を無効にしました'
        ;;
      approve)
        request_id="${2:-}"
        [[ -n "$request_id" ]] || { print -u2 "公開要求IDが必要です"; exit 2; }
        request_row="$(sqlite3 "$db" "SELECT state || '|' || head_sha FROM publish_requests WHERE request_id='$(sql_quote "$request_id")';")"
        [[ -n "$request_row" ]] || { print -u2 "公開要求が見つかりません: $request_id"; exit 2; }
        request_state="${request_row%%|*}"; head_sha="${request_row#*|}"
        [[ "$request_state" == PREPARED ]] || { print -u2 "承認可能な状態ではありません: $request_state"; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM publish_requests p JOIN integration_jobs j ON j.job_id=p.job_id JOIN change_sets c ON c.change_set_id=j.change_set_id WHERE p.request_id='$(sql_quote "$request_id")' AND j.state='VERIFIED' AND c.state='VERIFIED' AND j.membership_revision=c.membership_revision AND NOT EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state<>'VERIFIED');")" == 1 ]] || { print -u2 '現在のTask構成ではこの公開要求を承認できません'; exit 3; }
        sqlite3 "$db" "INSERT INTO publish_approvals(request_id,head_sha,approved_by,approved_at) VALUES ('$(sql_quote "$request_id")','$head_sha','owner','$(now)') ON CONFLICT(request_id) DO UPDATE SET head_sha=excluded.head_sha,approved_by=excluded.approved_by,approved_at=excluded.approved_at;"
        event publish "$request_id" OWNER_APPROVED "$head_sha"
        print "公開を承認しました: $request_id"
        print "承認対象SHA: $head_sha"
        print '監視がこの固定SHAの公開を実行します。接続失敗時も承認を保持して再試行します。'
        ;;
      apply)
        ensure_capacity publish
        request_id="${2:-}"
        [[ -n "$request_id" ]] || { print -u2 "公開要求IDが必要です"; exit 2; }
        publish_row="$(sqlite3 "$db" "SELECT p.job_id || '|' || p.state || '|' || p.head_sha || '|' || r.change_set_id || '|' || r.branch_name || '|' || r.base_branch || '|' || r.remote_name || '|' || r.body_path || '|' || r.draft || '|' || COALESCE(r.last_pushed_sha,'') FROM publish_requests p JOIN pull_requests r ON r.request_id=p.request_id WHERE p.request_id='$(sql_quote "$request_id")';")"
        [[ -n "$publish_row" ]] || { print -u2 "公開要求が見つかりません: $request_id"; exit 2; }
        IFS='|' read -r job_id request_state head_sha change_set_id branch base_branch remote_name body_path draft last_pushed_sha <<< "$publish_row"
        retry_publish_failure="$(sqlite3 "$db" "SELECT COALESCE(failure_reason,'') FROM publish_requests WHERE request_id='$(sql_quote "$request_id")';")"
        [[ "$request_state" == PREPARED || ( "$request_state" == FAILED && "$retry_publish_failure" == PR_RESULT_INVALID && "$last_pushed_sha" == "$head_sha" ) ]] || { print -u2 "適用可能な状態ではありません: $request_state"; exit 2; }
        [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM integration_jobs j JOIN change_sets c ON c.change_set_id=j.change_set_id WHERE j.job_id='$(sql_quote "$job_id")' AND j.change_set_id='$(sql_quote "$change_set_id")' AND j.state='VERIFIED' AND c.state='VERIFIED' AND j.membership_revision=c.membership_revision AND NOT EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state<>'VERIFIED');")" == 1 ]] || { print -u2 '現在のTask構成ではこの公開要求を適用できません'; exit 3; }
        branch="$(sqlite3 "$db" "SELECT branch_name FROM pull_requests WHERE request_id='$(sql_quote "$request_id")';")"
        git check-ref-format --branch "$branch" >/dev/null || { print -u2 '公開branchが不正です。publish repair-branchで修復してください'; exit 2; }
        approved_sha="$(sqlite3 "$db" "SELECT COALESCE(head_sha,'') FROM publish_approvals WHERE request_id='$(sql_quote "$request_id")';")"
        publish_mode="$(sqlite3 "$db" "SELECT COALESCE(value,'manual') FROM metadata WHERE key='publish_mode';")"; [[ -n "$publish_mode" ]] || publish_mode=manual
        if [[ "$publish_mode" == automatic ]]; then
          configured_remote_hash="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='publish_remote_url_hash';")"
          current_remote_url="$(git -C "$project_root" remote get-url "$remote_name" 2>/dev/null || true)"
          [[ -n "$configured_remote_hash" && "$configured_remote_hash" == "$(text_sha256 "$current_remote_url")" ]] || { print -u2 '自動公開で確認済みのremote URLと一致しません'; exit 3; }
        else
          [[ -n "$approved_sha" && "$approved_sha" == "$head_sha" ]] || { print -u2 "この固定SHAに対するオーナー承認がありません: cpt publish approve $request_id"; exit 3; }
        fi
        assert_integration_acceptance "$job_id" || exit $?
        candidate_sha="$(sqlite3 "$db" "SELECT COALESCE(candidate_sha,'') FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")';")"
        ref_sha="$(git -C "$project_root" rev-parse "refs/counterpointer/publish/$request_id" 2>/dev/null || true)"
        [[ "$candidate_sha" == "$head_sha" && "$ref_sha" == "$head_sha" && -f "$body_path" ]] || { print -u2 "公開準備が変更されています。再準備と再承認が必要です"; exit 3; }
        [[ "$branch" == counterpointer/change/* && "$branch" != "$base_branch" ]] || { print -u2 "許可されていない公開branchです: $branch"; exit 3; }
        gh_bin="${COUNTERPOINTER_GH_BIN:-gh}"
        command -v "$gh_bin" >/dev/null 2>&1 || { print -u2 "PR作成にはgh CLIが必要です"; exit 2; }
        git -C "$project_root" remote get-url "$remote_name" >/dev/null 2>&1 || { print -u2 "remoteが見つかりません: $remote_name"; exit 2; }
        pr_row="$(cd "$project_root" && run_network_command "$gh_bin" pr list --head "$branch" --state all --limit 1 --json number,state,url --jq '.[0] // empty | [.number,.state,.url] | @tsv')" || { print -u2 'GitHubのPR一覧を確認できません。公開を停止しました'; exit 3; }
        if [[ -n "$pr_row" ]]; then
          IFS=$'\t' read -r pr_number pr_state pr_url <<< "$pr_row"
          pr_state="${pr_state:u}"
          if [[ "$pr_state" == MERGED || "$pr_state" == CLOSED ]]; then
            sqlite3 "$db" "BEGIN; UPDATE pull_requests SET pr_number=$pr_number,pr_url='$(sql_quote "$pr_url")',pr_state='$pr_state',updated_at='$(now)' WHERE request_id='$(sql_quote "$request_id")'; UPDATE change_sets SET state='$pr_state',updated_at='$(now)' WHERE change_set_id='$(sql_quote "$change_set_id")'; COMMIT;"
            print "既存PRは${pr_state}です。pushを中止しました: $pr_url"
            exit 0
          fi
        fi
        remote_head="$(run_network_command git -C "$project_root" ls-remote --heads "$remote_name" "refs/heads/$branch" | awk 'NR==1 {print $1}')"
        if [[ -n "$remote_head" ]]; then
          if [[ -z "$last_pushed_sha" || "$remote_head" != "$last_pushed_sha" ]]; then
            sqlite3 "$db" "BEGIN; UPDATE publish_requests SET state='FAILED',failure_reason='REMOTE_DIVERGED',updated_at='$(now)' WHERE request_id='$(sql_quote "$request_id")'; UPDATE pull_requests SET failure_reason='REMOTE_DIVERGED',updated_at='$(now)' WHERE request_id='$(sql_quote "$request_id")'; COMMIT;"
            event publish "$request_id" REMOTE_DIVERGED "$remote_head"
            print -u2 "remote branchがDB記録と一致しないためpushを拒否しました: $remote_head"
            exit 4
          fi
          git -C "$project_root" merge-base --is-ancestor "$last_pushed_sha" "$head_sha" || { print -u2 "fast-forwardでない更新を拒否しました"; exit 4; }
        fi
        pinned_base_sha="$(sqlite3 "$db" "SELECT value FROM metadata WHERE key='publish_base_sha:$request_id';")"
        if [[ -n "$pinned_base_sha" ]]; then
          remote_base_sha="$(run_network_command git -C "$project_root" ls-remote --heads "$remote_name" "refs/heads/$base_branch" | awk 'NR==1 {print $1}')"
          [[ "$remote_base_sha" == "$pinned_base_sha" ]] || { print -u2 '比較先branchが確認済みSHAから変わりました。公開を停止します'; exit 3; }
        fi
        event publish "$request_id" PUSH_INTENT "$head_sha $remote_name $branch"
        run_network_command git -C "$project_root" push "$remote_name" "${head_sha}:refs/heads/$branch"
        sqlite3 "$db" "UPDATE pull_requests SET last_pushed_sha='$head_sha',updated_at='$(now)' WHERE request_id='$(sql_quote "$request_id")';"
        if [[ -z "$pr_row" ]]; then
          pr_title="$(sqlite3 "$db" "SELECT title FROM change_sets WHERE change_set_id='$(sql_quote "$change_set_id")';")"
          pr_title="$(print -r -- "$pr_title" | /usr/bin/tr '\r' ' ' | /usr/bin/awk 'NF {sub(/^#+[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); if (length($0)) {print; exit}}')"
          [[ -n "$pr_title" ]] || pr_title="Change Set $change_set_id"
          gh_args=(pr create --head "$branch" --base "$base_branch" --title "$pr_title" --body-file "$body_path")
          (( draft == 0 )) || gh_args+=(--draft)
          event publish "$request_id" PR_CREATE_INTENT "$branch"
          (cd "$project_root" && run_network_command "$gh_bin" "${gh_args[@]}") >/dev/null
          pr_row="$(cd "$project_root" && run_network_command "$gh_bin" pr list --head "$branch" --state all --limit 1 --json number,state,url --jq '.[0] // empty | [.number,.state,.url] | @tsv')"
        fi
        IFS=$'\t' read -r pr_number pr_state pr_url <<< "$pr_row"
        [[ -n "$pr_number" && "${pr_state:u}" == OPEN && -n "$pr_url" ]] || { sqlite3 "$db" "UPDATE publish_requests SET state='FAILED',failure_reason='PR_RESULT_INVALID',updated_at='$(now)' WHERE request_id='$(sql_quote "$request_id")';"; print -u2 "PR作成結果を確認できません"; exit 4; }
        timestamp="$(now)"
        duplicate_requests="$(sqlite3 "$db" "SELECT p.request_id FROM publish_requests p JOIN pull_requests r USING(request_id) WHERE p.request_id<>'$request_id' AND p.job_id='$job_id' AND p.head_sha='$head_sha' AND p.state='PREPARED' AND r.pr_state='NOT_CREATED' AND COALESCE(r.last_pushed_sha,'')='' AND NOT EXISTS (SELECT 1 FROM events e WHERE e.entity_type='publish' AND e.entity_id=p.request_id AND e.event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY'));")"
        sqlite3 "$db" "BEGIN; UPDATE publish_requests SET state='FAILED',failure_reason='SUPERSEDED_BY_PUBLISHED_REQUEST',updated_at='$timestamp' WHERE request_id IN (SELECT p.request_id FROM publish_requests p JOIN pull_requests r USING(request_id) WHERE p.request_id<>'$request_id' AND p.job_id='$job_id' AND p.head_sha='$head_sha' AND p.state='PREPARED' AND r.pr_state='NOT_CREATED' AND COALESCE(r.last_pushed_sha,'')='' AND NOT EXISTS (SELECT 1 FROM events e WHERE e.entity_type='publish' AND e.entity_id=p.request_id AND e.event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY'))); UPDATE publish_requests SET state='PUBLISHED',failure_reason=NULL,updated_at='$timestamp' WHERE request_id='$(sql_quote "$request_id")'; UPDATE pull_requests SET pr_number=$pr_number,pr_url='$(sql_quote "$pr_url")',pr_state='OPEN',last_pushed_sha='$head_sha',failure_reason=NULL,updated_at='$timestamp' WHERE request_id='$(sql_quote "$request_id")'; UPDATE integration_jobs SET state='PR_READY',updated_at='$timestamp' WHERE job_id='$(sql_quote "$job_id")'; UPDATE change_sets SET state='AWAITING_MERGE',updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$change_set_id")'; COMMIT;"
        emission_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        sqlite3 "$db" "INSERT INTO notifications(emission_id,entity_id,message,state,attempts,created_at,updated_at) VALUES ('$emission_id','$(sql_quote "$job_id")','PR準備完了: $(sql_quote "$pr_url")','PENDING',0,'$timestamp','$timestamp');"
        [[ -z "$duplicate_requests" ]] || event publish "$request_id" DUPLICATE_REQUESTS_SUPERSEDED "$duplicate_requests"
        event publish "$request_id" PR_READY "$pr_number $pr_url"
        print "PR準備完了: $pr_url"
        print 'マージは自動実行しません。オーナーがPRを確認して手動でマージしてください。'
        ;;
      sync)
        request_id="${2:-}"
        [[ -n "$request_id" && $# == 2 ]] || { print -u2 '使い方: cpt publish sync <公開要求ID>'; exit 2; }
        refresh_main_and_index_after_merge "$request_id"
        ;;
      reconcile)
        request_id="${2:-}"
        [[ -n "$request_id" ]] || { print -u2 "公開要求IDが必要です"; exit 2; }
        pr_info="$(sqlite3 "$db" "SELECT r.branch_name || '|' || r.change_set_id FROM pull_requests r WHERE r.request_id='$(sql_quote "$request_id")' AND r.pr_number IS NOT NULL;")"
        [[ -n "$pr_info" ]] || { print -u2 "PRが未作成です"; exit 2; }
        branch="${pr_info%%|*}"; change_set_id="${pr_info#*|}"
        gh_bin="${COUNTERPOINTER_GH_BIN:-gh}"
        pr_row="$(cd "$project_root" && run_network_command "$gh_bin" pr list --head "$branch" --state all --limit 1 --json number,state,url,mergeCommit,baseRefName --jq '.[0] // empty | [.number,.state,.url,(.mergeCommit.oid // "-"),.baseRefName] | @tsv')" || { event publish "$request_id" PR_LOOKUP_FAILED 'GitHub照会が失敗またはタイムアウトしました。次の監視周期で再試行します'; exit 3; }
        IFS=$'\t' read -r pr_number pr_state pr_url pr_merge_sha pr_base_branch <<< "$pr_row"; pr_state="${pr_state:u}"
        case "$pr_state" in OPEN|MERGED|CLOSED) ;; *) print -u2 "PR状態を確認できません"; exit 4;; esac
        [[ "$pr_number" == "$(sqlite3 "$db" "SELECT pr_number FROM pull_requests WHERE request_id='$(sql_quote "$request_id")';")" ]] || { print -u2 '記録済みPRと照会結果が一致しません'; exit 4; }
        git check-ref-format --branch "$pr_base_branch" >/dev/null 2>&1 || { print -u2 'PRのマージ先を確認できません'; exit 4; }
        timestamp="$(now)"
        sqlite3 "$db" "UPDATE pull_requests SET base_branch='$(sql_quote "$pr_base_branch")',pr_number=$pr_number,pr_url='$(sql_quote "$pr_url")',pr_state='$pr_state',updated_at='$timestamp' WHERE request_id='$(sql_quote "$request_id")';"
        if [[ "$pr_state" == MERGED || "$pr_state" == CLOSED ]]; then sqlite3 "$db" "UPDATE change_sets SET state='$pr_state',updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$change_set_id")';"; fi
        if [[ "$pr_state" == MERGED ]]; then
          if print -r -- "$pr_merge_sha" | /usr/bin/grep -Eq '^[0-9a-f]{40,64}$'; then
            # squash/rebase mergeでは候補SHAとmain上のSHAが異なる。
            merged_job="$(sqlite3 "$db" "SELECT job_id FROM publish_requests WHERE request_id='$(sql_quote "$request_id")';")"
            sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('integration_merge:$(sql_quote "$merged_job")','$pr_merge_sha') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
          fi
          print 'マージを記録しました。最終取り込み先の同期・索引更新は監視プロセスが処理します。'
          if [[ "${3:-}" != --record-only && -s "$state_root/supervisor.pid" && "$PPID" == "$(<"$state_root/supervisor.pid")" ]]; then
            refresh_main_and_index_after_merge "$request_id" || true
          fi
        fi
        event publish "$request_id" PR_RECONCILED "$pr_state $pr_url"
        print "PR状態: $pr_state $pr_url"
        ;;
      ''|--*) print -u2 "使い方: cpt publish <ジョブID> | approve|apply|reconcile <公開要求ID>"; exit 2;;
      *) prepare_publish_request "$publish_action";;
    esac
    ;;
  reconcile)
    repaired=0
    "$0" -C "$project_root" runtime reconcile reconcile 0 || true
    while IFS='|' read -r task_id state worktree; do
      [[ "$state" == RUNNING || "$state" == CLAIMED_DONE || "$state" == VERIFYING ]] || continue
      if [[ -z "$worktree" || ! -d "$worktree" ]]; then
        sqlite3 "$db" "UPDATE tasks SET state='FAILED', updated_at='$(now)' WHERE task_id='$task_id';"
        sqlite3 "$db" "UPDATE task_runtimes SET state='FAILED',updated_at='$(now)' WHERE task_id='$(sql_quote "$task_id")' AND state NOT IN ('COMPLETED','CANCELLED','FAILED');"
        event task "$task_id" RECONCILE_FAILED "worktree missing"
        repaired=$((repaired+1))
      fi
    done < <(sqlite3 "$db" 'SELECT task_id,state,worktree FROM tasks;')
    while IFS='|' read -r task_id commit_sha evidence; do
      [[ -n "$task_id" ]] || continue
      if [[ ! -f "$evidence/result.txt" || ! -f "$evidence/result.sha256" ]]; then
        sqlite3 "$db" "DELETE FROM verify_results WHERE task_id='$task_id';"
        event task "$task_id" RECONCILE_VERIFY_INVALID "evidence missing"
        repaired=$((repaired+1))
      fi
    done < <(sqlite3 "$db" 'SELECT task_id,commit_sha,evidence_path FROM verify_results WHERE status="PASSED";')
    parent_row="$(sqlite3 "$db" "SELECT generation,COALESCE(process_pid,'') FROM parent_runtimes WHERE state='ACTIVE' ORDER BY generation DESC LIMIT 1;")"
    if [[ -n "$parent_row" ]]; then
      parent_generation="${parent_row%%|*}"; parent_pid="${parent_row#*|}"
      if [[ "$parent_pid" == <-> ]] && ! kill -0 "$parent_pid" 2>/dev/null; then
        sqlite3 "$db" "UPDATE parent_runtimes SET state='LOST',updated_at='$(now)' WHERE generation=$parent_generation AND state='ACTIVE';"
        event parent "$parent_generation" PARENT_SESSION_LOST "pid=$parent_pid"
        repaired=$((repaired+1))
      fi
    fi
    print "整合性修復完了: 修復数=$repaired"
    ;;
  backup)
    ensure_capacity backup
    backup_path="${1:-$state_root/backups/state-$(date -u +%Y%m%dT%H%M%SZ).sqlite3}"
    mkdir -p "${backup_path:h}"
    sqlite3 "$db" ".backup '$backup_path'"
    [[ "$(sqlite3 "$backup_path" 'PRAGMA integrity_check;')" == ok ]] || { print -u2 "backupの整合性検査に失敗しました"; exit 1; }
    backup_hash="$(file_sha256 "$backup_path")"
    backup_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    sqlite3 "$db" "INSERT OR REPLACE INTO backups VALUES ('$backup_id','$(sql_quote "$backup_path")','$backup_hash','VERIFIED','$(now)'); INSERT INTO metadata(key,value) VALUES('last_backup_at','$(now)') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('last_backup_epoch','$(date +%s)') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
    event backup "$backup_id" VERIFIED "$backup_hash"
    print "$backup_path"
    ;;
  restore)
    backup_path="${1:-}"
    [[ -f "$backup_path" ]] || { print -u2 "backupファイルが必要です"; exit 2; }
    [[ "$(sqlite3 "$backup_path" 'PRAGMA integrity_check;')" == ok ]] || { print -u2 "backupの整合性検査に失敗しました"; exit 2; }
    cp "$db" "$db.pre-restore.$(/bin/date -u +%Y%m%dT%H%M%SZ)"
    cp "$backup_path" "$db"
    print "復元完了: $backup_path"
    ;;
  service)
    action="${1:-status}"
    service_state="$state_root/service.state"
    case "$action" in
      install)
        mkdir -p "$state_root/launchagents"
        cat > "$state_root/launchagents/com.counterpointer.supervisor.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.counterpointer.supervisor</string>
<key>ProgramArguments</key><array><string>$launcher_path</string><string>-C</string><string>$project_root</string><string>supervise</string><string>--watch</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
EOF
        cat > "$state_root/launchagents/com.counterpointer.watchdog.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.counterpointer.watchdog</string>
<key>ProgramArguments</key><array><string>$launcher_path</string><string>-C</string><string>$project_root</string><string>watchdog</string><string>--watch</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
EOF
        print "installed_at=$(now)" > "$service_state"
        print "state=CREDENTIALS_PENDING" >> "$service_state"
        print "credential_generation=0" >> "$service_state"
        chmod 600 "$service_state"
        print "サービスを登録しました: $state_root"
        ;;
      status)
        if [[ -f "$service_state" ]]; then cat "$service_state"; else print "状態=未登録"; fi
        ;;
      start)
        [[ "${2:-}" == '' || "${2:-}" == --attach-current-parent ]] || { print -u2 '未対応のstartオプション'; exit 2; }
        attach_parent_pid=""
        if [[ "${COUNTERPOINTER_TEST:-0}" != 1 ]]; then
          remaining_monitors="$(project_monitor_pids)" || exit 3
          [[ -z "$remaining_monitors" ]] || { print -u2 '旧監視が残っています。service stopで終了確認してください'; exit 3; }
          if [[ "${2:-}" == --attach-current-parent ]]; then
            [[ -n "${CMUX_WORKSPACE_ID:-}" && -n "${CMUX_SURFACE_ID:-}" ]] || { print -u2 'cmux内の現在の親が必要です'; exit 3; }
            cmux ping >/dev/null || exit 3
            ancestor="$PPID"
            while [[ "$ancestor" == <-> && "$ancestor" -gt 1 ]]; do
              ancestor_executable="$(/bin/ps -p "$ancestor" -o comm=)" || exit 3
              if [[ "${ancestor_executable:t}" == codex ]]; then attach_parent_pid="$ancestor"; break; fi
              ancestor="$(/bin/ps -p "$ancestor" -o ppid= | tr -d ' ')"
            done
            [[ -n "$attach_parent_pid" ]] || { print -u2 '現在のCodex親プロセスを確認できません'; exit 3; }
          fi
          assert_no_old_parent "$attach_parent_pid" || exit $?
        fi
        restart_context >/dev/null || exit $?
        [[ -f "$service_state" ]] || { print -u2 "サービスが登録されていません"; exit 2; }
        [[ "$(sed -n 's/^state=//p' "$service_state")" == CREDENTIALS_VERIFIED || "$(sed -n 's/^state=//p' "$service_state")" == STOPPED ]] || { print -u2 "実行profileが未設定です: cpt service configure-credentials --profile phase1-attended"; exit 2; }
        "$0" -C "$project_root" doctor --profile phase1-attended >/dev/null || { print -u2 "診断に失敗したためサービスを開始できません"; exit 2; }
        print "installed_at=$(sed -n 's/^installed_at=//p' "$service_state")" > "$service_state"
        print "state=RUNNING" >> "$service_state"
        /bin/rm -f "$state_root/service.stop-requested" "$state_root/parent-close-requested" "$state_root/parent-close-ack"
        parent_generation="$(sqlite3 "$db" 'SELECT COALESCE(MAX(generation),0)+1 FROM parent_runtimes;')"
        timestamp="$(now)"
        sqlite3 "$db" "BEGIN;
          UPDATE parent_runtimes SET state='LOST',updated_at='$timestamp' WHERE state IN ('STARTING','ACTIVE');
          INSERT INTO parent_runtimes(generation,state,process_pid,started_at,last_heartbeat_at,updated_at) VALUES ($parent_generation,'STARTING',$$,'$timestamp','$timestamp','$timestamp');
          INSERT INTO metadata(key,value) VALUES('parent_recovery_remaining','1')
            ON CONFLICT(key) DO UPDATE SET value='1';
          COMMIT;"
        if [[ "${COUNTERPOINTER_TEST:-0}" != 1 || "${COUNTERPOINTER_LAUNCHER_TEST:-0}" == 1 ]]; then
          if [[ "${COUNTERPOINTER_LAUNCHER_TEST:-0}" != 1 ]]; then
            nohup env -u CPT_SCHEDULER_LOCK_OWNER "$0" -C "$project_root" supervise --watch --interval 5 > "$state_root/supervisor.log" 2>&1 &
            print $! > "$state_root/supervisor.pid"
            nohup env -u CPT_SCHEDULER_LOCK_OWNER "$0" -C "$project_root" watchdog --watch 10 > "$state_root/watchdog.log" 2>&1 &
            print $! > "$state_root/watchdog.pid"
          fi
          # Keep one owner-facing Codex session alive.  It consumes the SQLite
          # event stream through the cpt CLI and performs the post-task flow.
          parent_prompt="$state_root/orchestrator-prompt.md"
          parent_events="$state_root/orchestrator-events.log"
          cat > "$parent_prompt" <<EOF
# Counterpointer 親オーケストレーター

You are the persistent parent agent for this project.  This pane is the owner's
conversation surface.  Use the installed cpt CLI in $project_root to register tasks,
inspect status, and act on completion events.

利用者向けの応答・状態メッセージは必ず日本語で表示する。英語の内部ログをそのまま表示せず、短く分かりやすく翻訳する。

Start each monitoring cycle by reading $state_root/context/project-context.md.
It is the stable project index capsule; read detailed SSOT/source files only on demand.

Rules:
- Active restart-handoff.md / restart-state.json takes precedence over stale task notifications. Read the handoff and parent-summary before index operations or scheduling; preserve holds until the parent has reconciled the recorded steps with actual state.
- Specification questions from children use cpt question TASK JSON; inspect question status ID and answer ID JSON with exact task/generation/plan/operation. Existing execution authorization is not an OS permission. Never forward arbitrary host commands or treat a parent answer as sandbox approval.
- A separate CPT notice agent handles routine child coordination automatically. Owner decisions appear in the cmux sidebar without submitting text into this conversation. At the start of each owner turn, run cpt -C $project_root attention and cpt -C $project_root status --json. Present exact pending decisions to the owner when needed; never infer approval from a sidebar notification.
- Child Codex sessions use workspace-write with approval policy never. A blocked local check becomes a cpt permission request with Task, generation, exact argv, purpose and remaining checks. CPT stores a deduplicated proposal; it never approves one itself. Show cpt permission status ID to the owner and wait for explicit approval of that exact ID before cpt permission approve ID --hash ID. Add --scope project only when the owner explicitly chooses reuse for the exact argv, relative target path and file hash. The child can then call permission run ID; do not execute its check in this parent pane. An unknown command category needs a CPT implementation change, not an ad hoc host command.
- For a stalled child, inspect status, runtime generation, PID, turn report and worktree before cpt repair-child TASK 'reason'. This command verifies and stops only the recorded child process, preserves edits, and queues a fresh generation. Do not repair an unchanged environmental restriction or mark the Task complete.
- Quality comes first. Keep the parent's selected Astra or Sol model. Child default is Sol; use cpt model TASK luna 'reason' only for bounded low-risk work with clear verification. Record every change and permit at most one upward model handoff per Task. The parent may choose subagent models under the same rule and records the reason in the Task report. Requirements, acceptance criteria, prices/contracts, destructive operations and production changes without prior authorization return to the owner.
- selfcheck --implementation-only completes only child implementation checks. Integration stays VERIFYING until the parent runs final acceptance on candidate SHA and supplies hashed artifacts using integration-verify JOB JSON. Never substitute whitespace checks for browser/API acceptance.
- At startup run: cpt -C $project_root index onboarding --json. If state is PENDING_AI_ANALYSIS, perform the initial project analysis before accepting implementation Tasks.
- For initial analysis, read the manifest_path from that JSON. Treat filename-based SSOT labels as candidates only. Inspect existing index files, AGENTS.md, documentation headings and cross-references first, then read only representative source/config/schema files needed to map areas. Do not load every source file into context.
- Obtain the required JSON shape with: cpt -C $project_root index analysis-template <proposal-id>. Fill summary, existing_ssot[{path,role,quality}], areas[{name,root,coverage,ssot_paths}], gaps, inconsistencies, generated_drafts[{target_path,draft_path,rationale}], and replacement_candidates[{existing_path,generated_draft,recommendation,reason}]. Paths in existing_ssot must be Git-tracked. Write generated drafts only below $state_root/index/proposals/<proposal-id>/generated-ssot/; compare accuracy, coverage, design intent, maintainability, duplication, and references. Never alter or delete existing project SSOT during onboarding.
- Submit the completed JSON with: cpt -C $project_root index submit-analysis <proposal-id> <analysis-json>. Show its Japanese report to the owner and wait for explicit approval. Only after approval run cpt -C $project_root index apply <proposal-id>. A generic “適用しますか” without current counts, deficiencies, effects, and non-effects is prohibited.
- The supervisor owns Git fetch/fast-forward and routine index synchronization after merges. Do not run git fetch/pull/merge or ask the owner to sync main manually from the parent sandbox. Read status --json and saved sync errors; the supervisor retries automatically. Only diagnose credentials, unsafe local changes, divergence or required SSOT analysis when reported. If onboarding state is READY, let the supervisor run index sync at each monitoring cycle. Normal merged code changes are incorporated automatically. SSOT-related changes become PENDING_AI_ANALYSIS and must be re-analyzed; existing SSOT deletion, consolidation, or replacement always requires explicit owner approval.
- If a request is ambiguous, do not register it immediately. Ask whether the owner wants quick registration or a dialogue to refine requirements and execution plan.
- For requests such as “build reservations in the booking app”, first confirm the target project and registration mode, then execute the corresponding cpt register command.
- For quick registration, resolve the concrete repository-relative target paths and call cpt register --mode quick --text <one-string> --path <path>. If the CLI returns NEEDS_DECISION, no Task exists; continue the dialogue instead of bypassing the guard.
- For detailed registration, refine the requirements over multiple turns, write the final execution plan under .counterpointer/registrations/, show the owner a concise non-technical summary, and wait for explicit confirmation. Only then compute its SHA-256 and call cpt register --mode detailed --plan <file> --confirm-hash <sha256> with the target paths. Never reuse confirmation after changing the plan.
- Treat one independently mergeable owner outcome as one Change Set. A standalone Task gets its automatic Change Set; pass --change-set <id> only when multiple Tasks are inseparable parts of the same outcome. Record --depends-on and --provides/--consumes when the relationship is known.
- Preserve docs/requirements/owner-requirements.json exactly; never change it without explicit owner approval.
- Keep owner communication concise and non-technical.
- The supervisor launches each RUNNING Task's child pane automatically and performs bounded session recovery. Monitor the recorded runtime state; do not ask the owner to run child commands manually. After the child signals selfcheck, the supervisor continues verify/external-verify.
- A child NEEDS_ATTENTION means its turn ended without selfcheck. Read its report and resolve the concrete environment or approval issue; preserve its work and do not claim completion or retry under unchanged restrictions. Browser verification must use cpt browser (cmux embedded browser); never launch system Chrome or silently fall back to an external browser. Read the Task browser-verification.md. Task-local browser actions use CPT's bounded broker; approved local checks use cpt permission run, without occupying this parent pane.
- REGISTERED means no execution permission. A request to register alone must never call queue or dispatch. A clear request to execute means queue the named Tasks; "全部実行" means queue --all at that moment, not future registrations. READY Tasks (including an explicitly requested retry) are automatically started by the supervisor when eligible. Explain that queue grants execution permission and may start work immediately on the next cycle.
- Before each registration read cpt -C $project_root schedule context. Compare summaries, paths and provides/consumes across pending Tasks; inspect only related plans/SSOT in detail. Do not ask the owner to manually group Tasks. After registration, record inferred relationships with schedule relation SOURCE TARGET DEPENDENCY|CONFLICT|UNCERTAIN 'evidence and reason'. Record uncertainty only for affected pairs; independent Tasks may proceed. Resolve old inferred relations with schedule forget SOURCE TARGET 'reason' before replacing them. Do not remove explicit owner dependencies to increase priority.
- After analyzing each unassessed Task, get the latest schedule context hash, then call schedule assess TASK HASH 'reason including why other pending Tasks are independent or related'. Do this automatically, without seeking approval for routine scheduling. Unassessed Tasks cannot dispatch. Re-evaluate when a new Task is registered, a plan changes, or completion/merge changes available results. Never fabricate urgency or a deadline. Use register --urgency low|normal|high|critical --due-at UTC_TIMESTAMP, or schedule priority TASK URGENCY [UTC_TIMESTAMP], only for the owner's explicit scheduling preferences. Omit deadline when unspecified; translate owner's local deadline into UTC.
- CLI priority is explicit urgency, deadline, downstream unblocking effect, then registration order, subject to dependencies and conflict constraints. Running Tasks are never automatically preempted. Do not interpret priority alone as a merge dependency. Cross-PR dependencies wait for owner merge and local incorporation; within one PR the CLI passes verified predecessor commits to the successor worktree.
- Natural-language controls: "登録済みに戻す" -> schedule withdraw TASK; "新規開始を止める" -> schedule pause; "再開" -> schedule resume; "実行中も止める" -> pause TASK (revokes execution permission and preserves work). Unknown execution intent stays REGISTERED. For a material plan change use schedule replan TASK FILE, show the updated plan, and use schedule confirm TASK HASH only after owner confirmation; the Task remains REGISTERED until another execution request. Changes only to priority/deadline do not revoke permission.
- In-scope integration repairs inherit execution permission, with at most two repair Tasks per Change Set. Repeated failure, scope expansion or unresolved scope stops repair and requires an owner decision. Report holds with concrete reasons and the next action; do not ask the owner to cancel/re-register Tasks to rearrange order.
- Once all Tasks in a Change Set are externally verified, let the service supervisor perform that Change Set's mandatory integration phase outside the Codex sandbox. Inspect the resulting Integration Job and resolve conflicts through a clearly scoped integration_fix Task in the same Change Set.
- Push and create a PR automatically only when cpt publish enable has pinned the exact remote name and URL. Never push main directly, force-push, merge, or change repository settings. In manual publish mode, obtain explicit owner approval via publish approve; the supervisor then executes the approved request and retries transient failures. Do not require the owner or parent sandbox to run publish apply.
- Poll with: cpt -C $project_root status --json and cpt -C $project_root logs <id>.
- For task lists and progress reports, use display_label, waiting_reason, pr_url and completed from status --json as the canonical owner-facing view. Never translate Task VERIFIED or Change Set MERGED into overall completion yourself. completed=true means the recorded verification matches the task commit, the PR is merged and incorporated into its local base branch, and the formal index is current. It does not certify deployment or acceptance checks absent from the recorded verification. Explain pending conditions concisely; do not ask the owner to relay manual operational prompts to child panes.
- When the conversation grows large (about 20 turns or a context warning), write a concise summary to $state_root/context/parent-summary.md, run cpt context compact, and continue from that summary.
- If $state_root/context/compaction-required exists, perform the same summary-and-compact flow before accepting another large task.
- When a child produces a Codex JSONL log with usage data, import it with cpt usage import <task-id> <jsonl>; otherwise leave the prompt-size estimate as-is.

Remain available for owner instructions and continue monitoring after each response.
EOF
          restart_context >> "$parent_prompt" || exit $?
          if [[ -n "$attach_parent_pid" ]]; then
            parent_ref="$(normalize_cmux_ref workspace "$CMUX_WORKSPACE_ID")"
            parent_surface="$(normalize_cmux_ref surface "$CMUX_SURFACE_ID")"
            print -r -- "$parent_ref" > "$state_root/orchestrator.workspace"
            print -r -- "$parent_surface" > "$state_root/orchestrator.parent-surface"
            print 'mode=attached' > "$state_root/orchestrator.mode"
            sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',workspace_ref='$(sql_quote "$parent_ref")',pane_ref='$(sql_quote "$parent_surface")',process_pid=$attach_parent_pid,last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$parent_generation;"
            event service "$project_root" CURRENT_PARENT_ATTACHED "pid=$attach_parent_pid surface=$parent_surface"
            /bin/rm -f "$state_root/parent-close-ack"
            nohup "$launcher_path" -C "$project_root" parent-close-watch "$parent_generation" > "$state_root/parent-close-watch.log" 2>&1 &
            print $! > "$state_root/parent-close-watch.pid"
            print "現在の親を維持して監視を開始しました。まず $parent_prompt と再起動引継ぎを読んでください。"
            # Keep an attached launch owned by this foreground job. Some tool
            # terminals reap descendants once their command exits, despite nohup.
            attached_supervisor="$(<"$state_root/supervisor.pid")"
            attached_watchdog="$(<"$state_root/watchdog.pid")"
            /bin/rm -f "$scheduler_lock/pid" "$service_lifecycle_lock/pid"
            rmdir "$scheduler_lock" "$service_lifecycle_lock"
            trap - EXIT
            unset CPT_SCHEDULER_LOCK_OWNER
            while kill -0 "$attached_supervisor" 2>/dev/null && kill -0 "$attached_watchdog" 2>/dev/null; do sleep 5; done
            if [[ "$(sed -n 's/^state=//p' "$service_state")" == STOPPED ]]; then exit 0; fi
            print -r -- "installed_at=$(sed -n 's/^installed_at=//p' "$service_state")"$'\n''state=DEGRADED' > "$service_state"
            event service "$project_root" SERVICE_MONITOR_EXITED '接続中の監視が終了しました。service stopで終了確認してください。'
            print -u2 '監視が終了したため再起動成功とは扱いません'
            exit 3
          fi
          parent_launcher="$state_root/parent-launch.zsh"
          cat > "$parent_launcher" <<EOF
#!/bin/zsh
set +e
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE GH_TOKEN GITHUB_TOKEN CLOUDFLARE_API_TOKEN NPM_TOKEN
parent_generation=\$1
${(q)launcher_path} -C ${(q)project_root} parent-runtime started \$parent_generation \$\$ "\${CMUX_WORKSPACE_ID:-}" "\${CMUX_SURFACE_ID:-}"
nohup ${(q)launcher_path} -C ${(q)project_root} parent-close-watch \$parent_generation > ${(q)state_root}/parent-close-watch.log 2>&1 &
print \$! > ${(q)state_root}/parent-close-watch.pid
script -q ${(q)parent_events} codex --ask-for-approval on-request --sandbox workspace-write -C ${(q)project_root} "\$(/bin/cat ${(q)parent_prompt})"
parent_exit_code=\$?
${(q)launcher_path} -C ${(q)project_root} parent-runtime exited \$parent_generation \$parent_exit_code
exit \$parent_exit_code
EOF
          chmod 700 "$parent_launcher"
          if [[ "${COUNTERPOINTER_LAUNCHER_TEST:-0}" == 1 ]]; then
            /bin/zsh -n "$parent_launcher"
            sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',workspace_ref='launcher-test',last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$parent_generation;"
            print -r -- "$parent_launcher"
            exit 0
          fi
          parent_command="/bin/zsh ${(q)parent_launcher} $parent_generation"
          if [[ -n "${CMUX_WORKSPACE_ID:-}" && -n "${CMUX_SURFACE_ID:-}" ]]; then
            # cpt start from an existing cmux pane turns that pane into the
            # owner-facing parent agent; child tasks split to its right.
            parent_ref="$(normalize_cmux_ref workspace "${CMUX_WORKSPACE_ID}")"
            parent_surface="$(normalize_cmux_ref surface "${CMUX_SURFACE_ID}")"
            print -r -- "$parent_ref" > "$state_root/orchestrator.workspace"
            print -r -- "$parent_surface" > "$state_root/orchestrator.parent-surface"
            /bin/rm -f "$state_root/orchestrator.last-child-surface"
            print -r -- "mode=attached" > "$state_root/orchestrator.mode"
            sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',workspace_ref='$(sql_quote "$parent_ref")',pane_ref='$(sql_quote "$parent_surface")',process_pid=$$,last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$parent_generation;"
            print "サービスを開始しました（現在のペインを親として使用）"
            exec /bin/zsh "$parent_launcher" "$parent_generation"
          fi
          parent_workspace="$(cmux new-workspace --name "cpt-parent" --cwd "$project_root" --command "$parent_command" --focus false)"
          parent_workspace_ref="$(print -r -- "$parent_workspace" | sed -n 's/.*\(workspace:[^ ]*\).*/\1/p')"
          [[ -n "$parent_workspace_ref" ]] || parent_workspace_ref="$parent_workspace"
          print -r -- "$parent_workspace_ref" > "$state_root/orchestrator.workspace"
          print -r -- "mode=workspace" > "$state_root/orchestrator.mode"
          sqlite3 "$db" "UPDATE parent_runtimes SET workspace_ref='$(sql_quote "$parent_workspace_ref")',updated_at='$(now)' WHERE generation=$parent_generation;"
        else
          sqlite3 "$db" "UPDATE parent_runtimes SET state='ACTIVE',workspace_ref='test',last_heartbeat_at='$(now)',updated_at='$(now)' WHERE generation=$parent_generation;"
        fi
        print "サービスを開始しました"
        ;;
      reload)
        [[ -f "$service_state" && "$(sed -n 's/^state=//p' "$service_state")" == RUNNING ]] || { print -u2 'reloadには実行中serviceが必要です'; exit 2; }
        # LaunchAgent経由と手動起動を併存させない。cmux内からreloadした
        # processへ接続権限を継承させ、親ペイン通知を可能にする。
        if command -v launchctl >/dev/null 2>&1; then
          launchctl bootout "gui/$(id -u)/com.counterpointer.supervisor" 2>/dev/null || true
          launchctl bootout "gui/$(id -u)/com.counterpointer.watchdog" 2>/dev/null || true
        fi
        for worker in supervisor watchdog; do
          pid_file="$state_root/$worker.pid"
          [[ -s "$pid_file" ]] || continue
          worker_pid="$(<"$pid_file")"
          [[ "$worker_pid" == <-> ]] || continue
          kill -TERM "$worker_pid" 2>/dev/null || true
          for wait_step in {1..30}; do
            kill -0 "$worker_pid" 2>/dev/null || break
            sleep 0.1
          done
          if kill -0 "$worker_pid" 2>/dev/null; then
            kill -KILL "$worker_pid" 2>/dev/null || true
            sleep 0.1
          fi
          if kill -0 "$worker_pid" 2>/dev/null; then
            print -u2 "${worker}を停止できませんでした: PID $worker_pid"
            exit 3
          fi
        done
        /bin/rm -f "$state_root/supervisor.pid" "$state_root/watchdog.pid"
        rmdir "$state_root/supervisor.lock" 2>/dev/null || true
        nohup env -u CPT_SCHEDULER_LOCK_OWNER "$0" -C "$project_root" supervise --watch --interval 5 > "$state_root/supervisor.log" 2>&1 &
        print $! > "$state_root/supervisor.pid"
        nohup env -u CPT_SCHEDULER_LOCK_OWNER "$0" -C "$project_root" watchdog --watch 10 > "$state_root/watchdog.log" 2>&1 &
        print $! > "$state_root/watchdog.pid"
        event service "$project_root" SERVICE_WORKERS_RELOADED "supervisor=$(<"$state_root/supervisor.pid") watchdog=$(<"$state_root/watchdog.pid")"
        sqlite3 "$db" "INSERT OR IGNORE INTO parent_notices(notice_id,message,state,attempts,created_at) VALUES('permission-workflow-v6','CPTの権限外検証は cpt permission list / status ID で確認し、所有者が具体的に承認した場合だけ approve ID --hash ID を実行してください。project範囲は所有者が明示した場合だけです。子の検証コマンドを親ペインで代行しないでください。','PENDING',0,'$(now)');"
        print '監視processを最新版で再起動しました（親ペインは維持）'
        ;;
      configure-credentials)
        [[ "${2:-}" == "--profile" && -n "${3:-}" ]] || { print -u2 "使い方: cpt service configure-credentials --profile <phase1-attended|phase2-publish|phase2-notify|phase3-unattended>"; exit 2; }
        [[ -f "$service_state" ]] || { print -u2 "サービスが未登録です"; exit 2; }
        case "$3" in
          local) selected_profile=phase1-attended;;
          phase1-attended|phase2-publish|phase2-notify|phase3-unattended) selected_profile="$3";;
          *) print -u2 "不明なprofileです: $3"; exit 2;;
        esac
        "$0" -C "$project_root" doctor --profile "$selected_profile" >/dev/null || { print -u2 "profileの前提条件を満たしていません: cpt doctor --profile $selected_profile"; exit 3; }
        generation="$(($(sed -n 's/^credential_generation=//p' "$service_state") + 1))"
        installed="$(sed -n 's/^installed_at=//p' "$service_state")"
        print "installed_at=$installed" > "$service_state"
        print "state=CREDENTIALS_VERIFIED" >> "$service_state"
        print "credential_generation=$generation" >> "$service_state"
        print "profile=$selected_profile" >> "$service_state"
        print "credential_mode=現在の利用者のCodex・GitHubログインとowner-only通知設定" >> "$service_state"
        chmod 600 "$service_state"
        event service "$project_root" EXECUTION_PROFILE_CONFIGURED "$selected_profile generation=$generation"
        print "実行profileを設定しました: $selected_profile（世代=$generation）"
        ;;
      plist-validate)
        command -v plutil >/dev/null 2>&1 || { print -u2 "plutilを利用できません"; exit 2; }
        plutil -lint "$state_root/launchagents/com.counterpointer.supervisor.plist"
        plutil -lint "$state_root/launchagents/com.counterpointer.watchdog.plist"
        ;;
      load)
        command -v launchctl >/dev/null 2>&1 || { print -u2 "launchctlを利用できません"; exit 2; }
        launchctl bootstrap "gui/$(id -u)" "$state_root/launchagents/com.counterpointer.supervisor.plist"
        launchctl bootstrap "gui/$(id -u)" "$state_root/launchagents/com.counterpointer.watchdog.plist"
        print "常駐定義を読み込みました"
        ;;
      unload)
        command -v launchctl >/dev/null 2>&1 || { print -u2 "launchctlを利用できません"; exit 2; }
        launchctl bootout "gui/$(id -u)/com.counterpointer.supervisor" 2>/dev/null || true
        launchctl bootout "gui/$(id -u)/com.counterpointer.watchdog" 2>/dev/null || true
        print "常駐定義を解除しました"
        ;;
      stop)
        stop_failures=0
        stop_permission_runs --all || { print -u2 '承認済み検証サーバーを停止できません'; exit 3; }
        if [[ -s "$state_root/notice-worker.pid" ]]; then
          notice_stop_pid="$(<"$state_root/notice-worker.pid")"
          if [[ "$notice_stop_pid" == <-> ]] && [[ "$(/bin/ps -p "$notice_stop_pid" -o command= 2>/dev/null || true)" == *"-C $project_root notice-worker"* ]]; then
            service_stop_process "$notice_stop_pid" "-C $project_root notice-worker" || { print -u2 '通知エージェントの停止を確認できません'; exit 3; }
          fi
          /bin/rm -f "$state_root/notice-worker.pid"
        fi
        while IFS='|' read -r stop_task stop_generation stop_pid stop_worktree stop_runtime_state; do
          [[ -n "$stop_task" ]] || continue
          stop_launcher="$stop_worktree/.counterpointer-task/launch-$stop_generation.zsh"
          if [[ "$stop_runtime_state" != (STARTING|ACTIVE|RESUMING|RESTARTING) ]]; then
            # A finished runtime may leave an idle child CLI. Never use a reused
            # historical PID to stop an unrelated process.
            [[ -n "$stop_pid" ]] || continue
            /bin/ps -p $$ -o pid= >/dev/null || { print -u2 'プロセスを確認できません'; exit 3; }
            [[ "$(/bin/ps -p "$stop_pid" -o command= 2>/dev/null || true)" == *"$stop_launcher"* ]] || continue
          fi
          # A command already queued in a pane must not launch after shutdown.
          if [[ -f "$stop_launcher" ]]; then
            [[ -e "$stop_launcher.service-stop" ]] || cp "$stop_launcher" "$stop_launcher.service-stop"
            print -r -- '#!/bin/zsh'$'\n''exit 3 # invalidated by service stop' > "$stop_launcher.stopped"
            chmod 700 "$stop_launcher.stopped"; mv "$stop_launcher.stopped" "$stop_launcher"
          fi
          if [[ -n "$stop_pid" ]] && ! service_stop_process "$stop_pid" "$stop_launcher"; then
            stop_failures=$((stop_failures+1)); continue
          fi
          sqlite3 "$db" "UPDATE task_runtimes SET state='CANCELLED',updated_at='$(now)' WHERE task_id='$(sql_quote "$stop_task")' AND generation=$stop_generation AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');"
        done < <(sqlite3 "$db" "SELECT r.task_id,r.generation,COALESCE(r.process_pid,''),COALESCE(t.worktree,''),r.state FROM task_runtimes r JOIN tasks t USING(task_id) WHERE r.state IN ('STARTING','ACTIVE','RESUMING','RESTARTING') OR r.process_pid IS NOT NULL;")
        if (( stop_failures )); then
          event service "$project_root" SERVICE_STOP_INCOMPLETE "workers=$stop_failures"
          print -u2 '停止できないワーカーがあります。停止状態を維持します。service stopを再実行してください'
          exit 3
        fi
        parent_stop_row="$(sqlite3 "$db" "SELECT generation,COALESCE(process_pid,''),COALESCE(workspace_ref,''),COALESCE(pane_ref,'') FROM parent_runtimes WHERE state IN ('ACTIVE','LOST','STARTING') ORDER BY generation DESC LIMIT 1;")"
        if [[ -n "$parent_stop_row" ]]; then
          IFS='|' read -r parent_stop_generation parent_stop_pid parent_stop_workspace parent_stop_surface <<< "$parent_stop_row"
          : > "$state_root/parent-close-requested"
          # The cmux-origin watcher can close this surface even when an external
          # terminal is denied socket access. Wait briefly before stopping Codex.
          if [[ -s "$state_root/parent-close-watch.pid" ]] && kill -0 "$(<"$state_root/parent-close-watch.pid")" 2>/dev/null; then
            for parent_close_wait in {1..15}; do
              [[ ! -s "$state_root/parent-close-ack" || "$(<"$state_root/parent-close-ack")" != "$parent_stop_generation|$parent_stop_workspace|$parent_stop_surface" ]] || break
              sleep 0.2
            done
          fi
          if [[ "$parent_stop_pid" == <-> ]] && (( parent_stop_pid != $$ )); then
            parent_stop_expected="$state_root/parent-launch.zsh"
            if [[ -s "$state_root/orchestrator.mode" && "$(<"$state_root/orchestrator.mode")" == mode=attached ]]; then
              # Attached parents are existing Codex processes, not parent-launch shells.
              parent_stop_cwd="$(/usr/sbin/lsof -a -p "$parent_stop_pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | sed -n '1p')"
              [[ -n "$parent_stop_cwd" && "${parent_stop_cwd:A}" == "${project_root:A}" ]] || { print -u2 '親PIDの作業場所を確認できません。STOPPINGを維持します'; exit 3; }
              parent_stop_expected=codex
            fi
            service_stop_process "$parent_stop_pid" "$parent_stop_expected" || { print -u2 '親の終了を確認できません。STOPPINGを維持します'; exit 3; }
          elif [[ "$parent_stop_pid" == <-> ]]; then
            print -u2 '親自身からのservice stopは別端末で実行してください'; exit 3
          fi
          # A socket unavailable outside cmux does not turn process exit into success for the pane.
          if [[ -n "$parent_stop_workspace" && -n "$parent_stop_surface" ]] && cmux ping >/dev/null 2>&1; then
            cmux close-surface --workspace "$parent_stop_workspace" --surface "$parent_stop_surface" >/dev/null 2>&1 || true
          fi
        fi
        timestamp="$(now)"
        sqlite3 "$db" "BEGIN;
          INSERT INTO task_retry_requests(task_id,launch_mode,state,created_at,updated_at)
            SELECT task_id,'RESTART','QUEUED','$timestamp','$timestamp' FROM tasks WHERE state='RUNNING'
            ON CONFLICT(task_id) DO UPDATE SET launch_mode='RESTART',state='QUEUED',updated_at=excluded.updated_at;
          UPDATE tasks SET state='READY',updated_at='$timestamp' WHERE state='RUNNING';
          UPDATE parent_runtimes SET state='STOPPED',updated_at='$timestamp' WHERE state IN ('STARTING','ACTIVE','LOST');
          COMMIT;"
        print -r -- "installed_at=$service_previous_installed"$'\n''state=STOPPED' > "$service_state"
        rmdir "$state_root/supervisor.lock" 2>/dev/null || true
        event service "$project_root" SERVICE_STOPPED '監視・ワーカー停止確認済み。worktreeと承認を保持'
        print '監視と全ワーカーを停止しました。成果を保持しています。service startで既存worktreeを使い、新しい子セッションで再開できます。'
        ;;
      *) print -u2 "使い方: cpt service install|configure-credentials|status|start|reload|stop|plist-validate|load|unload"; exit 2;;
    esac
    ;;
  pause)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 'タスクIDが必要です'; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == RUNNING ]] || { print -u2 '実行中Taskだけを一時停止できます'; exit 2; }
    timestamp="$(now)"
    runtime_pid="$(sqlite3 "$db" "SELECT COALESCE(process_pid,'') FROM task_runtimes WHERE task_id='$(sql_quote "$task_id")' AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING') ORDER BY generation DESC LIMIT 1;")"
    pause_generation="$(latest_runtime_generation "$task_id")"
    pause_worktree="$(sqlite3 "$db" "SELECT worktree FROM tasks WHERE task_id='$(sql_quote "$task_id")';")"
    # Do not publish CANCELLED/REGISTERED or enqueue a retry before verified exit.
    if [[ "$runtime_pid" == <-> ]]; then
      if ! service_stop_process "$runtime_pid" "$pause_worktree/.counterpointer-task/launch-$pause_generation.zsh"; then
        event task "$task_id" PAUSE_FAILED '子プロセス終了を確認できないため状態と実行枠を保持'
        print -u2 '子プロセス終了を確認できません。一時停止成功とは扱いません。通常端末の監視環境での停止確認が必要です。'
        exit 3
      fi
    else
      print -u2 '起動処理中でPID未確定のため停止完了と判定できません。状態を保持します。'
      exit 3
    fi
    sqlite3 "$db" "BEGIN;
      UPDATE tasks SET state='REGISTERED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state='RUNNING';
      UPDATE task_runtimes SET state='CANCELLED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');
      INSERT INTO task_retry_requests(task_id,launch_mode,state,created_at,updated_at)
        VALUES ('$(sql_quote "$task_id")','RESUME','QUEUED','$timestamp','$timestamp')
        ON CONFLICT(task_id) DO UPDATE SET launch_mode='RESUME',state='QUEUED',updated_at=excluded.updated_at;
      COMMIT;"
    event task "$task_id" PAUSED 'worktree and logical session preserved'
    print "一時停止しました: ${task_id[1,12]}（成果を保持・登録済みへ戻しました。queueで再開を許可）"
    ;;
  cancel)
    task_id="${1:-}"
    [[ -n "$task_id" ]] || { print -u2 "タスクIDが必要です"; exit 2; }
    task_id="$(resolve_task_id "$task_id")" || exit $?
    task_row="$(sqlite3 "$db" "SELECT state || '|' || COALESCE(worktree,'') FROM tasks WHERE task_id='$task_id';")"
    task_state="${task_row%%|*}"; worktree="${task_row#*|}"
    if [[ "$task_state" == CANCELLED ]]; then
      if [[ -n "$worktree" && -d "$worktree" ]]; then
        if git -C "$project_root" worktree remove --force "$worktree" 2>/dev/null; then
          sqlite3 "$db" "UPDATE tasks SET worktree=NULL WHERE task_id='$(sql_quote "$task_id")';"
        else
          print -u2 "警告: 取消済みTaskのworktreeを削除できません。cpt cleanup --applyで再試行できます: $worktree"
        fi
      elif [[ -n "$worktree" ]]; then
        sqlite3 "$db" "UPDATE tasks SET worktree=NULL WHERE task_id='$(sql_quote "$task_id")';"
      fi
      sqlite3 "$db" "UPDATE task_schedule SET hold_reason='' WHERE task_id='$(sql_quote "$task_id")';"
      print "取消済みです: ${task_id[1,12]}"
      exit 0
    fi
    task_change_set="$(sqlite3 "$db" "SELECT change_set_id FROM change_set_tasks WHERE task_id='$(sql_quote "$task_id")';")"
    change_set_state=""
    if [[ -n "$task_change_set" ]]; then
      change_set_state="$(sqlite3 "$db" "SELECT state FROM change_sets WHERE change_set_id='$(sql_quote "$task_change_set")';")"
      case "$change_set_state" in
        AWAITING_MERGE|MERGED|CLOSED)
          print -u2 "pushまたはPR開始後のChange SetはTask取消できません: $change_set_state"
          exit 3
          ;;
      esac
      external_publication="$(sqlite3 "$db" "SELECT COUNT(*) FROM publish_requests p JOIN integration_jobs j ON j.job_id=p.job_id LEFT JOIN pull_requests r ON r.request_id=p.request_id WHERE j.change_set_id='$(sql_quote "$task_change_set")' AND (p.state='PUBLISHED' OR COALESCE(r.pr_state,'NOT_CREATED')<>'NOT_CREATED' OR COALESCE(r.last_pushed_sha,'')<>'' OR EXISTS (SELECT 1 FROM events e WHERE e.entity_type='publish' AND e.entity_id=p.request_id AND e.event_type IN ('PUSH_INTENT','PR_CREATE_INTENT','PR_READY')));")"
      if (( external_publication > 0 )); then
        print -u2 'pushまたはPR作成を開始済みのためTask取消を拒否しました。外部状態を確認し、必要ならrevert Taskを作成してください'
        exit 3
      fi
    fi
    timestamp="$(now)"
    invalidated_jobs=""; invalidated_requests=""
    if [[ -n "$task_change_set" ]]; then
      invalidated_jobs="$(sqlite3 "$db" "SELECT job_id FROM integration_jobs WHERE change_set_id='$(sql_quote "$task_change_set")' AND state IN ('WAITING_TASKS','PREPARING','VERIFYING','VERIFIED');")"
      invalidated_requests="$(sqlite3 "$db" "SELECT p.request_id FROM publish_requests p JOIN integration_jobs j ON j.job_id=p.job_id WHERE j.change_set_id='$(sql_quote "$task_change_set")' AND p.state='PREPARED';")"
    fi
    while IFS= read -r runtime_pid; do
      [[ "$runtime_pid" == <-> ]] || continue
      /usr/bin/pkill -TERM -P "$runtime_pid" 2>/dev/null || true
      kill -TERM "$runtime_pid" 2>/dev/null || true
    done < <(sqlite3 "$db" "SELECT process_pid FROM task_runtimes WHERE task_id='$(sql_quote "$task_id")' AND state IN ('STARTING','ACTIVE','RESUMING','RESTARTING');")
    cancel_sql="BEGIN IMMEDIATE;
      UPDATE tasks SET state='CANCELLED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state<>'CANCELLED';
      UPDATE task_runtimes SET state='CANCELLED',updated_at='$timestamp' WHERE task_id='$(sql_quote "$task_id")' AND state NOT IN ('COMPLETED','FAILED','CANCELLED');
      UPDATE task_schedule SET hold_reason='' WHERE task_id='$(sql_quote "$task_id")';
      DELETE FROM task_retry_requests WHERE task_id='$(sql_quote "$task_id")';"
    if [[ -n "$task_change_set" ]]; then
      cancel_sql+="
        UPDATE integration_attempts SET status='FAILED',failure_kind='TASK_CANCELLED',updated_at='$timestamp' WHERE job_id IN (SELECT job_id FROM integration_jobs WHERE change_set_id='$(sql_quote "$task_change_set")') AND status IN ('BUILDING','VERIFYING');
        UPDATE publish_requests SET state='FAILED',failure_reason='TASK_CANCELLED',updated_at='$timestamp' WHERE job_id IN (SELECT job_id FROM integration_jobs WHERE change_set_id='$(sql_quote "$task_change_set")') AND state='PREPARED';
        DELETE FROM publish_approvals WHERE request_id IN (SELECT p.request_id FROM publish_requests p JOIN integration_jobs j ON j.job_id=p.job_id WHERE j.change_set_id='$(sql_quote "$task_change_set")');
        UPDATE integration_index_snapshots SET state='SUPERSEDED' WHERE job_id IN (SELECT job_id FROM integration_jobs WHERE change_set_id='$(sql_quote "$task_change_set")') AND state='CANDIDATE';
        UPDATE integration_jobs SET state='FAILED',failure_reason='TASK_CANCELLED',updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$task_change_set")' AND state IN ('WAITING_TASKS','PREPARING','VERIFYING','VERIFIED');
        UPDATE change_sets SET state=CASE WHEN EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=change_sets.change_set_id AND t.state<>'CANCELLED') THEN 'OPEN' ELSE 'CANCELLED' END,membership_revision=membership_revision+1,updated_at='$timestamp' WHERE change_set_id='$(sql_quote "$task_change_set")' AND state NOT IN ('AWAITING_MERGE','MERGED','CLOSED');"
    fi
    cancel_sql+=' COMMIT;'
    sqlite3 "$db" "$cancel_sql"
    [[ "$(sqlite3 "$db" "SELECT state FROM tasks WHERE task_id='$(sql_quote "$task_id")';")" == CANCELLED ]] || { print -u2 '取消状態を保存できませんでした'; exit 4; }
    event task "$task_id" TASK_CANCELLED "previous_state=$task_state change_set=${task_change_set:-none}"
    while IFS= read -r invalidated_job; do [[ -z "$invalidated_job" ]] || event integration "$invalidated_job" INVALIDATED_BY_TASK_CANCEL "$task_id"; done <<< "$invalidated_jobs"
    while IFS= read -r invalidated_request; do [[ -z "$invalidated_request" ]] || event publish "$invalidated_request" INVALIDATED_BY_TASK_CANCEL "$task_id"; done <<< "$invalidated_requests"
    if [[ -n "$worktree" && -d "$worktree" ]]; then
      if git -C "$project_root" worktree remove --force "$worktree" 2>/dev/null; then
        sqlite3 "$db" "UPDATE tasks SET worktree=NULL WHERE task_id='$(sql_quote "$task_id")';"
      else
        print -u2 "警告: Taskは取消済みですがworktreeを削除できません。cpt cleanup --applyで再試行できます: $worktree"
      fi
    elif [[ -n "$worktree" ]]; then
      sqlite3 "$db" "UPDATE tasks SET worktree=NULL WHERE task_id='$(sql_quote "$task_id")';"
    fi
    final_change_set_state=""; [[ -z "$task_change_set" ]] || final_change_set_state="$(sqlite3 "$db" "SELECT state FROM change_sets WHERE change_set_id='$(sql_quote "$task_change_set")';")"
    print "取消しました: ${task_id[1,12]}（$task_state → CANCELLED${final_change_set_state:+ / Change Set $final_change_set_state}）"
    ;;
  status)
    if [[ "${1:-}" == "--json" ]]; then
      task_status_json
      exit 0
    fi
    if [[ "${1:-}" != "--details" ]]; then
      service_code="$(sed -n 's/^state=//p' "$state_root/service.state" 2>/dev/null || true)"
      parent_code="$(sqlite3 "$db" "SELECT COALESCE(state,'') FROM parent_runtimes ORDER BY generation DESC LIMIT 1;")"
      index_code="$(sqlite3 "$db" "SELECT COALESCE(value,'') FROM metadata WHERE key='index_onboarding_state';")"
      index_display_code="$index_code"; [[ "$index_code" != READY ]] || index_display_code=READY_INDEX
      latest_integration_state="$(sqlite3 "$db" "SELECT COALESCE(state,'なし') FROM integration_jobs ORDER BY created_at DESC LIMIT 1;")"
      approval_waiting="$(sqlite3 "$db" "SELECT COUNT(*) FROM publish_requests p LEFT JOIN publish_approvals a ON a.request_id=p.request_id AND a.head_sha=p.head_sha WHERE p.state='PREPARED' AND a.request_id IS NULL;")"
      registration_waiting="$(sqlite3 "$db" "SELECT COUNT(*) FROM registrations WHERE status='NEEDS_DECISION';")"
      notification_pending="$(sqlite3 "$db" "SELECT COUNT(*) FROM notifications WHERE state='PENDING';")"
      notification_dead="$(sqlite3 "$db" "SELECT COUNT(*) FROM notifications WHERE state='DEAD_LETTER';")"
      measured_sessions="$(sqlite3 "$db" 'SELECT COUNT(*) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"
      if (( measured_sessions == 0 )); then cache_status='計測不能'; else measured_input_total="$(sqlite3 "$db" 'SELECT COALESCE(SUM(measured_input_tokens),0) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"; measured_cached_total="$(sqlite3 "$db" 'SELECT COALESCE(SUM(measured_cached_tokens),0) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"; if (( measured_input_total > 0 && measured_cached_total * 2 >= measured_input_total )); then cache_status='cache利用良好'; else cache_status='再利用少'; fi; fi
      [[ -f "$state_root/context/compaction-required" ]] && context_status='checkpoint推奨' || context_status='余裕あり'
      capacity_values
      if (( CAPACITY_FREE_BYTES < CAPACITY_CRITICAL_BYTES )); then capacity_code=FAILED; capacity_label='停止下限未満'; elif (( CAPACITY_FREE_BYTES < CAPACITY_WARNING_BYTES )); then capacity_code=READY; capacity_label='警告'; else capacity_code=VERIFIED; capacity_label='正常'; fi

      CPT_STATUS_COLOR_ENABLED=0
      if [[ -z "${NO_COLOR:-}" && ( "${TERM:-}" != dumb || "${CPT_COLOR:-auto}" == always ) ]]; then
        case "${CPT_COLOR:-auto}" in always) CPT_STATUS_COLOR_ENABLED=1;; auto) [[ -t 1 ]] && CPT_STATUS_COLOR_ENABLED=1;; esac
      fi
      index_revision="$(sqlite3 "$db" 'SELECT COALESCE(MAX(revision),0) FROM index_revisions;')"
      total_tasks="$(sqlite3 "$db" 'SELECT COUNT(*) FROM tasks;')"
      running_tasks="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state IN ('RUNNING','CLAIMED_DONE','VERIFYING');")"
      waiting_tasks="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state IN ('REGISTERED','READY');")"
      failed_tasks="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state='FAILED';")"
      owner_status="$(task_status_json)"
      completed_tasks="$(print -r -- "$owner_status" | jq '[.[] | select(.completed)] | length')"
      verified_tasks="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state='VERIFIED';")"

      print "Counterpointer — ${project_root:t}"
      print "サービス $(status_paint "$service_code")  親 $(status_paint "$parent_code")  索引 $(status_paint "$index_display_code")（rev $index_revision）  容量 $(status_paint "$capacity_code" "$capacity_label")"
      print "タスク $total_tasks件  実行中 $running_tasks  待機 $waiting_tasks  失敗 $failed_tasks  検証済み $verified_tasks  完了 $completed_tasks"

      notices=()
      [[ "$(sqlite3 "$db" "SELECT COALESCE(value,'0') FROM metadata WHERE key='scheduler_paused';")" != 1 ]] || notices+=('新規開始を一時停止中')
      failed_change_sets="$(sqlite3 "$db" "SELECT COUNT(*) FROM change_sets WHERE state='FAILED';")"
      pending_integration_repairs="$(sqlite3 "$db" "SELECT COUNT(*) FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.member_kind='integration_fix' AND t.state NOT IN ('VERIFIED','CANCELLED');")"
      (( failed_change_sets == 0 )) || notices+=("統合失敗 ${failed_change_sets}件")
      (( pending_integration_repairs == 0 )) || notices+=("統合修正待ち ${pending_integration_repairs}件")
      [[ "$context_status" != checkpoint推奨 ]] || notices+=('コンテキスト要約を推奨')
      (( registration_waiting == 0 )) || notices+=("壁打ち待ち ${registration_waiting}件")
      (( approval_waiting == 0 )) || notices+=("公開承認待ち ${approval_waiting}件")
      (( notification_pending == 0 )) || notices+=("通知待ち ${notification_pending}件")
      (( notification_dead == 0 )) || notices+=("通知失敗 ${notification_dead}件")
      if (( ${#notices[@]} > 0 )); then print "要確認: ${(j: / :)notices}"; fi

      print ''
      print '現在のタスク'
      attention_rows="$(print -r -- "$owner_status" | jq -r '.[] | select(.completed==false and .state!="CANCELLED") | [.display_label,.task_id[0:12],(.source_text | gsub("[\\t\\r\\n]";" ") | .[0:34]),(.waiting_reason | gsub("[\\t\\r\\n]";" "))] | @tsv')"
      if [[ -n "$attention_rows" ]]; then
        {
          print -r -- $'状態\tID\t内容・待機理由'
          while IFS=$'\t' read -r attention_state attention_id attention_text; do
            print -r -- "$attention_state"$'\t'"$attention_id"$'\t'"$attention_text"
          done <<< "$attention_rows"
        } | /usr/bin/column -t -s $'\t' | while IFS= read -r status_line; do
          if (( CPT_STATUS_COLOR_ENABLED )); then
            case "$status_line" in
              失敗*) print -r -- $'\e[31m'"$status_line"$'\e[0m';;
              実行中*|親検証待ち*|検証中*) print -r -- $'\e[32m'"$status_line"$'\e[0m';;
              実行待ち*|登録済み*) print -r -- $'\e[33m'"$status_line"$'\e[0m';;
              *) print -r -- "$status_line";;
            esac
          else
            print -r -- "$status_line"
          fi
        done
      else
        print '対応中のタスクはありません'
      fi
      while IFS= read -r waiting_task_id; do
        blocker_summary="$(task_blockers "$waiting_task_id")"
        [[ -z "$blocker_summary" ]] || print -r -- "保留 ${waiting_task_id[1,12]}: $blocker_summary"
      done < <(sqlite3 "$db" "SELECT task_id FROM tasks WHERE state IN ('REGISTERED','READY') ORDER BY rowid;")
      print ''
      print '詳細表示: cpt status --details'
      exit 0
    fi
    sqlite3 -header -column "$db" 'SELECT task_id, mode, state, commit_sha, created_at, updated_at FROM tasks ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT c.change_set_id,c.title,c.state,c.membership_revision,COUNT(m.task_id) AS tasks,c.created_at,c.updated_at FROM change_sets c LEFT JOIN change_set_tasks m ON m.change_set_id=c.change_set_id GROUP BY c.change_set_id ORDER BY c.created_at;'
    sqlite3 -header -column "$db" 'SELECT task_id,generation,logical_session_id,state,launch_mode,workspace_ref,pane_ref,process_pid,resume_attempts,restart_attempts,exit_code,updated_at FROM task_runtimes ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT generation,state,workspace_ref,pane_ref,process_pid,started_at,last_heartbeat_at,updated_at FROM parent_runtimes ORDER BY generation;'
    sqlite3 -header -column "$db" 'SELECT registration_id, registration_mode, status, reason_code, task_id, created_at FROM registrations ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT job_id,change_set_id,membership_revision,state,candidate_sha,failure_reason,evidence_path,worktree,created_at,updated_at FROM integration_jobs ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT attempt_id,job_id,change_set_id,membership_revision,base_sha,candidate_sha,status,failure_kind,failure_hash,evidence_path,created_at,updated_at FROM integration_attempts ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT p.request_id,p.job_id,p.state,p.head_sha,CASE WHEN a.request_id IS NULL THEN "未承認" ELSE "承認済み" END AS approval,r.branch_name,r.base_branch,r.remote_name,r.pr_number,r.pr_state,r.pr_url,r.failure_reason,p.created_at,p.updated_at FROM publish_requests p LEFT JOIN publish_approvals a ON a.request_id=p.request_id AND a.head_sha=p.head_sha LEFT JOIN pull_requests r ON r.request_id=p.request_id ORDER BY p.created_at;'
    sqlite3 -header -column "$db" 'SELECT emission_id, entity_id, state, attempts, created_at, updated_at FROM notifications ORDER BY created_at;'
    sqlite3 -header -column "$db" 'SELECT revision,proposal_id,source_sha,index_hash,applied_at FROM index_revisions ORDER BY revision;'
    sqlite3 -header -column "$db" 'SELECT job_id,source_sha,state,snapshot_hash,created_at,promoted_at FROM integration_index_snapshots ORDER BY created_at;'
    ;;
  doctor)
    profile="phase1-attended"
    doctor_quick=0
    while (( $# )); do
      case "$1" in
        --profile) profile="${2:-}"; shift 2;;
        --quick) doctor_quick=1; shift;;
        *) print -u2 "不明なdoctorオプションです: $1"; exit 2;;
      esac
    done
    case "$profile" in phase1-attended|phase2-publish|phase2-notify|phase3-unattended) ;; *) print -u2 "不明な診断profileです: $profile"; exit 2;; esac
    print "診断profile=$profile"
    failures=0
    check_cmd() { if command -v "$1" >/dev/null 2>&1; then print "正常 $1"; else print "失敗 $1"; failures=$((failures+1)); fi }
    check_cmd sqlite3
    check_cmd git
    check_cmd cmux
    check_cmd codex
    check_cmd jq
    if [[ -d "$project_root/.git" ]]; then print "正常 Gitリポジトリ"; else print "失敗 Gitリポジトリ"; failures=$((failures+1)); fi
    if [[ "$(sqlite3 "$db" 'PRAGMA integrity_check;')" == ok ]]; then print "正常 SQLite整合性"; else print "失敗 SQLite整合性"; failures=$((failures+1)); fi
    if owner_requirements_ok; then print "正常 オーナー要件"; else print "失敗 オーナー要件: SHA-256不一致"; failures=$((failures+1)); fi
    if (( doctor_quick )); then
      print '省略 監査hash chain全件検証（dispatch用即時診断）'
    elif "$0" -C "$project_root" audit verify >/dev/null 2>&1; then
      print "正常 監査hash chain"
    else
      print "失敗 監査hash chain"
      failures=$((failures+1))
    fi
    state_mode="$(stat -f '%Lp' "$state_root" 2>/dev/null || print unknown)"
    if [[ "$state_mode" == 700 ]]; then print "正常 状態directory権限"; else print "失敗 状態directory権限: $state_mode"; failures=$((failures+1)); fi
    if [[ "$profile" == phase2-publish || "$profile" == phase3-unattended ]]; then
      check_cmd gh
      if gh auth status >/dev/null 2>&1; then print '正常 GitHub認証'; else print '失敗 GitHub認証'; failures=$((failures+1)); fi
      publish_mode="$(sqlite3 "$db" "SELECT COALESCE(value,'manual') FROM metadata WHERE key='publish_mode';")"
      if [[ "$publish_mode" == automatic ]]; then print '正常 公開先remote確認'; else print '失敗 公開先remote未確認'; failures=$((failures+1)); fi
    fi
    if [[ "$profile" == phase2-notify || "$profile" == phase3-unattended ]]; then
      notification_config="$(notification_config_root)/notifications.json"
      if [[ -f "$notification_config" && "$(stat -f '%Lp' "$notification_config" 2>/dev/null || print unknown)" == 600 ]]; then print '正常 通知設定'; else print '失敗 通知設定または権限'; failures=$((failures+1)); fi
    fi
    if (( failures > 0 )); then exit 2; fi
    ;;
  audit)
    audit_action="${1:-verify}"
    case "$audit_action" in
      show) sqlite3 -header -column "$db" 'SELECT sequence,event_id,entity_type,entity_id,event_type,detail_hash,previous_hash,event_hash,created_at FROM audit_events ORDER BY sequence;';;
      verify)
        # One read snapshot and one hash implementation; still verify every row.
        python3 - "$db" <<'AUDIT'
import hashlib,sqlite3,sys
conn=sqlite3.connect('file:'+sys.argv[1]+'?mode=ro',uri=True)
conn.execute('BEGIN')
previous='GENESIS';expected=1
for row in conn.execute('SELECT sequence,event_id,entity_type,entity_id,event_type,detail_hash,previous_hash,event_hash,created_at FROM audit_events ORDER BY sequence'):
 sequence,event_id,kind,entity,event,detail,prev,digest,created=row
 payload='|'.join(str(x) if x is not None else '' for x in (sequence,event_id,kind,entity,event,detail,prev,created))
 actual=hashlib.sha256(payload.encode('utf-8')).hexdigest()
 if sequence!=expected or prev!=previous or digest!=actual:
  print(f'監査鎖が不正です: sequence={sequence}',file=sys.stderr);sys.exit(3)
 expected+=1;previous=digest
print(f'監査鎖: 正常（{expected-1}件）')
AUDIT
        ;;
      *) print -u2 '使い方: cpt audit verify|show'; exit 2;;
    esac
    ;;
  capacity)
    capacity_action="${1:-status}"
    capacity_values
    state_kib="$(du -sk "$state_root" 2>/dev/null | awk '{print $1}')"; [[ -n "$state_kib" ]] || state_kib=0
    case "$capacity_action" in
      status)
        print "空き容量: $((CAPACITY_FREE_BYTES/1024/1024)) MiB"
        print "警告下限: $((CAPACITY_WARNING_BYTES/1024/1024)) MiB"
        print "停止下限: $((CAPACITY_CRITICAL_BYTES/1024/1024)) MiB"
        print "Counterpointer状態使用量: $((state_kib/1024)) MiB"
        ;;
      check) ensure_capacity manual-check; print '容量検査: 正常';;
      *) print -u2 '使い方: cpt capacity status|check'; exit 2;;
    esac
    ;;
  cleanup)
    dry_run=1
    [[ "${1:-}" == "--apply" ]] && dry_run=0
    [[ -z "${1:-}" || "${1:-}" == "--dry-run" || "${1:-}" == "--apply" ]] || { print -u2 '使い方: cpt cleanup [--dry-run|--apply]'; exit 2; }
    while IFS='|' read -r task_id state worktree; do
      [[ -n "$worktree" && -d "$worktree" ]] || continue
      terminal_change_set="$(sqlite3 "$db" "SELECT c.state FROM change_set_tasks m JOIN change_sets c ON c.change_set_id=m.change_set_id WHERE m.task_id='$(sql_quote "$task_id")';")"
      [[ "$state" == CANCELLED || "$terminal_change_set" == MERGED || "$terminal_change_set" == CLOSED || "$terminal_change_set" == CANCELLED ]] || continue
      print "Task $task_id $worktree"
      if (( ! dry_run )); then
        git -C "$project_root" worktree remove --force "$worktree" 2>/dev/null || true
        sqlite3 "$db" "UPDATE tasks SET worktree=NULL WHERE task_id='$task_id';"
      fi
    done < <(sqlite3 "$db" 'SELECT task_id,state,worktree FROM tasks WHERE worktree IS NOT NULL;')
    while IFS='|' read -r job_id state worktree; do
      [[ -n "$worktree" && -d "$worktree" ]] || continue
      terminal_change_set="$(sqlite3 "$db" "SELECT state FROM change_sets WHERE change_set_id=(SELECT change_set_id FROM integration_jobs WHERE job_id='$(sql_quote "$job_id")');")"
      [[ "$terminal_change_set" == MERGED || "$terminal_change_set" == CLOSED || "$terminal_change_set" == CANCELLED ]] || continue
      print "統合 $job_id $worktree"
      if (( ! dry_run )); then
        git -C "$project_root" worktree remove --force "$worktree" 2>/dev/null || true
        sqlite3 "$db" "UPDATE integration_jobs SET worktree=NULL WHERE job_id='$job_id';"
      fi
    done < <(sqlite3 "$db" 'SELECT job_id,state,worktree FROM integration_jobs WHERE worktree IS NOT NULL;')
    (( dry_run == 0 )) && event project "$project_root" CLEANUP_APPLIED 'terminal worktrees only' || true
    ;;
  logs)
    entity_id="${1:-}"
    [[ -n "$entity_id" ]] || { print -u2 "対象IDが必要です"; exit 2; }
    sqlite3 -header -column "$db" "SELECT created_at,event_type,detail FROM events WHERE entity_id='$entity_id' ORDER BY created_at;"
    ;;
  usage)
    if [[ "${1:-}" == "import" ]]; then
      entity_id="${2:-}"; jsonl="${3:-}"
      [[ -n "$entity_id" && -f "$jsonl" ]] || { print -u2 "使い方: cpt usage import <ID> <JSONLファイル>"; exit 2; }
      command -v jq >/dev/null 2>&1 || { print -u2 "実測取り込みにはjqが必要です"; exit 2; }
      values="$(jq -s '[.[] | select(.usage != null) | .usage] | {input:(map(.input_tokens // 0)|add), cached:(map(.input_tokens_details.cached_tokens // .cached_input_tokens // 0)|add), output:(map(.output_tokens // 0)|add)}' "$jsonl")"
      measured_input="$(print -r -- "$values" | jq -r '.input')"
      measured_cached="$(print -r -- "$values" | jq -r '.cached')"
      measured_output="$(print -r -- "$values" | jq -r '.output')"
      [[ "$measured_input" != null && "$measured_input" != 0 ]] || { print -u2 "JSONログにusageがありません"; exit 2; }
      sqlite3 "$db" "INSERT INTO usage_metrics VALUES ('$(uuidgen | tr '[:upper:]' '[:lower:]')','task','$entity_id','imported',$measured_input,$measured_cached,$measured_output,NULL,NULL,'codex-json','$(now)');"
      print "実測usageを取り込みました: input=$measured_input cached=$measured_cached output=$measured_output"
      exit 0
    fi
    if [[ "${1:-}" == summary ]]; then
      measured_sessions="$(sqlite3 "$db" 'SELECT COUNT(*) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"
      estimated_sessions="$(sqlite3 "$db" 'SELECT COUNT(*) FROM usage_metrics WHERE estimated_input_tokens IS NOT NULL;')"
      measured_input="$(sqlite3 "$db" 'SELECT COALESCE(SUM(measured_input_tokens),0) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"
      measured_cached="$(sqlite3 "$db" 'SELECT COALESCE(SUM(measured_cached_tokens),0) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"
      measured_output="$(sqlite3 "$db" 'SELECT COALESCE(SUM(measured_output_tokens),0) FROM usage_metrics WHERE measured_input_tokens IS NOT NULL;')"
      estimated_input="$(sqlite3 "$db" 'SELECT COALESCE(SUM(estimated_input_tokens),0) FROM usage_metrics WHERE estimated_input_tokens IS NOT NULL;')"
      print "実測session: $measured_sessions"
      print "実測input: $measured_input"
      print "実測cached input: $measured_cached"
      print "実測output: $measured_output"
      if (( measured_input > 0 )); then print "実測cache率: $(( measured_cached * 100 / measured_input ))%"; print "実測cache再利用tokens: $measured_cached"; else print '実測cache率: 計測不能'; fi
      print "推定session: $estimated_sessions"
      print "推定input: $estimated_input（実測値には合算しません）"
      print "checkpoint: $(sqlite3 "$db" 'SELECT COUNT(*) FROM context_checkpoints;')"
      exit 0
    fi
    filter=""
    [[ "${1:-}" == --all || -z "${1:-}" ]] || filter=" WHERE entity_id='${1}'"
    sqlite3 -header -column "$db" "SELECT entity_type,entity_id,session_kind,measured_input_tokens,measured_cached_tokens,measured_output_tokens,estimated_input_tokens,prompt_bytes,source,created_at FROM usage_metrics$filter ORDER BY created_at;"
    ;;
  notify)
    notify_action="${1:-status}"
    case "$notify_action" in
      configure)
        provider=""; server=""; topic=""; token_stdin=0; enabled=0
        shift || true
        while (( $# )); do
          case "$1" in
            --provider) provider="$2"; shift 2;;
            --server) server="$2"; shift 2;;
            --topic) topic="$2"; shift 2;;
            --token-stdin) token_stdin=1; shift;;
            --enable) enabled=1; shift;;
            *) print -u2 "不明な通知設定です: $1"; exit 2;;
          esac
        done
        [[ "$provider" == ntfy && -n "$server" && -n "$topic" ]] || { print -u2 '使い方: cpt notify configure --provider ntfy --server <URL> --topic <topic> [--token-stdin] [--enable]'; exit 2; }
        [[ "$server" == https://* || "$server" == http://127.0.0.1:* || "$server" == http://localhost:* ]] || { print -u2 'ntfy serverはHTTPSが必要です（localhostを除く）'; exit 2; }
        [[ "$server" != *$'\n'* && "$topic" != *$'\n'* && "$topic" != */* ]] || { print -u2 '通知設定に不正な文字があります'; exit 2; }
        token=""
        if (( token_stdin )); then
          if [[ -n "${CPT_NOTIFICATION_TOKEN:-}" && "${COUNTERPOINTER_TEST:-0}" == 1 ]]; then token="$CPT_NOTIFICATION_TOKEN"; else read -rs "token?ntfy token（画面には表示されません）: "; print; fi
        fi
        [[ "$token" != *$'\n'* && "$token" != *'"'* ]] || { print -u2 'tokenに不正な文字があります'; exit 2; }
        config_root="$(notification_config_root)"; config_file="$config_root/notifications.json"; config_tmp="$config_file.new.$$"
        mkdir -p "$config_root"; chmod 700 "$config_root"
        jq -n --arg provider "$provider" --arg server "${server%/}" --arg topic "$topic" --arg token "$token" --argjson enabled "$enabled" '{schema_version:1,provider:$provider,server:$server,topic:$topic,token:$token,enabled:($enabled==1)}' > "$config_tmp"
        chmod 600 "$config_tmp"; /bin/mv "$config_tmp" "$config_file"; chmod 600 "$config_file"
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('notification_configured','1') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('notifications_enabled','$enabled') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        event project "$project_root" NOTIFICATION_CONFIGURED "provider=ntfy enabled=$enabled"
        print "ntfy設定を保存しました: $config_file"
        (( enabled == 0 )) || print '通知を有効にしました'
        ;;
      status)
        config_file="$(notification_config_root)/notifications.json"
        if [[ ! -f "$config_file" ]]; then print '通知: 未設定'; exit 0; fi
        config_mode="$(stat -f '%Lp' "$config_file" 2>/dev/null || print unknown)"
        print "通知: $(jq -r 'if .enabled then "有効" else "無効" end' "$config_file")"
        print "通知方式: $(jq -r '.provider' "$config_file")"
        print "サーバー: $(jq -r '.server' "$config_file")"
        print "トピック: $(jq -r '.topic' "$config_file")"
        print "token: $(jq -r 'if (.token|length)>0 then "設定済み" else "未設定" end' "$config_file")"
        print "権限: $config_mode"
        ;;
      test)
        emission_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"; timestamp="$(now)"
        sqlite3 "$db" "INSERT INTO notifications(emission_id,entity_id,message,state,attempts,created_at,updated_at) VALUES ('$emission_id','project','Counterpointer ntfy接続テスト','PENDING',0,'$timestamp','$timestamp');"
        if [[ "${2:-}" == --apply ]]; then "$0" -C "$project_root" notify deliver "$emission_id" --apply; else "$0" -C "$project_root" notify deliver "$emission_id" --dry-run; fi
        ;;
      deliver)
        emission_id="${2:-}"; delivery_mode="${3:---dry-run}"
        if [[ -z "$emission_id" || "$emission_id" == --* ]]; then emission_id="$(sqlite3 "$db" "SELECT emission_id FROM notifications WHERE state='PENDING' ORDER BY rowid LIMIT 1;")"; delivery_mode="${2:---dry-run}"; fi
        [[ -n "$emission_id" ]] || { print '配送待ち通知はありません'; exit 0; }
        notification_row="$(sqlite3 "$db" "SELECT message || '|' || state || '|' || attempts FROM notifications WHERE emission_id='$(sql_quote "$emission_id")';")"
        [[ -n "$notification_row" ]] || { print -u2 "通知が見つかりません: $emission_id"; exit 2; }
        IFS='|' read -r message notification_state attempts <<< "$notification_row"
        [[ "$notification_state" == PENDING ]] || { print "通知は配送対象外です: $notification_state"; exit 0; }
        payload_hash="$(text_sha256 "$message")"
        if [[ "$delivery_mode" != --apply ]]; then print "通知dry-run: id=$emission_id payload_sha256=$payload_hash"; exit 0; fi
        config_file="$(notification_config_root)/notifications.json"
        [[ -f "$config_file" && "$(stat -f '%Lp' "$config_file")" == 600 ]] || { print -u2 'mode 0600の通知設定が必要です'; exit 3; }
        [[ "$(jq -r '.enabled' "$config_file")" == true ]] || { print -u2 '通知は無効です'; exit 3; }
        server="$(jq -r '.server' "$config_file")"; topic="$(jq -r '.topic' "$config_file")"; token="$(jq -r '.token // ""' "$config_file")"
        curl_bin="${COUNTERPOINTER_CURL_BIN:-curl}"
        event notification "$emission_id" DELIVERY_INTENT "$payload_hash"
        if response="$({ print 'silent'; print 'show-error'; print 'fail-with-body'; [[ -z "$token" ]] || print -r -- "header = \"Authorization: Bearer $token\""; } | "$curl_bin" --config - --data-binary "$message" "$server/$topic" 2>/dev/null)"; then
          external_id="$(print -r -- "$response" | jq -r '.id // "confirmed"' 2>/dev/null || print confirmed)"
          sqlite3 "$db" "UPDATE notifications SET state='CONFIRMED',attempts=attempts+1,provider_id='ntfy',external_id='$(sql_quote "$external_id")',last_error=NULL,next_attempt_at=NULL,updated_at='$(now)' WHERE emission_id='$(sql_quote "$emission_id")' AND state='PENDING';"
          event notification "$emission_id" DELIVERY_CONFIRMED "$external_id"
          print "通知配送成功: $emission_id"
        else
          next_attempts=$((attempts+1)); [[ "$next_attempts" -ge 5 ]] && next_state=DEAD_LETTER || next_state=PENDING
          sqlite3 "$db" "UPDATE notifications SET state='$next_state',attempts=$next_attempts,provider_id='ntfy',last_error='DELIVERY_FAILED',next_attempt_at='$(now)',updated_at='$(now)' WHERE emission_id='$(sql_quote "$emission_id")' AND state='PENDING';"
          event notification "$emission_id" DELIVERY_FAILED "attempt=$next_attempts state=$next_state"
          print -u2 "通知配送失敗: $emission_id（attempt=$next_attempts state=$next_state）"
          exit 4
        fi
        ;;
      *)
        task_id="$notify_action"; message="${2:-Counterpointer task update}"
        [[ -n "$task_id" ]] || { print -u2 "Task IDが必要です"; exit 2; }
        emission_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        sqlite3 "$db" "INSERT INTO notifications(emission_id,entity_id,message,state,attempts,created_at,updated_at) VALUES ('$emission_id','$(sql_quote "$task_id")','$(sql_quote "$message")','PENDING',0,'$(now)','$(now)');"
        event task "$task_id" NOTIFICATION "$message"
        print "通知を記録しました: $emission_id"
        ;;
    esac
    ;;
  notify-resolve)
    emission_id="${1:-}"; decision="${2:-}"
    [[ "$decision" == "confirm_delivered" || "$decision" == "retry" || "$decision" == "dismiss" ]] || { print -u2 "判断はconfirm_delivered、retry、dismissのいずれかです"; exit 2; }
    case "$decision" in
      confirm_delivered) next=CONFIRMED;;
      retry) next=PENDING;;
      dismiss) next=DEAD_LETTER;;
    esac
    sqlite3 "$db" "UPDATE notifications SET state='$next', attempts=attempts+1, updated_at='$(now)' WHERE emission_id='$emission_id' AND state IN ('PENDING','UNCERTAIN');"
    print "$emission_id: $next"
    ;;
  config)
    case "${1:-}" in
      --max-parallel)
        [[ -n "${2:-}" && "${2}" == <-> && "$2" -gt 0 ]] || { print -u2 "並列上限は1以上の整数で指定してください"; exit 2; }
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('max_parallel_tasks','$2') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        ;;
      --integration-review)
        [[ "${2:-}" == required ]] || { print -u2 '使い方: config --integration-review required'; exit 2; }
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('integration_review_required','1') ON CONFLICT(key) DO UPDATE SET value='1';"
        print '最終統合SHAの受入証拠を公開前に必須としました'
        ;;
      --integration-verify)
        verify_hook_path="${2:-}"
        [[ -n "$verify_hook_path" && "$verify_hook_path" != /* && "$verify_hook_path" != *'..'* ]] || { print -u2 "verify hookはリポジトリ相対pathで指定してください"; exit 2; }
        git -C "$project_root" cat-file -e "HEAD:$verify_hook_path" 2>/dev/null || { print -u2 "現在の固定baseにverify hookがありません: $verify_hook_path"; exit 2; }
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('integration_verify_hook','$(sql_quote "$verify_hook_path")') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        print "統合verify hookを設定しました: $verify_hook_path"
        ;;
      --publish-base)
        publish_base="${2:-}"
        [[ -n "$publish_base" && "$publish_base" != refs/* && "$publish_base" != *'..'* ]] || { print -u2 "base branch名が不正です"; exit 2; }
        git check-ref-format "refs/heads/$publish_base" >/dev/null 2>&1 || { print -u2 "base branch名が不正です: $publish_base"; exit 2; }
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('publish_base_branch','$(sql_quote "$publish_base")') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        print "PRのbase branchを設定しました: $publish_base"
        ;;
      --publish-remote)
        publish_remote="${2:-}"
        [[ -n "$publish_remote" ]] || { print -u2 "remote名が必要です"; exit 2; }
        git -C "$project_root" remote get-url "$publish_remote" >/dev/null 2>&1 || { print -u2 "remoteが見つかりません: $publish_remote"; exit 2; }
        sqlite3 "$db" "INSERT INTO metadata(key,value) VALUES('publish_remote','$(sql_quote "$publish_remote")') ON CONFLICT(key) DO UPDATE SET value=excluded.value;"
        print "公開remoteを設定しました: $publish_remote"
        ;;
      --capacity)
        critical_mib="${2:-}"; warning_mib="${3:-}"
        [[ "$critical_mib" == <-> && "$warning_mib" == <-> && "$critical_mib" -gt 0 && "$warning_mib" -gt "$critical_mib" ]] || { print -u2 '容量は criticalMiB < warningMiB となる正の整数で指定してください'; exit 2; }
        sqlite3 "$db" "BEGIN; INSERT INTO metadata(key,value) VALUES('capacity_critical_mib','$critical_mib') ON CONFLICT(key) DO UPDATE SET value=excluded.value; INSERT INTO metadata(key,value) VALUES('capacity_warning_mib','$warning_mib') ON CONFLICT(key) DO UPDATE SET value=excluded.value; COMMIT;"
        print "容量下限を設定しました: critical=${critical_mib}MiB warning=${warning_mib}MiB"
        ;;
      *) print -u2 "使い方: cpt config --max-parallel <件数> | --integration-verify <相対path> | --publish-base <branch> | --publish-remote <remote> | --capacity <criticalMiB> <warningMiB>"; exit 2;;
    esac
    ;;
  supervise)
    mode="${1:-}"
    [[ "$mode" == "--once" || "$mode" == "--watch" ]] || { print -u2 "使い方: cpt supervise --once|--watch [--interval <秒>]"; exit 2; }
    interval=5
    if [[ "${2:-}" == "--interval" ]]; then interval="$3"; fi
    [[ "$interval" == <-> && "$interval" -gt 0 ]] || { print -u2 "監視間隔は正の整数で指定してください"; exit 2; }
    lockdir="$state_root/supervisor.lock"
    if ! mkdir "$lockdir" 2>/dev/null; then print -u2 "supervisorは既に実行中です"; exit 2; fi
    trap 'rmdir "$lockdir" 2>/dev/null || true' EXIT
    trap 'rmdir "$lockdir" 2>/dev/null || true; exit 0' INT TERM
    while true; do
      service_execution_gate || break
      last_backup_epoch="$(sqlite3 "$db" "SELECT COALESCE(value,'0') FROM metadata WHERE key='last_backup_epoch';")"; [[ -n "$last_backup_epoch" ]] || last_backup_epoch=0
      current_epoch="$(date +%s)"
      if (( current_epoch - last_backup_epoch >= 86400 )); then "$0" -C "$project_root" backup >/dev/null || true; fi
      if [[ "$(sqlite3 "$db" "SELECT COALESCE(value,'NOT_INITIALIZED') FROM metadata WHERE key='index_onboarding_state';")" == READY ]]; then "$0" -C "$project_root" index sync >/dev/null || true; fi
      "$0" -C "$project_root" parent-runtime reconcile 0 --defer-publish || true
      "$0" -C "$project_root" runtime reconcile supervisor 0 || true
      # REGISTEREDは対象外。READYだけを完了・マージ確認後に再評価する。
      while IFS= read -r launch_task; do
        [[ -n "$launch_task" ]] || continue
        "$0" -C "$project_root" run "$launch_task" || true
      done < <(sqlite3 "$db" "SELECT t.task_id FROM tasks t WHERE t.state='RUNNING' AND NOT EXISTS (SELECT 1 FROM task_runtimes r WHERE r.task_id=t.task_id AND r.state IN ('STARTING','ACTIVE','RESUMING','RESTARTING')) AND (NOT EXISTS (SELECT 1 FROM task_runtimes any_runtime WHERE any_runtime.task_id=t.task_id) OR EXISTS (SELECT 1 FROM task_retry_requests rr WHERE rr.task_id=t.task_id AND rr.state='DISPATCHED')) ORDER BY t.created_at;")
      parent_log="$state_root/orchestrator-events.log"
      compaction_marker="$state_root/context/compaction-required"
      compaction_threshold="$(sqlite3 "$db" "SELECT COALESCE(value,'1048576') FROM metadata WHERE key='context_compaction_bytes';")"
      [[ -n "$compaction_threshold" ]] || compaction_threshold=1048576
      if [[ -f "$parent_log" && ! -f "$compaction_marker" ]]; then
        parent_log_bytes="$(wc -c < "$parent_log" | tr -d ' ')"
        if (( parent_log_bytes >= compaction_threshold )); then
          print "required_at=$(now)" > "$compaction_marker"
          print "log_bytes=$parent_log_bytes" >> "$compaction_marker"
          event project "$project_root" CONTEXT_COMPACTION_REQUIRED "$parent_log_bytes"
        fi
      fi
      # Completion is event-driven through SQLite states.  The parent performs
      # deterministic checks automatically; no manual per-task commands are
      # required once a child has signalled selfcheck completion.
      while IFS= read -r task_id; do
        [[ -n "$task_id" ]] || continue
        "$0" -C "$project_root" verify "$task_id" || true
      done < <(sqlite3 "$db" "SELECT task_id FROM tasks WHERE state='CLAIMED_DONE';")
      while IFS= read -r task_id; do
        [[ -n "$task_id" ]] || continue
        "$0" -C "$project_root" external-verify "$task_id" || true
      done < <(sqlite3 "$db" "SELECT t.task_id FROM tasks t LEFT JOIN verify_results v ON v.task_id=t.task_id AND v.status='PASSED' WHERE t.state='VERIFIED' AND v.task_id IS NULL;")
      while IFS='|' read -r browser_task browser_wt; do
        [[ -f "$browser_wt/.counterpointer-task/browser-surface.json" ]] || continue
        close_task_browser "$browser_task" "$browser_wt" || true
      done < <(sqlite3 "$db" "SELECT t.task_id,t.worktree FROM tasks t WHERE (t.state IN ('FAILED','CANCELLED') OR (t.state='VERIFIED' AND EXISTS (SELECT 1 FROM verify_results v WHERE v.task_id=t.task_id AND v.status='PASSED'))) AND COALESCE(t.worktree,'')<>'';")
      while IFS= read -r ready_change_set; do
        [[ -n "$ready_change_set" ]] || continue
        integration_lock="$state_root/integration-$ready_change_set.lock"
        if mkdir "$integration_lock" 2>/dev/null; then
          "$0" -C "$project_root" integrate "$ready_change_set" || true
          rmdir "$integration_lock" 2>/dev/null || true
        fi
      done < <(sqlite3 "$db" "SELECT c.change_set_id FROM change_sets c WHERE c.state='OPEN' AND EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state='VERIFIED') AND NOT EXISTS (SELECT 1 FROM change_set_tasks m JOIN tasks t ON t.task_id=m.task_id WHERE m.change_set_id=c.change_set_id AND t.state NOT IN ('VERIFIED','CANCELLED')) AND NOT EXISTS (SELECT 1 FROM integration_jobs j WHERE j.change_set_id=c.change_set_id AND j.membership_revision=c.membership_revision AND j.state IN ('PREPARING','VERIFYING','VERIFIED')) ORDER BY c.created_at;")
      while IFS= read -r publish_job; do
        [[ -n "$publish_job" ]] || continue
        prepare_publish_request "$publish_job" || true
      done < <(sqlite3 "$db" "SELECT j.job_id FROM integration_jobs j WHERE j.state='VERIFIED' AND NOT EXISTS (SELECT 1 FROM publish_requests p WHERE p.job_id=j.job_id AND p.head_sha=j.candidate_sha AND p.state IN ('PREPARED','PUBLISHED')) ORDER BY j.rowid;")
      process_pending_publications
      while IFS= read -r published_request; do
        [[ -n "$published_request" ]] || continue
        "$0" -C "$project_root" publish reconcile "$published_request" --record-only >/dev/null || true
        # Sync is owned by this normally launched worker, not the parent sandbox.
        # A transient API failure must not suppress retries of an already recorded merge.
        if [[ "$(sqlite3 "$db" "SELECT pr_state FROM pull_requests WHERE request_id='$(sql_quote "$published_request")';")" == MERGED ]]; then
          "$0" -C "$project_root" publish sync "$published_request" || true
        fi
      done < <(sqlite3 "$db" "SELECT request_id FROM publish_requests WHERE state='PUBLISHED' ORDER BY rowid;")
      "$0" -C "$project_root" dispatch --automatic || true
      if [[ "$(sqlite3 "$db" "SELECT COALESCE(value,'0') FROM metadata WHERE key='notifications_enabled';")" == 1 ]]; then
        while IFS= read -r pending_emission; do
          [[ -n "$pending_emission" ]] || continue
          "$0" -C "$project_root" notify deliver "$pending_emission" --apply || true
        done < <(sqlite3 "$db" "SELECT emission_id FROM notifications WHERE state='PENDING' AND attempts<5 ORDER BY rowid LIMIT 10;")
      fi
      [[ "$mode" == "--once" ]] && break
      sleep "$interval"
    done
    "$0" -C "$project_root" status
    ;;
  watchdog)
    mode="${1:-}"
    [[ "$mode" == "--once" || "$mode" == "--watch" ]] || { print -u2 "使い方: cpt watchdog --once|--watch"; exit 2; }
    if [[ "$mode" == "--watch" ]]; then
      trap 'exit 0' INT TERM
      while true; do "$0" -C "$project_root" watchdog --once || true; sleep "${2:-10}"; done
    fi
    "$0" -C "$project_root" parent-runtime reconcile 0 || true
    "$0" -C "$project_root" runtime reconcile watchdog 0 || true
    issues=0
    service_state="$state_root/service.state"
    if [[ -f "$service_state" && "$(sed -n 's/^state=//p' "$service_state")" == RUNNING && ! -d "$state_root/supervisor.lock" ]]; then
      print "警告 supervisor lockがありません"
      issues=$((issues+1))
    fi
    stale="$(sqlite3 "$db" "SELECT COUNT(*) FROM tasks WHERE state IN ('RUNNING','CLAIMED_DONE','VERIFYING') AND (worktree IS NULL OR worktree='');")"
    if (( stale > 0 )); then print "警告 worktreeのないTask=$stale"; issues=$((issues+stale)); fi
    runtime_failures="$(sqlite3 "$db" "SELECT COUNT(*) FROM task_runtimes WHERE state='FAILED';")"
    if (( runtime_failures > 0 )); then print "警告 子session復旧失敗=$runtime_failures"; issues=$((issues+runtime_failures)); fi
    if (( issues > 0 )); then
      "$0" -C "$project_root" reconcile >/dev/null || true
      print "監視: 問題=$issues、整合化を実行しました"
      exit 2
    fi
    print "監視: 正常"
    ;;
  recovery)
    recovery_action="${1:-status}"
    if [[ "$recovery_action" == "drill" ]]; then
      drill_dir="$(mktemp -d)"
      trap 'rm -rf "$drill_dir"' EXIT
      drill_backup="$drill_dir/state.sqlite3"
      sqlite3 "$db" ".backup '$drill_backup'"
      [[ "$(sqlite3 "$drill_backup" 'PRAGMA integrity_check;')" == ok ]] || { print -u2 "復元試験: 整合性検査に失敗しました"; exit 1; }
      source_count="$(sqlite3 "$db" 'SELECT COUNT(*) FROM tasks;')"
      restored_count="$(sqlite3 "$drill_backup" 'SELECT COUNT(*) FROM tasks;')"
      [[ "$source_count" == "$restored_count" ]] || { print -u2 "復元試験: Task件数が一致しません"; exit 1; }
      print "復元試験: 成功（Task=$restored_count件）"
      exit 0
    fi
    [[ "$recovery_action" == "status" ]] || { print -u2 "使い方: cpt recovery status|drill"; exit 2; }
    print "プロジェクト=$project_root"
    print "データベース整合性=$(sqlite3 "$db" 'PRAGMA integrity_check;')"
    print "最新backup=$(find "$state_root/backups" -type f -name '*.sqlite3' 2>/dev/null | sort | tail -1)"
    print "サービス=$(sed -n 's/^state=//p' "$state_root/service.state" 2>/dev/null || print 未登録)"
    ;;
  test)
    case "${1:-}" in
      smoke)
        test_script="$project_root/tests/smoke.zsh"
        [[ -x "$test_script" ]] || { print -u2 "基本testを利用できません"; exit 2; }
        "$test_script"
        ;;
      e2e) /bin/zsh "$project_root/tests/e2e.zsh";;
      install) /bin/zsh "$project_root/tests/install.zsh";;
      all)
        "$0" -C "$project_root" doctor --profile phase1-attended
        "$0" -C "$project_root" recovery drill
        "$project_root/tests/smoke.zsh"
        /bin/zsh "$project_root/tests/graph.zsh"
        /bin/zsh "$project_root/tests/runtime.zsh"
        /bin/zsh "$project_root/tests/child-attention.zsh"
        /bin/zsh "$project_root/tests/browser.zsh"
        /bin/zsh "$project_root/tests/resume-session.zsh"
        /bin/zsh "$project_root/tests/resume-hardening.zsh"
        /bin/zsh "$project_root/tests/restart-workflow.zsh"
        /bin/zsh "$project_root/tests/orphan-monitor.zsh"
        /bin/zsh "$project_root/tests/integration.zsh"
        /bin/zsh "$project_root/tests/integration-order.zsh"
        /bin/zsh "$project_root/tests/repair-bounds.zsh"
        /bin/zsh "$project_root/tests/scheduling.zsh"
        /bin/zsh "$project_root/tests/scheduler-priority.zsh"
        /bin/zsh "$project_root/tests/publish.zsh"
        /bin/zsh "$project_root/tests/publish-branch.zsh"
        /bin/zsh "$project_root/tests/context.zsh"
        /bin/zsh "$project_root/tests/security.zsh"
        /bin/zsh "$project_root/tests/operations.zsh"
        /bin/zsh "$project_root/tests/e2e.zsh"
        /bin/zsh "$project_root/tests/install.zsh"
        /bin/zsh "$project_root/tests/migration.zsh"
        /bin/zsh "$project_root/tests/index-lifecycle.zsh"
        /bin/zsh "$project_root/tests/concurrency.zsh"
        /bin/zsh "$project_root/tests/retry.zsh"
        /bin/zsh "$project_root/tests/verification-recovery.zsh"
        /bin/zsh "$project_root/tests/cancel.zsh"
        ;;
      *) print -u2 "使い方: cpt test smoke|e2e|install|all"; exit 2;;
    esac
    ;;
  *)
    print -u2 "不明なコマンドです: $cmd"
    exit 2
    ;;
esac
